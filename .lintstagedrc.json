{
  "*": "prettier --check --ignore-unknown --no-error-on-unmatched-pattern",
  "*.ts": "eslint --no-warn-ignored --max-warnings 0",
  "*.{sh,bash}": "scripts/lint-shell",
  ".githooks/!(*.*)": "scripts/lint-shell",
  "scripts/!(*.*)": "scripts/lint-shell",
  "plugins/*/bin/!(*.*)": "scripts/lint-shell",
  "plugins/*/skills/*/scripts/!(*.*)": "scripts/lint-shell"
}
