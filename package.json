{
  "name": "darrow",
  "private": true,
  "license": "BUSL-1.1",
  "author": "Björn Rochel <bjoern@bjro.de>",
  "repository": {
    "type": "git",
    "url": "https://github.com/BjRo/darrow.git"
  },
  "type": "module",
  "scripts": {
    "check:docs": "bun scripts/check-docs.ts",
    "check:docs:external": "bun scripts/check-docs.ts --external",
    "check:decisions": "uv run --quiet --frozen --no-dev --project plugins/foundation/darrow-decisions/backend darrow-decision validate --repo .",
    "check:python": "scripts/check-python",
    "check:python:inventory": "scripts/test-python-inventory",
    "check:python:performance": "plugins/capability/darrow-observability-langfuse/tests/performance.test.sh",
    "eval": "bun evals/runner/run.ts",
    "test:eval-runner-compatibility": "bun test evals/runner/compatibility",
    "eval:coverage": "bun evals/runner/coverage.ts",
    "eval:orchestration:prepare": "bun evals/corpus/orchestration/prepare.ts",
    "eval:orchestration": "bun evals/runner/suite.ts",
    "format": "prettier --write .",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "prettier --check .",
    "lint:shell": "scripts/lint-shell",
    "lint:staged": "lint-staged",
    "lint:ts": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.2.0",
    "eslint": "^10.8.1",
    "github-slugger": "^2.0.0",
    "lint-staged": "^17.0.8",
    "markdown-it": "^15.0.2",
    "prettier": "^3.9.5",
    "smol-toml": "1.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "yaml": "^2.6.0"
  }
}
