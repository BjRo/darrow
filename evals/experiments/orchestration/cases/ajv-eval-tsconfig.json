{
  "compilerOptions": {
    "outDir": "../dist",
    "target": "ES2018",
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": true,
    "lib": ["ES2018", "DOM"],
    "typeRoots": ["./eval-tools/node_modules/@types"],
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "strict": true,
    "strictNullChecks": true,
    "declaration": true
  },
  "include": ["../lib", "./eval-stubs.d.ts"],
  "exclude": ["../lib/standalone/instance.ts"]
}
