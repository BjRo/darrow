  "boundary": "CliRunner combined output must contain binary stdout/stderr writelines writes interleaved with text writes, without explicit flushing.",
  "method": "Extract the latest complete src/click/testing.py diff retained in each native bundle; verify bundle and transcript hashes; apply only that file to pinned Click 8.0.0 source in an isolated copy; verify the reconstructed Git blob against the retained diff index; run the same public CliRunner probe under Python 3.13. No transcript commands are replayed.",
  "probe": {
    "path": "/Users/bjro/Benchmarks/darrow/2026-10-30-review-medium-n1/click-quality-probe/probe.py",
    "sha256": "66024d1b8c1c05e6347a37dd8d480de7f8dd4c3e21c0185e09417ae9f7f5f3e1",
    "source": "import hashlib\nimport json\nfrom pathlib import Path\nimport sys\n\nimport click\nfrom click.testing import CliRunner\n\nrows = []\nfor selected in (\"stdout\", \"stderr\"):\n    for method in (\"write\", \"writelines\"):\n\n        @click.command()\n        def command():\n            other = sys.stderr if selected == \"stdout\" else sys.stdout\n            other.write(\"before\")\n            stream = click.get_binary_stream(selected)\n            if method == \"write\":\n                stream.write(b\" middle\")\n            else:\n                stream.writelines([b\" middle\"])\n            other.write(\" after\")\n\n        result = CliRunner().invoke(command)\n        expected = b\"before middle after\"\n        rows.append({\n            \"stream\": selected,\n            \"method\": method,\n            \"stdout_bytes\": repr(result.stdout_bytes),\n            \"stderr_bytes\": repr(result.stderr_bytes),\n            \"output_bytes\": repr(result.output_bytes),\n            \"output\": result.output,\n            \"expected_output_bytes\": repr(expected),\n            \"exception\": repr(result.exception),\n            \"passed\": result.exception is None\n            and result.output_bytes == expected\n            and result.output == expected.decode(),\n        })\n\nsource = Path(sys.modules[\"click.testing\"].__file__)\ndata = source.read_bytes()\nprint(json.dumps({\n    \"source\": str(source),\n    \"source_sha256\": hashlib.sha256(source.read_bytes()).hexdigest(),\n    \"source_git_blob_id\": hashlib.sha1(b\"blob \" + str(len(data)).encode() + b\"\\0\" + data).hexdigest(),\n    \"python\": sys.version,\n    \"checks\": rows,\n}, indent=2))\nsys.exit(0 if all(row[\"passed\"] for row in rows) else 1)\n"
  },
