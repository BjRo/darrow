{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/skill-metadata/v1",
  "title": "Darrow skill metadata",
  "description": "Metadata for a Darrow command or capability skill.",
  "oneOf": [
    {
      "title": "Command skill",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "contractVersion",
        "inputSchema",
        "outputSchema"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "command"
        },
        "contractVersion": {
          "$ref": "#/$defs/semver"
        },
        "inputSchema": {
          "$ref": "#/$defs/schemaPath"
        },
        "outputSchema": {
          "$ref": "#/$defs/schemaPath"
        },
        "cancellation": {
          "description": "Whether an active invocation may be interrupted safely; omission means wait_for_boundary.",
          "enum": ["wait_for_boundary", "interrupt"]
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          },
          "uniqueItems": true
        }
      }
    },
    {
      "title": "Capability skill",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "provides"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "capability"
        },
        "provides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provision"
          },
          "uniqueItems": true
        }
      }
    }
  ],
  "$defs": {
    "contractId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "semverRange": {
      "type": "string",
      "minLength": 1
    },
    "schemaPath": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^\\./.+\\.json$"
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "version"],
      "properties": {
        "contract": {
          "$ref": "#/$defs/contractId"
        },
        "version": {
          "$ref": "#/$defs/semverRange"
        }
      }
    },
    "provision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "version"],
      "properties": {
        "contract": {
          "$ref": "#/$defs/contractId"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    }
  }
}
