{
  "format": "sevro.runtime.v1",
  "environment": {
    "inherit": ["PATH", "UV_PYTHON_INSTALL_DIR"],
    "set": {
      "UV_CACHE_DIR": "{{sevro.runtime}}/uv-cache",
      "UV_PYTHON_DOWNLOADS": "never"
    }
  },
  "filesystem": {
    "readOnlyRoots": ["${UV_PYTHON_INSTALL_DIR}"],
    "optionalReadOnlyRoots": ["/System/Library/OpenSSL"]
  },
  "runtime": {
    "sharedCacheDirectories": [
      {
        "source": "~/.darrow/cache/sevro-uv-cache",
        "target": "uv-cache",
        "roles": ["candidate", "checks"]
      }
    ]
  },
  "hooks": {
    "nativeGoal": true
  },
  "nativeTranscripts": true
}
