{
  "name": "@darrow/cli",
  "version": "0.1.0",
  "description": "Local-first durable workflow runtime for agentic delivery",
  "type": "module",
  "bin": {
    "darrow": "./src/index.ts",
    "darrow-install": "./src/install.ts"
  },
  "files": [
    "src",
    "schemas",
    "fixtures",
    "workflows",
    "profiles",
    "temporal.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun test tests/e2e.test.ts",
    "install:temporal:global": "bun src/install.ts --scope global --temporal-only",
    "install:temporal:local": "bun src/install.ts --scope local --temporal-only"
  },
  "dependencies": {
    "@temporalio/activity": "1.20.3",
    "@temporalio/client": "1.20.3",
    "@temporalio/worker": "1.20.3",
    "@temporalio/workflow": "1.20.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "semver": "7.8.5",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@types/bun": "1.2.18",
    "@types/semver": "7.7.1",
    "typescript": "5.8.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "license": "MIT"
}
