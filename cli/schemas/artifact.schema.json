{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/artifact-reference/0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "type",
    "schema",
    "schemaDigest",
    "contentHash",
    "size",
    "stepId",
    "attemptId",
    "location",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "artifactId": { "type": "string" },
    "type": { "type": "string" },
    "schema": { "type": "string" },
    "schemaDigest": { "$ref": "#/$defs/digest" },
    "contentHash": { "$ref": "#/$defs/digest" },
    "size": { "type": "integer", "minimum": 0 },
    "stepId": { "type": "string" },
    "attemptId": { "type": "string" },
    "location": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
