{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/workflow/0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "engine",
    "inputs",
    "requirements",
    "loops",
    "steps"
  ],
  "oneOf": [
    {
      "required": ["profile"],
      "properties": {
        "profile": { "$ref": "#/$defs/id" },
        "roles": false,
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "role": false }
          }
        }
      }
    },
    {
      "required": ["roles"],
      "properties": {
        "profile": false,
        "roles": { "type": "object" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role"],
            "properties": { "role": { "$ref": "#/$defs/id" } }
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/semver" },
    "engine": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "required"],
        "properties": {
          "type": { "enum": ["string", "boolean", "number"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities"],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirement" },
          "uniqueItems": true
        }
      }
    },
    "profile": { "$ref": "#/$defs/id" },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile"],
        "properties": {
          "profile": { "$ref": "#/$defs/id" }
        }
      }
    },
    "loops": {
      "type": "array",
      "items": { "$ref": "#/$defs/loop" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dependsOn", "command", "with"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "role": { "$ref": "#/$defs/id" },
          "dependsOn": {
            "type": "array",
            "items": { "$ref": "#/$defs/id" },
            "uniqueItems": true
          },
          "command": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
              },
              "version": { "type": "string", "minLength": 1 }
            }
          },
          "with": { "type": "object" },
          "publish": { "$ref": "#/$defs/publication" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "version"],
      "properties": {
        "contract": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
        },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticket", "artifactTypes"],
      "properties": {
        "ticket": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "project", "nativeId", "url"],
          "properties": {
            "backend": { "type": "string", "minLength": 1 },
            "project": { "type": "string", "minLength": 1 },
            "nativeId": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 }
          }
        },
        "artifactTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "outcomeValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "steps", "maxAttempts", "until", "waiver"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "until": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stepId", "output", "equals"],
          "properties": {
            "stepId": { "$ref": "#/$defs/id" },
            "output": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            },
            "equals": { "$ref": "#/$defs/outcomeValue" }
          }
        },
        "waiver": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "description", "instructionsTo"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "description": { "type": "string", "minLength": 1 },
                "instructionsTo": {
                  "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }]
                }
              }
            }
          ]
        }
      }
    }
  }
}
