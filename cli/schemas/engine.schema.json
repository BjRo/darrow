{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/engine/0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engineVersion",
    "backend",
    "workflowSchemaVersions",
    "cliProtocolVersions"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "engineVersion": { "const": "0.1.0" },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapterVersion"],
      "properties": {
        "id": { "const": "temporal" },
        "adapterVersion": { "const": "0.1.0" }
      }
    },
    "workflowSchemaVersions": { "type": "array", "const": ["0.1.0"] },
    "cliProtocolVersions": { "type": "array", "const": ["0.1.0"] }
  }
}
