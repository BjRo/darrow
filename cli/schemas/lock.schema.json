{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/lock/0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "createdAt",
    "versions",
    "planDigest",
    "workflow",
    "commands",
    "capabilities",
    "roles",
    "routes",
    "schemas",
    "builtins",
    "adapters",
    "engine"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "runId": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "cliProtocol", "workflowSchema"],
      "properties": {
        "engine": { "const": "0.1.0" },
        "cliProtocol": { "const": "0.1.0" },
        "workflowSchema": { "const": "0.1.0" }
      }
    },
    "planDigest": { "$ref": "#/$defs/digest" },
    "workflow": { "$ref": "#/$defs/workflow" },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/role" }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    },
    "schemas": { "type": "array", "items": { "$ref": "#/$defs/schema" } },
    "builtins": { "type": "array", "items": { "$ref": "#/$defs/builtin" } },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/adapter" }
    },
    "engine": { "$ref": "#/$defs/engine" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source", "scope", "digest"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "source": { "type": "string" },
        "scope": { "enum": ["explicit", "project", "user", "bundled"] },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "id",
        "contractVersion",
        "pluginVersion",
        "source",
        "digest"
      ],
      "properties": {
        "harness": { "enum": ["codex", "claude"] },
        "id": { "type": "string" },
        "contractVersion": { "type": "string" },
        "pluginVersion": { "type": "string" },
        "source": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "contract",
        "requested",
        "version",
        "providerId",
        "pluginVersion",
        "scope",
        "source",
        "digest"
      ],
      "properties": {
        "harness": { "enum": ["codex", "claude"] },
        "contract": { "type": "string" },
        "requested": { "type": "string" },
        "version": { "type": "string" },
        "providerId": { "type": "string" },
        "pluginVersion": { "type": "string" },
        "scope": { "enum": ["explicit", "project", "user", "bundled"] },
        "source": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "harness",
        "provider",
        "model",
        "reasoningEffort",
        "permissions",
        "source",
        "scope",
        "digest"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "id": { "type": "string" },
        "harness": { "enum": ["codex", "claude"] },
        "provider": { "enum": ["openai", "anthropic"] },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "type": "string", "minLength": 1 },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inherit"],
          "properties": { "inherit": { "const": true } }
        },
        "source": { "type": "string" },
        "scope": { "enum": ["explicit", "project", "user", "bundled"] },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": { "properties": { "harness": { "const": "codex" } } },
          "then": {
            "properties": {
              "provider": { "const": "openai" }
            }
          }
        },
        {
          "if": { "properties": { "harness": { "const": "claude" } } },
          "then": {
            "properties": {
              "provider": { "const": "anthropic" }
            }
          }
        }
      ]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/profile" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeId",
        "profileId",
        "profileDigest",
        "harness",
        "provider",
        "model",
        "reasoningEffort",
        "permissions",
        "limits",
        "adapter",
        "selectionSource"
      ],
      "properties": {
        "routeId": { "$ref": "#/$defs/digest" },
        "profileId": { "type": "string", "minLength": 1 },
        "profileDigest": { "$ref": "#/$defs/digest" },
        "harness": { "enum": ["codex", "claude"] },
        "provider": { "enum": ["openai", "anthropic"] },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "type": "string", "minLength": 1 },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inherit"],
          "properties": { "inherit": { "const": true } }
        },
        "limits": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "enum": ["codex-cli", "claude-code"] },
            "version": { "const": "0.1.0" }
          }
        },
        "selectionSource": {
          "enum": [
            "fixed_plan",
            "scoped_human_amendment",
            "explicit_user_pin",
            "routing_policy"
          ]
        }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "version", "location", "digest"],
      "properties": {
        "identity": { "type": "string" },
        "version": { "type": "string" },
        "location": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "builtin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "executable",
        "detectedVersion",
        "harness",
        "routeIds",
        "nativePermissions"
      ],
      "properties": {
        "id": { "enum": ["codex-cli", "claude-code"] },
        "version": { "const": "0.1.0" },
        "executable": { "type": "string" },
        "detectedVersion": { "type": "string" },
        "harness": { "enum": ["codex", "claude"] },
        "routeIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/digest" },
          "uniqueItems": true
        },
        "nativePermissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inherit", "configurationSources"],
          "properties": {
            "inherit": { "const": true },
            "configurationEnvironment": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "CODEX_HOME": { "type": "string" },
                "CLAUDE_CONFIG_DIR": { "type": "string" },
                "DARROW_CODEX_PERMISSION_PROFILE": { "type": "string" },
                "DARROW_EXTERNAL_WORKSPACE_SANDBOX_ROOT": {
                  "type": "string"
                },
                "PATH": { "type": "string" }
              }
            },
            "configurationSources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "scope", "digest"],
                "properties": {
                  "path": { "type": "string" },
                  "scope": {
                    "enum": ["environment", "user", "project", "local"]
                  },
                  "present": { "type": "boolean" },
                  "digest": { "$ref": "#/$defs/digest" }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "harness": { "const": "codex" } } },
          "then": {
            "properties": {
              "id": { "const": "codex-cli" }
            }
          }
        },
        {
          "if": { "properties": { "harness": { "const": "claude" } } },
          "then": {
            "properties": {
              "id": { "const": "claude-code" }
            }
          }
        }
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "const": "darrow" },
        "version": { "const": "0.1.0" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
