{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/resolved-plan/0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engineVersion",
    "workflow",
    "profile",
    "capabilities",
    "loops",
    "steps",
    "inputs",
    "digest"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "engineVersion": { "const": "0.1.0" },
    "workflow": { "$ref": "#/$defs/resolved" },
    "profile": { "$ref": "#/$defs/profile" },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "loops": {
      "type": "array",
      "items": { "$ref": "#/$defs/loop" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "inputs": { "type": "object" },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source", "scope", "digest"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "source": { "type": "string" },
        "scope": { "enum": ["explicit", "project", "user", "bundled"] },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "source",
        "digest",
        "harness",
        "provider",
        "model",
        "reasoningEffort",
        "permissions"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "id": { "type": "string" },
        "source": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" },
        "harness": { "const": "codex" },
        "provider": { "const": "openai" },
        "model": { "const": "gpt-5.6-sol" },
        "reasoningEffort": { "const": "high" },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inherit"],
          "properties": { "inherit": { "const": true } }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "requested",
        "version",
        "providerId",
        "pluginVersion",
        "scope",
        "source",
        "digest"
      ],
      "properties": {
        "contract": { "type": "string" },
        "requested": { "type": "string" },
        "version": { "type": "string" },
        "providerId": { "type": "string" },
        "pluginVersion": { "type": "string" },
        "scope": { "enum": ["explicit", "project", "user", "bundled"] },
        "source": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "outcomeValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "steps", "maxAttempts", "until", "waiver"],
      "properties": {
        "id": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "until": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stepId", "output", "equals"],
          "properties": {
            "stepId": { "type": "string" },
            "output": { "type": "string" },
            "equals": { "$ref": "#/$defs/outcomeValue" }
          }
        },
        "waiver": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "description", "instructionsTo"],
              "properties": {
                "id": { "type": "string" },
                "description": { "type": "string" },
                "instructionsTo": { "type": ["string", "null"] }
              }
            }
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dependsOn",
        "commandId",
        "contractVersion",
        "cancellation",
        "source",
        "digest",
        "input",
        "publish"
      ],
      "properties": {
        "id": { "type": "string" },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "commandId": { "type": "string" },
        "contractVersion": { "type": "string" },
        "cancellation": {
          "enum": ["wait_for_boundary", "interrupt"]
        },
        "source": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" },
        "input": { "type": "object" },
        "publish": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/publication" }]
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticket", "artifactTypes"],
      "properties": {
        "ticket": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "project", "nativeId", "url"],
          "properties": {
            "backend": { "type": "string", "minLength": 1 },
            "project": { "type": "string", "minLength": 1 },
            "nativeId": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "artifactTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
