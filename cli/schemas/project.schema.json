{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/project/0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultProfile", "pluginRoots"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "defaultProfile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "pluginRoots": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
