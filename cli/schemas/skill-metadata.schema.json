{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/skill-metadata/v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "contractVersion",
        "inputSchema",
        "outputSchema"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "command" },
        "contractVersion": { "$ref": "#/$defs/semver" },
        "inputSchema": { "$ref": "#/$defs/path" },
        "outputSchema": { "$ref": "#/$defs/path" },
        "execution": { "$ref": "#/$defs/execution" },
        "cancellation": {
          "enum": ["wait_for_boundary", "interrupt"]
        },
        "requires": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirement" },
          "uniqueItems": true
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "provides"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "capability" },
        "provides": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provision" },
          "uniqueItems": true
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "range": { "type": "string", "minLength": 1 },
    "contract": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "path": {
      "type": "string",
      "allOf": [
        { "pattern": "^\\./.+\\.json$" },
        { "not": { "pattern": "(^|/)\\.\\.(/|$)" } }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol"],
      "properties": {
        "protocol": { "enum": ["structured", "delivery-tdd"] }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "version"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "version": { "$ref": "#/$defs/range" }
      }
    },
    "provision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "version"],
      "properties": {
        "contract": { "$ref": "#/$defs/contract" },
        "version": { "$ref": "#/$defs/semver" }
      }
    }
  }
}
