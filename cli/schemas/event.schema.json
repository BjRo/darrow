{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/event/0.1.0",
  "oneOf": [
    { "$ref": "#/$defs/workflowCompiled" },
    { "$ref": "#/$defs/dependenciesResolved" },
    { "$ref": "#/$defs/humanRequested" },
    { "$ref": "#/$defs/humanReceived" },
    { "$ref": "#/$defs/waiverAccepted" },
    { "$ref": "#/$defs/workspaceAllocated" },
    { "$ref": "#/$defs/runStarted" },
    { "$ref": "#/$defs/runRecovered" },
    { "$ref": "#/$defs/runCancelRequested" },
    { "$ref": "#/$defs/runCompleted" },
    { "$ref": "#/$defs/ticketArtifactsPublished" },
    { "$ref": "#/$defs/cleanupResourceDeleted" },
    { "$ref": "#/$defs/invocationStarted" },
    { "$ref": "#/$defs/invocationCancelled" },
    { "$ref": "#/$defs/invocationFailed" },
    { "$ref": "#/$defs/invocationCompleted" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "outcomeValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedAt", "completed", "incomplete", "uncertain"],
      "properties": {
        "requestedAt": { "type": "string", "format": "date-time" },
        "completed": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "incomplete": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "uncertain": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "baseProperties": {
      "schemaVersion": { "const": "0.1.0" },
      "eventId": { "type": "string" },
      "runId": { "type": "string" },
      "timestamp": { "type": "string", "format": "date-time" }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source", "scope", "digest"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "source": { "type": "string" },
        "scope": { "enum": ["explicit", "project", "user", "bundled"] },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "humanRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "version",
        "stepId",
        "reason",
        "question",
        "choices",
        "context"
      ],
      "properties": {
        "requestId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "integer", "minimum": 1 },
        "stepId": { "type": ["string", "null"] },
        "reason": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "consequence", "acceptsInstructions"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "consequence": { "type": "string", "minLength": 1 },
              "acceptsInstructions": { "type": "boolean" }
            }
          }
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "reference"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "reference": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "contentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentId", "mediaType", "contentHash", "size", "location"],
      "properties": {
        "contentId": { "type": "string", "minLength": 1 },
        "mediaType": { "const": "text/plain" },
        "contentHash": { "$ref": "#/$defs/digest" },
        "size": { "type": "integer", "minimum": 0 },
        "location": { "type": "string", "minLength": 1 }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "requested",
        "version",
        "providerId",
        "pluginVersion",
        "scope",
        "source",
        "digest"
      ],
      "properties": {
        "contract": { "type": "string" },
        "requested": { "type": "string" },
        "version": { "type": "string" },
        "providerId": { "type": "string" },
        "pluginVersion": { "type": "string" },
        "scope": { "enum": ["explicit", "project", "user", "bundled"] },
        "source": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "artifactId",
        "type",
        "schema",
        "schemaDigest",
        "contentHash",
        "size",
        "stepId",
        "attemptId",
        "location",
        "createdAt"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "artifactId": { "type": "string" },
        "type": { "type": "string" },
        "schema": { "type": "string" },
        "schemaDigest": { "$ref": "#/$defs/digest" },
        "contentHash": { "$ref": "#/$defs/digest" },
        "size": { "type": "integer" },
        "stepId": { "type": "string" },
        "attemptId": { "type": "string" },
        "location": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "publishedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationId",
        "artifactId",
        "runId",
        "stepId",
        "attemptId",
        "type",
        "contentHash",
        "size",
        "sourceLocation",
        "location",
        "publishedAt"
      ],
      "properties": {
        "publicationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifactId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "stepId": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "contentHash": { "$ref": "#/$defs/digest" },
        "size": { "type": "integer", "minimum": 0 },
        "sourceLocation": { "type": "string", "minLength": 1 },
        "location": {
          "type": "string",
          "pattern": "^\\.darrow/tickets/[a-f0-9]{64}/artifacts/"
        },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "workflowCompiled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "eventId": { "type": "string" },
        "runId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "const": "workflow.compiled" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow", "planDigest"],
          "properties": {
            "workflow": { "$ref": "#/$defs/workflow" },
            "planDigest": { "$ref": "#/$defs/digest" }
          }
        }
      }
    },
    "dependenciesResolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "eventId": { "type": "string" },
        "runId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "const": "dependencies.resolved" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commands", "capabilities"],
          "properties": {
            "commands": { "type": "array", "items": { "type": "string" } },
            "capabilities": {
              "type": "array",
              "items": { "$ref": "#/$defs/capability" }
            }
          }
        }
      }
    },
    "humanRequested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "eventId": { "type": "string" },
        "runId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "const": "human.input.requested" },
        "data": { "$ref": "#/$defs/humanRequest" }
      }
    },
    "humanReceived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "eventId": { "type": "string" },
        "runId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "const": "human.input.received" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestId",
            "version",
            "choice",
            "actor",
            "instructions",
            "rationale"
          ],
          "properties": {
            "requestId": { "type": "string" },
            "version": { "type": "integer", "minimum": 1 },
            "choice": { "type": "string" },
            "actor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "harness", "verified"],
              "properties": {
                "id": { "type": ["string", "null"] },
                "harness": { "type": ["string", "null"] },
                "verified": { "const": false }
              }
            },
            "instructions": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/contentReference" }
              ]
            },
            "rationale": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/contentReference" }
              ]
            },
            "model": { "type": "string" }
          }
        }
      }
    },
    "waiverAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "eventId": { "type": "string" },
        "runId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "const": "waiver.accepted" },
        "data": { "$ref": "#/$defs/waiver" }
      }
    },
    "workspaceAllocated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "eventId": { "type": "string" },
        "runId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "const": "workspace.allocated" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workspace", "commit", "attached"],
          "properties": {
            "workspace": { "type": "string" },
            "commit": { "type": "string" },
            "attached": { "type": "boolean" }
          }
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowId", "namespace", "address", "taskQueue", "runId"],
      "properties": {
        "workflowId": { "type": "string" },
        "namespace": { "type": "string" },
        "address": { "type": "string" },
        "taskQueue": { "type": "string" },
        "runId": { "type": ["string", "null"] },
        "startPending": { "type": "boolean" },
        "attached": { "const": true }
      }
    },
    "runStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "eventId": { "type": "string" },
        "runId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "const": "run.started" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["temporal", "workspace"],
          "properties": {
            "temporal": { "$ref": "#/$defs/temporal" },
            "workspace": { "type": "string" }
          }
        }
      }
    },
    "runRecovered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "eventId": { "type": "string" },
        "runId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "const": "run.recovered" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "workflowId", "workspace"],
          "properties": {
            "mode": { "enum": ["reattached", "started_pending"] },
            "workflowId": { "type": "string" },
            "workspace": { "type": "string" }
          }
        }
      }
    },
    "runCancelRequested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "eventId": { "type": "string" },
        "runId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "const": "run.cancel.requested" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestedAt"],
          "properties": {
            "requestedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "resultSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocationId", "status", "artifacts"],
      "properties": {
        "invocationId": { "type": "string" },
        "status": { "enum": ["succeeded", "failed"] },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waiverId",
        "loopId",
        "stepId",
        "attempt",
        "outcome",
        "actor",
        "rationale",
        "instructions",
        "instructionsTo"
      ],
      "properties": {
        "waiverId": { "type": "string" },
        "loopId": { "type": "string" },
        "stepId": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["output", "expected", "actual"],
          "properties": {
            "output": { "type": "string" },
            "expected": { "$ref": "#/$defs/outcomeValue" },
            "actual": { "$ref": "#/$defs/outcomeValue" }
          }
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "harness", "verified"],
          "properties": {
            "id": { "type": ["string", "null"] },
            "harness": { "type": ["string", "null"] },
            "verified": { "const": false }
          }
        },
        "rationale": { "$ref": "#/$defs/contentReference" },
        "instructions": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/contentReference" }]
        },
        "instructionsTo": { "type": ["string", "null"] }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "message"],
      "properties": {
        "category": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "runCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "eventId": { "type": "string" },
        "runId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "const": "run.completed" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conclusion"],
          "properties": {
            "conclusion": {
              "enum": [
                "succeeded",
                "succeeded_with_waivers",
                "failed",
                "cancelled"
              ]
            },
            "results": {
              "type": "array",
              "items": { "$ref": "#/$defs/resultSummary" }
            },
            "waivers": {
              "type": "array",
              "items": { "$ref": "#/$defs/waiver" }
            },
            "cancellation": { "$ref": "#/$defs/cancellation" },
            "error": { "$ref": "#/$defs/error" }
          }
        }
      }
    },
    "ticketArtifactsPublished": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "eventId": { "type": "string" },
        "runId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "const": "ticket.artifacts.published" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ticketKey", "ticket", "artifacts"],
          "properties": {
            "ticketKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "ticket": {
              "type": "object",
              "additionalProperties": false,
              "required": ["backend", "project", "nativeId", "url"],
              "properties": {
                "backend": { "type": "string", "minLength": 1 },
                "project": { "type": "string", "minLength": 1 },
                "nativeId": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri" }
              }
            },
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/publishedArtifact" }
            }
          }
        }
      }
    },
    "cleanupResourceDeleted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "eventId": { "type": "string" },
        "runId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "const": "cleanup.resource.deleted" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resourceId", "kind", "path", "size", "completedAt"],
          "properties": {
            "resourceId": { "type": "string" },
            "kind": {
              "enum": [
                "artifacts",
                "snapshot",
                "content",
                "results",
                "worktree"
              ]
            },
            "path": { "type": "string" },
            "size": { "type": "integer", "minimum": 0 },
            "completedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "invocationStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "eventId": { "type": "string" },
        "runId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "const": "command.invocation.started" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["invocationId", "stepId", "attemptId", "commandId"],
          "properties": {
            "invocationId": { "type": "string" },
            "stepId": { "type": "string" },
            "attemptId": { "type": "string" },
            "commandId": { "type": "string" }
          }
        }
      }
    },
    "invocationCancelled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "eventId": { "type": "string" },
        "runId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "const": "command.invocation.cancelled" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["invocationId", "stepId", "attemptId", "transcript"],
          "properties": {
            "invocationId": { "type": "string" },
            "stepId": { "type": "string" },
            "attemptId": { "type": "string" },
            "transcript": { "type": "string" }
          }
        }
      }
    },
    "invocationFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "eventId": { "type": "string" },
        "runId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "const": "command.invocation.failed" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["invocationId", "category", "transcript"],
          "properties": {
            "invocationId": { "type": "string" },
            "category": { "type": "string" },
            "message": { "type": "string" },
            "exitCode": { "type": "integer" },
            "transcript": { "type": ["string", "null"] }
          }
        }
      }
    },
    "invocationCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "timestamp",
        "type",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
