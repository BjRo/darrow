{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/event/0.1.0",
  "oneOf": [
    { "$ref": "#/$defs/workflowCompiled" },
    { "$ref": "#/$defs/dependenciesResolved" },
    { "$ref": "#/$defs/humanRequested" },
    { "$ref": "#/$defs/humanReceived" },
    { "$ref": "#/$defs/workspaceAllocated" },
    { "$ref": "#/$defs/runStarted" },
    { "$ref": "#/$defs/runRecovered" },
    { "$ref": "#/$defs/runCompleted" },
    { "$ref": "#/$defs/invocationStarted" },
    { "$ref": "#/$defs/invocationFailed" },
    { "$ref": "#/$defs/invocationCompleted" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "baseProperties": {
      "schemaVersion": { "const": "0.1.0" }, "eventId": { "type": "string" }, "runId": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" }
    },
    "workflow": { "type": "object", "additionalProperties": false, "required": ["id", "version", "source", "scope", "digest"], "properties": { "id": { "type": "string" }, "version": { "type": "string" }, "source": { "type": "string" }, "scope": { "enum": ["explicit", "project", "user", "bundled"] }, "digest": { "$ref": "#/$defs/digest" } } },
    "capability": { "type": "object", "additionalProperties": false, "required": ["contract", "requested", "version", "providerId", "pluginVersion", "scope", "source", "digest"], "properties": { "contract": { "type": "string" }, "requested": { "type": "string" }, "version": { "type": "string" }, "providerId": { "type": "string" }, "pluginVersion": { "type": "string" }, "scope": { "enum": ["explicit", "project", "user", "bundled"] }, "source": { "type": "string" }, "digest": { "$ref": "#/$defs/digest" } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "artifactId", "type", "schema", "schemaDigest", "contentHash", "size", "stepId", "attemptId", "location", "createdAt"], "properties": { "schemaVersion": { "const": "0.1.0" }, "artifactId": { "type": "string" }, "type": { "type": "string" }, "schema": { "type": "string" }, "schemaDigest": { "$ref": "#/$defs/digest" }, "contentHash": { "$ref": "#/$defs/digest" }, "size": { "type": "integer" }, "stepId": { "type": "string" }, "attemptId": { "type": "string" }, "location": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" } } },
    "workflowCompiled": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "eventId", "runId", "timestamp", "type", "data"], "properties": { "schemaVersion": { "const": "0.1.0" }, "eventId": { "type": "string" }, "runId": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" }, "type": { "const": "workflow.compiled" }, "data": { "type": "object", "additionalProperties": false, "required": ["workflow", "planDigest"], "properties": { "workflow": { "$ref": "#/$defs/workflow" }, "planDigest": { "$ref": "#/$defs/digest" } } } } },
    "dependenciesResolved": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "eventId", "runId", "timestamp", "type", "data"], "properties": { "schemaVersion": { "const": "0.1.0" }, "eventId": { "type": "string" }, "runId": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" }, "type": { "const": "dependencies.resolved" }, "data": { "type": "object", "additionalProperties": false, "required": ["commands", "capabilities"], "properties": { "commands": { "type": "array", "items": { "type": "string" } }, "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } } } } } },
    "humanRequested": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "eventId", "runId", "timestamp", "type", "data"], "properties": { "schemaVersion": { "const": "0.1.0" }, "eventId": { "type": "string" }, "runId": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" }, "type": { "const": "human.input.requested" }, "data": { "type": "object", "additionalProperties": false, "required": ["reason", "choices", "version"], "properties": { "reason": { "type": "string" }, "choices": { "type": "array", "items": { "type": "string" } }, "version": { "type": "integer" } } } } },
    "humanReceived": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "eventId", "runId", "timestamp", "type", "data"], "properties": { "schemaVersion": { "const": "0.1.0" }, "eventId": { "type": "string" }, "runId": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" }, "type": { "const": "human.input.received" }, "data": { "type": "object", "additionalProperties": false, "required": ["choice"], "properties": { "choice": { "type": "string" }, "model": { "type": "string" } } } } },
    "workspaceAllocated": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "eventId", "runId", "timestamp", "type", "data"], "properties": { "schemaVersion": { "const": "0.1.0" }, "eventId": { "type": "string" }, "runId": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" }, "type": { "const": "workspace.allocated" }, "data": { "type": "object", "additionalProperties": false, "required": ["workspace", "commit", "attached"], "properties": { "workspace": { "type": "string" }, "commit": { "type": "string" }, "attached": { "type": "boolean" } } } } },
    "temporal": { "type": "object", "additionalProperties": false, "required": ["workflowId", "namespace", "address", "taskQueue", "runId"], "properties": { "workflowId": { "type": "string" }, "namespace": { "type": "string" }, "address": { "type": "string" }, "taskQueue": { "type": "string" }, "runId": { "type": ["string", "null"] }, "startPending": { "type": "boolean" }, "attached": { "const": true } } },
    "runStarted": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "eventId", "runId", "timestamp", "type", "data"], "properties": { "schemaVersion": { "const": "0.1.0" }, "eventId": { "type": "string" }, "runId": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" }, "type": { "const": "run.started" }, "data": { "type": "object", "additionalProperties": false, "required": ["temporal", "workspace"], "properties": { "temporal": { "$ref": "#/$defs/temporal" }, "workspace": { "type": "string" } } } } },
    "runRecovered": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "eventId", "runId", "timestamp", "type", "data"], "properties": { "schemaVersion": { "const": "0.1.0" }, "eventId": { "type": "string" }, "runId": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" }, "type": { "const": "run.recovered" }, "data": { "type": "object", "additionalProperties": false, "required": ["mode", "workflowId", "workspace"], "properties": { "mode": { "enum": ["reattached", "started_pending"] }, "workflowId": { "type": "string" }, "workspace": { "type": "string" } } } } },
    "resultSummary": { "type": "object", "additionalProperties": false, "required": ["invocationId", "status", "artifacts"], "properties": { "invocationId": { "type": "string" }, "status": { "enum": ["succeeded", "failed"] }, "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } } } },
    "error": { "type": "object", "additionalProperties": false, "required": ["category", "message"], "properties": { "category": { "type": "string" }, "message": { "type": "string" } } },
    "runCompleted": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "eventId", "runId", "timestamp", "type", "data"], "properties": { "schemaVersion": { "const": "0.1.0" }, "eventId": { "type": "string" }, "runId": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" }, "type": { "const": "run.completed" }, "data": { "type": "object", "additionalProperties": false, "required": ["conclusion"], "properties": { "conclusion": { "enum": ["succeeded", "succeeded_with_waivers", "failed", "cancelled"] }, "results": { "type": "array", "items": { "$ref": "#/$defs/resultSummary" } }, "error": { "$ref": "#/$defs/error" } } } } },
    "invocationStarted": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "eventId", "runId", "timestamp", "type", "data"], "properties": { "schemaVersion": { "const": "0.1.0" }, "eventId": { "type": "string" }, "runId": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" }, "type": { "const": "command.invocation.started" }, "data": { "type": "object", "additionalProperties": false, "required": ["invocationId", "stepId", "attemptId", "commandId"], "properties": { "invocationId": { "type": "string" }, "stepId": { "type": "string" }, "attemptId": { "type": "string" }, "commandId": { "type": "string" } } } } },
    "invocationFailed": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "eventId", "runId", "timestamp", "type", "data"], "properties": { "schemaVersion": { "const": "0.1.0" }, "eventId": { "type": "string" }, "runId": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" }, "type": { "const": "command.invocation.failed" }, "data": { "type": "object", "additionalProperties": false, "required": ["invocationId", "category", "transcript"], "properties": { "invocationId": { "type": "string" }, "category": { "type": "string" }, "message": { "type": "string" }, "exitCode": { "type": "integer" }, "transcript": { "type": ["string", "null"] } } } } },
    "invocationCompleted": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "eventId", "runId", "timestamp", "type", "data"], "properties": { "schemaVersion": { "const": "0.1.0" }, "eventId": { "type": "string" }, "runId": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" }, "type": { "const": "command.invocation.completed" }, "data": { "type": "object", "additionalProperties": false, "required": ["invocationId", "stepId", "attemptId", "artifacts", "transcript", "nativeSessionId", "usage"], "properties": { "invocationId": { "type": "string" }, "stepId": { "type": "string" }, "attemptId": { "type": "string" }, "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }, "transcript": { "type": "string" }, "nativeSessionId": { "type": ["string", "null"] }, "usage": { "type": ["object", "null"], "additionalProperties": { "type": "number" } } } } } }
  }
}
