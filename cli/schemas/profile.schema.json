{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/profile/0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "harness",
    "provider",
    "model",
    "reasoningEffort",
    "permissions"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "harness": { "enum": ["codex", "claude"] },
    "provider": { "enum": ["openai", "anthropic"] },
    "model": { "type": "string", "minLength": 1 },
    "reasoningEffort": { "type": "string", "minLength": 1 },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inherit"],
      "properties": { "inherit": { "const": true } }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "harness": { "const": "codex" } } },
      "then": {
        "properties": {
          "provider": { "const": "openai" }
        }
      }
    },
    {
      "if": { "properties": { "harness": { "const": "claude" } } },
      "then": {
        "properties": {
          "provider": { "const": "anthropic" }
        }
      }
    }
  ]
}
