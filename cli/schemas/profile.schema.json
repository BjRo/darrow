{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/profile/0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "harness", "provider", "model", "reasoningEffort", "permissions"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "harness": { "const": "codex" },
    "provider": { "const": "openai" },
    "model": { "const": "gpt-5.6-sol" },
    "reasoningEffort": { "const": "high" },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inherit"],
      "properties": { "inherit": { "const": true } }
    }
  }
}
