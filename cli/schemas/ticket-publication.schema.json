{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/ticket-publication/0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ticketKey", "ticket", "publications"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "ticketKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ticket": { "$ref": "#/$defs/ticket" },
    "publications": {
      "type": "array",
      "items": { "$ref": "#/$defs/publication" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "project", "nativeId", "url"],
      "properties": {
        "backend": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "nativeId": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationId",
        "artifactId",
        "runId",
        "stepId",
        "attemptId",
        "type",
        "contentHash",
        "size",
        "sourceLocation",
        "location",
        "publishedAt"
      ],
      "properties": {
        "publicationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifactId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "stepId": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "contentHash": { "$ref": "#/$defs/digest" },
        "size": { "type": "integer", "minimum": 0 },
        "sourceLocation": { "type": "string", "minLength": 1 },
        "location": {
          "type": "string",
          "pattern": "^\\.darrow/tickets/[a-f0-9]{64}/artifacts/"
        },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
