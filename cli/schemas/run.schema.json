{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/run/0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "workflowId", "state", "conclusion", "createdAt", "updatedAt", "temporal", "workspace", "currentStep", "error"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" }, "runId": { "type": "string" }, "workflowId": { "type": "string" },
    "state": { "enum": ["running", "waiting_for_input", "completed"] }, "conclusion": { "type": ["null", "string"], "enum": [null, "succeeded", "succeeded_with_waivers", "failed", "cancelled"] },
    "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" },
    "temporal": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "workflowId": { "type": "string" }, "namespace": { "type": "string" }, "address": { "type": "string" }, "taskQueue": { "type": "string" }, "runId": { "type": ["string", "null"] }, "attached": { "const": true },
        "pending": { "type": "object", "additionalProperties": false, "required": ["kind", "commit", "invokedRoot"], "properties": { "kind": { "const": "dirty_checkout" }, "commit": { "type": "string" }, "invokedRoot": { "type": "string" } } },
        "request": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["version", "reason", "choices"], "properties": { "version": { "type": "integer", "minimum": 1 }, "reason": { "type": "string" }, "choices": { "type": "array", "items": { "type": "string" } } } }] }
      }
    },
    "workspace": { "type": ["null", "string"] }, "currentStep": { "type": ["null", "string"] },
    "error": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["category", "message"], "properties": { "category": { "type": "string" }, "message": { "type": "string" } } }] }
  }
}
