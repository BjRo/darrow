{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/run/0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "workflowId",
    "state",
    "conclusion",
    "createdAt",
    "updatedAt",
    "temporal",
    "workspace",
    "currentStep",
    "steps",
    "request",
    "error"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "runId": { "type": "string" },
    "workflowId": { "type": "string" },
    "state": { "enum": ["running", "waiting_for_input", "completed"] },
    "conclusion": {
      "type": ["null", "string"],
      "enum": [
        null,
        "succeeded",
        "succeeded_with_waivers",
        "failed",
        "cancelled"
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflowId": { "type": "string" },
        "namespace": { "type": "string" },
        "address": { "type": "string" },
        "taskQueue": { "type": "string" },
        "runId": { "type": ["string", "null"] },
        "startPending": { "type": "boolean" },
        "attached": { "const": true },
        "pending": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "commit", "invokedRoot"],
          "properties": {
            "kind": { "const": "dirty_checkout" },
            "commit": { "type": "string" },
            "invokedRoot": { "type": "string" }
          }
        }
      }
    },
    "workspace": { "type": ["null", "string"] },
    "currentStep": { "type": ["null", "string"] },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "state", "attempt"],
        "properties": {
          "stepId": { "type": "string" },
          "state": {
            "enum": [
              "pending",
              "running",
              "waiting_for_input",
              "succeeded",
              "failed",
              "blocked"
            ]
          },
          "attempt": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "request": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/humanRequest" }]
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "message"],
          "properties": {
            "category": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      ]
    }
  },
  "$defs": {
    "humanRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "version",
        "stepId",
        "reason",
        "question",
        "choices",
        "context"
      ],
      "properties": {
        "requestId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "integer", "minimum": 1 },
        "stepId": { "type": ["string", "null"] },
        "reason": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "consequence", "acceptsInstructions"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "consequence": { "type": "string", "minLength": 1 },
              "acceptsInstructions": { "type": "boolean" }
            }
          }
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "reference"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "reference": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
