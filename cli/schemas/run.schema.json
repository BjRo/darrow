{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/run/0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "workflowId",
    "state",
    "conclusion",
    "createdAt",
    "updatedAt",
    "temporal",
    "workspace",
    "currentStep",
    "steps",
    "request",
    "waivers",
    "amendments",
    "cancellation",
    "error"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "runId": { "type": "string" },
    "workflowId": { "type": "string" },
    "state": { "enum": ["running", "waiting_for_input", "completed"] },
    "conclusion": {
      "type": ["null", "string"],
      "enum": [
        null,
        "succeeded",
        "succeeded_with_waivers",
        "failed",
        "cancelled"
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflowId": { "type": "string" },
        "namespace": { "type": "string" },
        "address": { "type": "string" },
        "taskQueue": { "type": "string" },
        "runId": { "type": ["string", "null"] },
        "startPending": { "type": "boolean" },
        "attached": { "const": true },
        "pending": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "commit", "invokedRoot"],
          "properties": {
            "kind": { "const": "dirty_checkout" },
            "commit": { "type": "string" },
            "invokedRoot": { "type": "string" }
          }
        }
      }
    },
    "workspace": { "type": ["null", "string"] },
    "currentStep": { "type": ["null", "string"] },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "state", "attempt"],
        "properties": {
          "stepId": { "type": "string" },
          "state": {
            "enum": [
              "pending",
              "running",
              "waiting_for_input",
              "succeeded",
              "accepted_with_waiver",
              "cancelled",
              "failed",
              "blocked"
            ]
          },
          "attempt": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "request": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/humanRequest" }]
    },
    "waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    },
    "amendments": {
      "type": "array",
      "items": { "$ref": "#/$defs/routeAmendment" }
    },
    "cancellation": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cancellation" }]
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "message"],
          "properties": {
            "category": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      ]
    }
  },
  "$defs": {
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedAt", "completed", "incomplete", "uncertain"],
      "properties": {
        "requestedAt": { "type": "string", "format": "date-time" },
        "completed": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "incomplete": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "uncertain": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "outcomeValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "contentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentId", "mediaType", "contentHash", "size", "location"],
      "properties": {
        "contentId": { "type": "string" },
        "mediaType": { "const": "text/plain" },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "location": { "type": "string" }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "harness", "verified"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "harness": { "type": ["string", "null"] },
        "verified": { "const": false }
      }
    },
    "executionRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeId",
        "profileId",
        "profileDigest",
        "harness",
        "provider",
        "model",
        "reasoningEffort",
        "permissions",
        "limits",
        "adapter",
        "selectionSource"
      ],
      "properties": {
        "routeId": { "type": "string", "minLength": 1 },
        "profileId": { "type": "string", "minLength": 1 },
        "profileDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "harness": { "enum": ["codex", "claude"] },
        "provider": { "enum": ["openai", "anthropic"] },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "type": "string", "minLength": 1 },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inherit"],
          "properties": { "inherit": { "const": true } }
        },
        "limits": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "enum": ["codex-cli", "claude-code"] },
            "version": { "const": "0.1.0" }
          }
        },
        "selectionSource": {
          "enum": [
            "fixed_plan",
            "scoped_human_amendment",
            "explicit_user_pin",
            "routing_policy"
          ]
        }
      }
    },
    "resolvedProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "harness",
        "provider",
        "model",
        "reasoningEffort",
        "permissions",
        "source",
        "scope",
        "digest"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "harness": { "enum": ["codex", "claude"] },
        "provider": { "enum": ["openai", "anthropic"] },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "type": "string", "minLength": 1 },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inherit"],
          "properties": { "inherit": { "const": true } }
        },
        "source": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["explicit", "project", "user", "bundled"] },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "routeAmendment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amendmentId",
        "requestId",
        "responseId",
        "stepId",
        "planRouteId",
        "attemptScope",
        "unavailableRoute",
        "replacementProfile",
        "replacementRoute",
        "actor",
        "approvedAt"
      ],
      "properties": {
        "amendmentId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "requestId": { "type": "string", "minLength": 1 },
        "responseId": { "type": "string", "minLength": 1 },
        "stepId": { "type": "string", "minLength": 1 },
        "planRouteId": { "type": "string", "minLength": 1 },
        "attemptScope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fromAttempt", "throughAttempt"],
          "properties": {
            "fromAttempt": { "type": "integer", "minimum": 1 },
            "throughAttempt": { "type": "null" }
          }
        },
        "unavailableRoute": { "$ref": "#/$defs/executionRoute" },
        "replacementProfile": { "$ref": "#/$defs/resolvedProfile" },
        "replacementRoute": { "$ref": "#/$defs/executionRoute" },
        "actor": { "$ref": "#/$defs/actor" },
        "approvedAt": { "type": "string", "format": "date-time" }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waiverId",
        "loopId",
        "stepId",
        "attempt",
        "outcome",
        "actor",
        "rationale",
        "instructions",
        "instructionsTo"
      ],
      "properties": {
        "waiverId": { "type": "string" },
        "loopId": { "type": "string" },
        "stepId": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["output", "expected", "actual"],
          "properties": {
            "output": { "type": "string" },
            "expected": { "$ref": "#/$defs/outcomeValue" },
            "actual": { "$ref": "#/$defs/outcomeValue" }
          }
        },
        "actor": { "$ref": "#/$defs/actor" },
        "rationale": { "$ref": "#/$defs/contentReference" },
        "instructions": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/contentReference" }]
        },
        "instructionsTo": { "type": ["string", "null"] }
      }
    },
    "humanRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "version",
        "stepId",
        "reason",
        "question",
        "choices",
        "context"
      ],
      "properties": {
        "requestId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "integer", "minimum": 1 },
        "stepId": { "type": ["string", "null"] },
        "reason": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "consequence", "acceptsInstructions"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "consequence": { "type": "string", "minLength": 1 },
              "acceptsInstructions": { "type": "boolean" }
            }
          }
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "reference"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "reference": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
