{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/schemas/cli-protocol/0.1.0",
  "oneOf": [
    { "$ref": "#/$defs/init" },
    { "$ref": "#/$defs/waiting" },
    { "$ref": "#/$defs/terminalSuccess" },
    { "$ref": "#/$defs/terminalFailure" },
    { "$ref": "#/$defs/failedStart" },
    { "$ref": "#/$defs/inspect" }
  ],
  "$defs": {
    "error": { "type": "object", "additionalProperties": false, "required": ["category", "message"], "properties": { "category": { "type": "string" }, "message": { "type": "string" } } },
    "envelopeProperties": { "protocolVersion": { "const": "0.1.0" }, "command": { "enum": ["init", "run", "continue", "resume", "inspect"] }, "ok": { "type": "boolean" }, "data": {}, "error": {} },
    "initData": { "type": "object", "additionalProperties": false, "required": ["repository", "stateDirectory"], "properties": { "repository": { "type": "string" }, "stateDirectory": { "type": "string" } } },
    "waitingData": { "type": "object", "additionalProperties": false, "required": ["runId", "state", "reason", "choices", "continuation"], "properties": { "runId": { "type": "string" }, "state": { "const": "waiting_for_input" }, "reason": { "type": "string" }, "choices": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "continuation": { "type": "string" } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "artifactId", "type", "schema", "schemaDigest", "contentHash", "size", "stepId", "attemptId", "location", "createdAt"], "properties": { "schemaVersion": { "const": "0.1.0" }, "artifactId": { "type": "string" }, "type": { "type": "string" }, "schema": { "type": "string" }, "schemaDigest": { "type": "string" }, "contentHash": { "type": "string" }, "size": { "type": "integer" }, "stepId": { "type": "string" }, "attemptId": { "type": "string" }, "location": { "type": "string" }, "createdAt": { "type": "string" } } },
    "timing": { "type": "object", "additionalProperties": false, "required": ["startedAt", "finishedAt"], "properties": { "startedAt": { "type": "string" }, "finishedAt": { "type": "string" } } },
    "result": { "type": "object", "additionalProperties": false, "required": ["invocationId", "status", "commandId", "contractVersion", "implementationVersion", "artifacts", "timing"], "properties": { "invocationId": { "type": "string" }, "status": { "enum": ["succeeded", "failed"] }, "commandId": { "type": "string" }, "contractVersion": { "type": "string" }, "implementationVersion": { "type": "string" }, "payload": { "type": "object" }, "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }, "transcript": { "type": "string" }, "nativeSessionId": { "type": "string" }, "usage": { "type": "object", "additionalProperties": { "type": "number" } }, "timing": { "$ref": "#/$defs/timing" }, "error": { "$ref": "#/$defs/error" } } },
    "terminalSuccessData": { "type": "object", "additionalProperties": false, "required": ["runId", "state", "conclusion", "workspace", "results"], "properties": { "runId": { "type": "string" }, "state": { "const": "completed" }, "conclusion": { "enum": ["succeeded", "succeeded_with_waivers", "cancelled"] }, "workspace": { "type": ["string", "null"] }, "results": { "type": "array", "items": { "$ref": "#/$defs/result" } } } },
    "terminalFailureData": { "type": "object", "additionalProperties": false, "required": ["runId", "state", "conclusion", "workspace", "results"], "properties": { "runId": { "type": "string" }, "state": { "const": "completed" }, "conclusion": { "const": "failed" }, "workspace": { "type": ["string", "null"] }, "results": { "type": "array", "items": { "$ref": "#/$defs/result" } } } },
    "failedStartData": { "type": "object", "additionalProperties": false, "required": ["runId", "state", "conclusion"], "properties": { "runId": { "type": "string" }, "state": { "const": "completed" }, "conclusion": { "const": "failed" } } },
    "request": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["version", "reason", "choices"], "properties": { "version": { "type": "integer" }, "reason": { "type": "string" }, "choices": { "type": "array", "items": { "type": "string" } } } }] },
    "pending": { "type": "object", "additionalProperties": false, "required": ["kind", "commit", "invokedRoot"], "properties": { "kind": { "const": "dirty_checkout" }, "commit": { "type": "string" }, "invokedRoot": { "type": "string" } } },
    "temporal": { "type": "object", "additionalProperties": false, "properties": { "workflowId": { "type": "string" }, "namespace": { "type": "string" }, "address": { "type": "string" }, "taskQueue": { "type": "string" }, "runId": { "type": ["string", "null"] }, "startPending": { "type": "boolean" }, "attached": { "const": true }, "pending": { "$ref": "#/$defs/pending" }, "request": { "$ref": "#/$defs/request" } } },
    "liveTemporal": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["status", "startTime", "closeTime", "runId"], "properties": { "status": { "type": "string" }, "startTime": { "type": "string" }, "closeTime": { "type": ["string", "null"] }, "runId": { "type": "string" } } }] },
    "paths": { "type": "object", "additionalProperties": false, "required": ["run", "plan", "lock", "snapshot", "workspace"], "properties": { "run": { "type": "string" }, "plan": { "type": "string" }, "lock": { "type": "string" }, "snapshot": { "type": "string" }, "workspace": { "type": ["string", "null"] } } },
    "counts": { "type": "object", "additionalProperties": false, "required": ["events", "results"], "properties": { "events": { "type": "integer" }, "results": { "type": "integer" } } },
    "inspectData": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "runId", "workflowId", "state", "conclusion", "createdAt", "updatedAt", "temporal", "workspace", "currentStep", "error", "liveTemporal", "paths", "counts"], "properties": { "schemaVersion": { "const": "0.1.0" }, "runId": { "type": "string" }, "workflowId": { "type": "string" }, "state": { "enum": ["running", "waiting_for_input", "completed"] }, "conclusion": { "type": ["string", "null"] }, "createdAt": { "type": "string" }, "updatedAt": { "type": "string" }, "temporal": { "$ref": "#/$defs/temporal" }, "workspace": { "type": ["string", "null"] }, "currentStep": { "type": ["string", "null"] }, "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }] }, "liveTemporal": { "$ref": "#/$defs/liveTemporal" }, "paths": { "$ref": "#/$defs/paths" }, "counts": { "$ref": "#/$defs/counts" } } },
    "init": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "command", "ok", "data", "error"], "properties": { "protocolVersion": { "const": "0.1.0" }, "command": { "const": "init" }, "ok": { "const": true }, "data": { "$ref": "#/$defs/initData" }, "error": { "type": "null" } } },
    "waiting": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "command", "ok", "data", "error"], "properties": { "protocolVersion": { "const": "0.1.0" }, "command": { "enum": ["run", "continue", "resume"] }, "ok": { "const": true }, "data": { "$ref": "#/$defs/waitingData" }, "error": { "type": "null" } } },
    "terminalSuccess": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "command", "ok", "data", "error"], "properties": { "protocolVersion": { "const": "0.1.0" }, "command": { "enum": ["run", "continue", "resume"] }, "ok": { "const": true }, "data": { "$ref": "#/$defs/terminalSuccessData" }, "error": { "type": "null" } } },
    "terminalFailure": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "command", "ok", "data", "error"], "properties": { "protocolVersion": { "const": "0.1.0" }, "command": { "enum": ["run", "continue", "resume"] }, "ok": { "const": false }, "data": { "$ref": "#/$defs/terminalFailureData" }, "error": { "$ref": "#/$defs/error" } } },
    "failedStart": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "command", "ok", "data", "error"], "properties": { "protocolVersion": { "const": "0.1.0" }, "command": { "const": "run" }, "ok": { "const": false }, "data": { "$ref": "#/$defs/failedStartData" }, "error": { "$ref": "#/$defs/error" } } },
    "inspect": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "command", "ok", "data", "error"], "properties": { "protocolVersion": { "const": "0.1.0" }, "command": { "const": "inspect" }, "ok": { "const": true }, "data": { "$ref": "#/$defs/inspectData" }, "error": { "type": "null" } } }
  }
}
