#!/bin/sh
set -eu

usage() {
  echo "usage: scripts/detect-python-quality-changes --all | <base-commit> <head-commit>" >&2
  exit 2
}

changed() {
  set +e
  git -C "$repo_root" diff --quiet "$base" "$head" -- "$@"
  status=$?
  set -e
  case "$status" in
    0) return 1 ;;
    1) return 0 ;;
    *) echo "error: unable to compare Python quality paths" >&2; exit "$status" ;;
  esac
}

plugin_root() {
  package=$1
  case "$package" in
    plugins/*/*/*)
      rest=${package#plugins/}
      kind=${rest%%/*}
      rest=${rest#*/}
      name=${rest%%/*}
      printf 'plugins/%s/%s\n' "$kind" "$name"
      ;;
    *) printf '%s\n' "$package" ;;
  esac
}

append_package() {
  package=$1
  if [ "$packages_json" = '[]' ]; then
    packages_json="[\"$package\"]"
  else
    packages_json=${packages_json%]}
    packages_json="$packages_json,\"$package\"]"
  fi
  package_selected=true

  case "$package" in
    plugins/foundation/darrow-skill-authoring/skills/author-agent-skill/backend)
      skill_authoring=true
      ;;
    plugins/capability/darrow-observability-langfuse/backend)
      observability_langfuse=true
      ;;
    plugins/capability/darrow-discovery/skills/plan-implementation/backend)
      discovery=true
      ;;
    plugins/capability/darrow-verification/skills/verify-change/backend)
      verification=true
      ;;
  esac
}

repo_root=$(git rev-parse --show-toplevel)
inventory="$repo_root/python-packages.txt"
if [ ! -r "$inventory" ]; then
  echo "error: Python package inventory is unreadable: $inventory" >&2
  exit 1
fi

packages=$(sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$inventory")
if [ -z "$packages" ]; then
  echo "error: Python package inventory is empty: $inventory" >&2
  exit 1
fi

select_all=false
if [ "$#" -eq 1 ] && [ "$1" = --all ]; then
  select_all=true
elif [ "$#" -eq 2 ]; then
  base=$1
  head=$2
  git -C "$repo_root" cat-file -e "$base^{commit}" 2>/dev/null || {
    echo "error: base commit is unavailable: $base" >&2
    exit 1
  }
  git -C "$repo_root" cat-file -e "$head^{commit}" 2>/dev/null || {
    echo "error: head commit is unavailable: $head" >&2
    exit 1
  }
else
  usage
fi

shared=$select_all
if [ "$shared" = false ] && changed \
  .github/workflows/python-quality.yml \
  docs/specs/python-quality.md \
  python-packages.txt \
  scripts/check-python \
  scripts/check-python-inventory \
  scripts/detect-python-quality-changes \
  scripts/test-python-coverage \
  scripts/test-python-inventory \
  scripts/test-python-quality-changes \
  scripts/verify-python-coverage \
  scripts/verify-python-quality-results; then
  shared=true
fi

packages_json='[]'
package_selected=false
skill_authoring=false
observability_langfuse=false
discovery=false
verification=false
seen_packages='|'

while IFS= read -r package; do
  case "$package" in
    /* | *../* | */.. | *[!A-Za-z0-9._/-]*)
      echo "error: invalid Python package path in $inventory: $package" >&2
      exit 1
      ;;
  esac
  case "$seen_packages" in
    *"|$package|"*)
      echo "error: duplicate Python package in $inventory: $package" >&2
      exit 1
      ;;
  esac
  seen_packages="$seen_packages$package|"

  selected=$shared
  if [ "$selected" = false ]; then
    root=$(plugin_root "$package")
    if changed "$root"; then
      selected=true
    fi
  fi

  if [ "$selected" = true ]; then
    append_package "$package"
  fi
done <<EOF
$packages
EOF

printf 'packages=%s\n' "$packages_json"
printf 'package_selected=%s\n' "$package_selected"
printf 'skill_authoring=%s\n' "$skill_authoring"
printf 'observability_langfuse=%s\n' "$observability_langfuse"
printf 'discovery=%s\n' "$discovery"
printf 'verification=%s\n' "$verification"
