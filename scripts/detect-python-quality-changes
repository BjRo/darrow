#!/bin/sh
set -eu

usage() {
  echo "usage: scripts/detect-python-quality-changes --all | <base-commit> <head-commit>" >&2
  exit 2
}

changed() {
  set +e
  git -C "$repo_root" diff --quiet "$base" "$head" -- "$@"
  status=$?
  set -e
  case "$status" in
    0) return 1 ;;
    1) return 0 ;;
    *) echo "error: unable to compare Python quality paths" >&2; exit "$status" ;;
  esac
}

plugin_root() {
  package=$1
  case "$package" in
    plugins/*/*/*)
      rest=${package#plugins/}
      kind=${rest%%/*}
      rest=${rest#*/}
      name=${rest%%/*}
      printf 'plugins/%s/%s\n' "$kind" "$name"
      ;;
    *) printf '%s\n' "$package" ;;
  esac
}

append_package() {
  package=$1
  if [ "$packages_json" = '[]' ]; then
    packages_json="[\"$package\"]"
  else
    packages_json=${packages_json%]}
    packages_json="$packages_json,\"$package\"]"
  fi
  package_selected=true

  case "$package" in
    plugins/foundation/darrow-skill-authoring/backend)
      skill_authoring=true
      ;;
    plugins/capability/darrow-discovery/skills/work-through-decisions/backend)
      discovery=true
      ;;
    plugins/capability/darrow-verification/backend)
      verification=true
      ;;
  esac
}

repo_root=$(git rev-parse --show-toplevel)
inventory="$repo_root/python-packages.txt"
if [ ! -r "$inventory" ]; then
  echo "error: Python package inventory is unreadable: $inventory" >&2
  exit 1
fi

packages=$(sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$inventory")
if [ -z "$packages" ]; then
  echo "error: Python package inventory is empty: $inventory" >&2
  exit 1
fi

select_all=false
installed_pin_required=false
if [ "$#" -eq 1 ] && [ "$1" = --all ]; then
  select_all=true
  installed_pin_required=true
elif [ "$#" -eq 2 ]; then
  base=$1
  head=$2
  git -C "$repo_root" cat-file -e "$base^{commit}" 2>/dev/null || {
    echo "error: base commit is unavailable: $base" >&2
    exit 1
  }
  git -C "$repo_root" cat-file -e "$head^{commit}" 2>/dev/null || {
    echo "error: head commit is unavailable: $head" >&2
    exit 1
  }
else
  usage
fi

if [ "$select_all" = false ]; then
  if changed package.json bun.lock bunfig.toml tsconfig.json sevro.json python-packages.txt \
    scripts/setup-sevro-linux ':(glob)scripts/**/*.ts' evals \
    .agents/skills/darrow-guide .claude/skills/darrow-guide \
    plugins/capability/darrow-discovery plugins/capability/darrow-git \
    plugins/capability/darrow-readiness-gate plugins/capability/darrow-review \
    plugins/capability/darrow-tdd plugins/capability/darrow-tickets \
    plugins/capability/darrow-verification plugins/foundation/darrow-skill-authoring \
    plugins/orchestration/darrow-adaptive-goal plugins/orchestration/darrow-ticket-pipeline \
    plugins/task-recipe/darrow-ticket-to-pr; then
    installed_pin_required=true
  fi

  # Scope-only workflow edits are exercised by the selector tests. Changes to
  # the job, its setup, or the workflow triggers still exercise the pin.
  workflow=.github/workflows/sevro-integration.yml
  if changed "$workflow"; then
    scope_tmp=$(mktemp -d "${TMPDIR:-/tmp}/darrow-sevro-scope.XXXXXX")
    trap 'rm -rf "$scope_tmp"' EXIT HUP INT TERM
    for side in base head; do
      if [ "$side" = base ]; then revision=$base; else revision=$head; fi
      if ! git -C "$repo_root" show "$revision:$workflow" >"$scope_tmp/workflow" 2>/dev/null; then
        installed_pin_required=true
        break
      fi
      awk '
        /^  changes:$/ { scope = 1; next }
        scope && /^  [a-zA-Z0-9_-]+:$/ { scope = 0 }
        !scope { print }
      ' "$scope_tmp/workflow" >"$scope_tmp/$side"
    done
    if [ "$installed_pin_required" = false ] && ! cmp -s "$scope_tmp/base" "$scope_tmp/head"; then
      installed_pin_required=true
    fi
    rm -rf "$scope_tmp"
    trap - EXIT HUP INT TERM
  fi
fi

packages_json='[]'
package_selected=false
skill_authoring=false
discovery=false
verification=false
seen_packages='|'

while IFS= read -r package; do
  case "$package" in
    /* | *../* | */.. | *[!A-Za-z0-9._/-]*)
      echo "error: invalid Python package path in $inventory: $package" >&2
      exit 1
      ;;
  esac
  case "$seen_packages" in
    *"|$package|"*)
      echo "error: duplicate Python package in $inventory: $package" >&2
      exit 1
      ;;
  esac
  seen_packages="$seen_packages$package|"

  if [ "$select_all" = false ] && changed "$package/pyproject.toml" "$package/uv.lock"; then
    installed_pin_required=true
  fi

  selected=$select_all
  if [ "$selected" = false ]; then
    root=$(plugin_root "$package")
    if changed "$root" ':(exclude,icase)**/README' ':(exclude,icase)**/README.*'; then
      selected=true
    fi
  fi

  if [ "$selected" = true ]; then
    append_package "$package"
  fi
done <<EOF
$packages
EOF

printf 'packages=%s\n' "$packages_json"
printf 'installed_pin_required=%s\n' "$installed_pin_required"
printf 'package_selected=%s\n' "$package_selected"
printf 'skill_authoring=%s\n' "$skill_authoring"
printf 'discovery=%s\n' "$discovery"
printf 'verification=%s\n' "$verification"
