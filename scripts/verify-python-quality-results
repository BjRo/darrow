#!/bin/sh
set -eu

if [ "$#" -ne 17 ]; then
  echo "usage: scripts/verify-python-quality-results <changes> <inventory> <package-selected> <package> <skill-selected> <skill-windows> <skill-install> <observability-selected> <observability-windows> <observability-install> <observability-performance> <discovery-selected> <discovery-windows> <discovery-install> <verification-selected> <verification-windows> <verification-install>" >&2
  exit 2
fi

changes_result=$1
inventory_result=$2
package_selected=$3
package_result=$4
skill_selected=$5
skill_windows_result=$6
skill_install_result=$7
observability_selected=$8
observability_windows_result=$9
shift 9
observability_install_result=$1
observability_performance_result=$2
discovery_selected=$3
discovery_windows_result=$4
discovery_install_result=$5
verification_selected=$6
verification_windows_result=$7
verification_install_result=$8

require_result() {
  name=$1
  expected=$2
  actual=$3
  if [ "$actual" != "$expected" ]; then
    echo "error: $name expected $expected, got $actual" >&2
    exit 1
  fi
}

require_scope() {
  scope=$1
  selected=$2
  shift 2
  case "$selected" in
    true) expected=success ;;
    false) expected=skipped ;;
    *) echo "error: invalid $scope selection: $selected" >&2; exit 1 ;;
  esac
  for result do
    require_result "$scope job" "$expected" "$result"
  done
}

require_result "change detection" success "$changes_result"
require_result "inventory" success "$inventory_result"
require_scope packages "$package_selected" "$package_result"
require_scope skill-authoring "$skill_selected" \
  "$skill_windows_result" "$skill_install_result"
require_scope observability-langfuse "$observability_selected" \
  "$observability_windows_result" "$observability_install_result" \
  "$observability_performance_result"
require_scope discovery "$discovery_selected" \
  "$discovery_windows_result" "$discovery_install_result"
require_scope verification "$verification_selected" \
  "$verification_windows_result" "$verification_install_result"
