#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
mode=full
selected_package=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --fast)
      mode=fast
      shift
      ;;
    --package)
      if [ "$#" -lt 2 ] || [ -n "$selected_package" ]; then
        echo "usage: scripts/check-python [--fast] [--package REPOSITORY_PATH]" >&2
        exit 2
      fi
      selected_package=$2
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

if ! command -v uv >/dev/null 2>&1; then
  echo "error: uv is required for Python quality checks" >&2
  exit 1
fi

"$repo_root/scripts/check-python-inventory" "$repo_root"

packages=$(sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$repo_root/python-packages.txt")
if [ -n "$selected_package" ]; then
  package_registered=false
  for relative in $packages; do
    if [ "$relative" = "$selected_package" ]; then
      package_registered=true
    fi
  done
  if [ "$package_registered" != true ]; then
    echo "error: Python package is not registered: $selected_package" >&2
    exit 1
  fi
  packages=$selected_package
fi
coverage_verifier_tested=false
for relative in $packages; do
  package="$repo_root/$relative"
  echo "==> Python quality: $relative"
  (
    cd "$package"
    trap 'rm -f .coverage coverage.json' EXIT HUP INT TERM
    uv lock --check
    uv sync --locked --all-groups

    quality_paths="src tests"
    if [ -d scripts ]; then
      quality_paths="$quality_paths scripts"
    fi
    # shellcheck disable=SC2086
    uv run --all-groups ruff format --check $quality_paths
    # shellcheck disable=SC2086
    uv run --all-groups ruff check $quality_paths
    # shellcheck disable=SC2086
    uv run --all-groups mypy $quality_paths

    if [ "$mode" = full ]; then
      if [ "$coverage_verifier_tested" = false ]; then
        uv run --all-groups "$repo_root/scripts/test-python-coverage"
      fi
      uv run --all-groups coverage run -m pytest
      uv run --all-groups coverage json -o coverage.json
      uv run --all-groups "$repo_root/scripts/verify-python-coverage" coverage.json
    fi
  )
  if [ "$mode" = full ]; then
    coverage_verifier_tested=true
  fi
done
