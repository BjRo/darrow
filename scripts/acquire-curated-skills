#!/usr/bin/env bash
# Acquire the exact upstream inputs documented in docs/specs/curated-upstream.md.
set -euo pipefail
export LC_ALL=C

if [ "$#" -ne 1 ]; then
  echo 'usage: bash scripts/acquire-curated-skills <new-output-directory>' >&2
  exit 2
fi
destination=$1
mkdir -p "$(dirname "$destination")"
destination="$(cd "$(dirname "$destination")" && pwd -P)/$(basename "$destination")"
if [ -e "$destination" ] || [ -L "$destination" ]; then
  echo "refusing existing destination: $destination" >&2
  exit 1
fi
stage=$(mktemp -d "${destination}.partial.XXXXXX")
trap 'rm -rf "$stage"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
export npm_config_cache="$stage/npm-cache"
export DISABLE_TELEMETRY=1 DO_NOT_TRACK=1

matt_revision=abeeaf95660ba9e8b7c753eb38f441ca707a8823
pstack_revision=aaeb0ea3a0584995aa8f55ce44c6c5259414b896
matt_skills=(grilling wayfinder grill-with-docs domain-modeling diagnosing-bugs
  to-spec to-tickets wizard codebase-design improve-codebase-architecture
  writing-for-agents wait-what tdd implement research prototype setup-matt-pocock-skills)
mkdir -p "$stage/acquisition/matt" "$stage/acquisition/pstack" "$stage/matt" "$stage/pstack"
(
  cd "$stage/acquisition/matt"
  npx --yes skills@1.9.0 add "mattpocock/skills@$matt_revision" \
    --agent codex --copy --yes --skill "${matt_skills[@]}" >installer.log 2>&1
) || { cat "$stage/acquisition/matt/installer.log" >&2; exit 1; }
(
  cd "$stage/acquisition/pstack"
  npx --yes skills@1.9.0 add "https://github.com/cursor/plugins/tree/$pstack_revision/pstack" \
    --agent codex --copy --yes --skill unslop >installer.log 2>&1
) || { cat "$stage/acquisition/pstack/installer.log" >&2; exit 1; }
cp -R "$stage/acquisition/matt/.agents/skills" "$stage/matt/skills"
cp -R "$stage/acquisition/pstack/.agents/skills" "$stage/pstack/skills"
curl -fsSL "https://raw.githubusercontent.com/mattpocock/skills/$matt_revision/LICENSE" -o "$stage/matt/LICENSE"
curl -fsSL "https://raw.githubusercontent.com/cursor/plugins/$pstack_revision/pstack/LICENSE" -o "$stage/pstack/LICENSE"

for skill in "${matt_skills[@]}"; do
  printf 'skills/%s/SKILL.md\nskills/%s/agents/openai.yaml\n' "$skill" "$skill"
done >"$stage/matt/required-files.txt"
cat >>"$stage/matt/required-files.txt" <<'FILES'
skills/domain-modeling/ADR-FORMAT.md
skills/domain-modeling/GLOSSARY-FORMAT.md
skills/diagnosing-bugs/scripts/hitl-loop.template.sh
skills/wizard/template.sh
skills/codebase-design/DEEPENING.md
skills/codebase-design/DESIGN-IT-TWICE.md
skills/improve-codebase-architecture/HTML-REPORT.md
skills/writing-for-agents/SKILL-MECHANICS.md
skills/tdd/tests.md
skills/tdd/mocking.md
skills/prototype/LOGIC.md
skills/prototype/UI.md
skills/setup-matt-pocock-skills/issue-tracker-github.md
skills/setup-matt-pocock-skills/issue-tracker-gitlab.md
skills/setup-matt-pocock-skills/issue-tracker-local.md
skills/setup-matt-pocock-skills/triage-labels.md
skills/setup-matt-pocock-skills/domain.md
FILES
printf 'skills/unslop/SKILL.md\n' >"$stage/pstack/required-files.txt"
for skill in "${matt_skills[@]}"; do
  case "$skill" in
    grilling | writing-for-agents | wait-what) category=productivity ;;
    *) category=engineering ;;
  esac
  printf '%s\tskills/%s/%s\n' "$skill" "$category" "$skill"
done >"$stage/matt/selection.tsv"
printf 'unslop\tpstack/skills/unslop\n' >"$stage/pstack/selection.tsv"

cat >"$stage/matt/provenance.txt" <<EOF
source: https://github.com/mattpocock/skills
revision: $matt_revision
author: Matt Pocock
license: MIT (full upstream notice in LICENSE)
acquisition-tool: npx --yes skills@1.9.0
installer-gitHead: 50894c1d98bc45ca1ab127213e59d6525065b5e7
source-argument: mattpocock/skills@$matt_revision
installer-options: --agent codex --copy --yes --skill (names from selection.tsv)
selection-and-source-paths: selection.tsv
required-files: required-files.txt
content-inventory: files.sha256
local-adaptations: none in these inputs; downstream owns host calls, configured tracker/setup compatibility, Review binding and adapted implement with one Adaptive Goal owner, inherited seams and publication authority.
EOF
cat >"$stage/pstack/provenance.txt" <<EOF
source: https://github.com/cursor/plugins
revision: $pstack_revision
author: Lauren Tan
license: MIT (full upstream notice in LICENSE)
acquisition-tool: npx --yes skills@1.9.0
installer-gitHead: 50894c1d98bc45ca1ab127213e59d6525065b5e7
source-argument: https://github.com/cursor/plugins/tree/$pstack_revision/pstack
installer-options: --agent codex --copy --yes --skill unslop
selection-and-source-paths: selection.tsv
required-files: required-files.txt
content-inventory: files.sha256
local-adaptations: none in unslop inputs; downstream owns the current Darrow principle implementations and routing/customization, licensed MIT as part of the curated bundle.
principle-upstream-revision: unknown; the selected 24 Darrow adaptations have no established exact upstream revision. The pstack pin applies to unslop only. Preserve current bodies and custom routing; do not acquire raw principle leaves, benchmark-checklist or typescript-best-practices.
EOF

for source in matt pstack; do
  while IFS= read -r file; do
    if [ ! -s "$stage/$source/$file" ] || [ -L "$stage/$source/$file" ]; then
      echo "missing required regular file: $source/$file" >&2
      exit 1
    fi
  done <"$stage/$source/required-files.txt"
  cut -f 1 "$stage/$source/selection.tsv" | sort >"$stage/expected"
  (cd "$stage/$source/skills" && printf '%s\n' *) | sort >"$stage/actual"
  if ! cmp -s "$stage/expected" "$stage/actual"; then
    echo "unexpected skill selection: $source" >&2
    exit 1
  fi
  if [ -n "$(find "$stage/$source/skills" -type l -print)" ]; then
    echo "unsupported symlink in acquired inputs: $source" >&2
    exit 1
  fi
  case "$source" in
    matt) notice_hash=0e7ac423bf2c6e223b7c5b156f8cf72da49d748e56a1641402c31f22ad07dbb5 ;;
    pstack) notice_hash=bc957ca6bee02792566a1a028d105e02e247c6e77cf057061674273da77b200e ;;
  esac
  if [ "$(shasum -a 256 "$stage/$source/LICENSE" | cut -d ' ' -f 1)" != "$notice_hash" ]; then
    echo "upstream MIT notice differs from pinned source: $source" >&2
    exit 1
  fi
  (
    cd "$stage/$source"
    find skills -type f -print | sort | while IFS= read -r file; do shasum -a 256 "$file"; done
    shasum -a 256 LICENSE
  ) >"$stage/$source/files.sha256"
done
rm "$stage/expected" "$stage/actual"
rm -rf "$stage/npm-cache"
mv "$stage" "$destination"
printf 'Acquired pinned inputs: %s\n' "$destination"
