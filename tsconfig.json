{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["evals/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["evals/results/**", "evals/corpus/**/cache/**"]
}
