#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

usage() {
  cat >&2 <<'USAGE'
usage: decision inspect [--dir <path>] [--repo <path>]
       decision list [--dir <path>] [--repo <path>]
                     [--status Proposed|Accepted|Rejected|Deprecated|Superseded]
                     [--search <text>] [--related-to <ADR-NNNN>] [--limit <n>]
       decision next-id [--dir <path>] [--repo <path>] [--title <title>]
       decision validate [--dir <path>] [--repo <path>]
       decision catalog rebuild|check [--dir <path>] [--repo <path>]
       decision canonical-path --path <path> [--repo <path>]
       decision check-transition --from <status> --to <status>
USAGE
  exit 2
}

CATALOG_NAME=README.md
CATALOG_FORMAT=darrow-adr-catalog-v1

die() {
  printf 'error: %s\n' "$1" >&2
  exit "${2:-2}"
}

status_is_valid() {
  case "$1" in
    Proposed|Accepted|Rejected|Deprecated|Superseded) return 0 ;;
    *) return 1 ;;
  esac
}

has_control_char() {
  local LC_ALL=C
  [[ $1 == *[[:cntrl:]]* ]]
}

check_transition() {
  local from=$1 to=$2
  status_is_valid "$from" || die "unsupported decision status: $from"
  status_is_valid "$to" || die "unsupported decision status: $to"
  case "$from:$to" in
    Proposed:Accepted|Proposed:Rejected|Accepted:Deprecated|Accepted:Superseded)
      printf '%s -> %s: allowed\n' "$from" "$to"
      ;;
    *) die "unsupported decision transition: $from -> $to" 3 ;;
  esac
}

resolve_root() {
  local target=$1 worktrees line
  if [[ ! -d "$target" || ! -r "$target" ]]; then
    die "repository path is not a readable directory: $target"
  fi
  if ! worktrees=$(git -C "$target" worktree list --porcelain 2>/dev/null); then
    die "not a Git repository: $target"
  fi
  if ! line=$(awk 'NR == 1 && $1 == "worktree" {sub(/^worktree /, ""); print}' <<< "$worktrees"); then
    die "cannot parse git worktree metadata"
  fi
  [[ -n "$line" ]] || die "cannot resolve repository root from git worktree metadata"
  has_control_char "$line" && die "repository root contains unsupported control bytes"
  printf '%s' "$line"
}

inside_root() {
  case "$1" in
    "$ROOT"|"$ROOT"/*) return 0 ;;
    *) return 1 ;;
  esac
}

path_has_symlink_component() {
  local path=$1 current="" rest component
  rest=${path#/}
  while [[ -n "$rest" ]]; do
    component=${rest%%/*}
    case "$rest" in
      */*) rest=${rest#*/} ;;
      *) rest="" ;;
    esac
    [[ -n "$component" ]] || continue
    current="$current/$component"
    [[ ! -L "$current" ]] || return 0
  done
  return 1
}

canonical_directory() {
  local value=$1 candidate resolved
  case "$value" in
    /*) candidate=$value ;;
    *) candidate="$ROOT/$value" ;;
  esac
  ! path_has_symlink_component "$candidate" || die "ADR directory symlinks are not allowed: $candidate"
  [[ -d "$candidate" ]] || die "ADR directory does not exist: $candidate"
  [[ -r "$candidate" && -x "$candidate" ]] || die "ADR directory is not readable: $candidate"
  resolved=$(cd "$candidate" 2>/dev/null && pwd -P) || die "cannot resolve ADR directory: $candidate"
  has_control_char "$resolved" && die "ADR directory contains unsupported control bytes"
  inside_root "$resolved" || die "ADR directory escapes the repository root: $resolved"
  printf '%s' "$resolved"
}

run_canonical_path() {
  local candidate parent name resolved_parent resolved
  [[ -n "$PATH_ARG" ]] || usage
  case "$PATH_ARG" in
    /*) candidate=$PATH_ARG ;;
    *) candidate="$ROOT/$PATH_ARG" ;;
  esac
  ! path_has_symlink_component "$candidate" || die "canonical record symlinks are not allowed: $candidate"
  [[ -f "$candidate" ]] || die "canonical record is not a regular file: $candidate"
  [[ -r "$candidate" ]] || die "canonical record is not readable: $candidate"
  parent=$(dirname "$candidate") || die "cannot resolve canonical record parent: $candidate"
  name=$(basename "$candidate") || die "cannot resolve canonical record name: $candidate"
  resolved_parent=$(cd "$parent" 2>/dev/null && pwd -P) || die "cannot resolve canonical record parent: $candidate"
  resolved="$resolved_parent/$name"
  has_control_char "$resolved" && die "canonical record path contains unsupported control bytes"
  inside_root "$resolved" || die "canonical record escapes the repository root: $resolved"
  printf 'path: %s\n' "$resolved"
}

select_adr_directory() {
  local candidate duplicate existing
  ADR_DIR=""
  if [[ -n "$DIR_ARG" ]]; then
    ADR_DIR=$(canonical_directory "$DIR_ARG")
    return
  fi

  ADR_DIR_COUNT=0
  ADR_DIR_CANDIDATES=()
  for candidate in \
    "$ROOT/docs/decisions" \
    "$ROOT/docs/adrs" \
    "$ROOT/docs/adr" \
    "$ROOT/architecture/decisions" \
    "$ROOT/adrs" \
    "$ROOT/adr"
  do
    if [[ ( -e "$candidate" || -L "$candidate" ) && ! -d "$candidate" ]]; then
      die "ADR directory candidate is not a directory: $candidate"
    fi
    if [[ -d "$candidate" ]]; then
      candidate=$(canonical_directory "$candidate")
      duplicate=0
      for existing in "${ADR_DIR_CANDIDATES[@]:-}"; do
        [[ "$existing" != "$candidate" ]] || duplicate=1
      done
      if [[ $duplicate -eq 0 ]]; then
        ADR_DIR_CANDIDATES+=("$candidate")
        ADR_DIR_COUNT=$((ADR_DIR_COUNT + 1))
      fi
    fi
  done

  if [[ $ADR_DIR_COUNT -eq 1 ]]; then
    ADR_DIR=${ADR_DIR_CANDIDATES[0]}
  elif [[ $ADR_DIR_COUNT -gt 1 ]]; then
    printf 'error: multiple ADR directories found; pass --dir explicitly:\n' >&2
    for candidate in "${ADR_DIR_CANDIDATES[@]}"; do
      printf '  - %s\n' "$candidate" >&2
    done
    exit 3
  fi
}

valid_iso_date() {
  local value=$1 year month day year_n month_n day_n max_day
  [[ $value =~ ^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$ ]] || return 1
  year=${value:0:4}
  month=${value:5:2}
  day=${value:8:2}
  year_n=$((10#$year))
  month_n=$((10#$month))
  day_n=$((10#$day))
  [[ $year_n -gt 0 && $month_n -ge 1 && $month_n -le 12 && $day_n -ge 1 ]] || return 1
  case "$month_n" in
    1|3|5|7|8|10|12) max_day=31 ;;
    4|6|9|11) max_day=30 ;;
    2)
      max_day=28
      if (( year_n % 400 == 0 || (year_n % 4 == 0 && year_n % 100 != 0) )); then
        max_day=29
      fi
      ;;
  esac
  [[ $day_n -le $max_day ]]
}

parse_adr() {
  local file=$1
  LC_ALL=C awk '
    function trim(value) {
      sub(/^[ \t]+/, "", value)
      sub(/[ \t]+$/, "", value)
      return value
    }
    function clean(value) {
      gsub(/[[:cntrl:]]/, " ", value)
      return value
    }
    function heading_info(value,    level, rest, text) {
      level = 0
      while (substr(value, level + 1, 1) == "#") level++
      if (level < 1 || level > 6) return 0
      rest = substr(value, level + 1, 1)
      if (rest != " " && rest != "\t") return 0
      text = trim(substr(value, level + 2))
      sub(/[ \t]+#+[ \t]*$/, "", text)
      heading_level = level
      heading_text = text
      return 1
    }
    BEGIN {
      sep = sprintf("%c", 28)
      in_fence = 0
      fence_char = ""
      fence_size = 0
      metadata = 1
      section = ""
    }
    {
      line = $0
      if (NR == 1) sub(/^\357\273\277/, "", line)
      scan = line
      indent = 0
      while (indent < 3 && substr(scan, 1, 1) == " ") {
        scan = substr(scan, 2)
        indent++
      }
      marker = substr(scan, 1, 1)
      marker_size = 0
      if (marker == "`" || marker == "~") {
        while (substr(scan, marker_size + 1, 1) == marker) marker_size++
      }
      if (marker_size >= 3) {
        if (!in_fence) {
          in_fence = 1
          fence_char = marker
          fence_size = marker_size
        } else if (marker == fence_char && marker_size >= fence_size && trim(substr(scan, marker_size + 1)) == "") {
          in_fence = 0
          fence_char = ""
          fence_size = 0
        } else if (section != "" && trim(line) != "") {
          nonempty[section] = 1
        }
        next
      }
      if (in_fence) {
        if (section != "" && trim(line) != "") nonempty[section] = 1
        next
      }

      heading_level = 0
      heading_text = ""
      if (heading_info(scan)) {
        if (heading_level == 1 && heading_text ~ /^ADR-/) {
          heading_count++
          colon = index(heading_text, ":")
          if (colon > 0) {
            identifier = trim(substr(heading_text, 1, colon - 1))
            title = trim(substr(heading_text, colon + 1))
          } else {
            identifier = trim(heading_text)
            title = ""
          }
        }
        if (heading_level <= 2) section = ""
        if (heading_level == 2) {
          metadata = 0
          if (heading_text == "Context") {
            section = "context"
            context_count++
          } else if (heading_text == "Decision") {
            section = "decision"
            decision_count++
          } else if (heading_text == "Consequences") {
            section = "consequences"
            consequences_count++
          }
        }
        next
      }

      if (metadata && line ~ /^Status:[ \t]*/) {
        status_count++
        status = trim(substr(line, index(line, ":") + 1))
        next
      }
      if (metadata && line ~ /^Date:[ \t]*/) {
        date_count++
        date = trim(substr(line, index(line, ":") + 1))
        next
      }
      if (metadata && line ~ /^Summary:[ \t]*/) {
        summary_count++
        summary = trim(substr(line, index(line, ":") + 1))
        next
      }
      if (metadata && line ~ /^Supersedes:[ \t]*/) {
        supersedes_count++
        supersedes = trim(substr(line, index(line, ":") + 1))
        next
      }
      if (metadata && line ~ /^Superseded by:[ \t]*/) {
        superseded_by_count++
        superseded_by = trim(substr(line, index(line, ":") + 1))
        next
      }
      if (metadata && line ~ /^Revisit when:[ \t]*/) {
        revisit_count++
        revisit = trim(substr(line, index(line, ":") + 1))
        next
      }
      if (section != "" && trim(line) != "") nonempty[section] = 1
    }
    END {
      printf "%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s", \
        clean(identifier), sep, clean(title), sep, clean(status), sep, clean(date), sep, clean(summary), sep, \
        clean(supersedes), sep, clean(superseded_by), sep, clean(revisit), sep, \
        heading_count + 0, sep, status_count + 0, sep, date_count + 0, sep, summary_count + 0, sep, \
        supersedes_count + 0, sep, superseded_by_count + 0, sep, revisit_count + 0, sep, \
        context_count + 0, sep, decision_count + 0, sep, consequences_count + 0, sep, \
        nonempty["context"] + 0, sep, nonempty["decision"] + 0, sep, nonempty["consequences"] + 0, sep, in_fence + 0
    }
  ' "$file"
}

relative_to_root() {
  case "$1" in
    "$ROOT"/*) printf '%s' "${1#"$ROOT"/}" ;;
    *) die "path is outside the repository root: $1" ;;
  esac
}

current_fingerprint() {
  local file=$1 relative staged index_flag diff_status fingerprint
  relative=$(relative_to_root "$file")
  staged=$(git -C "$ROOT" ls-files --stage -- "$relative" 2>/dev/null || true)
  if [[ -n "$staged" && "$staged" != *$'\n'* ]]; then
    index_flag=$(git -C "$ROOT" ls-files -v -- "$relative" 2>/dev/null) || die "cannot inspect Git index flags for ADR: $file"
    if [[ "$index_flag" != "H $relative" ]]; then
      fingerprint=$(git -C "$ROOT" hash-object --path="$relative" "$file" 2>/dev/null) || die "cannot fingerprint ADR file: $file"
      [[ $fingerprint =~ ^[0-9a-f]+$ ]] || die "cannot fingerprint ADR file: $file"
      printf '%s' "$fingerprint"
      return
    fi
    diff_status=0
    git -C "$ROOT" diff-files --quiet -- "$relative" >/dev/null 2>&1 || diff_status=$?
    if [[ $diff_status -eq 0 ]]; then
      fingerprint=${staged#* }
      fingerprint=${fingerprint%% *}
      [[ $fingerprint =~ ^[0-9a-f]+$ ]] || die "cannot parse Git fingerprint for ADR: $file"
      printf '%s' "$fingerprint"
      return
    fi
    [[ $diff_status -eq 1 ]] || die "cannot compare ADR with the Git index: $file"
  fi
  fingerprint=$(git -C "$ROOT" hash-object --path="$relative" "$file" 2>/dev/null) || die "cannot fingerprint ADR file: $file"
  [[ $fingerprint =~ ^[0-9a-f]+$ ]] || die "cannot fingerprint ADR file: $file"
  printf '%s' "$fingerprint"
}

markdown_cell() {
  LC_ALL=C sed 's/&/\&#38;/g; s/</\&#60;/g; s/>/\&#62;/g; s/\\/\\\\/g; s/|/\\|/g' <<< "$1"
}

markdown_label() {
  LC_ALL=C sed 's/&/\&#38;/g; s/</\&#60;/g; s/>/\&#62;/g; s/\\/\\\\/g; s/\[/\\[/g; s/\]/\\]/g; s/|/\\|/g' <<< "$1"
}

markdown_target() {
  LC_ALL=C sed 's/%/%25/g; s/\\/%5C/g; s/ /%20/g; s/(/%28/g; s/)/%29/g; s/#/%23/g; s/?/%3F/g; s/|/%7C/g; s/</%3C/g; s/>/%3E/g' <<< "$1"
}

catalog_relationships() {
  local supersedes=$1 superseded_by=$2 revisit=$3 rendered=""
  [[ -z "$supersedes" ]] || rendered="Supersedes: $supersedes"
  if [[ -n "$superseded_by" ]]; then
    [[ -z "$rendered" ]] || rendered="$rendered; "
    rendered="${rendered}Superseded by: $superseded_by"
  fi
  if [[ -n "$revisit" ]]; then
    [[ -z "$rendered" ]] || rendered="$rendered; "
    rendered="${rendered}Revisit when: $revisit"
  fi
  printf '%s' "${rendered:-None}"
}

write_catalog_file() {
  local target=$1 wanted identifier title status date summary supersedes superseded_by revisit file
  local fingerprint basename label link summary_cell relationships relationship_cell signature crc bytes source_file source_name
  {
    printf '# ADR Catalog\n\n'
    printf 'This checked-in catalog is derived, non-authoritative metadata. ADR files remain canonical.\n'
    # shellcheck disable=SC2016 # literal Markdown code spans, not command substitution
    printf 'Rebuild it with `decision catalog rebuild` and verify it with `decision catalog check`.\n\n'
    printf '<!-- %s -->\n' "$CATALOG_FORMAT"
  } > "$target"
  source_file="$DECISION_TMP/catalog-sources"
  for wanted in Proposed Accepted Rejected Deprecated Superseded; do
    : > "$source_file"
    {
      printf '\n## %s\n\n' "$wanted"
      printf '<!-- prettier-ignore -->\n'
      printf '| Decision | Status | Date | Summary | Relationships |\n'
      printf '| --- | --- | --- | --- | --- |\n'
    } >> "$target"
    while IFS=$'\034' read -r identifier title status date summary supersedes superseded_by revisit file; do
      [[ -n "$identifier" && "$status" == "$wanted" ]] || continue
      fingerprint=$(current_fingerprint "$file")
      basename=${file##*/}
      source_name=$(markdown_target "$basename")
      label=$(markdown_label "$identifier: $title")
      link=$(markdown_target "$basename")
      summary_cell=$(markdown_cell "$summary")
      relationships=$(catalog_relationships "$supersedes" "$superseded_by" "$revisit")
      relationship_cell=$(markdown_cell "$relationships")
      printf '| [%s](%s) | %s | %s | %s | %s |\n' \
        "$label" "$link" "$status" "$date" "$summary_cell" "$relationship_cell" >> "$target"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$fingerprint" "$basename" "$link" "$identifier" "$title" "$status" "$date" "$summary" "$supersedes" "$superseded_by" "$revisit" > "$DECISION_TMP/catalog-signature"
      signature=$(cksum < "$DECISION_TMP/catalog-signature") || die "cannot checksum ADR catalog row: $file"
      crc=${signature%% *}; signature=${signature#* }; bytes=${signature%% *}
      [[ $crc =~ ^[0-9]+$ && $bytes =~ ^[0-9]+$ ]] || die "cannot parse ADR catalog row checksum: $file"
      printf '<!-- darrow-source: %s %s %s %s -->\n' "$fingerprint" "$crc" "$bytes" "$source_name" >> "$source_file"
    done < "$INVENTORY"
    if [[ -s "$source_file" ]]; then
      printf '\n' >> "$target"
      cat "$source_file" >> "$target"
    fi
  done
}

filename_identifier() {
  local base
  base=${1##*/}
  if [[ $base =~ ^(ADR-[0-9]+)(-|\.md$) ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  fi
  return 1
}

record_error() {
  ERROR_COUNT=$((ERROR_COUNT + 1))
  if [[ $ERROR_COUNT -le 40 ]]; then
    printf 'error: %s\n' "$1" >> "$ERRORS"
  fi
}

relation_contains() {
  local rest=$1 wanted=$2 item
  while :; do
    item=${rest%%,*}
    item=${item#"${item%%[![:space:]]*}"}
    item=${item%"${item##*[![:space:]]}"}
    [[ "$item" != "$wanted" ]] || return 0
    [[ "$rest" == *,* ]] || break
    rest=${rest#*,}
  done
  return 1
}

build_inventory() {
  local file parsed file_id identifier title status date summary supersedes superseded_by revisit
  local heading_count status_count date_count summary_count supersedes_count superseded_by_count revisit_count
  local context_count decision_count consequences_count context_nonempty decision_nonempty consequences_nonempty unclosed_fence
  local unsafe_file_count

  : > "$INVENTORY"
  : > "$ERRORS"
  ERROR_COUNT=0
  [[ -n "$ADR_DIR" ]] || return 0

  if ! find "$ADR_DIR" -maxdepth 1 -mindepth 1 -name '*.md' -print0 > "$DECISION_TMP/files"; then
    record_error "$ADR_DIR: cannot enumerate Markdown entries"
    return 1
  fi
  : > "$DECISION_TMP/safe-files"
  unsafe_file_count=0
  while IFS= read -r -d '' file; do
    if has_control_char "$file"; then
      unsafe_file_count=$((unsafe_file_count + 1))
      continue
    fi
    printf '%s\n' "$file" >> "$DECISION_TMP/safe-files"
  done < "$DECISION_TMP/files"
  if ! LC_ALL=C sort "$DECISION_TMP/safe-files" -o "$DECISION_TMP/safe-files"; then
    record_error "$ADR_DIR: cannot sort ADR paths"
    return 1
  fi
  if [[ $unsafe_file_count -gt 0 ]]; then
      record_error "$ADR_DIR: $unsafe_file_count ADR filename(s) contain unsupported control bytes"
  fi
  while IFS= read -r file; do
    [[ "$file" != "$ADR_DIR/$CATALOG_NAME" ]] || continue
    if [[ -L "$file" ]]; then
      record_error "$file: ADR symlinks are not allowed"
      continue
    fi
    if [[ ! -f "$file" ]]; then
      record_error "$file: ADR path is occupied by an unsupported file type"
      continue
    fi
    if [[ ! -r "$file" ]]; then
      record_error "$file: Markdown file is not readable"
      continue
    fi
    file_id=""
    if filename_identifier "$file" >/dev/null; then
      file_id=$(filename_identifier "$file")
    fi
    if ! parsed=$(parse_adr "$file"); then
      record_error "$file: cannot parse ADR file"
      continue
    fi
    IFS=$'\034' read -r identifier title status date summary supersedes superseded_by revisit \
      heading_count status_count date_count summary_count supersedes_count superseded_by_count revisit_count \
      context_count decision_count consequences_count context_nonempty decision_nonempty consequences_nonempty unclosed_fence <<< "$parsed"

    if [[ -z "$file_id" ]]; then record_error "$file: filename does not carry its ADR identifier"; fi
    if [[ $heading_count -ne 1 ]]; then record_error "$file: expected exactly one level-1 ADR heading; found $heading_count"; fi
    if [[ -z "$identifier" ]]; then
      record_error "$file: ADR heading has no identifier"
    elif [[ ${#identifier} -gt 22 ]]; then
      record_error "$file: ADR identifier exceeds the 18-digit limit"
    elif [[ ! $identifier =~ ^ADR-[0-9][0-9][0-9][0-9][0-9]*$ ]]; then
      record_error "$file: unsupported ADR identifier: $identifier"
    fi
    if [[ -n "$file_id" && -n "$identifier" && "$file_id" != "$identifier" ]]; then
      record_error "$file: filename identifier $file_id disagrees with heading identifier $identifier"
    fi
    if [[ -z "$title" ]]; then
      record_error "$file: ADR title is empty"
    elif [[ ${#title} -gt 240 ]]; then
      record_error "$file: ADR title exceeds 240 bytes"
    fi
    if [[ $status_count -ne 1 ]]; then
      record_error "$file: expected exactly one Status field; found $status_count"
    elif [[ ${#status} -gt 32 ]]; then
      record_error "$file: decision status exceeds 32 bytes"
    elif ! status_is_valid "$status"; then
      record_error "$file: unsupported decision status: $status"
    fi
    if [[ $date_count -ne 1 ]]; then
      record_error "$file: expected exactly one Date field; found $date_count"
    elif [[ ${#date} -gt 32 ]]; then
      record_error "$file: Date exceeds 32 bytes"
    elif ! valid_iso_date "$date"; then
      record_error "$file: Date is not a valid ISO calendar date: $date"
    fi
    if [[ $summary_count -ne 1 ]]; then
      record_error "$file: expected exactly one Summary field; found $summary_count"
    elif [[ -z "$summary" ]]; then
      record_error "$file: Summary field is blank"
    elif [[ ${#summary} -gt 500 ]]; then
      record_error "$file: Summary exceeds 500 bytes"
    fi
    [[ $supersedes_count -le 1 ]] || record_error "$file: duplicate Supersedes fields"
    [[ $superseded_by_count -le 1 ]] || record_error "$file: duplicate Superseded by fields"
    [[ $revisit_count -le 1 ]] || record_error "$file: duplicate Revisit when fields"
    [[ $supersedes_count -ne 1 || -n "$supersedes" ]] || record_error "$file: Supersedes field is blank"
    [[ $superseded_by_count -ne 1 || -n "$superseded_by" ]] || record_error "$file: Superseded by field is blank"
    [[ $revisit_count -ne 1 || -n "$revisit" ]] || record_error "$file: Revisit when field is blank"
    [[ ${#supersedes} -le 1000 ]] || record_error "$file: Supersedes exceeds 1000 bytes"
    [[ ${#superseded_by} -le 1000 ]] || record_error "$file: Superseded by exceeds 1000 bytes"
    [[ ${#revisit} -le 500 ]] || record_error "$file: Revisit when exceeds 500 bytes"
    [[ $unclosed_fence -eq 0 ]] || record_error "$file: Markdown fence is not closed"
    if [[ $context_count -ne 1 || $context_nonempty -ne 1 ]]; then
      record_error "$file: Context section must occur once and contain content"
    fi
    if [[ $decision_count -ne 1 || $decision_nonempty -ne 1 ]]; then
      record_error "$file: Decision section must occur once and contain content"
    fi
    if [[ $consequences_count -ne 1 || $consequences_nonempty -ne 1 ]]; then
      record_error "$file: Consequences section must occur once and contain content"
    fi

    printf '%s\034%s\034%s\034%s\034%s\034%s\034%s\034%s\034%s\n' \
      "$identifier" "$title" "$status" "$date" "$summary" "$supersedes" "$superseded_by" "$revisit" "$file" >> "$INVENTORY"
  done < "$DECISION_TMP/safe-files"

  if ! LC_ALL=C sort "$INVENTORY" -o "$INVENTORY"; then
    record_error "$ADR_DIR: cannot sort ADR inventory"
    return 1
  fi
  if ! DECISION_SEP=$SEP awk '
    function trim(value) {
      sub(/^[ \t]+/, "", value)
      sub(/[ \t]+$/, "", value)
      return value
    }
    function valid_id(value, digits) {
      if (substr(value, 1, 4) != "ADR-") return 0
      digits = substr(value, 5)
      return length(digits) >= 4 && length(digits) <= 18 && digits !~ /[^0-9]/
    }
    function contains(value, wanted, count, part, i) {
      count = split(value, part, ",")
      for (i = 1; i <= count; i++) if (trim(part[i]) == wanted) return 1
      return 0
    }
    function report(message) {print message}
    function validate_relations(id, value, kind, count, part, seen, i, target) {
      if (value == "") return
      count = split(value, part, ",")
      if (count > 50) report(path[id] ": " kind " has more than 50 targets")
      for (i = 1; i <= count; i++) {
        target = trim(part[i])
        if (!valid_id(target)) {
          report(path[id] ": invalid " kind " identifier")
          continue
        }
        if (seen[target]++) {
          report(path[id] ": duplicate " kind " target: " target)
          continue
        }
        if (target == id) {
          report(path[id] ": an ADR cannot relate to itself through " kind)
          continue
        }
        if (!(target in present)) {
          report(path[id] ": " kind " target does not exist: " target)
          continue
        }
        if (kind == "Supersedes") {
          edge[id, ++edge_count[id]] = target
          if (status[target] != "Superseded") report(path[id] ": " target " must have status Superseded")
          if (!contains(superseded_by[target], id)) report(path[id] ": " target " does not reciprocate Superseded by " id)
        } else {
          if (status[target] != "Accepted") report(path[id] ": replacement " target " must have status Accepted")
          if (!contains(supersedes[target], id)) report(path[id] ": " target " does not reciprocate Supersedes " id)
        }
      }
    }
    function visit(id, i, target) {
      state[id] = 1
      for (i = 1; i <= edge_count[id]; i++) {
        target = edge[id, i]
        if (state[target] == 1) {
          report(path[id] ": supersession relationship cycle detected at edge " id " -> " target)
          return 1
        }
        if (state[target] == 0 && visit(target)) return 1
      }
      state[id] = 2
      return 0
    }
    BEGIN {FS = ENVIRON["DECISION_SEP"]}
    $1 != "" {
      id = $1
      if (id in present) {
        report("duplicate ADR identifier: " id)
        next
      }
      present[id] = 1
      ids[++record_count] = id
      status[id] = $3
      supersedes[id] = $6
      superseded_by[id] = $7
      path[id] = $9
    }
    END {
      for (record = 1; record <= record_count; record++) {
        id = ids[record]
        if (supersedes[id] != "" && status[id] != "Accepted") report(path[id] ": Supersedes is allowed only on an Accepted replacement")
        if (superseded_by[id] != "" && status[id] != "Superseded") report(path[id] ": Superseded by requires status Superseded")
        if (superseded_by[id] == "" && status[id] == "Superseded") report(path[id] ": status Superseded requires Superseded by")
        validate_relations(id, supersedes[id], "Supersedes")
        validate_relations(id, superseded_by[id], "Superseded by")
      }
      for (record = 1; record <= record_count; record++) {
        id = ids[record]
        if (state[id] == 0 && visit(id)) break
      }
    }
  ' "$INVENTORY" > "$DECISION_TMP/relationship-errors"; then
    record_error "$ADR_DIR: cannot validate ADR relationships"
    return 1
  fi
  while IFS= read -r parsed; do
    [[ -z "$parsed" ]] || record_error "$parsed"
  done < "$DECISION_TMP/relationship-errors"

  if [[ $ERROR_COUNT -gt 40 ]]; then
    printf 'error: %d additional diagnostics omitted\n' "$((ERROR_COUNT - 40))" >> "$ERRORS"
  fi
  [[ $ERROR_COUNT -eq 0 ]]
}

parse_catalog_rows() {
  local catalog=$1
  CATALOG_ROWS="$DECISION_TMP/catalog-rows"
  CATALOG_NAMES="$DECISION_TMP/catalog-names"
  : > "$CATALOG_ROWS"
  if ! DECISION_SEP=$SEP LC_ALL=C awk '
    function trim(value) {sub(/^[ \t]+/, "", value); sub(/[ \t]+$/, "", value); return value}
    function fail() {bad = 1}
    function encode_target(value) {
      gsub(/%/, "%25", value); gsub(/\\/, "%5C", value); gsub(/ /, "%20", value)
      gsub(/\(/, "%28", value); gsub(/\)/, "%29", value); gsub(/#/, "%23", value)
      gsub(/\?/, "%3F", value); gsub(/\|/, "%7C", value); gsub(/</, "%3C", value); gsub(/>/, "%3E", value)
      return value
    }
    function decode_target(value) {
      gsub(/%3E/, ">", value); gsub(/%3C/, "<", value); gsub(/%7C/, "|", value)
      gsub(/%3F/, "?", value); gsub(/%23/, "#", value); gsub(/%29/, ")", value)
      gsub(/%28/, "(", value); gsub(/%20/, " ", value); gsub(/%5C/, "\\", value)
      gsub(/%25/, "%", value)
      return value
    }
    function decode_html(value) {
      gsub(/&#60;/, "<", value); gsub(/&#62;/, ">", value); gsub(/&#38;/, "\\&", value)
      return value
    }
    function split_cells(line, out,    i, c, escaped, value, count) {
      value = ""; count = 0
      for (i = 2; i < length(line); i++) {
        c = substr(line, i, 1)
        if (escaped) {value = value c; escaped = 0}
        else if (c == "\\") escaped = 1
        else if (c == "|") {out[++count] = trim(value); value = ""}
        else value = value c
      }
      if (escaped) value = value "\\"
      out[++count] = trim(value)
      return count
    }
    function parse_relationships(value,    rest, pos) {
      supersedes = ""; superseded_by = ""; revisit = ""
      if (value == "None") return 1
      rest = value
      if (substr(rest, 1, 12) == "Supersedes: ") {
        rest = substr(rest, 13); pos = index(rest, "; ")
        if (pos) {supersedes = substr(rest, 1, pos - 1); rest = substr(rest, pos + 2)}
        else {supersedes = rest; rest = ""}
      }
      if (substr(rest, 1, 15) == "Superseded by: ") {
        rest = substr(rest, 16); pos = index(rest, "; ")
        if (pos) {superseded_by = substr(rest, 1, pos - 1); rest = substr(rest, pos + 2)}
        else {superseded_by = rest; rest = ""}
      }
      if (substr(rest, 1, 14) == "Revisit when: ") {revisit = substr(rest, 15); rest = ""}
      return rest == "" && (supersedes != "" || superseded_by != "" || revisit != "")
    }
    /^# ADR Catalog$/ {heading++; next}
    /^This checked-in catalog is derived, non-authoritative metadata\. ADR files remain canonical\.$/ {description++; next}
    /^Rebuild it with `decision catalog rebuild` and verify it with `decision catalog check`\.$/ {instructions++; next}
    /^<!-- darrow-adr-catalog-v1 -->$/ {format++; next}
    /^## / {
      current = substr($0, 4)
      if (current !~ /^(Proposed|Accepted|Rejected|Deprecated|Superseded)$/ || section[current]++) fail()
      section_count++
      next
    }
    /^<!-- prettier-ignore -->$/ {prettier_markers++; next}
    /^\| Decision \| Status \| Date \| Summary \| Relationships \|$/ {
      if (current == "" || table_header[current]++) fail(); else header_count++
      next
    }
    /^\| --- \| --- \| --- \| --- \| --- \|$/ {
      if (current == "" || table_separator[current]++ || table_header[current] != 1) fail(); else separator_count++
      next
    }
    /^\| / {
      for (key in cell) delete cell[key]
      if (split_cells($0, cell) != 5 || current == "" || table_header[current] != 1 || table_separator[current] != 1) {fail(); next}
      linkpos = 0
      for (i = 1; i < length(cell[1]); i++) if (substr(cell[1], i, 2) == "](") linkpos = i
      if (substr(cell[1], 1, 1) != "[" || linkpos == 0 || substr(cell[1], length(cell[1]), 1) != ")") {fail(); next}
      label = substr(cell[1], 2, linkpos - 2)
      link = substr(cell[1], linkpos + 2, length(cell[1]) - linkpos - 2)
      colon = index(label, ": ")
      if (colon == 0) {fail(); next}
      identifier = substr(label, 1, colon - 1)
      title = decode_html(substr(label, colon + 2))
      status = cell[2]; date = cell[3]; summary = decode_html(cell[4])
      if (identifier !~ /^ADR-[0-9][0-9][0-9][0-9][0-9]*$/ || title == "" || status != current || summary == "" || !parse_relationships(decode_html(cell[5]))) {fail(); next}
      row_count++
      row_identifier[row_count] = identifier; row_title[row_count] = title
      row_link[row_count] = link
      row_status[row_count] = status; row_date[row_count] = date; row_summary[row_count] = summary
      row_supersedes[row_count] = supersedes; row_superseded_by[row_count] = superseded_by; row_revisit[row_count] = revisit
      next
    }
    /^<!-- darrow-source: / {
      source_count++
      if (source_count > row_count || $0 !~ /^<!-- darrow-source: [0-9a-f]+ [0-9]+ [0-9]+ .+ -->$/) {fail(); next}
      source = substr($0, 21, length($0) - 24)
      space = index(source, " "); fingerprint = substr(source, 1, space - 1); source = substr(source, space + 1)
      space = index(source, " "); crc = substr(source, 1, space - 1); source = substr(source, space + 1)
      space = index(source, " "); bytes = substr(source, 1, space - 1); name = decode_target(substr(source, space + 1))
      identifier = row_identifier[source_count]; title = row_title[source_count]; status = row_status[source_count]
      link = row_link[source_count]
      date = row_date[source_count]; summary = row_summary[source_count]; supersedes = row_supersedes[source_count]
      superseded_by = row_superseded_by[source_count]; revisit = row_revisit[source_count]
      if ((length(fingerprint) != 40 && length(fingerprint) != 64) || fingerprint ~ /[^0-9a-f]/ || crc ~ /[^0-9]/ || bytes ~ /[^0-9]/ || name !~ /^ADR-[0-9]+.*\.md$/ || name ~ /\// || link != encode_target(name) || seen_id[identifier]++ || seen_name[name]++) {fail(); next}
      print fingerprint ENVIRON["DECISION_SEP"] name ENVIRON["DECISION_SEP"] identifier ENVIRON["DECISION_SEP"] title ENVIRON["DECISION_SEP"] status ENVIRON["DECISION_SEP"] date ENVIRON["DECISION_SEP"] summary ENVIRON["DECISION_SEP"] supersedes ENVIRON["DECISION_SEP"] superseded_by ENVIRON["DECISION_SEP"] revisit ENVIRON["DECISION_SEP"] crc ENVIRON["DECISION_SEP"] bytes ENVIRON["DECISION_SEP"] link
      next
    }
    /^[ \t]*$/ {next}
    {fail()}
    END {
      if (heading != 1 || description != 1 || instructions != 1 || format != 1 || section_count != 5 || prettier_markers != 5 || header_count != 5 || separator_count != 5 || source_count != row_count || bad) exit 1
    }
  ' "$catalog" > "$CATALOG_ROWS"; then
    return 1
  fi
  DECISION_SEP=$SEP LC_ALL=C awk 'BEGIN {FS = ENVIRON["DECISION_SEP"]} {print $2}' "$CATALOG_ROWS" | LC_ALL=C sort > "$CATALOG_NAMES" || return 1
}

collect_catalog_files() {
  local file unsafe_count
  CATALOG_FILES="$DECISION_TMP/catalog-files"
  CATALOG_ACTUAL_NAMES="$DECISION_TMP/catalog-actual-names"
  find "$ADR_DIR" -maxdepth 1 -mindepth 1 -name '*.md' -print0 > "$DECISION_TMP/catalog-files0" || return 1
  : > "$CATALOG_FILES"
  unsafe_count=0
  while IFS= read -r -d '' file; do
    [[ "$file" != "$CATALOG_PATH" ]] || continue
    if has_control_char "$file"; then unsafe_count=$((unsafe_count + 1)); continue; fi
    [[ ! -L "$file" && -f "$file" && -r "$file" ]] || return 1
    printf '%s\n' "$file" >> "$CATALOG_FILES"
  done < "$DECISION_TMP/catalog-files0"
  [[ $unsafe_count -eq 0 ]] || return 1
  LC_ALL=C sort "$CATALOG_FILES" -o "$CATALOG_FILES" || return 1
  awk '{name=$0; sub(/^.*\//, "", name); print name}' "$CATALOG_FILES" > "$CATALOG_ACTUAL_NAMES" || return 1
}

catalog_is_fresh() {
  local catalog=$1 fingerprint basename identifier title status date summary supersedes superseded_by revisit crc bytes link staged relative_dir relative_catalog catalog_flag signature actual_crc actual_bytes
  [[ -e "$catalog" || -L "$catalog" ]] || return 10
  [[ ! -L "$catalog" && -f "$catalog" ]] || return 12
  [[ -r "$catalog" ]] || return 11
  relative_catalog=$(relative_to_root "$catalog")
  git -C "$ROOT" cat-file -e "HEAD:$relative_catalog" 2>/dev/null || return 13
  catalog_flag=$(git -C "$ROOT" ls-files -v -- "$relative_catalog" 2>/dev/null) || return 13
  [[ "$catalog_flag" == "H $relative_catalog" ]] || return 13
  git -C "$ROOT" diff --quiet HEAD -- "$relative_catalog" >/dev/null 2>&1 || return 13
  parse_catalog_rows "$catalog" || return 12
  collect_catalog_files || return 13
  cmp -s "$CATALOG_NAMES" "$CATALOG_ACTUAL_NAMES" || return 13
  relative_dir=$(relative_to_root "$ADR_DIR")
  git -C "$ROOT" ls-files --stage -z -- "$relative_dir" > "$DECISION_TMP/catalog-staged0" 2>/dev/null || return 13
  tr '\000' '\n' < "$DECISION_TMP/catalog-staged0" > "$DECISION_TMP/catalog-staged" || return 13
  git -C "$ROOT" ls-files -v -z -- "$relative_dir" > "$DECISION_TMP/catalog-flags0" 2>/dev/null || return 13
  tr '\000' '\n' < "$DECISION_TMP/catalog-flags0" > "$DECISION_TMP/catalog-flags" || return 13
  git -C "$ROOT" diff-files --name-only -z -- "$relative_dir" > "$DECISION_TMP/catalog-modified0" 2>/dev/null || return 13
  tr '\000' '\n' < "$DECISION_TMP/catalog-modified0" > "$DECISION_TMP/catalog-modified" || return 13
  if ! DECISION_SEP=$SEP STAGED_FILE="$DECISION_TMP/catalog-staged" FLAGS_FILE="$DECISION_TMP/catalog-flags" MODIFIED_FILE="$DECISION_TMP/catalog-modified" LC_ALL=C awk '
    FILENAME == ENVIRON["STAGED_FILE"] {
      tab = index($0, "\t"); if (!tab) next
      prefix = substr($0, 1, tab - 1); name = substr($0, tab + 1); sub(/^.*\//, "", name)
      split(prefix, fields, " "); if (fields[3] == "0") staged[name] = fields[2]
      next
    }
    FILENAME == ENVIRON["FLAGS_FILE"] {
      flag = substr($0, 1, 1); name = substr($0, 3); sub(/^.*\//, "", name)
      ordinary[name] = (flag == "H")
      next
    }
    FILENAME == ENVIRON["MODIFIED_FILE"] {name = $0; sub(/^.*\//, "", name); modified[name] = 1; next}
    {split($0, fields, ENVIRON["DECISION_SEP"]); name = fields[2]; current = ""; if (ordinary[name] && !modified[name] && name in staged) current = staged[name]; print $0 ENVIRON["DECISION_SEP"] current}
  ' "$DECISION_TMP/catalog-staged" "$DECISION_TMP/catalog-flags" "$DECISION_TMP/catalog-modified" "$CATALOG_ROWS" > "$DECISION_TMP/catalog-current"; then return 13; fi
  while IFS=$'\034' read -r fingerprint basename identifier title status date summary supersedes superseded_by revisit crc bytes link staged; do
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$fingerprint" "$basename" "$link" "$identifier" "$title" "$status" "$date" "$summary" "$supersedes" "$superseded_by" "$revisit" > "$DECISION_TMP/catalog-signature"
    signature=$(cksum < "$DECISION_TMP/catalog-signature") || return 12
    actual_crc=${signature%% *}; signature=${signature#* }; actual_bytes=${signature%% *}
    [[ "$actual_crc" == "$crc" && "$actual_bytes" == "$bytes" ]] || return 12
    [[ -n "$staged" && "$staged" == "$fingerprint" ]] || return 13
  done < "$DECISION_TMP/catalog-current"
  return 0
}

catalog_to_inventory() {
  local fingerprint basename identifier title status date summary supersedes superseded_by revisit crc bytes link
  : > "$INVENTORY"
  while IFS=$'\034' read -r fingerprint basename identifier title status date summary supersedes superseded_by revisit crc bytes link; do
    printf '%s\034%s\034%s\034%s\034%s\034%s\034%s\034%s\034%s\n' \
      "$identifier" "$title" "$status" "$date" "$summary" "$supersedes" "$superseded_by" "$revisit" "$ADR_DIR/$basename" >> "$INVENTORY"
  done < "$CATALOG_ROWS"
  LC_ALL=C sort "$INVENTORY" -o "$INVENTORY" || die "cannot sort ADR catalog inventory"
}

warn_catalog_fallback() {
  case "$1" in
    10) printf 'warning: ADR catalog is missing; using full scan: %s\n' "$CATALOG_PATH" >&2 ;;
    11) printf 'warning: ADR catalog is unreadable; using full scan: %s\n' "$CATALOG_PATH" >&2 ;;
    12) printf 'warning: ADR catalog is malformed; using full scan: %s\n' "$CATALOG_PATH" >&2 ;;
    *) printf 'warning: ADR catalog is stale; using full scan: %s\n' "$CATALOG_PATH" >&2 ;;
  esac
}

catalog_matches_inventory() {
  local expected="$DECISION_TMP/expected-catalog"
  write_catalog_file "$expected"
  cmp -s "$expected" "$CATALOG_PATH"
}

inventory_count() {
  DECISION_SEP=$SEP awk 'BEGIN {FS = ENVIRON["DECISION_SEP"]} $1 != "" {count++} END {print count + 0}' "$INVENTORY"
}

print_surfaces() {
  local path count found
  echo "specification-surfaces:"
  found=0
  for path in "$ROOT/docs/specs" "$ROOT/specs"; do
    if [[ -e "$path" ]]; then
      [[ -r "$path" ]] || die "canonical specification surface is not readable: $path"
      if [[ -d "$path" ]]; then
        if ! find "$path" -maxdepth 1 -type f -name '*.md' -print > "$DECISION_TMP/surface-files"; then
          die "cannot enumerate canonical specification surface: $path"
        fi
        if ! count=$(awk 'END {print NR + 0}' "$DECISION_TMP/surface-files"); then
          die "cannot summarize canonical specification surface: $path"
        fi
        printf '  - %s (%s Markdown files)\n' "$path" "$count"
      else
        printf '  - %s\n' "$path"
      fi
      found=1
    fi
  done
  [[ $found -eq 1 ]] || echo "  - (none detected)"

  echo "policy-surfaces:"
  found=0
  for path in "$ROOT/AGENTS.md" "$ROOT/CLAUDE.md" "$ROOT/CONTRIBUTING.md" "$ROOT/GOVERNANCE.md"; do
    if [[ -e "$path" || -L "$path" ]]; then
      [[ -r "$path" ]] || die "canonical policy surface is not readable: $path"
      printf '  - %s\n' "$path"
      found=1
    fi
  done
  [[ $found -eq 1 ]] || echo "  - (none detected)"
}

run_inspect() {
  local count
  if ! build_inventory; then cat "$ERRORS" >&2; exit 4; fi
  if ! count=$(inventory_count); then die "cannot count ADR inventory"; fi
  printf 'root: %s\n' "$ROOT"
  if [[ -n "$ADR_DIR" ]]; then
    printf 'adr-directory: %s\n' "$ADR_DIR"
  else
    echo "adr-directory: (none detected)"
  fi
  printf 'adr-records: %s\n' "$count"
  print_surfaces
}

run_validate() {
  local count
  if ! build_inventory; then cat "$ERRORS" >&2; exit 4; fi
  if ! count=$(inventory_count); then die "cannot count ADR inventory"; fi
  if [[ -n "$ADR_DIR" ]]; then
    if [[ $count -gt 0 && ! -e "$CATALOG_PATH" && ! -L "$CATALOG_PATH" ]]; then
      die "ADR catalog is missing: $CATALOG_PATH" 4
    fi
  fi
  if [[ -n "$ADR_DIR" ]] && [[ -e "$CATALOG_PATH" || -L "$CATALOG_PATH" ]]; then
    [[ ! -L "$CATALOG_PATH" && -f "$CATALOG_PATH" ]] || die "ADR catalog is malformed: $CATALOG_PATH" 4
    [[ -r "$CATALOG_PATH" ]] || die "ADR catalog is unreadable: $CATALOG_PATH" 4
    parse_catalog_rows "$CATALOG_PATH" || die "ADR catalog is malformed: $CATALOG_PATH" 4
    catalog_matches_inventory || die "ADR catalog is stale: $CATALOG_PATH" 4
  fi
  if [[ -n "$ADR_DIR" ]]; then
    printf 'valid: %s ADR(s) in %s\n' "$count" "$ADR_DIR"
  else
    echo "valid: 0 ADR(s); no ADR directory detected"
  fi
}

run_list() {
  local identifier title status date summary supersedes superseded_by revisit file matched shown relation_suffix grep_status catalog_status
  if [[ -n "$STATUS_FILTER" ]] && ! status_is_valid "$STATUS_FILTER"; then
    die "unsupported decision status: $STATUS_FILTER"
  fi
  if [[ -n "$RELATED_FILTER" && ! $RELATED_FILTER =~ ^ADR-[0-9][0-9][0-9][0-9][0-9]*$ ]]; then
    die "invalid related decision identifier: $RELATED_FILTER"
  fi
  [[ ${#RELATED_FILTER} -le 22 ]] || die "related decision identifier exceeds the 18-digit limit"
  [[ ${#SEARCH_FILTER} -le 200 ]] || die "--search must be at most 200 bytes"
  has_control_char "$SEARCH_FILTER" && die "--search contains unsupported control bytes"
  [[ $LIMIT =~ ^[0-9]+$ && $LIMIT -gt 0 && $LIMIT -le 200 ]] || die "--limit must be an integer from 1 to 200"
  if [[ -n "$ADR_DIR" ]]; then
    catalog_status=0
    catalog_is_fresh "$CATALOG_PATH" || catalog_status=$?
    if [[ $catalog_status -eq 0 && -z "$SEARCH_FILTER" ]]; then
      catalog_to_inventory
    else
      [[ $catalog_status -eq 0 ]] || warn_catalog_fallback "$catalog_status"
      if ! build_inventory; then cat "$ERRORS" >&2; exit 4; fi
    fi
  else
    if ! build_inventory; then cat "$ERRORS" >&2; exit 4; fi
  fi

  matched=0
  shown=0
  while IFS=$'\034' read -r identifier title status date summary supersedes superseded_by revisit file; do
    [[ -n "$identifier" ]] || continue
    if [[ -n "$STATUS_FILTER" && "$status" != "$STATUS_FILTER" ]]; then continue; fi
    if [[ -n "$RELATED_FILTER" ]] && ! relation_contains "$supersedes" "$RELATED_FILTER" && ! relation_contains "$superseded_by" "$RELATED_FILTER"; then
      continue
    fi
    if [[ -n "$SEARCH_FILTER" ]]; then
      grep_status=0
      LC_ALL=C grep -i -F -- "$SEARCH_FILTER" "$file" >/dev/null 2>&1 || grep_status=$?
      if [[ $grep_status -eq 1 ]]; then continue; fi
      [[ $grep_status -eq 0 ]] || die "cannot search ADR file: $file"
    fi
    matched=$((matched + 1))
    if [[ $shown -lt $LIMIT ]]; then
      relation_suffix=""
      [[ -z "$supersedes" ]] || relation_suffix="; supersedes: $supersedes"
      [[ -z "$superseded_by" ]] || relation_suffix="$relation_suffix; superseded by: $superseded_by"
      printf '%s %s architecture — %s — %s%s\n' "$identifier" "$status" "$title" "$file" "$relation_suffix"
      shown=$((shown + 1))
    fi
  done < "$INVENTORY"
  printf 'total: %s (status=%s, search=%s, related-to=%s)\n' "$matched" \
    "${STATUS_FILTER:-all}" "${SEARCH_FILTER:-(none)}" "${RELATED_FILTER:-(none)}"
  if [[ $matched -gt $LIMIT ]]; then
    printf 'note: showing first %s of %s matching ADRs\n' "$LIMIT" "$matched"
  fi
}

run_catalog_rebuild() {
  local count
  [[ -n "$ADR_DIR" ]] || die "no ADR directory detected; create or select one with --dir"
  if [[ -e "$CATALOG_PATH" || -L "$CATALOG_PATH" ]]; then
    [[ ! -L "$CATALOG_PATH" && -f "$CATALOG_PATH" ]] || die "ADR catalog is not a regular file: $CATALOG_PATH"
    [[ -r "$CATALOG_PATH" ]] || die "ADR catalog is not readable: $CATALOG_PATH"
    LC_ALL=C grep -F -x -- "<!-- $CATALOG_FORMAT -->" "$CATALOG_PATH" >/dev/null 2>&1 || \
      die "refusing to replace a README without the derived ADR catalog marker: $CATALOG_PATH" 4
  fi
  if ! build_inventory; then cat "$ERRORS" >&2; exit 4; fi
  CATALOG_WRITE_TMP=$(mktemp "$ADR_DIR/$CATALOG_NAME.tmp.XXXXXX") || die "cannot create an atomic ADR catalog in: $ADR_DIR"
  write_catalog_file "$CATALOG_WRITE_TMP"
  mv "$CATALOG_WRITE_TMP" "$CATALOG_PATH" || die "cannot replace ADR catalog: $CATALOG_PATH"
  CATALOG_WRITE_TMP=""
  count=$(inventory_count) || die "cannot count ADR inventory"
  printf 'catalog: %s\nrecords: %s\n' "$CATALOG_PATH" "$count"
}

run_catalog_check() {
  local count
  [[ -n "$ADR_DIR" ]] || die "no ADR directory detected; create or select one with --dir"
  [[ -e "$CATALOG_PATH" || -L "$CATALOG_PATH" ]] || die "ADR catalog is missing: $CATALOG_PATH" 4
  [[ ! -L "$CATALOG_PATH" && -f "$CATALOG_PATH" ]] || die "ADR catalog is malformed: $CATALOG_PATH" 4
  [[ -r "$CATALOG_PATH" ]] || die "ADR catalog is unreadable: $CATALOG_PATH" 4
  parse_catalog_rows "$CATALOG_PATH" || die "ADR catalog is malformed: $CATALOG_PATH" 4
  if ! build_inventory; then cat "$ERRORS" >&2; exit 4; fi
  catalog_matches_inventory || die "ADR catalog is stale: $CATALOG_PATH" 4
  count=$(inventory_count) || die "cannot count ADR inventory"
  printf 'fresh: %s\nrecords: %s\n' "$CATALOG_PATH" "$count"
}

slugify_title() {
  local value=$1 slug
  [[ ${#value} -le 200 ]] || die "--title must be at most 200 bytes"
  if ! slug=$(LC_ALL=C printf '%s' "$value" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//'); then
    die "cannot derive ADR filename from title"
  fi
  [[ -n "$slug" ]] || die "--title must contain an ASCII letter or digit"
  printf '%s' "$slug"
}

run_next_id() {
  local identifier title status date summary supersedes superseded_by revisit file digits number max next slug target
  [[ -n "$ADR_DIR" ]] || die "no ADR directory detected; create or select one with --dir"
  if ! build_inventory; then cat "$ERRORS" >&2; exit 4; fi
  max=0
  while IFS=$'\034' read -r identifier title status date summary supersedes superseded_by revisit file; do
    [[ -n "$identifier" ]] || continue
    digits=${identifier#ADR-}
    number=$((10#$digits))
    if [[ $number -gt $max ]]; then max=$number; fi
  done < "$INVENTORY"
  [[ $max -lt 999999999999999999 ]] || die "ADR identifier space is exhausted" 4
  next=$((max + 1))
  printf -v identifier 'ADR-%04d' "$next"
  printf 'id: %s\n' "$identifier"
  if [[ -n "$TITLE_ARG" ]]; then
    slug=$(slugify_title "$TITLE_ARG")
    target="$ADR_DIR/$identifier-$slug.md"
    [[ ! -e "$target" && ! -L "$target" ]] || die "next ADR path is already occupied: $target" 4
    printf 'path: %s\n' "$target"
  fi
}

COMMAND=${1:-}
[[ -n "$COMMAND" ]] || usage
shift

CATALOG_ACTION=""
if [[ "$COMMAND" == "catalog" ]]; then
  CATALOG_ACTION=${1:-}
  [[ "$CATALOG_ACTION" == "rebuild" || "$CATALOG_ACTION" == "check" ]] || usage
  shift
fi

if [[ "$COMMAND" == "check-transition" ]]; then
  FROM_STATUS=""
  TO_STATUS=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from) [[ $# -ge 2 ]] || usage; FROM_STATUS=$2; shift 2 ;;
      --to) [[ $# -ge 2 ]] || usage; TO_STATUS=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [[ -n "$FROM_STATUS" && -n "$TO_STATUS" ]] || usage
    has_control_char "$FROM_STATUS" && die "--from contains unsupported control bytes"
    has_control_char "$TO_STATUS" && die "--to contains unsupported control bytes"
  check_transition "$FROM_STATUS" "$TO_STATUS"
  exit 0
fi

case "$COMMAND" in inspect|list|next-id|validate|catalog|canonical-path) ;; *) usage ;; esac

REPO_ARG=.
DIR_ARG=""
STATUS_FILTER=""
SEARCH_FILTER=""
RELATED_FILTER=""
LIMIT=50
TITLE_ARG=""
PATH_ARG=""
DIR_SET=0
STATUS_SET=0
SEARCH_SET=0
RELATED_SET=0
LIMIT_SET=0
TITLE_SET=0
PATH_SET=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) [[ $# -ge 2 ]] || usage; REPO_ARG=$2; shift 2 ;;
    --dir) [[ $# -ge 2 ]] || usage; DIR_ARG=$2; DIR_SET=1; shift 2 ;;
    --status) [[ $# -ge 2 ]] || usage; STATUS_FILTER=$2; STATUS_SET=1; shift 2 ;;
    --search) [[ $# -ge 2 ]] || usage; SEARCH_FILTER=$2; SEARCH_SET=1; shift 2 ;;
    --related-to) [[ $# -ge 2 ]] || usage; RELATED_FILTER=$2; RELATED_SET=1; shift 2 ;;
    --limit) [[ $# -ge 2 ]] || usage; LIMIT=$2; LIMIT_SET=1; shift 2 ;;
    --title) [[ $# -ge 2 ]] || usage; TITLE_ARG=$2; TITLE_SET=1; shift 2 ;;
    --path) [[ $# -ge 2 ]] || usage; PATH_ARG=$2; PATH_SET=1; shift 2 ;;
    *) usage ;;
  esac
done

case "$COMMAND" in
  inspect|validate|catalog)
    [[ $STATUS_SET -eq 0 && $SEARCH_SET -eq 0 && $RELATED_SET -eq 0 && $LIMIT_SET -eq 0 && $TITLE_SET -eq 0 && $PATH_SET -eq 0 ]] || usage
    ;;
  list)
    [[ $TITLE_SET -eq 0 && $PATH_SET -eq 0 ]] || usage
    ;;
  next-id)
    [[ $STATUS_SET -eq 0 && $SEARCH_SET -eq 0 && $RELATED_SET -eq 0 && $LIMIT_SET -eq 0 && $PATH_SET -eq 0 ]] || usage
    ;;
  canonical-path)
    [[ $DIR_SET -eq 0 && $STATUS_SET -eq 0 && $SEARCH_SET -eq 0 && $RELATED_SET -eq 0 && $LIMIT_SET -eq 0 && $TITLE_SET -eq 0 && $PATH_SET -eq 1 ]] || usage
    ;;
esac

has_control_char "$REPO_ARG" && die "--repo contains unsupported control bytes"
has_control_char "$DIR_ARG" && die "--dir contains unsupported control bytes"
has_control_char "$STATUS_FILTER" && die "--status contains unsupported control bytes"
has_control_char "$SEARCH_FILTER" && die "--search contains unsupported control bytes"
has_control_char "$RELATED_FILTER" && die "--related-to contains unsupported control bytes"
has_control_char "$TITLE_ARG" && die "--title contains unsupported control bytes"
has_control_char "$PATH_ARG" && die "--path contains unsupported control bytes"
[[ ${#PATH_ARG} -le 1000 ]] || die "--path must be at most 1000 bytes"

ROOT=$(resolve_root "$REPO_ARG")
if [[ "$COMMAND" == "canonical-path" ]]; then
  run_canonical_path
  exit 0
fi
select_adr_directory
DECISION_TMP=$(mktemp -d "${TMPDIR:-/tmp}/darrow-decisions.XXXXXX")
CATALOG_WRITE_TMP=""
trap '[[ -z "$CATALOG_WRITE_TMP" ]] || rm -f "$CATALOG_WRITE_TMP"; rm -rf "$DECISION_TMP"' EXIT
SEP=$'\034'
INVENTORY="$DECISION_TMP/inventory"
ERRORS="$DECISION_TMP/errors"
CATALOG_PATH=""
[[ -z "$ADR_DIR" ]] || CATALOG_PATH="$ADR_DIR/$CATALOG_NAME"

case "$COMMAND" in
  inspect) run_inspect ;;
  list) run_list ;;
  next-id) run_next_id ;;
  validate) run_validate ;;
  catalog)
    case "$CATALOG_ACTION" in
      rebuild) run_catalog_rebuild ;;
      check) run_catalog_check ;;
    esac
    ;;
esac
