#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: ia-doctor inspect|verify [--runtime auto|both|codex|claude] [--mirror source=target]... [repository]" >&2
  exit 64
}

resolve_root() {
  local target=${1:-.} line worktrees
  if [[ ! -d "$target" || ! -r "$target" ]]; then
    echo "error: repository path is not a readable directory: $target" >&2
    exit 2
  fi
  worktrees=$(git -C "$target" worktree list --porcelain 2>/dev/null || :)
  line=$(awk 'NR==1 && $1=="worktree" {sub(/^worktree /, ""); print}' <<< "$worktrees")
  if [[ -n "$line" ]]; then
    printf '%s' "$line"
  else
    (cd "$target" && pwd -P)
  fi
}

relpath() {
  case "$1" in
    "$ROOT") printf '.' ;;
    "$ROOT"/*) printf '%s' "${1#"$ROOT"/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

abspath() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    .) printf '%s' "$ROOT" ;;
    *) printf '%s/%s' "$ROOT" "$1" ;;
  esac
}

inside_root() {
  case "$1" in "$ROOT"|"$ROOT"/*) return 0 ;; *) return 1 ;; esac
}

inventory_file() {
  if [[ -f "$1" || -L "$1" ]]; then printf '%s\n' "$1" >> "$FILES"; fi
}

add_file() {
  local file=$1
  inventory_file "$file"
  if [[ -L "$file" && ! -e "$file" ]]; then
    printf '%s\n' "$file (broken symlink)" >> "$UNREADABLE"
    return
  fi
  if [[ -L "$file" && ! -f "$file" ]]; then
    printf '%s\n' "$file (non-file symlink)" >> "$UNREADABLE"
    return
  fi
  if [[ -e "$file" && ! -r "$file" ]]; then
    printf '%s\n' "$file" >> "$UNREADABLE"
    return
  fi
}

extract_references() {
  LC_ALL=C awk '
    function emit(value, kind, origin) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if (value != "") print kind "\t" origin "\t" value
    }
    function fence_marker(line,    text,ch,n,i) {
      n=0
      while (n < length(line) && substr(line, n + 1, 1) == " ") n++
      if (n > 3) return ""
      text=substr(line, n + 1)
      ch=substr(text, 1, 1)
      if (ch != "`" && ch != "~") return ""
      n=0
      for (i=1; i<=length(text) && substr(text, i, 1)==ch; i++) n++
      return n >= 3 ? ch n : ""
    }
    function fence_closes(line, ch, need,    spaces,text,n,tail) {
      spaces=0
      while (spaces < length(line) && substr(line, spaces + 1, 1) == " ") spaces++
      if (spaces > 3) return 0
      text=substr(line, spaces + 1)
      n=0
      while (n < length(text) && substr(text, n + 1, 1) == ch) n++
      tail=substr(text, n + 1)
      return n >= need && tail ~ /^[[:space:]]*$/
    }
    {
      line=$0
      if (NR == 1 && substr(line, 1, 3) == sprintf("%c%c%c", 239, 187, 191)) line=substr(line, 4)
      marker=fence_marker(line)
      if (in_fence) {
        if (marker != "" && fence_closes(line, fence_ch, fence_n)) {in_fence=0; fence_ch=""; fence_n=0}
        next
      }
      if (marker != "") {
        fence_ch=substr(marker, 1, 1); fence_n=substr(marker, 2) + 0; in_fence=1
        next
      }
      lower=tolower(line)
      kind=(lower ~ /(^|[^a-z])(read|consult|load|follow)([^a-z]|$)/ || lower ~ /before .*(edit|chang|work)/ || line ~ /(^|[[:space:]])(->|→)([[:space:]]|$)/) ? "explicit" : "mention"
      rest=line
      while (match(rest, /\[[^][]*\]\([^()]*\)/)) {
        value=substr(rest, RSTART, RLENGTH)
        sub(/^.*\]\(/, "", value); sub(/\)$/, "", value)
        emit(value, kind, "ordinary")
        rest=substr(rest, RSTART + RLENGTH)
      }
      rest=line
      while (match(rest, /`[^`]+`/)) {
        value=substr(rest, RSTART + 1, RLENGTH - 2)
        emit(value, kind, "ordinary")
        rest=substr(rest, RSTART + RLENGTH)
      }
      rest=line
      gsub(/`[^`]*`/, "", rest)
      while (match(rest, /(^|[[:space:]])@[.A-Za-z0-9_\/-]+\.md/)) {
        value=substr(rest, RSTART, RLENGTH)
        sub(/^[[:space:]]*@/, "", value)
        emit(value, "explicit", "import")
        rest=substr(rest, RSTART + RLENGTH)
      }
    }
  ' "$1"
}

clean_reference() {
  local ref=$1
  ref=${ref#<}; ref=${ref%>}
  ref=${ref%%#*}
  case "$ref" in
    http://*|https://*|mailto:*|codex:*|file:*|'') return 1 ;;
    *' '*|*$'\t'*|*'<'*|*'>'*|*'$'*|*'{'*|*'}'*|*'*'*) return 1 ;;
  esac
  case "$ref" in
    */*.*|*.md) printf '%s' "${ref%/}" ;;
    *) return 1 ;;
  esac
}

canonical_existing() {
  local candidate=$1 dir base
  [[ -f "$candidate" ]] || return 1
  dir=$(dirname "$candidate")
  base=$(basename "$candidate")
  dir=$(cd "$dir" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s' "$dir" "$base"
}

resolve_reference() {
  local ref=$1 candidate resolved
  candidate="$ROOT/${ref#./}"
  if resolved=$(canonical_existing "$candidate"); then
    printf '%s' "$resolved"
    return
  fi
  return 1
}

resolve_source_relative() {
  local source=$1 ref=$2 candidate resolved
  case "$ref" in
    /*) candidate=$ref ;;
    *) candidate="$(dirname "$source")/$ref" ;;
  esac
  if resolved=$(canonical_existing "$candidate"); then
    printf '%s' "$resolved"
    return
  fi
  return 1
}

owning_skill() {
  local dir
  dir=$(dirname "$1")
  while inside_root "$dir"; do
    if [[ -f "$dir/SKILL.md" ]]; then printf '%s' "$dir"; return 0; fi
    [[ "$dir" != "$ROOT" ]] || break
    dir=$(dirname "$dir")
  done
  return 1
}

print_file_record() {
  local file=$1 bytes rel scope
  if [[ ! -f "$file" || ! -r "$file" ]]; then
    printf '  - %s | unreadable\n' "$file"
    return
  fi
  bytes=$(wc -c < "$file" | tr -d ' ')
  rel=$(relpath "$file")
  scope=referenced
  case "$rel" in
    AGENTS.md|AGENTS.override.md|CLAUDE.md|CLAUDE.local.md|.claude/CLAUDE.md) scope=root ;;
    */AGENTS.md|*/AGENTS.override.md|*/CLAUDE.md|*/CLAUDE.local.md) scope=nested ;;
    .claude/rules/*) scope=claude-native-rule ;;
    .agent-shared/rules/*|.agents/rules/*|.codex/rules/*|.pi/rules/*) scope=adapter-rule ;;
  esac
  printf '  - %s | scope=%s | bytes=%s | approx_tokens=%s\n' "$file" "$scope" "$bytes" "$(( (bytes + 3) / 4 ))"
}

is_route_reference() {
  case "$1" in
    .agent-shared/*|.claude/*|.agents/*|.codex/*|.pi/*|AGENTS.md|AGENTS.override.md|CLAUDE.md|CLAUDE.local.md|*/AGENTS.md|*/AGENTS.override.md|*/CLAUDE.md|*/CLAUDE.local.md) return 0 ;;
    *) return 1 ;;
  esac
}

print_line_findings() {
  local label=$1 file=$2 count=0 limit=40
  while IFS= read -r line; do
    count=$((count + 1))
    if [[ $count -le $limit ]]; then printf '  - %s | %s\n' "$label" "$line"; fi
  done < "$file"
  if [[ $count -gt $limit ]]; then printf '  - %s | ... %s additional findings omitted\n' "$label" "$((count - limit))"; fi
}

validate_mirror_spec() {
  local spec=$1 source target
  case "$spec" in *=*) ;; *) echo "error: mirror must be source=target: $spec" >&2; exit 64 ;; esac
  source=${spec%%=*}
  target=${spec#*=}
  case "$source:$target" in *:|:*|/*:*|*:/*|../*:*|*:../*|*/../*:*|*:*/../*)
    echo "error: mirror paths must stay inside the repository: $spec" >&2
    exit 64
    ;;
  esac
}

[[ ${1:-} == "inspect" || ${1:-} == "verify" ]] || usage
MODE=$1
shift
RUNTIME=auto
REPOSITORY=.
MIRROR_SPECS=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --runtime)
      [[ $# -ge 2 ]] || usage
      RUNTIME=$2
      shift 2
      ;;
    --runtime=*)
      RUNTIME=${1#*=}
      shift
      ;;
    --mirror)
      [[ $# -ge 2 ]] || usage
      MIRROR_SPECS="$MIRROR_SPECS${MIRROR_SPECS:+$'\n'}$2"
      shift 2
      ;;
    --mirror=*)
      MIRROR_SPECS="$MIRROR_SPECS${MIRROR_SPECS:+$'\n'}${1#*=}"
      shift
      ;;
    -*) usage ;;
    *)
      [[ "$REPOSITORY" == "." ]] || usage
      REPOSITORY=$1
      shift
      ;;
  esac
done
case "$RUNTIME" in auto|both|codex|claude) ;; *) usage ;; esac
ROOT=$(resolve_root "$REPOSITORY")
if [[ "$RUNTIME" == "auto" ]]; then
  has_codex=0
  has_claude=0
  [[ -f "$ROOT/AGENTS.md" || -f "$ROOT/AGENTS.override.md" ]] && has_codex=1
  [[ -f "$ROOT/CLAUDE.md" || -f "$ROOT/.claude/CLAUDE.md" ]] && has_claude=1
  if [[ $has_codex -eq 1 && $has_claude -eq 1 ]]; then RUNTIME=both
  elif [[ $has_claude -eq 1 ]]; then RUNTIME=claude
  else RUNTIME=codex
  fi
fi
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
FILES="$TMP/files"
ENTRYPOINTS="$TMP/entrypoints"
SEEDS="$TMP/seeds"
CODEX_SEEDS="$TMP/codex-seeds"
CLAUDE_SEEDS="$TMP/claude-seeds"
EDGES="$TMP/edges"
EXPLICIT_EDGES="$TMP/explicit-edges"
BROKEN="$TMP/broken"
UNREADABLE="$TMP/unreadable"
NONROOT="$TMP/nonroot"
MISSING_RUNTIME="$TMP/missing-runtime"
CYCLES="$TMP/cycles"
UNROUTED="$TMP/unrouted"
DUPLICATES="$TMP/duplicates"
: > "$FILES"; : > "$ENTRYPOINTS"; : > "$SEEDS"; : > "$CODEX_SEEDS"; : > "$CLAUDE_SEEDS"
: > "$EDGES"; : > "$EXPLICIT_EDGES"; : > "$BROKEN"; : > "$UNREADABLE"; : > "$NONROOT"
: > "$MISSING_RUNTIME"; : > "$CYCLES"; : > "$UNROUTED"; : > "$DUPLICATES"
ROOT_ADAPTER_STATUS=none
if [[ -e "$ROOT/AGENTS.md" && -L "$ROOT/CLAUDE.md" && "$ROOT/AGENTS.md" -ef "$ROOT/CLAUDE.md" ]]; then
  ROOT_ADAPTER_STATUS=symlink
fi

find "$ROOT" \( -type f -o -type l \) \
  \( -name 'AGENTS.md' -o -name 'AGENTS.override.md' -o -name 'CLAUDE.md' -o -name 'CLAUDE.local.md' \) \
  -not -path '*/.git/*' -not -path '*/node_modules/*' -not -path '*/.claude/worktrees/*' -not -path '*/.worktrees/*' -print 2>/dev/null |
  LC_ALL=C sort > "$ENTRYPOINTS"

while IFS= read -r file; do
  inventory_file "$file"
  rel=$(relpath "$file")
  case "$rel" in
    AGENTS.override.md)
      [[ -s "$file" ]] && printf '%s\n' "$file" >> "$CODEX_SEEDS"
      ;;
    AGENTS.md)
      [[ ! -s "$ROOT/AGENTS.override.md" ]] && printf '%s\n' "$file" >> "$CODEX_SEEDS"
      ;;
    CLAUDE.md|.claude/CLAUDE.md|CLAUDE.local.md|*/CLAUDE.md|*/CLAUDE.local.md)
      printf '%s\n' "$file" >> "$CLAUDE_SEEDS"
      ;;
  esac
done < "$ENTRYPOINTS"

if [[ "$RUNTIME" != "claude" && ! -s "$CODEX_SEEDS" ]]; then printf '%s\n' codex >> "$MISSING_RUNTIME"; fi
if [[ "$RUNTIME" != "codex" && ! -f "$ROOT/CLAUDE.md" && ! -f "$ROOT/.claude/CLAUDE.md" ]]; then
  printf '%s\n' claude >> "$MISSING_RUNTIME"
fi

for dir in .claude/rules .agent-shared/rules .agents/rules .codex/rules .pi/rules; do
  if [[ -d "$ROOT/$dir" ]]; then
    find "$ROOT/$dir" \( -type f -o -type l \) -name '*.md' -print 2>/dev/null |
      while IFS= read -r file; do inventory_file "$file"; done
  fi
done
if [[ -d "$ROOT/.claude/rules" ]]; then
  find "$ROOT/.claude/rules" \( -type f -o -type l \) -name '*.md' -print 2>/dev/null >> "$CLAUDE_SEEDS"
fi
LC_ALL=C sort -u "$FILES" -o "$FILES"
LC_ALL=C sort -u "$CODEX_SEEDS" -o "$CODEX_SEEDS"
LC_ALL=C sort -u "$CLAUDE_SEEDS" -o "$CLAUDE_SEEDS"
case "$RUNTIME" in
  codex) cp "$CODEX_SEEDS" "$SEEDS" ;;
  claude) cp "$CLAUDE_SEEDS" "$SEEDS" ;;
  both) cat "$CODEX_SEEDS" "$CLAUDE_SEEDS" | LC_ALL=C sort -u > "$SEEDS" ;;
esac
cp "$SEEDS" "$TMP/parse-files"
if [[ -n "$MIRROR_SPECS" ]]; then
  while IFS= read -r spec; do
    validate_mirror_spec "$spec"
    for dir in "${spec%%=*}" "${spec#*=}"; do
      if [[ -d "$ROOT/$dir" && -r "$ROOT/$dir" && -x "$ROOT/$dir" ]]; then
        find "$ROOT/$dir" \( -type f -o -type l \) -name '*.md' -print >> "$TMP/parse-files"
      fi
    done
  done <<< "$MIRROR_SPECS"
  LC_ALL=C sort -u "$TMP/parse-files" -o "$TMP/parse-files"
fi
: > "$TMP/parsed-files"

while [[ -s "$TMP/parse-files" ]]; do
  cp "$TMP/parse-files" "$TMP/pass-files"
  : > "$TMP/parse-files"
  while IFS= read -r source; do
    add_file "$source"
    [[ -f "$source" && -r "$source" ]] || continue
    skill_root=$(owning_skill "$source") || skill_root=""
    while IFS=$'\t' read -r kind origin raw; do
      ref=$(clean_reference "$raw") || continue
      source_rel=$(relpath "$source")
      target=""
      skip_broken=0
      broken_ref=$ref
      if [[ "$origin" == "import" ]]; then
        target=$(resolve_source_relative "$source" "$ref") || true
        case "$ref" in
          /*) broken_ref=$ref ;;
          *) broken_ref=$(relpath "$(dirname "$source")/$ref") ;;
        esac
        if [[ -n "$target" ]] && ! inside_root "$target"; then target=""; skip_broken=1; fi
      elif [[ -n "$skill_root" && "$ref" != /* ]]; then
        target=$(resolve_source_relative "$skill_root/SKILL.md" "$ref") || true
        broken_ref=$(relpath "$skill_root/$ref")
        if [[ -n "$target" ]] && ! inside_root "$target"; then target=""; fi
      else
        case "$ref" in
          /*)
            if [[ "$kind" == "explicit" ]]; then printf '%s\t%s\n' "$source_rel" "$ref" >> "$NONROOT"; fi
            target=$(canonical_existing "$ref") || true
            ;;
          *) target=$(resolve_reference "$ref") || true ;;
        esac
        if [[ -n "$target" ]] && ! inside_root "$target"; then target=""; fi
        if [[ -z "$target" ]] && relative_target=$(resolve_source_relative "$source" "$ref"); then
          if inside_root "$relative_target"; then
            if [[ "$kind" == "explicit" ]]; then printf '%s\t%s\n' "$source_rel" "$ref" >> "$NONROOT"; fi
            target=$relative_target
          fi
        fi
      fi
      if [[ -n "$target" ]]; then
        target_rel=$(relpath "$target")
        printf '%s\t%s\n' "$source_rel" "$target_rel" >> "$EDGES"
        inventory_file "$target"
        if [[ "$kind" == "explicit" ]]; then
          add_file "$target"
          printf '%s\t%s\n' "$source_rel" "$target_rel" >> "$EXPLICIT_EDGES"
          case "$target" in *.md) printf '%s\n' "$target" >> "$TMP/parse-files" ;; esac
        fi
      elif [[ $skip_broken -eq 0 ]]; then
        if [[ "$kind" == "explicit" ]] || is_route_reference "$ref"; then
          printf '%s\t%s\n' "$source_rel" "$broken_ref" >> "$BROKEN"
        fi
      fi
    done < <(extract_references "$source")
  done < "$TMP/pass-files"
  cat "$TMP/pass-files" >> "$TMP/parsed-files"
  LC_ALL=C sort -u "$TMP/parsed-files" -o "$TMP/parsed-files"
  LC_ALL=C sort -u "$TMP/parse-files" -o "$TMP/parse-files"
  LC_ALL=C comm -23 "$TMP/parse-files" "$TMP/parsed-files" > "$TMP/pending-files"
  mv "$TMP/pending-files" "$TMP/parse-files"
done
for records in "$FILES" "$EDGES" "$EXPLICIT_EDGES" "$BROKEN" "$NONROOT" "$UNREADABLE"; do
  LC_ALL=C sort -u "$records" -o "$records"
done

while IFS= read -r file; do relpath "$file"; echo; done < "$FILES" > "$TMP/relative-files"
while IFS= read -r file; do relpath "$file"; echo; done < "$SEEDS" > "$TMP/relative-seeds"
LC_ALL=C sort -u "$TMP/relative-files" -o "$TMP/relative-files"
LC_ALL=C sort -u "$TMP/relative-seeds" -o "$TMP/relative-seeds"

reachable_for_runtime() {
  local runtime=$1 seeds=$2 unreachable
  unreachable="$TMP/unreachable-$runtime"
  awk -F '\t' '
  FILENAME==ARGV[1] {seed[$0]=1; reach[$0]=1; node[$0]=1; next}
  FILENAME==ARGV[2] {node[$0]=1; next}
  {edge[$1 SUBSEP $2]=1; node[$1]=1; node[$2]=1}
  END {
    changed=1
    while (changed) {
      changed=0
      for (key in edge) {
        split(key, pair, SUBSEP)
        if (reach[pair[1]] && !reach[pair[2]]) {reach[pair[2]]=1; changed=1}
      }
    }
    for (n in node) if (!reach[n]) print n
  }
' "$seeds" "$TMP/relative-files" "$EXPLICIT_EDGES" | LC_ALL=C sort > "$unreachable"

  while IFS= read -r rel; do
    case "$runtime:$rel" in
      codex:.agent-shared/rules/*|codex:.agents/rules/*|codex:.codex/rules/*|codex:.pi/rules/*|codex:*/AGENTS.md|codex:*/AGENTS.override.md)
        printf '%s\t%s\n' "$runtime" "$rel" >> "$UNROUTED"
        ;;
      claude:.agent-shared/rules/*)
        printf '%s\t%s\n' "$runtime" "$rel" >> "$UNROUTED"
        ;;
    esac
  done < "$unreachable"
}

while IFS= read -r file; do relpath "$file"; echo; done < "$CODEX_SEEDS" | LC_ALL=C sort -u > "$TMP/relative-codex-seeds"
while IFS= read -r file; do relpath "$file"; echo; done < "$CLAUDE_SEEDS" | LC_ALL=C sort -u > "$TMP/relative-claude-seeds"
case "$RUNTIME" in
  codex) reachable_for_runtime codex "$TMP/relative-codex-seeds" ;;
  claude) reachable_for_runtime claude "$TMP/relative-claude-seeds" ;;
  both)
    reachable_for_runtime codex "$TMP/relative-codex-seeds"
    reachable_for_runtime claude "$TMP/relative-claude-seeds"
    ;;
esac
LC_ALL=C sort -u "$UNROUTED" -o "$UNROUTED"

awk -F '\t' '
  function dfs(n,    key,pair,t) {
    state[n]=1
    for (key in edge) {
      split(key, pair, SUBSEP)
      if (pair[1] != n) continue
      t=pair[2]
      if (state[t] == 1) print n " -> " t
      else if (!state[t]) dfs(t)
    }
    state[n]=2
  }
  {edge[$1 SUBSEP $2]=1; node[$1]=1; node[$2]=1}
  END {for (n in node) if (!state[n]) dfs(n)}
' "$EXPLICIT_EDGES" | LC_ALL=C sort -u > "$CYCLES"

while IFS= read -r file; do
  [[ -f "$file" && -r "$file" ]] || continue
  read -r checksum size _ < <(cksum "$file")
  printf '%s:%s\t%s\n' "$checksum" "$size" "$file"
done < "$FILES" |
  LC_ALL=C sort |
  awk -F '\t' '
    $1==last {if (!shown) {group=first; shown=1}; group=group " = " $2; next}
    last!="" && shown {print group}
    {last=$1; first=$2; shown=0; group=""}
    END {if (shown) print group}
  ' > "$DUPLICATES"

BUDGET=32768
if [[ "$RUNTIME" != "claude" && ( -e "$ROOT/.codex/config.toml" || -L "$ROOT/.codex/config.toml" ) ]]; then
  if [[ ! -f "$ROOT/.codex/config.toml" || ! -r "$ROOT/.codex/config.toml" ]]; then
    printf '%s\n' "$ROOT/.codex/config.toml" >> "$UNREADABLE"
  else
    add_file "$ROOT/.codex/config.toml"
  fi
fi
if [[ "$RUNTIME" != "claude" && -f "$ROOT/.codex/config.toml" && -r "$ROOT/.codex/config.toml" ]]; then
  configured=$(awk -F= '/^[[:space:]]*project_doc_max_bytes[[:space:]]*=/ {value=$2; sub(/[[:space:]]*#.*/, "", value); gsub(/[[:space:]]/, "", value); if (value ~ /^[0-9]+$/) {print value; exit}}' "$ROOT/.codex/config.toml")
  [[ -n "$configured" ]] && BUDGET=$configured
fi

CODEX_ROOT_BYTES=0
CLAUDE_ROOT_BYTES=0
BUDGET_FINDINGS="$TMP/budget"
ALWAYS_FINDINGS="$TMP/always"
DRIFT_FINDINGS="$TMP/drift"
: > "$BUDGET_FINDINGS"; : > "$ALWAYS_FINDINGS"; : > "$DRIFT_FINDINGS"
MIRROR_RECORDS="$TMP/mirror-records"
: > "$MIRROR_RECORDS"
while IFS= read -r file; do
  [[ -f "$file" && -r "$file" ]] || continue
  rel=$(relpath "$file")
  bytes=$(wc -c < "$file" | tr -d ' ')
  case "$rel" in
    AGENTS.md|AGENTS.override.md)
      if grep -Fqx "$file" "$CODEX_SEEDS"; then CODEX_ROOT_BYTES=$((CODEX_ROOT_BYTES + bytes)); fi
      if [[ "$RUNTIME" != "claude" ]] && grep -Fqx "$file" "$CODEX_SEEDS" && [[ $bytes -gt $BUDGET ]]; then printf '%s\t%s\t%s\n' "$file" "$bytes" "$BUDGET" >> "$BUDGET_FINDINGS"; fi
      ;;
    CLAUDE.md|.claude/CLAUDE.md|CLAUDE.local.md)
      if grep -Fqx "$file" "$CLAUDE_SEEDS"; then
        CLAUDE_ROOT_BYTES=$((CLAUDE_ROOT_BYTES + bytes))
      fi
      ;;
  esac
  case "$rel" in
    .claude/rules/*)
      if ! grep -Eq '^[[:space:]]*paths[[:space:]]*:' "$file" || grep -Eq 'paths:[[:space:]]*\[[^]]*"\*\*"|^[[:space:]]*-[[:space:]]*"\*\*"' "$file"; then
        printf '%s\n' "$file" >> "$ALWAYS_FINDINGS"
      fi
      ;;
  esac
done < "$FILES"

check_declared_mirror() {
  local spec=$1 source target source_abs target_abs status=aligned rel index
  validate_mirror_spec "$spec"
  source=${spec%%=*}
  target=${spec#*=}
  source_abs="$ROOT/$source"
  target_abs="$ROOT/$target"
  if [[ ! -d "$source_abs" || ! -r "$source_abs" || ! -x "$source_abs" || ! -d "$target_abs" || ! -r "$target_abs" || ! -x "$target_abs" ]]; then
    printf '%s -> %s | declared mirror source or target is unreadable, unsearchable, or missing\n' "$source_abs" "$target_abs" >> "$DRIFT_FINDINGS"
    printf '%s\t%s\tdrift\n' "$source_abs" "$target_abs" >> "$MIRROR_RECORDS"
    return
  fi
  index=$(wc -l < "$MIRROR_RECORDS" | tr -d ' ')
  if ! (cd "$source_abs" && find . ! -type d ! -name .DS_Store -print | LC_ALL=C sort) > "$TMP/mirror-source-$index" 2> "$TMP/mirror-source-error-$index"; then
    printf '%s -> %s | source traversal failed: %s\n' "$source_abs" "$target_abs" "$(sed -n '1p' "$TMP/mirror-source-error-$index")" >> "$DRIFT_FINDINGS"
    printf '%s\t%s\tdrift\n' "$source_abs" "$target_abs" >> "$MIRROR_RECORDS"
    return
  fi
  if ! (cd "$target_abs" && find . ! -type d ! -name .DS_Store -print | LC_ALL=C sort) > "$TMP/mirror-target-$index" 2> "$TMP/mirror-target-error-$index"; then
    printf '%s -> %s | target traversal failed: %s\n' "$source_abs" "$target_abs" "$(sed -n '1p' "$TMP/mirror-target-error-$index")" >> "$DRIFT_FINDINGS"
    printf '%s\t%s\tdrift\n' "$source_abs" "$target_abs" >> "$MIRROR_RECORDS"
    return
  fi
  if ! cmp -s "$TMP/mirror-source-$index" "$TMP/mirror-target-$index"; then
    status=drift
    printf '%s -> %s | file sets differ\n' "$source_abs" "$target_abs" >> "$DRIFT_FINDINGS"
  else
    while IFS= read -r rel; do
      if ! cmp -s "$source_abs/$rel" "$target_abs/$rel"; then
        status=drift
        printf '%s -> %s | content differs: %s\n' "$source_abs" "$target_abs" "${rel#./}" >> "$DRIFT_FINDINGS"
      fi
    done < "$TMP/mirror-source-$index"
  fi
  printf '%s\t%s\t%s\n' "$source_abs" "$target_abs" "$status" >> "$MIRROR_RECORDS"
  if [[ "$status" == "aligned" ]]; then
    SOURCE_PREFIX="$source_abs/" TARGET_PREFIX="$target_abs/" awk '
      index($0, ENVIRON["SOURCE_PREFIX"]) && index($0, ENVIRON["TARGET_PREFIX"]) {next}
      {print}
    ' "$DUPLICATES" > "$TMP/duplicates-filtered"
    mv "$TMP/duplicates-filtered" "$DUPLICATES"
  fi
}

if [[ -n "$MIRROR_SPECS" ]]; then
  while IFS= read -r spec; do [[ -n "$spec" ]] && check_declared_mirror "$spec"; done <<< "$MIRROR_SPECS"
fi
if [[ "$ROOT_ADAPTER_STATUS" == "symlink" ]]; then
  LEFT="$ROOT/AGENTS.md" RIGHT="$ROOT/CLAUDE.md" awk '$0 != ENVIRON["LEFT"] " = " ENVIRON["RIGHT"] && $0 != ENVIRON["RIGHT"] " = " ENVIRON["LEFT"]' "$DUPLICATES" > "$TMP/duplicates-filtered"
  mv "$TMP/duplicates-filtered" "$DUPLICATES"
fi

FILE_COUNT=$(wc -l < "$FILES" | tr -d ' ')
ENTRYPOINT_COUNT=$(wc -l < "$ENTRYPOINTS" | tr -d ' ')
EDGE_COUNT=$(wc -l < "$EXPLICIT_EDGES" | tr -d ' ')
BROKEN_COUNT=$(wc -l < "$BROKEN" | tr -d ' ')
NONROOT_COUNT=$(wc -l < "$NONROOT" | tr -d ' ')
MISSING_RUNTIME_COUNT=$(wc -l < "$MISSING_RUNTIME" | tr -d ' ')
CYCLE_COUNT=$(wc -l < "$CYCLES" | tr -d ' ')
UNROUTED_COUNT=$(wc -l < "$UNROUTED" | tr -d ' ')
DUPLICATE_COUNT=$(wc -l < "$DUPLICATES" | tr -d ' ')
UNREADABLE_COUNT=$(wc -l < "$UNREADABLE" | tr -d ' ')
DRIFT_COUNT=$(wc -l < "$DRIFT_FINDINGS" | tr -d ' ')
BUDGET_COUNT=$(wc -l < "$BUDGET_FINDINGS" | tr -d ' ')

echo "root: $ROOT"
printf 'summary: runtime=%s entrypoints=%s files=%s routes=%s broken=%s nonroot_paths=%s cycles=%s unrouted=%s missing_runtime=%s duplicate_files=%s unreadable=%s adapter_drift=%s codex_root_bytes=%s codex_root_approx_tokens=%s claude_root_bytes=%s claude_root_approx_tokens=%s\n' \
  "$RUNTIME" "$ENTRYPOINT_COUNT" "$FILE_COUNT" "$EDGE_COUNT" "$BROKEN_COUNT" "$NONROOT_COUNT" "$CYCLE_COUNT" "$UNROUTED_COUNT" "$MISSING_RUNTIME_COUNT" "$DUPLICATE_COUNT" "$UNREADABLE_COUNT" "$DRIFT_COUNT" "$CODEX_ROOT_BYTES" "$(( (CODEX_ROOT_BYTES + 3) / 4 ))" "$CLAUDE_ROOT_BYTES" "$(( (CLAUDE_ROOT_BYTES + 3) / 4 ))"
echo "entrypoints:"
entrypoint_number=0
while IFS= read -r file; do
  entrypoint_number=$((entrypoint_number + 1))
  if [[ $entrypoint_number -le 40 ]]; then print_file_record "$file"; fi
done < "$ENTRYPOINTS"
if [[ $entrypoint_number -gt 40 ]]; then printf '  - ... %s additional entrypoints omitted\n' "$((entrypoint_number - 40))"; fi
echo "adapter_mirrors:"
if [[ ! -s "$MIRROR_RECORDS" && "$ROOT_ADAPTER_STATUS" == "none" ]]; then
  echo "  - none detected"
fi
if [[ "$ROOT_ADAPTER_STATUS" != "none" ]]; then
  printf '  - %s -> %s | status=%s\n' "$ROOT/AGENTS.md" "$ROOT/CLAUDE.md" "$ROOT_ADAPTER_STATUS"
fi
while IFS=$'\t' read -r source target status; do printf '  - %s -> %s | status=%s | declared=true\n' "$source" "$target" "$status"; done < "$MIRROR_RECORDS"

echo "findings:"
if [[ $MISSING_RUNTIME_COUNT -eq 0 && $BROKEN_COUNT -eq 0 && $NONROOT_COUNT -eq 0 && $CYCLE_COUNT -eq 0 && $UNROUTED_COUNT -eq 0 && $DUPLICATE_COUNT -eq 0 && $UNREADABLE_COUNT -eq 0 && $DRIFT_COUNT -eq 0 && $BUDGET_COUNT -eq 0 && ! -s "$ALWAYS_FINDINGS" ]]; then
  echo "  - none"
fi
while IFS= read -r runtime; do printf '  - critical missing-entrypoint | runtime=%s\n' "$runtime"; done < "$MISSING_RUNTIME"
broken_number=0
while IFS=$'\t' read -r source target; do
  broken_number=$((broken_number + 1))
  if [[ $broken_number -le 40 ]]; then printf '  - critical broken-reference | %s -> %s\n' "$(abspath "$source")" "$(abspath "$target")"; fi
done < "$BROKEN"
if [[ $broken_number -gt 40 ]]; then printf '  - critical broken-reference | ... %s additional findings omitted\n' "$((broken_number - 40))"; fi
nonroot_number=0
while IFS=$'\t' read -r source target; do
  nonroot_number=$((nonroot_number + 1))
  if [[ $nonroot_number -le 40 ]]; then printf '  - critical nonroot-path | %s -> %s | expected session-root-relative path\n' "$(abspath "$source")" "$(abspath "$target")"; fi
done < "$NONROOT"
if [[ $nonroot_number -gt 40 ]]; then printf '  - critical nonroot-path | ... %s additional findings omitted\n' "$((nonroot_number - 40))"; fi
while IFS= read -r cycle; do
  source=${cycle%% -> *}
  target=${cycle#* -> }
  printf '  - critical instruction-cycle | %s -> %s\n' "$(abspath "$source")" "$(abspath "$target")"
done < "$CYCLES"
unrouted_number=0
while IFS=$'\t' read -r runtime path; do
  unrouted_number=$((unrouted_number + 1))
  if [[ $unrouted_number -le 40 ]]; then printf '  - critical unrouted-guidance | runtime=%s | %s\n' "$runtime" "$(abspath "$path")"; fi
done < "$UNROUTED"
if [[ $unrouted_number -gt 40 ]]; then printf '  - critical unrouted-guidance | ... %s additional findings omitted\n' "$((unrouted_number - 40))"; fi
print_line_findings "critical unreadable-guidance" "$UNREADABLE"
while IFS=$'\t' read -r file bytes limit; do printf '  - critical root-budget | %s bytes=%s limit=%s\n' "$file" "$bytes" "$limit"; done < "$BUDGET_FINDINGS"
print_line_findings "critical adapter-drift" "$DRIFT_FINDINGS"
print_line_findings "advisory always-loaded-rule" "$ALWAYS_FINDINGS"
print_line_findings "advisory duplicate-content" "$DUPLICATES"

echo "routes:"
if [[ $EDGE_COUNT -eq 0 ]]; then echo "  - none"; fi
route_number=0
while IFS=$'\t' read -r source target; do
  route_number=$((route_number + 1))
  if [[ $route_number -le 120 ]]; then printf '  - %s -> %s\n' "$(abspath "$source")" "$(abspath "$target")"; fi
done < "$EXPLICIT_EDGES"
if [[ $route_number -gt 120 ]]; then printf '  - ... %s additional routes omitted\n' "$((route_number - 120))"; fi

if [[ "$MODE" == "verify" && $(( MISSING_RUNTIME_COUNT + BROKEN_COUNT + NONROOT_COUNT + CYCLE_COUNT + UNROUTED_COUNT + UNREADABLE_COUNT + DRIFT_COUNT + BUDGET_COUNT )) -ne 0 ]]; then
  exit 1
fi
