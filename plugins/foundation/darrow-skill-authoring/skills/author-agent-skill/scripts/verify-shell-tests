#!/usr/bin/env bash
set -u

TAB=$(printf '\t')

fail() {
  printf 'verify-shell-tests: %s\n' "$2" >&2
  exit "$1"
}

usage() {
  printf '%s\n' \
    'usage: verify-shell-tests [--shell <executable>]... -- <test-script>...' >&2
  exit 2
}

canonical_file() {
  local input=$1 parent name
  case "$input" in
    */*)
      parent=${input%/*}
      name=${input##*/}
      [ -n "$parent" ] || parent=/
      ;;
    *)
      parent=.
      name=$input
      ;;
  esac
  parent=$(cd "$parent" 2>/dev/null && pwd -P) || return 1
  case "$parent" in
    /) printf '/%s\n' "$name" ;;
    *) printf '%s/%s\n' "$parent" "$name" ;;
  esac
}

resolve_interpreter() {
  local requested=$1 resolved
  case "$requested" in
    */*) resolved=$requested ;;
    *) resolved=$(command -v "$requested" 2>/dev/null) || return 1 ;;
  esac
  [ -x "$resolved" ] || return 1
  canonical_file "$resolved"
}

CANDIDATES=()
explicit_candidates=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --shell)
      [ "$#" -ge 2 ] || usage
      CANDIDATES[${#CANDIDATES[@]}]=$2
      explicit_candidates=:
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*) usage ;;
    *) break ;;
  esac
done

[ "$#" -gt 0 ] || usage

if ! $explicit_candidates; then
  CANDIDATES[${#CANDIDATES[@]}]=/bin/bash
  CANDIDATES[${#CANDIDATES[@]}]=bash
  CANDIDATES[${#CANDIDATES[@]}]=bash5
  CANDIDATES[${#CANDIDATES[@]}]=/opt/homebrew/bin/bash
  CANDIDATES[${#CANDIDATES[@]}]=/usr/local/bin/bash
fi

TESTS=()
for test_input in "$@"; do
  [ -f "$test_input" ] && [ -r "$test_input" ] ||
    fail 2 "test script is not a readable regular file: $test_input"
  test_file=$(canonical_file "$test_input") ||
    fail 2 "cannot resolve test script: $test_input"
  TESTS[${#TESTS[@]}]=$test_file
done

bash_3_2=
bash_3_2_version=
bash_5=
bash_5_version=

for candidate in "${CANDIDATES[@]}"; do
  if ! interpreter=$(resolve_interpreter "$candidate"); then
    if $explicit_candidates; then
      fail 2 "shell is not executable: $candidate"
    fi
    continue
  fi

  if ! version_record=$("$interpreter" -c "printf '%s\\t%s\\t%s\\n' \"\${BASH_VERSINFO[0]}\" \"\${BASH_VERSINFO[1]}\" \"\$BASH_VERSION\"" 2>/dev/null); then
    if $explicit_candidates; then
      fail 2 "cannot read Bash version: $interpreter"
    fi
    continue
  fi
  IFS="$TAB" read -r major minor version <<EOF
$version_record
EOF

  case "$major:$minor" in
    3:2)
      if [ -z "$bash_3_2" ]; then
        bash_3_2=$interpreter
        bash_3_2_version=$version
      fi
      ;;
    5:*)
      if [ -z "$bash_5" ]; then
        bash_5=$interpreter
        bash_5_version=$version
      fi
      ;;
    *)
      if $explicit_candidates; then
        fail 2 "unsupported Bash version $version: $interpreter"
      fi
      ;;
  esac
done

printf 'format%sdarrow-shell-test-matrix-v1\n' "$TAB"
for test_file in "${TESTS[@]}"; do
  printf 'test_script%s%s\n' "$TAB" "$test_file"
done

failures=0
missing=0

run_target() {
  local label=$1 interpreter=$2 version=$3 test_file test_status
  printf 'interpreter%s%s%savailable%s%s%s%s\n' \
    "$TAB" "$label" "$TAB" "$TAB" "$interpreter" "$TAB" "$version"
  for test_file in "${TESTS[@]}"; do
    "$interpreter" "$test_file" >/dev/null 2>&1
    test_status=$?
    if [ "$test_status" -eq 0 ]; then
      printf 'test_result%s%s%s%s%spassed\n' \
        "$TAB" "$label" "$TAB" "$test_file" "$TAB"
    else
      printf 'test_result%s%s%s%s%sfailed%sexit=%s\n' \
        "$TAB" "$label" "$TAB" "$test_file" "$TAB" "$TAB" "$test_status"
      failures=$((failures + 1))
    fi
  done
}

if [ -n "$bash_3_2" ]; then
  run_target bash-3.2 "$bash_3_2" "$bash_3_2_version"
else
  printf 'interpreter%sbash-3.2%sunavailable\n' "$TAB" "$TAB"
  missing=$((missing + 1))
fi

if [ -n "$bash_5" ]; then
  run_target bash-5 "$bash_5" "$bash_5_version"
else
  printf 'interpreter%sbash-5%sunavailable\n' "$TAB" "$TAB"
  missing=$((missing + 1))
fi

if [ "$failures" -ne 0 ]; then
  printf 'matrix_status%sfailed\n' "$TAB"
  exit 1
fi
if [ "$missing" -ne 0 ]; then
  printf 'matrix_status%sunverified\n' "$TAB"
  exit 3
fi

printf 'matrix_status%scomplete\n' "$TAB"
