#!/usr/bin/env bash
set -u

program=${0##*/}

usage() {
  printf 'usage: %s codex [--config PATH] [--backend v1|v2|unknown] [--context effective|isolated-eval]\n' "$program" >&2
  printf '       %s claude [--version VERSION]\n' "$program" >&2
  exit 2
}

absolute_path() {
  target=$1
  case "$target" in
    /*) ;;
    *) target=$PWD/$target ;;
  esac
  target_dir=${target%/*}
  target_base=${target##*/}
  canonical_dir=$(CDPATH='' cd -- "$target_dir" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s\n' "$canonical_dir" "$target_base"
}

version_at_least() {
  actual=$1
  required=$2
  awk -v actual="$actual" -v required="$required" 'BEGIN {
    split(actual, a, "."); split(required, r, ".")
    for (i = 1; i <= 3; i++) {
      av = a[i] + 0; rv = r[i] + 0
      if (av > rv) exit 0
      if (av < rv) exit 1
    }
    exit 0
  }'
}

positive_integer() {
  case "$1" in
    ''|*[!0-9]*|0) return 1 ;;
    *) return 0 ;;
  esac
}

emit_topology() {
  printf '%s\n' 'topology: primary -> owner -> verification coordinator -> review coordinator -> parallel Standards/Spec readers'
  printf '%s\n' 'required_spawned_slots: baseline=1 full=5 (primary excluded)'
  printf '%s\n' 'required_nesting_layers: baseline=1 full=4'
}

doctor_codex() {
  config=
  backend=unknown
  context=effective
  while test "$#" -gt 0; do
    case "$1" in
      --config) test "$#" -ge 2 || usage; config=$2; shift 2 ;;
      --backend) test "$#" -ge 2 || usage; backend=$2; shift 2 ;;
      --context) test "$#" -ge 2 || usage; context=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  case "$backend" in v1|v2|unknown) ;; *) usage ;; esac
  case "$context" in effective|isolated-eval) ;; *) usage ;; esac

  if test -z "$config"; then
    if test -n "${CODEX_HOME:-}"; then
      config=${CODEX_HOME}/config.toml
    else
      test -n "${HOME:-}" || { printf '%s\n' 'status: unavailable' 'reason: HOME and CODEX_HOME are unset' >&2; exit 1; }
      config=${HOME}/.codex/config.toml
    fi
  fi
  source_path=$(absolute_path "$config") || {
    printf '%s\n' 'status: unavailable' 'reason: configuration parent directory cannot be resolved' >&2
    exit 1
  }

  printf '%s\n' 'format: darrow-adaptive-delivery-host-doctor-v1'
  printf '%s\n' 'host: codex'
  printf 'configuration_source: %s\n' "$source_path"
  printf 'configuration_context: %s\n' "$context"
  printf '%s\n' 'checkout_config_used: no'
  printf 'backend: %s\n' "$backend"
  printf '%s\n' 'concurrency_control: agents.max_concurrent_threads_per_session'
  printf '%s\n' 'nesting_control: agents.max_depth (V1 only; ignored by V2)'
  emit_topology

  if test ! -e "$source_path"; then
    printf '%s\n' 'status: absent'
    printf '%s\n' 'delegation: enabled-by-default'
    printf '%s\n' 'concurrency: unknown (host default is not a configured value)'
    if test "$backend" = v2; then
      printf '%s\n' 'nesting: not-applicable (agents.max_depth is V1-only and ignored by V2)'
    else
      printf '%s\n' 'nesting: unknown'
    fi
    printf '%s\n' 'baseline_owner_only: unknown' 'full_required_assessment: unknown'
    printf 'guidance: create %s with [agents], enabled = true, and max_concurrent_threads_per_session = 5 or greater\n' "$source_path"
    return 0
  fi
  if test ! -f "$source_path" || test ! -r "$source_path"; then
    printf '%s\n' 'status: unreadable' 'reason: effective configuration is not a readable regular file' >&2
    exit 1
  fi

  parsed=$(awk '
    function trim(v) { sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v); return v }
    function scan_array(v, i, c, quoted, escaped) {
      quoted=""; escaped=0
      for (i=1; i<=length(v); i++) {
        c=substr(v, i, 1)
        if (quoted == "double") {
          if (escaped) escaped=0
          else if (c == "\\") escaped=1
          else if (c == "\"") quoted=""
        } else if (quoted == "single") {
          if (c == "\047") quoted=""
        } else if (c == "\"") quoted="double"
        else if (c == "\047") quoted="single"
        else if (c == "[") array_depth++
        else if (c == "]") array_depth--
      }
    }
    function begin_continuation(v, rest) {
      if (v ~ /^\[/) {
        array_depth=0
        scan_array(v)
        if (array_depth > 0) continuation="array"
        else if (array_depth < 0) bad=1
      }
      else if (substr(v, 1, 3) == "\"\"\"") {
        rest=substr(v, 4); if (index(rest, "\"\"\"") == 0) continuation="basic"
      } else if (substr(v, 1, 3) == "\047\047\047") {
        rest=substr(v, 4); if (index(rest, "\047\047\047") == 0) continuation="literal"
      }
    }
    BEGIN { section=""; continuation=""; enabled="unset"; concurrency="unset"; depth="unset"; bad=0 }
    {
      line=$0
      sub(/[ \t]*#.*/, "", line)
      line=trim(line)
      if (line == "") next
      if (continuation == "array") {
        scan_array(line)
        if (array_depth == 0) continuation=""
        else if (array_depth < 0) { continuation=""; bad=1 }
        next
      }
      if (continuation == "basic") { if (index(line, "\"\"\"") != 0) continuation=""; next }
      if (continuation == "literal") { if (index(line, "\047\047\047") != 0) continuation=""; next }
      if (line ~ /^\[/) {
        if (line !~ /\]$/) { bad=1; next }
        if (line == "[agents]") section="agents"
        else section="other"
        next
      }
      eq=index(line, "=")
      if (!eq) { bad=1; next }
      key=trim(substr(line, 1, eq-1)); value=trim(substr(line, eq+1))
      if (key == "" || key ~ /[{}:]/) { bad=1; next }
      begin_continuation(value)
      if (section != "agents") next
      if (key == "enabled") {
        if (enabled != "unset" || (value != "true" && value != "false")) bad=1
        else enabled=value
      } else if (key == "max_concurrent_threads_per_session") {
        if (concurrency != "unset" || value !~ /^[1-9][0-9]*$/) bad=1
        else concurrency=value
      } else if (key == "max_depth") {
        if (depth != "unset" || value !~ /^-?[0-9]+$/) bad=1
        else depth=value
      }
    }
    END { printf "bad=%d\nenabled=%s\nconcurrency=%s\ndepth=%s\n", bad, enabled, concurrency, depth }
  ' "$source_path") || {
    printf '%s\n' 'status: unreadable' 'reason: failed while reading effective configuration' >&2
    exit 1
  }
  bad=$(printf '%s\n' "$parsed" | awk -F= '$1=="bad" {print $2}')
  enabled=$(printf '%s\n' "$parsed" | awk -F= '$1=="enabled" {print $2}')
  concurrency=$(printf '%s\n' "$parsed" | awk -F= '$1=="concurrency" {print $2}')
  depth=$(printf '%s\n' "$parsed" | awk -F= '$1=="depth" {print $2}')
  if test "$bad" != 0; then
    printf '%s\n' 'status: malformed' 'reason: invalid or duplicate Adaptive Delivery agent setting' >&2
    exit 1
  fi

  printf '%s\n' 'status: valid'
  if test "$enabled" = false; then
    printf '%s\n' 'delegation: disabled'
  elif test "$enabled" = true; then
    printf '%s\n' 'delegation: enabled'
  else
    printf '%s\n' 'delegation: enabled-by-default'
  fi
  if test "$concurrency" = unset; then
    printf '%s\n' 'concurrency: unknown (host default is not a configured value)'
  elif test "$concurrency" -ge 5; then
    printf 'concurrency: adequate (%s; full path requires 5)\n' "$concurrency"
  else
    printf 'concurrency: inadequate (%s; baseline requires 1, full path requires 5)\n' "$concurrency"
  fi
  if test "$backend" = v2; then
    if test "$depth" = unset; then depth_label='unset'; else depth_label=$depth; fi
    printf 'nesting: not-applicable (agents.max_depth=%s is V1-only and ignored by V2)\n' "$depth_label"
  elif test "$backend" = v1; then
    if test "$depth" = unset; then
      printf '%s\n' 'nesting: unknown (agents.max_depth is unset)'
    elif test "$depth" -ge 4; then
      printf 'nesting: adequate (%s; full path requires 4)\n' "$depth"
    else
      printf 'nesting: inadequate (%s; baseline requires 1, full path requires 4)\n' "$depth"
    fi
  else
    printf '%s\n' 'nesting: unknown (backend was not established; max_depth applies only to V1)'
  fi

  if test "$enabled" = false; then
    printf '%s\n' 'baseline_owner_only: unsupported' 'full_required_assessment: unsupported'
    printf 'guidance: set agents.enabled = true in %s\n' "$source_path"
  else
    if test "$concurrency" = unset; then
      baseline=unknown; full=unknown
    elif test "$concurrency" -ge 5; then
      baseline=supported; full=supported
    else
      baseline=supported; full=unsupported
    fi
    if test "$backend" = v1; then
      if test "$depth" = unset; then
        baseline=unknown; full=unknown
      elif test "$depth" -lt 1; then
        baseline=unsupported; full=unsupported
      elif test "$depth" -lt 4; then
        full=unsupported
      fi
    elif test "$backend" = unknown; then
      baseline=unknown
      full=unknown
    fi
    printf 'baseline_owner_only: %s\n' "$baseline"
    printf 'full_required_assessment: %s\n' "$full"
    if test "$full" != supported; then
      printf 'guidance: set agents.max_concurrent_threads_per_session = 5 or greater in %s; for V1 also set agents.max_depth = 4 or greater\n' "$source_path"
    else
      printf '%s\n' 'guidance: no Adaptive Delivery capacity change is required'
    fi
  fi
}

doctor_claude() {
  version=
  while test "$#" -gt 0; do
    case "$1" in
      --version) test "$#" -ge 2 || usage; version=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  if test -z "$version" && command -v claude >/dev/null 2>&1; then
    version_output=$(claude --version 2>/dev/null || :)
    version=$(printf '%s\n' "$version_output" | awk 'match($0, /[0-9]+\.[0-9]+\.[0-9]+/) { print substr($0, RSTART, RLENGTH); exit }')
  fi
  case "$version" in ''|*[!0-9.]*) version=unknown ;; esac
  concurrency=${CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS-}
  depth=${CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH-}

  printf '%s\n' 'format: darrow-adaptive-delivery-host-doctor-v1' 'host: claude'
  printf '%s\n' 'configuration_source: process-environment'
  printf 'host_version: %s\n' "$version"
  printf '%s\n' 'concurrency_control: CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS'
  printf '%s\n' 'nesting_control: CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH'
  emit_topology
  if test "$version" = unknown; then
    printf '%s\n' 'status: version-unknown'
    printf '%s\n' 'concurrency_control_applicability: unknown (installed version not established)'
    printf '%s\n' 'nesting_control_applicability: unknown (installed version not established)'
    printf '%s\n' 'concurrency: unknown (installed version applicability was not established)'
    printf '%s\n' 'nesting: unknown (installed version applicability was not established)'
    printf '%s\n' 'baseline_owner_only: unknown' 'full_required_assessment: unknown'
    printf '%s\n' 'guidance: provide the installed Claude Code version before changing either control'
    return 0
  fi

  if version_at_least "$version" 2.1.217; then
    printf '%s\n' 'concurrency_control_applicability: supported (Claude Code 2.1.217 or later)'
    printf '%s\n' 'nesting_control_applicability: supported (Claude Code 2.1.217 or later)'
    if test -n "$concurrency" && ! positive_integer "$concurrency"; then
      printf '%s\n' 'status: malformed' 'reason: CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS must be a positive whole number' >&2
      exit 1
    fi
    if test -n "$depth" && ! positive_integer "$depth"; then
      printf '%s\n' 'status: malformed' 'reason: CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH must be a positive whole number' >&2
      exit 1
    fi
    effective_concurrency=${concurrency:-20}
    if test "$effective_concurrency" -ge 5; then
      printf 'concurrency: adequate (%s; full path requires 5)\n' "$effective_concurrency"
      concurrency_ok=yes
    else
      printf 'concurrency: inadequate (%s; baseline requires 1, full path requires 5)\n' "$effective_concurrency"
      concurrency_ok=no
    fi
  else
    printf '%s\n' 'concurrency_control_applicability: unsupported (requires Claude Code 2.1.217 or later)'
    printf '%s\n' 'nesting_control_applicability: fixed host behavior (environment control requires Claude Code 2.1.217 or later)'
    printf '%s\n' 'concurrency: not-applicable (control requires Claude Code 2.1.217 or later)'
    concurrency_ok=unknown
  fi

  if version_at_least "$version" 2.1.219; then
    effective_depth=${depth:-3}
    if test "$effective_depth" -ge 4; then
      printf 'nesting: adequate (%s; full path requires 4)\n' "$effective_depth"
      depth_ok=yes
    else
      printf 'nesting: inadequate (%s; baseline requires 1, full path requires 4)\n' "$effective_depth"
      depth_ok=no
    fi
  elif version_at_least "$version" 2.1.217; then
    effective_depth=${depth:-1}
    if test "$effective_depth" -ge 4; then
      printf 'nesting: adequate (%s; full path requires 4)\n' "$effective_depth"
      depth_ok=yes
    else
      printf 'nesting: inadequate (%s; baseline requires 1, full path requires 4)\n' "$effective_depth"
      depth_ok=no
    fi
  elif version_at_least "$version" 2.1.172; then
    printf '%s\n' 'nesting: adequate (host default 5; control not supported by this version)'
    depth_ok=yes
  else
    printf '%s\n' 'nesting: unknown (version predates documented nesting behavior)'
    depth_ok=unknown
  fi

  printf '%s\n' 'status: valid'
  if test "$concurrency_ok" = unknown; then baseline=unknown; else baseline=supported; fi
  if test "$concurrency_ok" = yes && test "$depth_ok" = yes; then full=supported
  elif test "$concurrency_ok" = no || test "$depth_ok" = no; then full=unsupported
  else full=unknown
  fi
  printf 'baseline_owner_only: %s\n' "$baseline"
  printf 'full_required_assessment: %s\n' "$full"
  if test "$full" = supported; then
    printf '%s\n' 'guidance: no Adaptive Delivery capacity change is required'
  elif version_at_least "$version" 2.1.217; then
    printf '%s\n' 'guidance: set CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS=5 and CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH=4 in the effective Claude Code environment, then start a new session'
  else
    printf '%s\n' 'guidance: upgrade Claude Code to a version with documented concurrency control before relying on the full path'
  fi
}

test "$#" -gt 0 || usage
host=$1
shift
case "$host" in
  codex) doctor_codex "$@" ;;
  claude) doctor_claude "$@" ;;
  *) usage ;;
esac
