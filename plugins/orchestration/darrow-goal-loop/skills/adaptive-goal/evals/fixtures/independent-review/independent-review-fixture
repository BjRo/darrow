#!/usr/bin/env bash
# Deterministic intent-matched review capability used only by adaptive-goal evals.
set -u

repo=${1:-}
mode=${2:-review}
[ -n "$repo" ] || { printf '%s\n' 'repository path is required' >&2; exit 2; }
case $mode in
  review | fingerprint) ;;
  *) printf '%s\n' 'usage: independent-review-fixture REPOSITORY [fingerprint]' >&2; exit 2 ;;
esac
root=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) || exit 2
root=$(cd "$root" && pwd -P) || exit 2
git_dir=$(git -C "$root" rev-parse --absolute-git-dir 2>/dev/null) || exit 2
packet_file=$(mktemp "$git_dir/independent-review-fixture.XXXXXX") || exit 2
changed_file=$(mktemp "$git_dir/independent-review-changed.XXXXXX") || exit 2
untracked_file=$(mktemp "$git_dir/independent-review-untracked.XXXXXX") || exit 2
end_packet_file=$(mktemp "$git_dir/independent-review-end-fixture.XXXXXX") || exit 2
end_changed_file=$(mktemp "$git_dir/independent-review-end-changed.XXXXXX") || exit 2
end_untracked_file=$(mktemp "$git_dir/independent-review-end-untracked.XXXXXX") || exit 2
trap 'rm -f "$packet_file" "$changed_file" "$untracked_file" "$end_packet_file" "$end_changed_file" "$end_untracked_file"' EXIT

capture_worktree() {
  capture_packet=$1
  capture_changed=$2
  capture_untracked=$3
  : >"$capture_packet" || return 1
  : >"$capture_changed" || return 1
  : >"$capture_untracked" || return 1
  git -C "$root" diff --binary --full-index HEAD -- >"$capture_packet" || return 1
  git -C "$root" diff --name-only -z HEAD -- >"$capture_changed" || return 1
  git -C "$root" ls-files --others --exclude-standard -z >"$capture_untracked" ||
    return 1
  while IFS= read -r -d '' path; do
    oid=$(git -C "$root" hash-object -- "$path" 2>/dev/null) || return 1
    printf 'untracked_path\0%s\0untracked_oid\0%s\0' "$path" "$oid" >>"$capture_packet"
    cat "$root/$path" >>"$capture_packet" || return 1
    printf '\0' >>"$capture_packet"
    printf '%s\0' "$path" >>"$capture_changed"
  done <"$capture_untracked"
  capture_base=$(git -C "$root" rev-parse HEAD 2>/dev/null) || return 1
  capture_checksum=$(git -C "$root" hash-object "$capture_packet" 2>/dev/null) ||
    return 1
  printf 'WORKTREE@%s+%s\n' "$capture_base" "$capture_checksum"
}

target=$(capture_worktree "$packet_file" "$changed_file" "$untracked_file") ||
  exit 2
if [ "$mode" = fingerprint ]; then
  printf '%s\n' "$target"
  exit 0
fi
review_subject_oid=
if [ -f "$git_dir/fixture-review-event-path" ]; then
  IFS= read -r review_subject <"$git_dir/fixture-review-event-path" || exit 2
  [ -n "$review_subject" ] && [ -f "$root/$review_subject" ] || exit 2
  review_subject_oid=$(git -C "$root" hash-object -- "$review_subject") || exit 2
  printf 'review_start\t%s\t%s\n' "$target" "$review_subject_oid" >>"$git_dir/review-events"
  if [ -f "$git_dir/fixture-review-delay-seconds" ]; then
    IFS= read -r review_delay <"$git_dir/fixture-review-delay-seconds" || exit 2
    case $review_delay in
      '' | *[!0-9]*) exit 2 ;;
    esac
    sleep "$review_delay" || exit 2
  fi
fi

outcome=clear
failure_evidence='Fixture policy rejects this candidate'
advisory_evidence=
if [ -f "$git_dir/fixture-review-sequence" ]; then
  invocation=1
  if [ -f "$git_dir/independent-review-invocations" ]; then
    invocation_count=$(wc -l <"$git_dir/independent-review-invocations" | tr -d ' ')
    case $invocation_count in
      '' | *[!0-9]*) exit 2 ;;
    esac
    invocation=$((invocation_count + 1))
  fi
  sequence_line=$(sed -n "${invocation}p" "$git_dir/fixture-review-sequence")
  [ -n "$sequence_line" ] || exit 2
  tab=$(printf '\t')
  old_ifs=$IFS
  IFS=$tab
  read -r outcome failure_evidence advisory_evidence <<EOF
$sequence_line
EOF
  IFS=$old_ifs
  case $outcome in
    clear) ;;
    blocking) [ -n "$failure_evidence" ] || exit 2 ;;
    inconclusive | unavailable) ;;
    *) exit 2 ;;
  esac
elif [ -f "$git_dir/fixture-review-inconclusive" ]; then
  outcome=inconclusive
elif [ -f "$git_dir/fixture-review-blocked" ]; then
  outcome=unavailable
elif [ -f "$git_dir/fixture-review-fail" ]; then
  outcome=blocking
elif [ -f "$git_dir/fixture-review-reject-pattern" ]; then
  reject_pattern=$(sed -n '1p' "$git_dir/fixture-review-reject-pattern")
  if [ -n "$reject_pattern" ] && grep -F "$reject_pattern" "$packet_file" >/dev/null 2>&1; then
    outcome=blocking
    failure_evidence="Fixture policy rejects changed content containing: $reject_pattern"
  fi
fi

if [ -n "$review_subject_oid" ]; then
  review_subject_end_oid=$(git -C "$root" hash-object -- "$review_subject") ||
    exit 2
  end_target=$(capture_worktree "$end_packet_file" "$end_changed_file" "$end_untracked_file") ||
    exit 2
  printf 'review_end\t%s\t%s\n' "$end_target" "$review_subject_end_oid" >>"$git_dir/review-events"
  if [ "$end_target" != "$target" ]; then
    outcome=inconclusive
    failure_evidence='Reviewed worktree changed before the review response returned'
  fi
fi

printf '%s\t%s\n' "$target" "$outcome" >>"$git_dir/independent-review-invocations"
if [ -n "$review_subject_oid" ]; then
  printf 'review\t%s\t%s\n' "$outcome" "$review_subject_oid" >>"$git_dir/review-events"
fi
if [ "$outcome" = clear ]; then
  printf '%s\n' 'Independent review outcome: no blocking findings'
elif [ "$outcome" = blocking ]; then
  printf '%s\n' 'Independent review outcome: blocking findings'
elif [ "$outcome" = inconclusive ]; then
  printf '%s\n' 'Independent review outcome: inconclusive'
else
  printf '%s\n' 'Independent review outcome: unavailable'
fi
printf 'Reviewed target: %s\n' "$target"
while IFS= read -r -d '' path; do
  [ -n "$path" ] && printf 'Changed file: %s/%s\n' "$root" "$path"
done <"$changed_file"
if [ "$outcome" = clear ]; then
  printf '%s\n' 'Summary: The current change has no blocking findings against the supplied goal and repository instructions.'
elif [ "$outcome" = blocking ]; then
  printf 'Blocking finding: %s\n' "$failure_evidence"
elif [ "$outcome" = inconclusive ]; then
  printf '%s\n' 'Evidence gap: The review could not reach a reliable conclusion from the available evidence.'
else
  printf '%s\n' 'Evidence gap: Required independent review evidence is unavailable.'
fi
if [ -n "$advisory_evidence" ]; then
  printf 'Advisory finding: %s\n' "$advisory_evidence"
fi
