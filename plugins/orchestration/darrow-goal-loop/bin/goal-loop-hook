#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
goal_loop="$script_dir/goal-loop"

deny() {
  printf 'darrow goal hook: %s\n' "$1" >&2
  exit 2
}

json_string_field() {
  DARROW_HOOK_FIELD=$1 awk '
    {
      if (NR > 1) json = json "\n"
      json = json $0
    }
    END {
      needle = "\"" ENVIRON["DARROW_HOOK_FIELD"] "\""
      start = index(json, needle)
      if (start == 0) exit 1
      pos = start + length(needle)
      while (substr(json, pos, 1) ~ /[ \t\r\n]/) pos++
      if (substr(json, pos, 1) != ":") exit 1
      pos++
      while (substr(json, pos, 1) ~ /[ \t\r\n]/) pos++
      if (substr(json, pos, 1) != "\"") exit 1
      pos++
      value = ""
      escaped = 0
      for (; pos <= length(json); pos++) {
        char = substr(json, pos, 1)
        if (escaped) {
          if (char == "n") value = value "\n"
          else if (char == "r") value = value "\r"
          else if (char == "t") value = value "\t"
          else if (char == "b") value = value sprintf("%c", 8)
          else if (char == "f") value = value sprintf("%c", 12)
          else if (char == "\"" || char == "\\" || char == "/") value = value char
          else exit 1
          escaped = 0
        } else if (char == "\\") {
          escaped = 1
        } else if (char == "\"") {
          print value
          exit 0
        } else {
          value = value char
        }
      }
      exit 1
    }
  '
}

state_value() {
  state_file=$1
  state_wanted=$2
  state_tab=$(printf '\t')
  while IFS="$state_tab" read -r state_key state_result state_extra; do
    if test "$state_key" = "$state_wanted"; then
      test -n "$state_result" && test -z "${state_extra:-}" || return 1
      printf '%s\n' "$state_result"
      return 0
    fi
  done <"$state_file"
  return 1
}

pending_contains() {
  pending_file=$1
  pending_candidate=$2
  pending_tab=$(printf '\t')
  while IFS="$pending_tab" read -r pending_key pending_value pending_extra; do
    if test "$pending_key" = before && test "$pending_value" = "$pending_candidate" &&
      test -z "${pending_extra:-}"; then
      return 0
    fi
  done <"$pending_file"
  return 1
}

secure_plugin_data() {
  test -n "$hook_plugin_data" || return 1
  case "$hook_plugin_data" in
    /*) ;;
    *) return 1 ;;
  esac
  test ! -L "$hook_plugin_data" || deny "plugin data path must not be a symbolic link"
  umask 077
  mkdir -p "$hook_plugin_data" || deny "could not create plugin data directory"
  chmod 700 "$hook_plugin_data" || deny "could not secure plugin data directory"
  hook_sessions="$hook_plugin_data/sessions"
  test ! -L "$hook_sessions" || deny "hook session path must not be a symbolic link"
  mkdir -p "$hook_sessions" || deny "could not create hook session directory"
  chmod 700 "$hook_sessions" || deny "could not secure hook session directory"
}

repository_root() {
  repo_from=$1
  git -C "$repo_from" rev-parse --show-toplevel 2>/dev/null || return 1
}

write_start_snapshot() {
  snapshot_file=$1
  snapshot_repo=$2
  snapshot_tmp="$snapshot_file.tmp.$$"
  {
    printf 'repo\t%s\n' "$snapshot_repo"
    for snapshot_candidate in "${TMPDIR:-/tmp}"/darrow-goal-run.*; do
      test -d "$snapshot_candidate" || continue
      printf 'before\t%s\n' "$snapshot_candidate"
    done
  } >"$snapshot_tmp" || deny "could not stage hook session snapshot"
  chmod 600 "$snapshot_tmp" || deny "could not secure hook session snapshot"
  mv "$snapshot_tmp" "$snapshot_file" || deny "could not commit hook session snapshot"
}

bind_started_ledger() {
  bind_pending=$1
  bind_repo=$(state_value "$bind_pending" repo) || deny "start hook snapshot is malformed"
  bind_count=0
  bind_ledger=
  for bind_candidate in "${TMPDIR:-/tmp}"/darrow-goal-run.*; do
    test -d "$bind_candidate" && test -f "$bind_candidate/state" || continue
    pending_contains "$bind_pending" "$bind_candidate" && continue
    test "$(state_value "$bind_candidate/state" repo 2>/dev/null || true)" = "$bind_repo" || continue
    test "$(state_value "$bind_candidate/state" session_id 2>/dev/null || true)" = none || continue
    bind_host=$(state_value "$bind_candidate/state" host 2>/dev/null || true)
    case "$bind_host" in claude|codex) ;; *) continue ;; esac
    bind_count=$((bind_count + 1))
    bind_ledger=$bind_candidate
  done
  test "$bind_count" -eq 1 || deny "could not identify exactly one newly started goal ledger"
  bind_enforcement="helper+$bind_host-hooks"
  bash "$goal_loop" step hook-bind --ledger "$bind_ledger" \
    --session-id "$hook_session_id" --enforcement "$bind_enforcement" >/dev/null ||
    deny "could not bind goal ledger to hook session"
  bind_file="$hook_sessions/$hook_session_id"
  bind_tmp="$bind_file.tmp.$$"
  printf '%s\n' "$bind_ledger" >"$bind_tmp" || deny "could not stage hook session binding"
  chmod 600 "$bind_tmp" || deny "could not secure hook session binding"
  mv "$bind_tmp" "$bind_file" || deny "could not commit hook session binding"
  rm -f "$bind_pending"
}

load_active_ledger() {
  active_binding="$hook_sessions/$hook_session_id"
  test -f "$active_binding" && test ! -L "$active_binding" || return 1
  IFS= read -r active_ledger <"$active_binding" || return 1
  case "$active_ledger" in
    "${TMPDIR:-/tmp}"/darrow-goal-run.*) ;;
    *) deny "hook session contains an unsafe goal ledger path" ;;
  esac
  test -d "$active_ledger" && test -f "$active_ledger/state" ||
    deny "hook session goal ledger is unavailable"
  active_state="$active_ledger/state"
  test "$(state_value "$active_state" session_id)" = "$hook_session_id" ||
    deny "hook session does not match goal ledger binding"
  active_phase=$(state_value "$active_state" phase)
  active_host=$(state_value "$active_state" host)
  active_repo=$(state_value "$active_state" repo)
  active_temp_root=$(state_value "$active_state" temp_root)
  active_staging_dir=$(state_value "$active_state" staging_dir)
}

is_current_thread_owner() {
  test "$(state_value "$active_state" route_applied_by)" = current-thread &&
    test "$(state_value "$active_state" launch_boundary)" = same_thread &&
    test "$(state_value "$active_state" agent_id)" = none &&
    test "$(state_value "$active_state" route_verified)" = true || return 1
  case "$active_phase" in
    readiness-pending|active) return 0 ;;
    reviewed)
      case "$(state_value "$active_state" review_last_outcome)" in
        blocking|continue) return 0 ;;
      esac
      ;;
  esac
  return 1
}

is_delegated_owner() {
  test "$active_host" = claude || return 1
  case "$active_phase" in readiness-pending|active) ;; *) return 1 ;; esac
  test -n "$hook_agent_id" && test -n "$hook_agent_type" || return 1
  test -f "$hook_sessions/$hook_session_id.spawn-claim" &&
    test -f "$hook_sessions/$hook_session_id.spawn-pending" || return 1
  test "$(state_value "$active_state" route_applied_by)" = native-subagent &&
    test "$(state_value "$active_state" launch_boundary)" = native_subagent &&
    test "$(state_value "$active_state" agent_id)" = pending &&
    test "$(state_value "$active_state" route_verified)" = false || return 1
  delegated_runner=$(state_value "$active_state" runner_type 2>/dev/null || true)
  test -n "$delegated_runner" || return 1
  delegated_short_runner=${delegated_runner##*:}
  case "$hook_agent_type" in
    "$delegated_runner"|"$delegated_short_runner") return 0 ;;
  esac
  return 1
}

is_goal_owner() {
  is_current_thread_owner || is_delegated_owner
}

target_path() {
  target_input=$1
  case "$target_input" in
    /*) target_candidate=$target_input ;;
    *) target_candidate=$hook_cwd/$target_input ;;
  esac
  target_name=$(basename -- "$target_candidate")
  case "$target_name" in ''|.|..) deny "unsafe tool target path" ;; esac
  target_parent=$(CDPATH='' cd -- "$(dirname -- "$target_candidate")" 2>/dev/null && pwd -P) ||
    deny "tool target parent is unreadable"
  target_candidate=$target_parent/$target_name
  test ! -L "$target_candidate" || deny "tool target must not be a symbolic link"
  printf '%s\n' "$target_candidate"
}

deny_protected_target() {
  protected_target=$1
  case "$protected_target/" in
    "$active_ledger/"*|"$hook_plugin_data/"*)
      deny "direct writes to goal protocol state are forbidden"
      ;;
  esac
  case "$protected_target" in
    "$active_temp_root"/darrow-goal-run.*)
      deny "direct writes to goal protocol state are forbidden"
      ;;
  esac
}

parse_literal_shell_words() {
  literal_command=$1
  test -n "$literal_command" || return 1
  literal_words=()
  literal_word=
  literal_word_started=false
  literal_quote=
  literal_index=1
  literal_length=${#literal_command}
  while test "$literal_index" -le "$literal_length"; do
    literal_char=${literal_command:$((literal_index - 1)):1}
    case "$literal_quote" in
      single)
        if test "$literal_char" = "'"; then
          literal_quote=
        else
          literal_word=$literal_word$literal_char
        fi
        ;;
      double)
        case "$literal_char" in
          '"') literal_quote= ;;
          \\|'$'|'`'|$'\n'|$'\r') return 1 ;;
          *) literal_word=$literal_word$literal_char ;;
        esac
        ;;
      '')
        case "$literal_char" in
          ' '|$'\t')
            if test "$literal_word_started" = true; then
              literal_words[${#literal_words[@]}]=$literal_word
              literal_word=
              literal_word_started=false
            fi
            ;;
          "'") literal_quote=single; literal_word_started=true ;;
          '"') literal_quote=double; literal_word_started=true ;;
          ';'|'|'|'&'|'<'|'>'|'`'|'$'|'('|')'|'{'|'}'|\\|'*'|'?'|'['|$'\n'|$'\r') return 1 ;;
          *) literal_word=$literal_word$literal_char; literal_word_started=true ;;
        esac
        ;;
    esac
    literal_index=$((literal_index + 1))
  done
  test -z "$literal_quote" || return 1
  if test "$literal_word_started" = true; then
    literal_words[${#literal_words[@]}]=$literal_word
  fi
  test "${#literal_words[@]}" -gt 0
}

allow_helper_command() {
  helper_command=$1
  parse_literal_shell_words "$helper_command" || return 1
  test "$helper_command" = "/usr/bin/printenv TMPDIR" && return 0
  set -- "${literal_words[@]}"
  test "${1:-}" = /bin/bash || return 1
  case "${2:-}|${3:-}" in
    "$goal_loop|step") test "$#" -ge 4 && return 0 ;;
    "$script_dir/claude-route-gate|--repo") test "$#" -ge 8 && return 0 ;;
  esac
  return 1
}

is_start_command() {
  start_command=$1
  allow_helper_command "$start_command" || return 1
  parse_literal_shell_words "$start_command" || return 1
  set -- "${literal_words[@]}"
  test "$#" -eq 8 && test "$2" = "$goal_loop" &&
    test "$3" = step && test "$4" = start &&
    test "$5" = --repo && test "$7" = --host
}

allow_phase_helper_command() {
  phase_command=$1
  if test "$phase_command" = "/usr/bin/printenv TMPDIR"; then
    case "$active_phase" in
      started|prepared|routed|runner-resolved) return 0 ;;
      *) return 1 ;;
    esac
  fi
  parse_literal_shell_words "$phase_command" || return 1
  set -- "${literal_words[@]}"
  if test "${2:-}" = "$script_dir/claude-route-gate"; then
    test "$#" -eq 10 && test "${3:-}" = --repo &&
      test "${4:-}" = "$active_repo" && test "${5:-}" = --agent-id &&
      test -n "${6:-}" && test "${7:-}" = --selected &&
      test "${8:-}" = "$(state_value "$active_state" selected_route)" &&
      test "${9:-}" = --ledger &&
      test "${10:-}" = "$active_ledger" || return 1
    case "$active_phase" in readiness-pending|readiness-stopped|active|reviewed) return 0 ;; *) return 1 ;; esac
  fi
  test "${2:-}" = "$goal_loop" && test "${3:-}" = step || return 1
  phase_step=${4:-}
  case "$phase_step" in
    route)
      case "$#" in 18|20|22) ;; *) return 1 ;; esac
      test "${5:-}" = --ledger && test "${6:-}" = "$active_ledger" &&
        test "${7:-}" = --workflow && test -n "${8:-}" &&
        test "${9:-}" = --risk && test -n "${10:-}" &&
        test "${11:-}" = --profile && test -n "${12:-}" &&
        test "${13:-}" = --verification-gate && test -n "${14:-}" &&
        test "${15:-}" = --readiness && test -n "${16:-}" &&
        test "${17:-}" = --review && test -n "${18:-}" || return 1
      case "$#|${19:-}|${21:-}" in
        18\|\|) ;;
        20\|--review-round-limit\|)
          case "${20:-}" in ''|*[!0-9]*) return 1 ;; esac
          ;;
        20\|--route\|) test -n "${20:-}" || return 1 ;;
        22\|--review-round-limit\|--route)
          case "${20:-}" in ''|*[!0-9]*) return 1 ;; esac
          test -n "${22:-}" || return 1
          ;;
        *) return 1 ;;
      esac
      ;;
    prepare)
      test "$#" -eq 6 && test "${5:-}" = --ledger &&
        test "${6:-}" = "$active_ledger" || return 1
      ;;
    runner)
      test "$#" -eq 12 && test "${5:-}" = --ledger &&
        test "${6:-}" = "$active_ledger" && test "${7:-}" = --provider &&
        test "${8:-}" = anthropic && test "${9:-}" = --model &&
        test -n "${10:-}" && test "${11:-}" = --effort &&
        test -n "${12:-}" || return 1
      ;;
    stage)
      test "$#" -eq 8 && test "${5:-}" = --ledger &&
        test "${6:-}" = "$active_ledger" && test "${7:-}" = --goal-file &&
        test -f "$hook_sessions/$hook_session_id.write-seen" &&
        test "${8:-}" = "$(cat "$hook_sessions/$hook_session_id.write-seen")" || return 1
      ;;
    materialize|release-staging)
      test "$#" -eq 10 && test "${5:-}" = --ledger &&
        test "${6:-}" = "$active_ledger" && test "${7:-}" = --goal-file &&
        test "${8:-}" = "$(state_value "$active_state" staging_file)" &&
        test "${9:-}" = --expected-sha256 &&
        test "${10:-}" = "$(state_value "$active_state" contract_sha256)" || return 1
      ;;
    release-objective)
      test "$#" -eq 10 && test "${5:-}" = --ledger &&
        test "${6:-}" = "$active_ledger" && test "${7:-}" = --attachment-dir &&
        test "${8:-}" = "$(state_value "$active_state" attachment_dir)" &&
        test "${9:-}" = --expected-sha256 &&
        test "${10:-}" = "$(state_value "$active_state" contract_sha256)" || return 1
      ;;
    launch-stop)
      test "$#" -eq 8 && test "${5:-}" = --ledger &&
        test "${6:-}" = "$active_ledger" && test "${7:-}" = --reason &&
        test -n "${8:-}" || return 1
      case "${8:-}" in
        readiness-unavailable|review-unavailable|launch-unavailable|enforcement-unavailable) ;;
        *) return 1 ;;
      esac
      ;;
    readiness)
      test "$#" -eq 8 && test "${5:-}" = --ledger &&
        test "${6:-}" = "$active_ledger" && test "${7:-}" = --verdict || return 1
      case "${8:-}" in
        ready|needs-discovery|needs-decision|blocked) ;;
        *) return 1 ;;
      esac
      ;;
    review)
      case "$#" in 12|14) ;; *) return 1 ;; esac
      test "${5:-}" = --ledger && test "${6:-}" = "$active_ledger" &&
        test "${7:-}" = --mode && test -n "${8:-}" || return 1
      case "${9:-}" in --target-sha256|--target-fingerprint) ;; *) return 1 ;; esac
      test -n "${10:-}" && test "${11:-}" = --outcome &&
        test -n "${12:-}" || return 1
      if test "$#" -eq 14; then
        test "${13:-}" = --finding && test -n "${14:-}" || return 1
      fi
      ;;
    report)
      test "$#" -eq 10 && test "${5:-}" = --ledger &&
        test "${6:-}" = "$active_ledger" && test "${7:-}" = --status &&
        test -n "${8:-}" && test "${9:-}" = --human-interruptions &&
        test -n "${10:-}" || return 1
      case "$active_phase" in
        routed|route-rejected|route-unavailable|launch-unavailable)
          test "${8:-}" = launch-required || return 1
          ;;
        released)
          case "${8:-}" in
            complete|blocked) ;;
            *) return 1 ;;
          esac
          ;;
        readiness-stopped)
          test "${8:-}" = blocked || return 1
          ;;
      esac
      ;;
    activate)
      case "$#" in 16|18) ;; *) return 1 ;; esac
      test "${5:-}" = --ledger && test "${6:-}" = "$active_ledger" &&
        test "${7:-}" = --applied-by && test "${9:-}" = --boundary &&
        test "${11:-}" = --agent-id && test "${13:-}" = --effective-route &&
        test "${14:-}" = "$(state_value "$active_state" selected_route)" &&
        test "${15:-}" = --route-verified || return 1
      case "${8:-}|${10:-}|${12:-}|${16:-}|$#" in
        native-subagent\|native_subagent\|pending\|false\|18)
          test "${17:-}" = --enforcement &&
            test "${18:-}" = helper+claude-hooks || return 1
          ;;
        current-thread\|same_thread\|none\|true\|16) ;;
        current-thread\|same_thread\|none\|true\|18)
          test "${17:-}" = --enforcement &&
            test "${18:-}" = helper+claude-hooks || return 1
          ;;
        *) return 1 ;;
      esac
      ;;
  esac
  case "$active_phase:$phase_step" in
    started:prepare|prepared:route|routed:runner|routed:stage|routed:launch-stop|routed:report|runner-resolved:stage|runner-resolved:launch-stop|staged:materialize|staged:launch-stop|materialized:release-staging|materialized:release-objective|materialized:launch-stop|staging-released:activate|staging-released:launch-stop|readiness-pending:readiness|readiness-stopped:release-objective|active:review|active:release-objective|reviewed:review|reviewed:release-objective|route-rejected:release-objective|route-unavailable:release-objective|launch-unavailable:release-objective|released:report)
      return 0
      ;;
    readiness-stopped:report|active:report|reviewed:report|route-rejected:report|route-unavailable:report|launch-unavailable:report)
      test "$(state_value "$active_state" objective_released)" = true
      return
      ;;
  esac
  return 1
}

pre_tool_use() {
  pre_tool=$1
  case "$pre_tool" in
    Bash)
      pre_command=$(json_string_field command <"$hook_input" 2>/dev/null || true)
      if allow_helper_command "$pre_command"; then
        allow_phase_helper_command "$pre_command" ||
          deny "helper call does not match the ledger's next transition"
        return 0
      fi
      case "$pre_command" in
        *"$active_ledger"*|*"$hook_plugin_data"*)
          deny "direct shell access to goal protocol state is forbidden"
          ;;
      esac
      test "$active_phase" != readiness-pending ||
        deny "shell use is unavailable until implementation readiness is ready"
      is_goal_owner && return 0
      deny "non-protocol shell use is reserved for the routed goal owner"
      ;;
    Read|Glob|Grep)
      if is_goal_owner; then
        case "$hook_compact" in
          *"$active_ledger"*|*"$hook_plugin_data"*)
            deny "direct access to goal protocol state is forbidden"
            ;;
        esac
        return 0
      fi
      case "$active_phase" in
        readiness-pending|readiness-stopped|active|reviewed|route-rejected|route-unavailable|launch-unavailable|released|reported)
          deny "parent repository inspection is forbidden after goal ownership begins"
          ;;
      esac
      ;;
    Write|Edit)
      pre_path=$(json_string_field file_path <"$hook_input" 2>/dev/null || true)
      test -n "$pre_path" || deny "$pre_tool omitted a file path"
      pre_path=$(target_path "$pre_path")
      deny_protected_target "$pre_path"
      test "$active_phase" != readiness-pending ||
        deny "repository mutation is unavailable until implementation readiness is ready"
      if is_delegated_owner; then
        case "$pre_path" in
          "$active_repo"/*) return 0 ;;
          *) deny "delegated goal owner writes must remain inside the repository" ;;
        esac
      fi
      is_current_thread_owner && return 0
      case "$active_phase" in
        runner-resolved|routed)
          test "$(dirname -- "$pre_path")" = "$active_staging_dir" ||
            deny "goal staging writes must remain in the ledger-owned staging directory"
          pre_content=$(json_string_field content <"$hook_input" 2>/dev/null || true)
          case "$pre_content" in
            'Outcome:'*) ;;
            *) deny "goal staging content must be the labeled contract beginning with Outcome:"
          esac
          case "$pre_content" in
            *'Before doing any work, read the complete goal contract at:'*|*'Expected SHA-256:'*)
              deny "goal staging content must not hand-author the objective wrapper"
              ;;
          esac
          test ! -e "$hook_sessions/$hook_session_id.write-seen" &&
            test ! -e "$hook_sessions/$hook_session_id.write-pending" ||
            deny "only one goal staging write is allowed"
          printf '%s\n' "$pre_path" >"$hook_sessions/$hook_session_id.write-pending"
          chmod 600 "$hook_sessions/$hook_session_id.write-pending"
          ;;
        readiness-stopped|active|reviewed|route-rejected|route-unavailable|launch-unavailable|released|reported)
          deny "parent repository mutation is forbidden after goal ownership begins"
          ;;
        *) deny "write use is reserved for the routed goal owner" ;;
      esac
      ;;
    apply_patch)
      test "$active_phase" != readiness-pending ||
        deny "repository mutation is unavailable until implementation readiness is ready"
      if is_goal_owner; then
        case "$hook_compact" in
          *"$active_ledger"*|*"$hook_plugin_data"*)
            deny "direct writes to goal protocol state are forbidden"
            ;;
        esac
        return 0
      fi
      deny "patch use is reserved for the routed goal owner"
      ;;
    Agent)
      case "$active_host|$active_phase" in
        claude\|readiness-pending|claude\|active|codex\|staging-released) ;;
        *) deny "goal owner launch requires released staging or a valid provisional Claude activation" ;;
      esac
      test ! -e "$hook_sessions/$hook_session_id.spawn-seen" ||
        deny "a goal owner was already launched"
      if test "$active_host" = claude; then
        pre_objective_file=$(state_value "$active_state" objective_file)
        test "$pre_objective_file" != none ||
          deny "Claude goal owner has no ledger-owned objective"
        pre_prompt=$(json_string_field prompt <"$hook_input" 2>/dev/null || true)
        expected_prompt="- phase: adaptive-goal-runner
- objective_file: $pre_objective_file"
        test "$pre_prompt" = "$expected_prompt" ||
          deny "Claude goal owner task does not exactly match the ledger-owned objective"
        pre_runner=$(state_value "$active_state" runner_type)
        case "$hook_compact" in
          *"\"subagent_type\":\"$pre_runner\""*) ;;
          *) deny "Claude goal owner does not match the resolved runner" ;;
        esac
        case "$hook_compact" in
          *'"run_in_background":false'*) ;;
          *) deny "Claude goal owner must run in the foreground" ;;
        esac
        pre_route=$(state_value "$active_state" selected_route)
        test "$(state_value "$active_state" route_applied_by)" = native-subagent &&
          test "$(state_value "$active_state" launch_boundary)" = native_subagent &&
          test "$(state_value "$active_state" agent_id)" = pending &&
          test "$(state_value "$active_state" effective_route)" = "$pre_route" &&
          test "$(state_value "$active_state" route_verified)" = false ||
          deny "existing Claude activation is not the valid provisional owner state"
      else
        pre_route=$(state_value "$active_state" selected_route)
        old_ifs=$IFS
        IFS='|'
        read -r pre_harness pre_provider pre_model pre_effort pre_extra <<EOF
$pre_route
EOF
        IFS=$old_ifs
        test "$pre_harness" = codex && test "$pre_provider" = openai &&
          test -z "${pre_extra:-}" ||
          deny "Codex goal route is malformed"
        case "$hook_compact" in
          *"\"model\":\"$pre_model\""*) ;;
          *) deny "Codex goal owner model does not match the selected route" ;;
        esac
        case "$hook_compact" in
          *"\"reasoning_effort\":\"$pre_effort\""*) ;;
          *) deny "Codex goal owner effort does not match the selected route" ;;
        esac
      fi
      spawn_claim="$hook_sessions/$hook_session_id.spawn-claim"
      (set -o noclobber; printf '%s\n' "$active_host" >"$spawn_claim") 2>/dev/null ||
        deny "a goal owner launch is already reserved"
      chmod 600 "$spawn_claim" || deny "could not secure goal owner launch reservation"
      spawn_pending="$hook_sessions/$hook_session_id.spawn-pending"
      printf '%s\n' "$active_host" >"$spawn_pending" ||
        deny "could not record pending goal owner launch"
      chmod 600 "$spawn_pending" || deny "could not secure pending goal owner launch"
      ;;
  esac
}

emit_post_tool_guidance() {
  printf '%s\n' "{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"$1\"}}"
}

post_tool_use() {
  post_tool=$1
  is_goal_owner && return 0
  case "$post_tool" in
    Bash)
      case "$active_host|$active_phase" in
        claude\|started)
          emit_post_tool_guidance 'The ledger start is bound. The next protocol transition is one exact standalone goal-loop step prepare command. Do not Write the contract yet.'
          ;;
        claude\|prepared)
          emit_post_tool_guidance 'Preparation is recorded. The next protocol transition is one exact standalone goal-loop step route command with the selected dimensions.'
          ;;
        claude\|routed)
          emit_post_tool_guidance 'Route selection is recorded. The next protocol transition is one exact standalone goal-loop step runner command for the selected Claude model and effort.'
          ;;
        claude\|runner-resolved)
          emit_post_tool_guidance 'Runner resolution is recorded. The next tool is the one native Write into the exact ledger staging directory. Write the labeled contract itself beginning with Outcome:. Never write an objective wrapper or Expected SHA-256 line.'
          ;;
        claude\|staged)
          emit_post_tool_guidance 'The contract digest is staged. The next protocol transition is one exact standalone goal-loop step materialize command using the exact goal path and contract_sha256 returned by step stage.'
          ;;
        claude\|materialized)
          emit_post_tool_guidance 'The helper created the file-backed objective. The next protocol transition is one exact standalone goal-loop step release-staging command using the exact staging path and helper-returned contract_sha256.'
          ;;
        claude\|staging-released)
          emit_post_tool_guidance 'Staging is released. The next protocol transition is one exact standalone goal-loop step activate command with native-subagent/native_subagent, agent id pending, the exact selected route, route-verified false, and enforcement helper+claude-hooks.'
          ;;
        claude\|active)
          if test "$(state_value "$active_state" agent_id)" = pending &&
            test ! -e "$hook_sessions/$hook_session_id.spawn-seen"; then
            emit_post_tool_guidance 'Provisional activation is recorded. Invoke exactly one foreground Agent with the resolved subagent_type and only the adaptive-goal-runner marker plus the exact helper-returned objective_file line.'
          else
            emit_post_tool_guidance 'The route gate returned with the owner result collected. Do not call Read, Glob, Grep, Write, Edit, or any repository command. The next lifecycle action is the exact release-objective command using the helper-returned attachment and digest.'
          fi
          ;;
        claude\|readiness-pending)
          emit_post_tool_guidance 'Provisional activation is recorded. Invoke exactly one foreground Agent with the resolved subagent_type and only the adaptive-goal-runner marker plus the exact helper-returned objective_file line.'
          ;;
        claude\|readiness-stopped)
          emit_post_tool_guidance 'The route gate returned with a non-ready implementation-readiness result. Do not inspect or mutate the repository. Release any objective attachment, then render a blocked canonical report after the complete readiness result.'
          ;;
        claude\|reviewed)
          emit_post_tool_guidance 'The route gate returned with the owner result collected. Do not call Read, Glob, Grep, Write, Edit, or any repository command. The next lifecycle action is the exact release-objective command using the helper-returned attachment and digest.'
          ;;
        claude\|route-unavailable|claude\|route-rejected)
          if test "$(state_value "$active_state" objective_released)" = true; then
            emit_post_tool_guidance 'The route stop and objective release are recorded. Do not call Read, Glob, Grep, Write, Edit, or any repository command. The next and final tool is the exact goal-loop step report command with --status launch-required and a truthful --human-interruptions integer; return that helper output verbatim at the start of the response.'
          else
            emit_post_tool_guidance 'The route gate stopped without verified route evidence. Do not call Read, Glob, Grep, Write, Edit, or any repository command. The next lifecycle action is the exact release-objective command using the helper-returned attachment and digest.'
          fi
          ;;
        claude\|released)
          emit_post_tool_guidance 'The terminal objective attachment is released. The next and final tool is one exact standalone goal-loop step report command; return that helper output verbatim at the start of the response.'
          ;;
      esac
      ;;
    Write|Edit)
      post_pending="$hook_sessions/$hook_session_id.write-pending"
      test -f "$post_pending" || return 0
      mv "$post_pending" "$hook_sessions/$hook_session_id.write-seen" ||
        deny "could not record goal staging write"
      if test "$active_host" = claude; then
        emit_post_tool_guidance 'The one staging Write is complete. The file must be the labeled contract beginning with Outcome:, never an objective wrapper. The next transition is one exact standalone goal-loop step stage command for this exact path.'
      fi
      ;;
    Agent)
      post_pending="$hook_sessions/$hook_session_id.spawn-pending"
      test -f "$post_pending" || return 0
      if test "$active_host" = codex; then
        post_agent_id=$(json_string_field agent_id <"$hook_input" 2>/dev/null || true)
        test -n "$post_agent_id" || deny "Codex goal owner response omitted an agent id"
        post_route=$(state_value "$active_state" selected_route)
        bash "$goal_loop" step activate --ledger "$active_ledger" \
          --applied-by native-subagent --boundary native_subagent \
          --agent-id "$post_agent_id" --effective-route "$post_route" \
          --route-verified true --enforcement helper+codex-hooks >/dev/null ||
          deny "could not record Codex goal owner activation"
      fi
      mv "$post_pending" "$hook_sessions/$hook_session_id.spawn-seen" ||
        deny "could not record goal owner launch"
      if test "$active_host" = claude; then
        printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"The foreground Darrow goal owner has returned. The next lifecycle action is one exact standalone claude-route-gate command from the launch guide, using the host-reported Agent id, selected route, repository, and ledger values literally. Do not call Read, Glob, Grep, Write, Edit, or another repository tool. Do not use a shell variable, assignment, substitution, command list, redirect, pipeline, discovery command, or direct step observe-route call."}}'
      fi
      ;;
  esac
}

post_tool_failure() {
  failed_tool=$1
  test "$failed_tool" = Agent || return 0
  failed_pending="$hook_sessions/$hook_session_id.spawn-pending"
  test -f "$failed_pending" || return 0
  bash "$goal_loop" step launch-stop --ledger "$active_ledger" \
    --reason launch-unavailable >/dev/null ||
    deny "could not reconcile failed goal owner launch"
  rm -f "$failed_pending" || deny "could not clear failed goal owner launch"
  emit_post_tool_guidance 'The goal owner launch failed and was reconciled as launch-unavailable with zero accepted children. Do not retry the Agent. Release the exact objective attachment, then render a launch-required report.'
}

clear_session_binding() {
  rm -f \
    "$hook_sessions/$hook_session_id" \
    "$hook_sessions/$hook_session_id.pending" \
    "$hook_sessions/$hook_session_id.invoked" \
    "$hook_sessions/$hook_session_id.write-pending" \
    "$hook_sessions/$hook_session_id.write-seen" \
    "$hook_sessions/$hook_session_id.spawn-claim" \
    "$hook_sessions/$hook_session_id.spawn-pending" \
    "$hook_sessions/$hook_session_id.spawn-seen" ||
    deny "could not clear completed adaptive-goal session state"
}

hook_input=$(mktemp "${TMPDIR:-/tmp}/darrow-goal-hook-input.XXXXXX") || exit 0
trap 'rm -f "$hook_input"' EXIT HUP INT TERM
umask 077
tee "$hook_input" >/dev/null
hook_raw=$(awk '{ if (NR > 1) value = value "\n"; value = value $0 } END { print value }' "$hook_input")
hook_compact=$(printf '%s' "$hook_raw" | tr -d '[:space:]')
hook_session_id=$(json_string_field session_id <"$hook_input" 2>/dev/null || true)
hook_event=$(json_string_field hook_event_name <"$hook_input" 2>/dev/null || true)
hook_tool=$(json_string_field tool_name <"$hook_input" 2>/dev/null || true)
hook_cwd=$(json_string_field cwd <"$hook_input" 2>/dev/null || true)
hook_agent_id=$(json_string_field agent_id <"$hook_input" 2>/dev/null || true)
hook_agent_type=$(json_string_field agent_type <"$hook_input" 2>/dev/null || true)
hook_plugin_data=${CLAUDE_PLUGIN_DATA:-${PLUGIN_DATA:-}}

case "$hook_session_id" in
  *[!a-zA-Z0-9._-]*|'') exit 0 ;;
esac
secure_plugin_data || exit 0

hook_pending="$hook_sessions/$hook_session_id.pending"
hook_armed="$hook_sessions/$hook_session_id.invoked"
arm_adaptive_goal() {
  printf '%s\n' adaptive-goal >"$hook_armed" ||
    deny "could not arm adaptive-goal invocation"
  chmod 600 "$hook_armed" || deny "could not secure adaptive-goal invocation"
}
if test "$hook_event" = UserPromptSubmit; then
  hook_prompt=$(json_string_field prompt <"$hook_input" 2>/dev/null || true)
  # shellcheck disable=SC2016
  case "$hook_prompt" in
    '/adaptive-goal'|'/adaptive-goal '*)
      arm_adaptive_goal
      printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"Darrow adaptive-goal enforcement is armed. The first protocol-bearing Bash call is the exact standalone /bin/bash goal-loop step start command using the absolute repository and helper paths already supplied or resolved with native Read, Glob, or Grep. Before that call, Bash discovery, listing, inspection, variables, assignments, substitutions, redirects, pipes, heredocs, and command lists are outside the protocol. A denied lifecycle call is a terminal stop, not retry authority."}}'
      ;;
  esac
  exit 0
fi
if test "$hook_event" = PostToolUse && test "$hook_tool" = Skill; then
  hook_skill=$(json_string_field skill <"$hook_input" 2>/dev/null || true)
  case "$hook_skill" in
    adaptive-goal|darrow-goal-loop:adaptive-goal)
      arm_adaptive_goal
      ;;
  esac
  exit 0
fi
if test "$hook_event" = PreToolUse && test "$hook_tool" = Bash; then
  hook_command=$(json_string_field command <"$hook_input" 2>/dev/null || true)
  if is_start_command "$hook_command"; then
    hook_repo=$(repository_root "$hook_cwd" 2>/dev/null || true)
    test -n "$hook_repo" || deny "goal start hook requires a repository cwd"
    write_start_snapshot "$hook_pending" "$hook_repo"
    exit 0
  fi
fi

if test "$hook_event" = PreToolUse && test -f "$hook_armed"; then
  case "$hook_tool" in
    Bash|Write|Edit|Agent|apply_patch)
      deny "adaptive-goal invocation requires one exact standalone ledger start"
      ;;
  esac
fi

if test "$hook_event" = PostToolUse && test "$hook_tool" = Bash && test -f "$hook_pending"; then
  bind_started_ledger "$hook_pending"
  rm -f "$hook_armed"
  emit_post_tool_guidance 'The ledger start is bound. The next protocol transition is one exact standalone goal-loop step prepare command. Do not Write the contract yet.'
  exit 0
fi

load_active_ledger || exit 0

case "$hook_event" in
  PreToolUse) pre_tool_use "$hook_tool" ;;
  PostToolUse) post_tool_use "$hook_tool" ;;
  PostToolUseFailure) post_tool_failure "$hook_tool" ;;
  Stop)
    if is_current_thread_owner; then
      stop_message=$(json_string_field last_assistant_message <"$hook_input" 2>/dev/null || true)
      case "$stop_message" in
        '- phase: human-feedback-request'$'\n'?*) exit 0 ;;
      esac
    fi
    test "$active_phase" = reported || deny "goal turn cannot end before the canonical helper report"
    active_report="$active_ledger/report"
    test -f "$active_report" && test ! -L "$active_report" ||
      deny "canonical helper report is unavailable"
    stop_message=$(json_string_field last_assistant_message <"$hook_input" 2>/dev/null || true)
    canonical_report=$(cat "$active_report")
    readiness_verdict=$(state_value "$active_state" readiness_verdict)
    case "$readiness_verdict" in
      needs-discovery|needs-decision|blocked)
        case "$stop_message" in
          '## Implementation readiness'$'\n'?*) ;;
          *) deny "non-ready response must begin with the complete implementation-readiness result" ;;
        esac
        case "$stop_message" in
          *$'\n'"$canonical_report"|*$'\n'"$canonical_report"$'\n'*) ;;
          *) deny "non-ready response must include the exact canonical helper report after readiness" ;;
        esac
        ;;
      *)
        case "$stop_message" in
          "$canonical_report"|"$canonical_report"$'\n'*) ;;
          *) deny "final response must begin with the exact canonical helper report" ;;
        esac
        ;;
    esac
    report_count=$(printf '%s\n' "$stop_message" | awk '$0 == "format: darrow-native-goal-report-v1" { count++ } END { print count + 0 }')
    test "$report_count" -eq 1 || deny "final response must contain exactly one canonical helper report"
    clear_session_binding
    ;;
  SubagentStop) ;;
esac
