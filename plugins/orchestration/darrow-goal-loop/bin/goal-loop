#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
routes_file="$script_dir/../config/routes.json"
routes_parser="$script_dir/routes-json.awk"
workflows_dir="$script_dir/../skills/adaptive-goal/references/workflows"
tab=$(printf '\t')

usage() {
  cat <<'EOF'
usage:
  goal-loop prepare --repo <path> --host <codex|claude>
  goal-loop route --repo <path> --host <codex|claude> --profile <profile> [--route <harness|provider|model|effort>]
EOF
}

die() {
  printf 'goal-loop: %s\n' "$*" >&2
  exit 2
}

require_value() {
  test "$#" -ge 2 && test -n "$2" || die "missing value for $1"
}

validate_host() {
  case "$1" in
    codex|claude) ;;
    *) die "unsupported host: $1" ;;
  esac
}

validate_profile() {
  case "$1" in
    ''|*[!a-z0-9-]*) die "unsupported profile: $1" ;;
  esac
}

split_route_tuple() {
  tuple_label=$1
  tuple_value=$2
  tuple_old_ifs=$IFS
  IFS='|'
  read -r tuple_harness tuple_provider tuple_model tuple_effort tuple_extra <<EOF
$tuple_value
EOF
  IFS=$tuple_old_ifs
  test -n "${tuple_harness:-}" && test -n "${tuple_provider:-}" &&
    test -n "${tuple_model:-}" && test -n "${tuple_effort:-}" &&
    test -z "${tuple_extra:-}" ||
    die "$tuple_label must be harness|provider|model|effort"
}

absolute_dir() {
  test -d "$1" || die "directory does not exist: $1"
  (CDPATH='' cd -- "$1" && pwd -P)
}

safe_regular_file() {
  test ! -L "$1" && test -f "$1" && test -r "$1"
}

repository_root() {
  repo_path=$(absolute_dir "$1")
  git -C "$repo_path" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    die "not a git working tree: $repo_path"
  git -C "$repo_path" rev-parse --show-toplevel
}

bundled_route_records() {
  test -r "$routes_file" || die "route configuration is unreadable: $routes_file"
  test -r "$routes_parser" || die "route configuration parser is unreadable: $routes_parser"
  awk -f "$routes_parser" "$routes_file"
}

validate_route_record_row() {
  route_row_source=$1
  route_row_host=$2
  route_row_profile=$3
  route_row_harness=$4
  route_row_provider=$5
  route_row_model=$6
  route_row_effort=$7
  route_row_fallback_model=$8
  route_row_fallback_effort=$9
  shift 9
  route_row_extra=${1:-}
  test -n "$route_row_host" && test -n "$route_row_profile" &&
    test -n "$route_row_harness" && test -n "$route_row_provider" &&
    test -n "$route_row_model" && test -n "$route_row_effort" &&
    test -n "$route_row_fallback_model" &&
    test -n "$route_row_fallback_effort" && test -z "$route_row_extra" ||
    die "invalid $route_row_source route configuration row for host=$route_row_host profile=$route_row_profile"
  test "$route_row_host" = "$route_row_harness" ||
    die "$route_row_source route host and harness disagree for host=$route_row_host profile=$route_row_profile"
}

route_records() {
  route_repo=$1
  bundled_records=$(bundled_route_records)
  repository_config="$route_repo/.darrow/config.json"

  if test ! -e "$repository_config" && test ! -L "$repository_config"; then
    while IFS="$tab" read -r host profile harness provider model effort fallback_model fallback_effort; do
      test -n "$host" || continue
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\tbundled\n' \
        "$host" "$profile" "$harness" "$provider" "$model" "$effort" \
        "$fallback_model" "$fallback_effort"
    done <<<"$bundled_records"
    return
  fi

  safe_regular_file "$repository_config" ||
    die "repository route configuration is unreadable or unsafe: $repository_config"
  repository_records=$(awk -v allow_missing_routes=1 -f "$routes_parser" "$repository_config") ||
    die "repository route configuration is invalid: $repository_config"

  while IFS="$tab" read -r host profile harness provider model effort fallback_model fallback_effort extra; do
    test -n "$host" || continue
    validate_route_record_row bundled "$host" "$profile" "$harness" \
      "$provider" "$model" "$effort" "$fallback_model" "$fallback_effort" \
      "${extra:-}"
  done <<<"$bundled_records"

  while IFS="$tab" read -r host profile harness provider model effort fallback_model fallback_effort extra; do
    test -n "$host" || continue
    validate_route_record_row repository "$host" "$profile" "$harness" \
      "$provider" "$model" "$effort" "$fallback_model" "$fallback_effort" \
      "${extra:-}"
    bundled_match=0
    while IFS="$tab" read -r bundled_host bundled_profile _; do
      if test "$host" = "$bundled_host" && test "$profile" = "$bundled_profile"; then
        bundled_match=1
        break
      fi
    done <<<"$bundled_records"
    test "$bundled_match" -eq 1 ||
      die "repository route is not in bundled host/profile catalog: host=$host profile=$profile"
  done <<<"$repository_records"

  while IFS="$tab" read -r host profile harness provider model effort fallback_model fallback_effort; do
    replacement=
    while IFS="$tab" read -r override_host override_profile override_harness override_provider override_model override_effort override_fallback_model override_fallback_effort; do
      if test "$host" = "$override_host" && test "$profile" = "$override_profile"; then
        replacement="$override_harness$tab$override_provider$tab$override_model$tab$override_effort$tab$override_fallback_model$tab$override_fallback_effort"
        break
      fi
    done <<<"$repository_records"
    if test -n "$replacement"; then
      printf '%s\t%s\t%s\trepository\n' "$host" "$profile" "$replacement"
    else
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\tbundled\n' \
        "$host" "$profile" "$harness" "$provider" "$model" "$effort" \
        "$fallback_model" "$fallback_effort"
    fi
  done <<<"$bundled_records"
}

route_record() {
  route_repo=$1
  route_host=$2
  route_profile=$3
  records=$(route_records "$route_repo")
  found=0
  while IFS="$tab" read -r host profile harness provider model effort fallback_model fallback_effort policy_source; do
    if test "$host" = "$route_host" && test "$profile" = "$route_profile"; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$harness" "$provider" "$model" "$effort" "$fallback_model" \
        "$fallback_effort" "$policy_source"
      found=1
      break
    fi
  done <<<"$records"
  test "$found" -eq 1 ||
    die "no route for host=$route_host profile=$route_profile"
}

validate_explicit_route() {
  explicit_host=$1
  explicit_route=$2
  split_route_tuple "--route" "$explicit_route"
  test "$tuple_harness" = "$explicit_host" ||
    die "explicit route must use current host: $explicit_host"
  case "$explicit_host|$tuple_provider" in
    codex\|openai|claude\|anthropic) ;;
    *) die "explicit route provider does not match host: $explicit_host" ;;
  esac
  case "$tuple_model" in
    none|*[!A-Za-z0-9._-]*) die "explicit route has no concrete safe model" ;;
  esac
  case "$tuple_effort" in
    low|medium|high|xhigh|max|ultra) ;;
    *) die "explicit route has unsupported effort: $tuple_effort" ;;
  esac
}

prepare() {
  repo=
  host=
  while test "$#" -gt 0; do
    case "$1" in
      --repo)
        require_value "$@"
        repo=$2
        shift 2
        ;;
      --host)
        require_value "$@"
        host=$2
        shift 2
        ;;
      *) die "unknown prepare option: $1" ;;
    esac
  done
  test -n "$repo" && test -n "$host" ||
    die "prepare requires --repo and --host"
  validate_host "$host"
  repo=$(repository_root "$repo")
  test -d "$workflows_dir" ||
    die "workflow directory is missing: $workflows_dir"

  revision=$(git -C "$repo" rev-parse HEAD)
  if test -n "$(git -C "$repo" status --porcelain=v1 --untracked-files=all)"; then
    tree_state=dirty
  else
    tree_state=clean
  fi
  records=$(route_records "$repo")

  printf 'format\tdarrow-native-goal-prepared-v2\n'
  printf 'repo\t%s\n' "$repo"
  printf 'base_revision\t%s\n' "$revision"
  printf 'working_tree\t%s\n' "$tree_state"

  for instruction_name in AGENTS.md CLAUDE.md; do
    instruction_path="$repo/$instruction_name"
    if test -e "$instruction_path"; then
      test -r "$instruction_path" ||
        die "repository instruction is unreadable: $instruction_path"
      printf 'instruction\t%s\n' "$instruction_path"
    fi
  done

  route_count=0
  while IFS="$tab" read -r route_host profile harness provider model effort fallback_model fallback_effort policy_source extra; do
    test -n "$profile" && test -n "$harness" && test -n "$provider" &&
      test -n "$model" && test -n "$effort" && test -n "$fallback_model" &&
      test -n "$fallback_effort" && test -n "$policy_source" &&
      test -z "${extra:-}" ||
      die "invalid route configuration row for profile: $profile"
    test "$route_host" = "$host" || continue
    printf 'route\t%s\t%s\t%s\t%s\t%s\n' \
      "$profile" "$harness" "$provider" "$model" "$effort"
    printf 'route_policy_source\t%s\t%s\n' "$profile" "$policy_source"
    route_count=$((route_count + 1))
  done <<<"$records"
  test "$route_count" -gt 0 || die "no routes for host=$host"

  for workflow in fix-bug implement-feature change-feature refactor migration mechanical; do
    workflow_file="$workflows_dir/$workflow.md"
    test -r "$workflow_file" ||
      die "workflow document is unreadable: $workflow_file"
    workflow_path=$(CDPATH='' cd -- "$workflows_dir" && pwd)/$workflow.md
    printf 'workflow\t%s\t%s\n' "$workflow" "$workflow_path"
  done
}

route() {
  repo=
  host=
  profile=
  explicit_route=
  while test "$#" -gt 0; do
    case "$1" in
      --repo)
        require_value "$@"
        repo=$2
        shift 2
        ;;
      --host)
        require_value "$@"
        host=$2
        shift 2
        ;;
      --profile)
        require_value "$@"
        profile=$2
        shift 2
        ;;
      --route)
        require_value "$@"
        explicit_route=$2
        shift 2
        ;;
      *) die "unknown route option: $1" ;;
    esac
  done
  test -n "$repo" && test -n "$host" && test -n "$profile" ||
    die "route requires --repo, --host, and --profile"
  validate_host "$host"
  validate_profile "$profile"
  repo=$(repository_root "$repo")
  if test -n "$explicit_route"; then
    split_route_tuple "--route" "$explicit_route"
    harness=$tuple_harness
    provider=$tuple_provider
    model=$tuple_model
    effort=$tuple_effort
    validate_explicit_route "$host" "$explicit_route"
    source=user
  else
    record=$(route_record "$repo" "$host" "$profile")
    old_ifs=$IFS
    IFS="$tab"
    read -r harness provider model effort fallback_model fallback_effort policy_source <<EOF
$record
EOF
    IFS=$old_ifs
    source=policy
  fi

  printf 'format\tdarrow-native-goal-route-v2\n'
  printf 'profile\t%s\n' "$profile"
  printf 'selected_route\t%s\t%s\t%s\t%s\n' \
    "$harness" "$provider" "$model" "$effort"
  printf 'route_source\t%s\n' "$source"
  if test "$source" = policy; then
    printf 'policy_route_source\t%s\n' "$policy_source"
  fi
}

test "$#" -gt 0 || {
  usage >&2
  exit 2
}
command=$1
shift
case "$command" in
  prepare) prepare "$@" ;;
  route) route "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown command: $command" ;;
esac
