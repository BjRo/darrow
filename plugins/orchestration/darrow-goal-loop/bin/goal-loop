#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
routes_file="$script_dir/../config/routes.json"
routes_parser="$script_dir/routes-json.awk"
workflows_dir="$script_dir/../skills/adaptive-goal/references/workflows"
tab=$(printf '\t')

usage() {
  cat <<'EOF'
usage:
  goal-loop step start --repo <path> --host <codex|claude>
  goal-loop step prepare --ledger <absolute-path>
  goal-loop step route --ledger <absolute-path> --workflow <id> --risk <level> --profile <profile> --verification-gate <gate> --readiness <selected|omitted> --review <selected|omitted> [--review-round-limit <integer>] [--route <harness|provider|model|effort>]
  goal-loop step runner --ledger <absolute-path> --provider <id> --model <id> --effort <level>
  goal-loop step stage --ledger <absolute-path> --goal-file <path> --expected-sha256 <digest>
  goal-loop step materialize --ledger <absolute-path> --goal-file <path> --expected-sha256 <digest>
  goal-loop step release-staging --ledger <absolute-path> --goal-file <path> --expected-sha256 <digest>
  goal-loop step activate --ledger <absolute-path> --applied-by <boundary> --boundary <boundary> <--agent-id <id|none>|--agent-ref <canonical-task-path>> --effective-route <route> --route-verified <true|false>
  goal-loop step goal-state --ledger <absolute-path> --status <active|unavailable>
  goal-loop step observe-route --ledger <absolute-path> --agent-id <id> --effective-route <route> --confirmation <confirmed|rejected|unavailable>
  goal-loop step readiness --ledger <absolute-path> --verdict <ready|needs-discovery|needs-decision|blocked>
  goal-loop step review --ledger <absolute-path> --mode <comprehensive|verify> <--target-fingerprint <literal>|--target-sha256 <digest>> --outcome <enum> [--finding <text>]
  goal-loop step launch-stop --ledger <absolute-path> --reason <readiness-unavailable|review-unavailable|launch-unavailable> [--agent-ref <canonical-task-path>]
  goal-loop step release-objective --ledger <absolute-path> --attachment-dir <path> --expected-sha256 <digest>
  goal-loop step report --ledger <absolute-path> --status <complete|blocked|launch-required> --human-interruptions <integer>
  goal-loop prepare --repo <path> --host <codex|claude>
  goal-loop route --repo <path> --host <codex|claude> --profile <profile> [--route <harness|provider|model|effort>]
  goal-loop confirm-route --selected <harness|provider|model|effort> --effective <harness|provider|model|effort> --applied-by <current-thread|host-api|native-subagent|nested-session>
  goal-loop materialize-objective [--force-file-backed] [--host <codex|claude>] [--expected-sha256 <digest>] --repo <path> --goal-file <path>
  goal-loop release-staging --goal-file <path> --expected-sha256 <digest>
  goal-loop release-objective --attachment-dir <path> --expected-sha256 <digest>
  goal-loop launch --host <codex|claude> --repo <path> --goal-file <path> --provider <id> --model <id> --effort <level> --allow-nested
EOF
}

die() {
  printf 'goal-loop: %s\n' "$*" >&2
  exit 2
}

require_value() {
  test "$#" -ge 2 || die "missing value for $1"
  test -n "$2" || die "empty value for $1"
}

validate_host() {
  case "$1" in
    codex|claude) ;;
    *) die "unsupported host: $1" ;;
  esac
}

validate_profile() {
  profile_name=$1
  case "$profile_name" in
    ''|*[!a-z0-9-]*) die "unsupported profile: $profile_name" ;;
  esac
}

absolute_dir() {
  test -d "$1" || die "directory does not exist: $1"
  (CDPATH='' cd -- "$1" && pwd -P)
}

absolute_regular_file() {
  file_path=$1
  test ! -L "$file_path" && test -f "$file_path" && test -r "$file_path" ||
    die "file is unreadable or unsafe: $file_path"
  file_dir=$(absolute_dir "$(dirname -- "$file_path")")
  file_name=$(basename -- "$file_path")
  printf '%s/%s\n' "$file_dir" "$file_name"
}

sha256_file() {
  sha_file=$1
  if command -v shasum >/dev/null 2>&1; then
    sha_output=$(shasum -a 256 "$sha_file") ||
      die "could not hash file: $sha_file"
  elif command -v sha256sum >/dev/null 2>&1; then
    sha_output=$(sha256sum "$sha_file") ||
      die "could not hash file: $sha_file"
  else
    die "SHA-256 utility is unavailable"
  fi
  sha_digest=${sha_output%% *}
  test "${#sha_digest}" -eq 64 || die "invalid SHA-256 digest for: $sha_file"
  case "$sha_digest" in
    *[!0-9a-f]*) die "invalid SHA-256 digest for: $sha_file" ;;
  esac
  printf '%s\n' "$sha_digest"
}

sha256_text() {
  sha_text=$1
  test "${#sha_text}" -le 4096 || die "review target fingerprint is too long"
  case "$sha_text" in
    ''|*"$tab"*|*$'\n'*|*$'\r'*) die "review target fingerprint is empty or multiline" ;;
  esac
  if command -v shasum >/dev/null 2>&1; then
    sha_output=$(printf '%s' "$sha_text" | shasum -a 256) ||
      die "could not hash review target fingerprint"
  elif command -v sha256sum >/dev/null 2>&1; then
    sha_output=$(printf '%s' "$sha_text" | sha256sum) ||
      die "could not hash review target fingerprint"
  else
    die "SHA-256 utility is unavailable"
  fi
  sha_digest=${sha_output%% *}
  validate_sha256_digest "$sha_digest"
  printf '%s\n' "$sha_digest"
}

validate_sha256_digest() {
  digest=$1
  test "${#digest}" -eq 64 || die "invalid expected SHA-256 digest"
  case "$digest" in
    *[!0-9a-f]*) die "invalid expected SHA-256 digest" ;;
  esac
}

validate_scalar() {
  scalar_label=$1
  scalar_value=$2
  case "$scalar_value" in
    ''|*"$tab"*) die "$scalar_label is empty or contains a tab" ;;
  esac
  case "$scalar_value" in
    *'
'*) die "$scalar_label contains a newline" ;;
  esac
}

validate_agent_id() {
  case "$1" in
    *[!a-zA-Z0-9._-]*|'') die "unsafe agent id: $1" ;;
  esac
}

validate_codex_agent_ref() {
  codex_agent_ref=$1
  case "$codex_agent_ref" in
    /root/*) ;;
    *) die "unsafe Codex agent reference: $codex_agent_ref" ;;
  esac
  codex_agent_path=${codex_agent_ref#/root/}
  case "$codex_agent_path" in
    ''|/*|*//*|*/|*[!a-z0-9_/]*)
      die "unsafe Codex agent reference: $codex_agent_ref"
      ;;
  esac
}

validate_resolved_owner_identity() {
  owner_host=$1
  owner_boundary=$2
  owner_agent_id=$3
  owner_agent_ref=$4
  case "$owner_host|$owner_boundary" in
    codex\|native_subagent)
      test "$owner_agent_id" = none && test "$owner_agent_ref" != none ||
        die "Codex native-subagent owner reference is unresolved"
      validate_codex_agent_ref "$owner_agent_ref"
      ;;
    claude\|native_subagent)
      test "$owner_agent_ref" = none &&
        test "$owner_agent_id" != none && test "$owner_agent_id" != pending ||
        die "Claude native-subagent owner id is unresolved"
      validate_agent_id "$owner_agent_id"
      ;;
    codex\|nested_session|claude\|nested_session)
      test "$owner_agent_ref" = none &&
        test "$owner_agent_id" != none && test "$owner_agent_id" != pending ||
        die "nested-session owner id is unresolved"
      validate_agent_id "$owner_agent_id"
      ;;
    codex\|same_thread|codex\|host_api|claude\|same_thread|claude\|host_api)
      test "$owner_agent_id" = none && test "$owner_agent_ref" = none ||
        die "same-thread and host-api owner identity must be none"
      ;;
    *) die "unsupported owner identity boundary: $owner_host/$owner_boundary" ;;
  esac
}

validate_boolean() {
  case "$1" in
    true|false) ;;
    *) die "expected true or false: $1" ;;
  esac
}

validate_nonnegative_integer() {
  case "$1" in
    ''|*[!0-9]*) die "expected a nonnegative integer: $1" ;;
  esac
}

validate_positive_integer() {
  validate_nonnegative_integer "$1"
  test "$1" -gt 0 || die "expected a positive integer: $1"
}

validate_workflow() {
  case "$1" in
    fix-bug|implement-feature|change-feature|refactor|migration|mechanical|decision-gated) ;;
    *) die "unsupported workflow: $1" ;;
  esac
}

validate_risk() {
  case "$1" in
    routine|elevated|high) ;;
    *) die "unsupported risk: $1" ;;
  esac
}

validate_verification_gate() {
  case "$1" in
    routine|elevated|high|not-applicable) ;;
    *) die "unsupported verification gate: $1" ;;
  esac
}

discard_goal_attachment() {
  discard_dir=$1
  test -n "$discard_dir" || return 0
  case "$(basename -- "$discard_dir")" in
    darrow-goal-contract.*) ;;
    *) return 0 ;;
  esac
  test ! -L "$discard_dir" && test -d "$discard_dir" || return 0
  rm -f "$discard_dir/goal-objective.txt" "$discard_dir/goal-contract.md"
  rmdir "$discard_dir" 2>/dev/null || true
}

discard_pending_goal_attachment() {
  discard_goal_attachment "${pending_goal_attachment:-}"
}

repository_root() {
  repo_path=$(absolute_dir "$1")
  git -C "$repo_path" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    die "not a git working tree: $repo_path"
  git -C "$repo_path" rev-parse --show-toplevel
}

bundled_route_records() {
  test -r "$routes_file" || die "route configuration is unreadable: $routes_file"
  test -r "$routes_parser" || die "route configuration parser is unreadable: $routes_parser"
  awk -f "$routes_parser" "$routes_file"
}

route_records() {
  route_repo=$1
  bundled_records=$(bundled_route_records)
  repository_config="$route_repo/.darrow/config.json"
  if test ! -e "$repository_config" && test ! -L "$repository_config"; then
    printf '%s\n' "$bundled_records" | while IFS="$tab" read -r host profile harness provider model effort fallback_model fallback_effort; do
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\tbundled\n' \
        "$host" "$profile" "$harness" "$provider" "$model" "$effort" "$fallback_model" "$fallback_effort"
    done
    return
  fi
  test ! -L "$repository_config" && test -f "$repository_config" && test -r "$repository_config" ||
    die "repository route configuration is unreadable or unsafe: $repository_config"
  repository_records=$(awk -v allow_missing_routes=1 -f "$routes_parser" "$repository_config") ||
    die "repository route configuration is invalid: $repository_config"

  while IFS="$tab" read -r host profile harness provider model effort fallback_model fallback_effort extra; do
    test -n "$host" || continue
    test -n "$host" && test -n "$profile" && test -n "$harness" && test -n "$provider" &&
      test -n "$model" && test -n "$effort" && test -n "$fallback_model" &&
      test -n "$fallback_effort" && test -z "${extra:-}" ||
      die "invalid bundled route configuration row for host=$host profile=$profile"
    test "$host" = "$harness" ||
      die "bundled route host and harness disagree for host=$host profile=$profile"
  done <<EOF
$bundled_records
EOF

  while IFS="$tab" read -r host profile harness provider model effort fallback_model fallback_effort extra; do
    test -n "$host" || continue
    test -n "$host" && test -n "$profile" && test -n "$harness" && test -n "$provider" &&
      test -n "$model" && test -n "$effort" && test -n "$fallback_model" &&
      test -n "$fallback_effort" && test -z "${extra:-}" ||
      die "invalid repository route configuration row for host=$host profile=$profile"
    test "$host" = "$harness" ||
      die "repository route host and harness disagree for host=$host profile=$profile"
    bundled_match=0
    while IFS="$tab" read -r bundled_host bundled_profile _; do
      if test "$host" = "$bundled_host" && test "$profile" = "$bundled_profile"; then
        bundled_match=1
        break
      fi
    done <<EOF
$bundled_records
EOF
    test "$bundled_match" -eq 1 ||
      die "repository route is not in bundled host/profile catalog: host=$host profile=$profile"
  done <<EOF
$repository_records
EOF

  while IFS="$tab" read -r host profile harness provider model effort fallback_model fallback_effort; do
    replacement=
    while IFS="$tab" read -r override_host override_profile override_harness override_provider override_model override_effort override_fallback_model override_fallback_effort; do
      if test "$host" = "$override_host" && test "$profile" = "$override_profile"; then
        replacement="$override_harness$tab$override_provider$tab$override_model$tab$override_effort$tab$override_fallback_model$tab$override_fallback_effort"
        break
      fi
    done <<EOF
$repository_records
EOF
    if test -n "$replacement"; then
      printf '%s\t%s\t%s\trepository\n' "$host" "$profile" "$replacement"
    else
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\tbundled\n' \
        "$host" "$profile" "$harness" "$provider" "$model" "$effort" "$fallback_model" "$fallback_effort"
    fi
  done <<EOF
$bundled_records
EOF
}

route_record() {
  route_repo=$1
  route_host=$2
  route_profile=$3
  records=$(route_records "$route_repo")
  found=0
  while IFS="$tab" read -r host profile harness provider model effort fallback_model fallback_effort policy_source; do
    if test "$host" = "$route_host" && test "$profile" = "$route_profile"; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$harness" "$provider" "$model" "$effort" "$fallback_model" "$fallback_effort" "$policy_source"
      found=1
      break
    fi
  done <<<"$records"
  test "$found" -eq 1 || die "no route for host=$route_host profile=$route_profile"
}

validate_explicit_route_in_catalog() {
  catalog_repo=$1
  catalog_host=$2
  catalog_route=$3
  old_ifs=$IFS
  IFS='|'
  read -r catalog_harness catalog_provider catalog_model catalog_effort catalog_extra <<EOF
$catalog_route
EOF
  IFS=$old_ifs
  test -n "${catalog_harness:-}" && test -n "${catalog_provider:-}" &&
    test -n "${catalog_model:-}" && test -n "${catalog_effort:-}" &&
    test -z "${catalog_extra:-}" ||
    die "--route must be harness|provider|model|effort"
  test "$catalog_harness" = "$catalog_host" ||
    die "explicit route must use current host: $catalog_host"

  catalog_found=0
  catalog_records=$(route_records "$catalog_repo")
  while IFS="$tab" read -r route_host _ route_harness route_provider route_model route_effort fallback_model fallback_effort _; do
    test "$route_host" = "$catalog_host" || continue
    if test "$route_harness" = "$catalog_harness" &&
      test "$route_provider" = "$catalog_provider" &&
      test "$route_model" = "$catalog_model" &&
      test "$route_effort" = "$catalog_effort"; then
      catalog_found=1
      break
    fi
    if test "$route_harness" = "$catalog_harness" &&
      test "$route_provider" = "$catalog_provider" &&
      test "$fallback_model" = "$catalog_model" &&
      test "$fallback_effort" = "$catalog_effort"; then
      catalog_found=1
      break
    fi
  done <<EOF
$catalog_records
EOF
  test "$catalog_found" -eq 1 ||
    die "explicit route is not in the active bundled catalog: $catalog_route"
}

prepare() {
  repo=
  host=
  while test "$#" -gt 0; do
    case "$1" in
      --repo)
        require_value "$@"
        repo=$2
        shift 2
        ;;
      --host)
        require_value "$@"
        host=$2
        shift 2
        ;;
      *) die "unknown prepare option: $1" ;;
    esac
  done
  test -n "$repo" && test -n "$host" ||
    die "prepare requires --repo and --host"
  validate_host "$host"
  repo=$(repository_root "$repo")
  test -d "$workflows_dir" ||
    die "workflow directory is missing: $workflows_dir"

  revision=$(git -C "$repo" rev-parse HEAD)
  status=$(git -C "$repo" status --porcelain=v1 --untracked-files=all)
  if test -n "$status"; then
    tree_state=dirty
  else
    tree_state=clean
  fi

  records=$(route_records "$repo")

  printf 'format\tdarrow-native-goal-prepared-v1\n'
  printf 'repo\t%s\n' "$repo"
  printf 'base_revision\t%s\n' "$revision"
  printf 'working_tree\t%s\n' "$tree_state"
  if test -n "$status"; then
    while IFS= read -r line; do
      test -n "$line" || continue
      printf 'preexisting_change\t%s\n' "$line"
    done <<<"$status"
  fi
  for instruction_name in AGENTS.md CLAUDE.md; do
    instruction_path="$repo/$instruction_name"
    if test -e "$instruction_path"; then
      test -r "$instruction_path" ||
        die "repository instruction is unreadable: $instruction_path"
      printf 'instruction\t%s\n' "$instruction_path"
    fi
  done

  route_count=0
  while IFS="$tab" read -r route_host profile harness provider model effort fallback_model fallback_effort policy_source extra; do
    test -n "$profile" && test -n "$harness" && test -n "$provider" &&
      test -n "$model" && test -n "$effort" && test -n "$fallback_model" &&
      test -n "$fallback_effort" && test -n "$policy_source" && test -z "${extra:-}" ||
      die "invalid route configuration row for profile: $profile"
    test "$route_host" = "$host" || continue
    printf 'route\t%s\t%s\t%s\t%s\t%s\n' \
      "$profile" "$harness" "$provider" "$model" "$effort"
    printf 'route_policy_source\t%s\t%s\n' "$profile" "$policy_source"
    route_count=$((route_count + 1))
  done <<<"$records"
  test "$route_count" -gt 0 || die "no routes for host=$host"

  for workflow in fix-bug implement-feature change-feature refactor migration mechanical decision-gated; do
    workflow_file="$workflows_dir/$workflow.md"
    test -r "$workflow_file" ||
      die "workflow document is unreadable: $workflow_file"
    workflow_path=$(CDPATH='' cd -- "$workflows_dir" && pwd)/$workflow.md
    printf 'workflow\t%s\t%s\n' "$workflow" "$workflow_path"
  done

}

route() {
  repo=
  host=
  profile=
  explicit_route=
  while test "$#" -gt 0; do
    case "$1" in
      --repo)
        require_value "$@"
        repo=$2
        shift 2
        ;;
      --host)
        require_value "$@"
        host=$2
        shift 2
        ;;
      --profile)
        require_value "$@"
        profile=$2
        shift 2
        ;;
      --route)
        require_value "$@"
        explicit_route=$2
        shift 2
        ;;
      *) die "unknown route option: $1" ;;
    esac
  done
  test -n "$repo" && test -n "$host" || die "route requires --repo and --host"
  test -n "$profile" || die "route requires --profile"
  validate_host "$host"
  validate_profile "$profile"
  repo=$(repository_root "$repo")
  record=$(route_record "$repo" "$host" "$profile")

  fallback_model=none
  fallback_effort=none
  if test -n "$explicit_route"; then
    old_ifs=$IFS
    IFS='|'
    read -r harness provider model effort extra <<EOF
$explicit_route
EOF
    IFS=$old_ifs
    validate_explicit_route_in_catalog "$repo" "$host" "$explicit_route"
    source=user
  else
    old_ifs=$IFS
    IFS="$tab"
    read -r harness provider model effort fallback_model fallback_effort policy_source <<EOF
$record
EOF
    IFS=$old_ifs
    source=policy
  fi

  printf 'format\tdarrow-native-goal-route-v2\n'
  printf 'profile\t%s\n' "$profile"
  printf 'selected_route\t%s\t%s\t%s\t%s\n' "$harness" "$provider" "$model" "$effort"
  printf 'route_source\t%s\n' "$source"
  if test "$source" = policy; then
    printf 'policy_route_source\t%s\n' "$policy_source"
  fi
  printf 'fallback\t%s\t%s\n' "$fallback_model" "$fallback_effort"
}

confirm_route() {
  selected=
  effective=
  applied_by=
  while test "$#" -gt 0; do
    case "$1" in
      --selected)
        require_value "$@"
        selected=$2
        shift 2
        ;;
      --effective)
        require_value "$@"
        effective=$2
        shift 2
        ;;
      --applied-by)
        require_value "$@"
        applied_by=$2
        shift 2
        ;;
      *) die "unknown confirm-route option: $1" ;;
    esac
  done
  test -n "$selected" && test -n "$effective" && test -n "$applied_by" ||
    die "confirm-route requires --selected, --effective, and --applied-by"
  case "$applied_by" in
    current-thread|host-api|native-subagent|nested-session) ;;
    *) die "unsupported route application boundary: $applied_by" ;;
  esac

  old_ifs=$IFS
  IFS='|'
  read -r selected_harness selected_provider selected_model selected_effort selected_extra <<EOF
$selected
EOF
  read -r effective_harness effective_provider effective_model effective_effort effective_extra <<EOF
$effective
EOF
  IFS=$old_ifs
  test -n "${selected_harness:-}" && test -n "${selected_provider:-}" &&
    test -n "${selected_model:-}" && test -n "${selected_effort:-}" &&
    test -z "${selected_extra:-}" ||
    die "--selected must be harness|provider|model|effort"
  test -n "${effective_harness:-}" && test -n "${effective_provider:-}" &&
    test -n "${effective_model:-}" && test -n "${effective_effort:-}" &&
    test -z "${effective_extra:-}" ||
    die "--effective must be harness|provider|model|effort"
  test "$selected" = "$effective" ||
    die "selected route does not match effective route"

  printf 'format\tdarrow-native-goal-route-application-v1\n'
  printf 'selected_route\t%s\t%s\t%s\t%s\n' \
    "$selected_harness" "$selected_provider" "$selected_model" "$selected_effort"
  printf 'effective_route\t%s\t%s\t%s\t%s\n' \
    "$effective_harness" "$effective_provider" "$effective_model" "$effective_effort"
  printf 'route_applied_by\t%s\n' "$applied_by"
  printf 'route_verified\ttrue\n'
}

materialize_objective() {
  repo=
  goal_file=
  materialize_host=
  expected_sha256=
  force_file_backed=0
  while test "$#" -gt 0; do
    case "$1" in
      --force-file-backed)
        force_file_backed=1
        shift
        ;;
      --repo)
        require_value "$@"
        repo=$2
        shift 2
        ;;
      --host)
        require_value "$@"
        materialize_host=$2
        shift 2
        ;;
      --expected-sha256)
        require_value "$@"
        expected_sha256=$2
        shift 2
        ;;
      --goal-file)
        require_value "$@"
        goal_file=$2
        shift 2
        ;;
      *) die "unknown materialize-objective option: $1" ;;
    esac
  done
  test -n "$repo" && test -n "$goal_file" ||
    die "materialize-objective requires --repo and --goal-file"
  repo=$(repository_root "$repo")
  goal_file=$(absolute_regular_file "$goal_file")
  if test -n "$materialize_host"; then
    validate_host "$materialize_host"
    if test "$materialize_host" = claude; then
      force_file_backed=1
    fi
  fi
  case "$goal_file" in
    *"$tab"*) die "goal file path contains a tab: $goal_file" ;;
  esac
  goal_size=$(wc -c <"$goal_file" | tr -d ' ')
  test "$goal_size" -gt 0 || die "goal file is empty: $goal_file"
  if test -n "$expected_sha256"; then
    validate_sha256_digest "$expected_sha256"
    supplied_digest=$(sha256_file "$goal_file")
    test "$supplied_digest" = "$expected_sha256" ||
      die "goal file digest does not match --expected-sha256: $goal_file"
  fi

  if test "$goal_size" -le 4000 && test "$force_file_backed" -eq 0; then
    contract_digest=$(sha256_file "$goal_file")
    printf 'format\tdarrow-native-goal-objective-v1\n'
    printf 'mode\tinline\n'
    printf 'contract_bytes\t%s\n' "$goal_size"
    printf 'contract_sha256\t%s\n' "$contract_digest"
    printf 'contract_file\t%s\n' "$goal_file"
    printf 'objective_bytes\t%s\n' "$goal_size"
    printf 'objective_file\t%s\n' "$goal_file"
    printf 'attachment_dir\tnone\n'
    return
  fi

  tmp_base=$(absolute_dir "${TMPDIR:-/tmp}")
  case "$tmp_base/" in
    "$repo/"*) die "temporary attachment directory must be outside the repository: $tmp_base" ;;
  esac
  umask 077
  attachment_dir=$(mktemp -d "$tmp_base/darrow-goal-contract.XXXXXX") ||
    die "could not create goal attachment directory under: $tmp_base"
  pending_goal_attachment=$attachment_dir
  trap discard_pending_goal_attachment EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  chmod 700 "$attachment_dir" || {
    rmdir "$attachment_dir" 2>/dev/null || true
    die "could not secure goal attachment directory: $attachment_dir"
  }
  contract_file="$attachment_dir/goal-contract.md"
  if ! cp "$goal_file" "$contract_file"; then
    rm -f "$contract_file"
    rmdir "$attachment_dir" 2>/dev/null || true
    die "could not copy goal contract to attachment directory"
  fi
  chmod 600 "$contract_file" || {
    rm -f "$contract_file"
    rmdir "$attachment_dir" 2>/dev/null || true
    die "could not secure goal contract: $contract_file"
  }
  if ! cmp -s "$goal_file" "$contract_file"; then
    rm -f "$contract_file"
    rmdir "$attachment_dir" 2>/dev/null || true
    die "goal contract copy did not match its source"
  fi
  contract_digest=$(sha256_file "$contract_file")
  objective_file="$attachment_dir/goal-objective.txt"
  if ! printf '%s\n' \
    'Before doing any work, read the complete goal contract at:' \
    "$contract_file" \
    "Expected SHA-256: $contract_digest" \
    'Verify the file digest before following the contract.' \
    'If the file is missing, unreadable, or does not match, stop and report the evidence gap.' \
    'This accepted ownership-marked task makes you the sole work owner.' \
    'The applicable launch contract says whether the launcher already persisted this contract in that thread or you must persist this contract in that thread before work.' \
    'Goal persistence belongs to the existing work owner; it does not create another owner.' \
    'Follow that complete contract through terminal completion.' >"$objective_file"; then
    rm -f "$objective_file" "$contract_file"
    rmdir "$attachment_dir" 2>/dev/null || true
    die "could not write file-backed native objective"
  fi
  chmod 600 "$objective_file" || {
    rm -f "$objective_file" "$contract_file"
    rmdir "$attachment_dir" 2>/dev/null || true
    die "could not secure native objective: $objective_file"
  }
  objective_size=$(wc -c <"$objective_file" | tr -d ' ')
  if test "$objective_size" -gt 4000; then
    rm -f "$objective_file" "$contract_file"
    rmdir "$attachment_dir" 2>/dev/null || true
    die "file-backed native objective exceeds 4000 bytes: $objective_size"
  fi

  printf 'format\tdarrow-native-goal-objective-v1\n'
  printf 'mode\tfile-backed\n'
  printf 'contract_bytes\t%s\n' "$goal_size"
  printf 'contract_sha256\t%s\n' "$contract_digest"
  printf 'contract_file\t%s\n' "$contract_file"
  printf 'objective_bytes\t%s\n' "$objective_size"
  printf 'objective_file\t%s\n' "$objective_file"
  printf 'attachment_dir\t%s\n' "$attachment_dir"
  pending_goal_attachment=
  trap - EXIT HUP INT TERM
}

objective_record_value() {
  objective_records=$1
  objective_key=$2
  objective_value=
  while IFS="$tab" read -r record_key record_value record_extra; do
    if test "$record_key" = "$objective_key"; then
      test -n "$record_value" && test -z "${record_extra:-}" ||
        die "invalid materialized objective record: $objective_key"
      objective_value=$record_value
      break
    fi
  done <<<"$objective_records"
  test -n "$objective_value" ||
    die "missing materialized objective record: $objective_key"
  printf '%s\n' "$objective_value"
}

release_goal_attachment_dir() {
  release_dir=$1
  expected_digest=$2
  validate_sha256_digest "$expected_digest"
  case "$release_dir" in
    /*) ;;
    *) die "goal attachment path must be absolute: $release_dir" ;;
  esac
  case "$(basename -- "$release_dir")" in
    darrow-goal-contract.*) ;;
    *) die "refusing unsafe goal attachment cleanup: $release_dir" ;;
  esac
  test ! -L "$release_dir" && test -d "$release_dir" ||
    die "goal attachment directory is unreadable or unsafe: $release_dir"
  release_parent=$(absolute_dir "$(dirname -- "$release_dir")")
  release_tmp_root=$(absolute_dir "${TMPDIR:-/tmp}")
  test "$release_parent" = "$release_tmp_root" ||
    die "goal attachment is outside the temporary root: $release_dir"
  release_dir="$release_parent/$(basename -- "$release_dir")"
  for release_entry in "$release_dir"/* "$release_dir"/.[!.]* "$release_dir"/..?*; do
    test -e "$release_entry" || test -L "$release_entry" || continue
    case "$(basename -- "$release_entry")" in
      goal-contract.md|goal-objective.txt)
        test ! -L "$release_entry" && test -f "$release_entry" ||
          die "goal attachment contains an unsafe file: $release_entry"
        ;;
      *) die "goal attachment contains an unexpected file: $release_entry" ;;
    esac
  done
  test -f "$release_dir/goal-contract.md" && test -f "$release_dir/goal-objective.txt" ||
    die "goal attachment is incomplete: $release_dir"
  release_digest=$(sha256_file "$release_dir/goal-contract.md")
  test "$release_digest" = "$expected_digest" ||
    die "goal attachment digest does not match: $release_dir"
  rm -f "$release_dir/goal-objective.txt" "$release_dir/goal-contract.md"
  rmdir "$release_dir" 2>/dev/null ||
    die "could not remove goal attachment directory: $release_dir"
}

release_staging() {
  goal_file=
  expected_sha256=
  while test "$#" -gt 0; do
    case "$1" in
      --goal-file)
        require_value "$@"
        goal_file=$2
        shift 2
        ;;
      --expected-sha256)
        require_value "$@"
        expected_sha256=$2
        shift 2
        ;;
      *) die "unknown release-staging option: $1" ;;
    esac
  done
  test -n "$goal_file" && test -n "$expected_sha256" ||
    die "release-staging requires --goal-file and --expected-sha256"
  validate_sha256_digest "$expected_sha256"
  goal_file=$(absolute_regular_file "$goal_file")
  staging_parent=$(absolute_dir "$(dirname -- "$goal_file")")
  staging_root=$(absolute_dir "${TMPDIR:-/tmp}")
  case "$staging_parent/" in
    "$staging_root/"*) ;;
    *) die "goal staging file is outside the temporary root: $goal_file" ;;
  esac
  actual_sha256=$(sha256_file "$goal_file")
  test "$actual_sha256" = "$expected_sha256" ||
    die "goal staging digest does not match: $goal_file"
  rm -f "$goal_file"
  test ! -e "$goal_file" ||
    die "could not remove goal staging file: $goal_file"
  printf 'format\tdarrow-native-goal-staging-release-v1\n'
  printf 'status\treleased\n'
  printf 'goal_file\t%s\n' "$goal_file"
}

release_objective() {
  attachment_dir=
  expected_sha256=
  while test "$#" -gt 0; do
    case "$1" in
      --attachment-dir)
        require_value "$@"
        attachment_dir=$2
        shift 2
        ;;
      --expected-sha256)
        require_value "$@"
        expected_sha256=$2
        shift 2
        ;;
      *) die "unknown release-objective option: $1" ;;
    esac
  done
  test -n "$attachment_dir" && test -n "$expected_sha256" ||
    die "release-objective requires --attachment-dir and --expected-sha256"
  release_goal_attachment_dir "$attachment_dir" "$expected_sha256"
  printf 'format\tdarrow-native-goal-objective-release-v1\n'
  printf 'status\treleased\n'
  printf 'attachment_dir\t%s\n' "$attachment_dir"
}

ledger_state_value() {
  ledger_value_file=$1
  ledger_value_key=$2
  ledger_value=
  ledger_value_count=0
  while IFS="$tab" read -r ledger_key ledger_field ledger_extra; do
    if test "$ledger_key" = "$ledger_value_key"; then
      test -n "$ledger_field" && test -z "${ledger_extra:-}" ||
        die "invalid ledger value: $ledger_value_key"
      ledger_value=$ledger_field
      ledger_value_count=$((ledger_value_count + 1))
    fi
  done <"$ledger_value_file"
  test "$ledger_value_count" -eq 1 ||
    die "missing or duplicate ledger value: $ledger_value_key"
  printf '%s\n' "$ledger_value"
}

load_ledger() {
  ledger_path=$1
  case "$ledger_path" in
    /*) ;;
    *) die "ledger path must be absolute: $ledger_path" ;;
  esac
  case "$(basename -- "$ledger_path")" in
    darrow-goal-run.*) ;;
    *) die "invalid ledger directory name: $ledger_path" ;;
  esac
  test ! -L "$ledger_path" && test -d "$ledger_path" ||
    die "ledger directory is unreadable or unsafe: $ledger_path"
  ledger_parent=$(absolute_dir "$(dirname -- "$ledger_path")")
  ledger="$ledger_parent/$(basename -- "$ledger_path")"
  ledger_state="$ledger/state"
  ledger_events="$ledger/events"
  ledger_targets="$ledger/review-targets"
  test ! -e "$ledger/.transition-state" &&
    test ! -e "$ledger/.transition-events" &&
    test ! -e "$ledger/.transition-targets" ||
    die "ledger has an incomplete transition snapshot: $ledger"
  test ! -L "$ledger_state" && test -f "$ledger_state" && test -r "$ledger_state" ||
    die "ledger state is unreadable or unsafe: $ledger_state"
  test ! -L "$ledger_events" && test -f "$ledger_events" && test -r "$ledger_events" ||
    die "ledger events are unreadable or unsafe: $ledger_events"
  test ! -L "$ledger_targets" && test -f "$ledger_targets" && test -r "$ledger_targets" ||
    die "ledger target history is unreadable or unsafe: $ledger_targets"
  test "$(ledger_state_value "$ledger_state" format)" = darrow-goal-step-ledger-v1 ||
    die "unsupported ledger format: $ledger_state"
  ledger_run_id=$(ledger_state_value "$ledger_state" run_id)
  test "$ledger_run_id" = "${ledger##*.}" ||
    die "ledger run id does not match its directory: $ledger"
  ledger_repo=$(ledger_state_value "$ledger_state" repo)
  ledger_host=$(ledger_state_value "$ledger_state" host)
  validate_host "$ledger_host"
  ledger_phase=$(ledger_state_value "$ledger_state" phase)
}

ledger_unlock_on_exit() {
  test -n "${ledger_lock:-}" || return 0
  trap '' HUP INT TERM
  if test -f "${ledger_transition_state:-}"; then
    mv "$ledger_transition_state" "$ledger_state" 2>/dev/null || true
  fi
  if test -f "${ledger_transition_events:-}"; then
    mv "$ledger_transition_events" "$ledger_events" 2>/dev/null || true
  fi
  if test -f "${ledger_transition_targets:-}"; then
    mv "$ledger_transition_targets" "$ledger_targets" 2>/dev/null || true
  fi
  rmdir "$ledger_lock" 2>/dev/null || true
}

ledger_unlock_and_exit() {
  signal_status=$1
  ledger_unlock_on_exit
  ledger_lock=
  trap - EXIT HUP INT TERM
  exit "$signal_status"
}

ledger_defer_signal() {
  ledger_pending_signal=$1
}

lock_ledger() {
  ledger_lock="$ledger/.lock"
  ledger_pending_signal=
  trap 'ledger_defer_signal 129' HUP
  trap 'ledger_defer_signal 130' INT
  trap 'ledger_defer_signal 143' TERM
  mkdir "$ledger_lock" 2>/dev/null || {
    trap - HUP INT TERM
    ledger_lock=
    die "ledger is locked by another step: $ledger"
  }
  trap ledger_unlock_on_exit EXIT
  trap 'ledger_unlock_and_exit 129' HUP
  trap 'ledger_unlock_and_exit 130' INT
  trap 'ledger_unlock_and_exit 143' TERM
  test -z "$ledger_pending_signal" ||
    ledger_unlock_and_exit "$ledger_pending_signal"
  load_ledger "$ledger"
  ledger_transition_state="$ledger/.transition-state"
  ledger_transition_events="$ledger/.transition-events"
  ledger_transition_targets="$ledger/.transition-targets"
  if ! cp "$ledger_state" "$ledger_transition_state" ||
    ! cp "$ledger_events" "$ledger_transition_events" ||
    ! cp "$ledger_targets" "$ledger_transition_targets"; then
    die "could not snapshot ledger transition: $ledger"
  fi
  chmod 600 "$ledger_transition_state" "$ledger_transition_events" \
    "$ledger_transition_targets" ||
    die "could not secure ledger transition snapshot: $ledger"
}

unlock_ledger() {
  trap '' HUP INT TERM
  rm -f "$ledger_transition_state" "$ledger_transition_events" \
    "$ledger_transition_targets" ||
    die "could not commit ledger transition snapshot: $ledger"
  rmdir "$ledger_lock" 2>/dev/null ||
    die "could not release ledger lock: $ledger_lock"
  ledger_lock=
  ledger_transition_state=
  ledger_transition_events=
  ledger_transition_targets=
  ledger_pending_signal=
  trap - EXIT HUP INT TERM
}

require_ledger_phase() {
  expected_phase=$1
  test "$ledger_phase" = "$expected_phase" ||
    die "step requires ledger phase $expected_phase, found $ledger_phase"
}

set_ledger_value() {
  update_key=$1
  update_value=$2
  validate_scalar "ledger value $update_key" "$update_value"
  update_file=$(mktemp "$ledger/state.XXXXXX") ||
    die "could not allocate ledger update under: $ledger"
  update_found=0
  while IFS="$tab" read -r current_key current_value current_extra; do
    test -n "$current_key" && test -n "$current_value" &&
      test -z "${current_extra:-}" || {
        rm -f "$update_file"
        die "malformed ledger state row: $ledger_state"
      }
    if test "$current_key" = "$update_key"; then
      printf '%s\t%s\n' "$update_key" "$update_value" >>"$update_file"
      update_found=$((update_found + 1))
    else
      printf '%s\t%s\n' "$current_key" "$current_value" >>"$update_file"
    fi
  done <"$ledger_state"
  test "$update_found" -eq 1 || {
    rm -f "$update_file"
    die "missing or duplicate ledger update key: $update_key"
  }
  chmod 600 "$update_file" || {
    rm -f "$update_file"
    die "could not secure ledger update: $update_file"
  }
  mv "$update_file" "$ledger_state" || {
    rm -f "$update_file"
    die "could not commit ledger update: $ledger_state"
  }
}

append_ledger_event() {
  event_name=$1
  event_value=$2
  validate_scalar "ledger event" "$event_name"
  validate_scalar "ledger event value" "$event_value"
  printf '%s\t%s\n' "$event_name" "$event_value" >>"$ledger_events" ||
    die "could not append ledger event: $ledger_events"
}

emit_step_record() {
  emitted_step=$1
  printf 'format\tdarrow-goal-step-v1\n'
  printf 'run_id\t%s\n' "$ledger_run_id"
  printf 'ledger\t%s\n' "$ledger"
  printf 'step\t%s\n' "$emitted_step"
  printf 'status\trecorded\n'
}

step_ledger_option() {
  step_ledger=
  while test "$#" -gt 0; do
    case "$1" in
      --ledger)
        require_value "$@"
        step_ledger=$2
        shift 2
        ;;
      *) die "unknown ledger option: $1" ;;
    esac
  done
  test -n "$step_ledger" || die "step requires --ledger"
}

step_start() {
  step_repo=
  step_host=
  while test "$#" -gt 0; do
    case "$1" in
      --repo)
        require_value "$@"
        step_repo=$2
        shift 2
        ;;
      --host)
        require_value "$@"
        step_host=$2
        shift 2
        ;;
      *) die "unknown step start option: $1" ;;
    esac
  done
  test -n "$step_repo" && test -n "$step_host" ||
    die "step start requires --repo and --host"
  validate_host "$step_host"
  step_repo=$(repository_root "$step_repo")
  step_tmp_root=$(absolute_dir "${TMPDIR:-/tmp}")
  case "$step_tmp_root/" in
    "$step_repo/"*) die "goal ledger must be outside the repository: $step_tmp_root" ;;
  esac
  umask 077
  ledger=$(mktemp -d "$step_tmp_root/darrow-goal-run.XXXXXX") ||
    die "could not create goal ledger under: $step_tmp_root"
  step_staging_dir=$(mktemp -d "$step_tmp_root/darrow-goal-stage.XXXXXX") || {
    rmdir "$ledger" 2>/dev/null || true
    die "could not create goal staging directory under: $step_tmp_root"
  }
  pending_step_ledger=$ledger
  pending_step_staging=$step_staging_dir
  trap 'rm -f "$pending_step_ledger/state" "$pending_step_ledger/events" "$pending_step_ledger/review-targets"; rmdir "$pending_step_ledger" 2>/dev/null || true; rmdir "$pending_step_staging" 2>/dev/null || true' EXIT HUP INT TERM
  chmod 700 "$ledger" || die "could not secure goal ledger: $ledger"
  chmod 700 "$step_staging_dir" || die "could not secure goal staging directory: $step_staging_dir"
  ledger_run_id=${ledger##*.}
  ledger_state="$ledger/state"
  ledger_events="$ledger/events"
  ledger_targets="$ledger/review-targets"
  {
    printf 'format\tdarrow-goal-step-ledger-v1\n'
    printf 'run_id\t%s\n' "$ledger_run_id"
    printf 'repo\t%s\n' "$step_repo"
    printf 'host\t%s\n' "$step_host"
    printf 'temp_root\t%s\n' "$step_tmp_root"
    printf 'staging_dir\t%s\n' "$step_staging_dir"
    printf 'phase\tstarted\n'
    printf 'workflow\tnone\n'
    printf 'risk\tnone\n'
    printf 'profile\tnone\n'
    printf 'verification_gate\tnot-applicable\n'
    printf 'readiness_selection\tnone\n'
    printf 'readiness_verdict\tnone\n'
    printf 'review_selection\tnone\n'
    printf 'review_round_limit\tnone\n'
    printf 'review_count\t0\n'
    printf 'review_stop_reason\tnone\n'
    printf 'selected_route\tnone\n'
    printf 'route_source\tnone\n'
    printf 'effective_route\tnone\n'
    printf 'route_applied_by\tnone\n'
    printf 'route_verified\tfalse\n'
    printf 'launch_boundary\tlaunch_required\n'
    printf 'agent_id\tnone\n'
    printf 'agent_ref\tnone\n'
    printf 'runner_type\tnone\n'
    printf 'child_invocations\t0\n'
    printf 'goal_persistence\tnone\n'
    printf 'enforcement\thelper\n'
    printf 'staging_file\tnone\n'
    printf 'contract_sha256\tnone\n'
    printf 'attachment_dir\tnone\n'
    printf 'objective_file\tnone\n'
    printf 'objective_released\ttrue\n'
    printf 'review_initial_outcome\tnone\n'
    printf 'review_initial_finding\tnone\n'
    printf 'review_last_outcome\tnone\n'
    printf 'terminal_reason\tnone\n'
    printf 'reported\tfalse\n'
  } >"$ledger_state"
  : >"$ledger_events"
  : >"$ledger_targets"
  chmod 600 "$ledger_state" "$ledger_events" "$ledger_targets" ||
    die "could not secure goal ledger files: $ledger"
  printf 'start\t%s\n' "$step_host" >>"$ledger_events"
  pending_step_ledger=
  pending_step_staging=
  trap - EXIT HUP INT TERM
  load_ledger "$ledger"
  emit_step_record start
  printf 'repo\t%s\n' "$step_repo"
  printf 'host\t%s\n' "$step_host"
  printf 'enforcement\thelper\n'
  printf 'staging_dir\t%s\n' "$step_staging_dir"
}

step_prepare() {
  step_ledger_option "$@"
  load_ledger "$step_ledger"
  lock_ledger
  require_ledger_phase started
  prepared_output=$(prepare --repo "$ledger_repo" --host "$ledger_host")
  set_ledger_value phase prepared
  append_ledger_event prepare recorded
  unlock_ledger
  emit_step_record prepare
  printf '%s\n' "$prepared_output"
}

step_route() {
  step_ledger=
  step_workflow=
  step_risk=
  step_profile=
  step_verification_gate=
  step_readiness_selection=
  step_review_selection=
  step_review_round_limit=none
  step_explicit_route=
  while test "$#" -gt 0; do
    case "$1" in
      --ledger)
        require_value "$@"
        step_ledger=$2
        shift 2
        ;;
      --workflow)
        require_value "$@"
        step_workflow=$2
        shift 2
        ;;
      --risk)
        require_value "$@"
        step_risk=$2
        shift 2
        ;;
      --profile)
        require_value "$@"
        step_profile=$2
        shift 2
        ;;
      --verification-gate)
        require_value "$@"
        step_verification_gate=$2
        shift 2
        ;;
      --readiness)
        require_value "$@"
        step_readiness_selection=$2
        shift 2
        ;;
      --review)
        require_value "$@"
        step_review_selection=$2
        shift 2
        ;;
      --review-round-limit)
        require_value "$@"
        step_review_round_limit=$2
        shift 2
        ;;
      --route)
        require_value "$@"
        step_explicit_route=$2
        shift 2
        ;;
      *) die "unknown step route option: $1" ;;
    esac
  done
  test -n "$step_ledger" && test -n "$step_workflow" &&
    test -n "$step_risk" && test -n "$step_profile" &&
    test -n "$step_verification_gate" && test -n "$step_readiness_selection" &&
    test -n "$step_review_selection" ||
    die "step route requires --ledger, --workflow, --risk, --profile, --verification-gate, --readiness, and --review"
  validate_workflow "$step_workflow"
  validate_risk "$step_risk"
  validate_verification_gate "$step_verification_gate"
  case "$step_readiness_selection" in selected|omitted) ;; *) die "step route requires --readiness selected or omitted" ;; esac
  case "$step_review_selection" in selected|omitted) ;; *) die "step route requires --review selected or omitted" ;; esac
  if test "$step_workflow" = decision-gated; then
    test "$step_risk" = high && test "$step_readiness_selection" = omitted &&
      test "$step_review_selection" = omitted ||
      die "decision-gated requires risk high with omitted readiness and review"
    test "$step_profile" = none && test "$step_verification_gate" = not-applicable ||
      die "decision-gated requires profile none and verification gate not-applicable"
    test -z "$step_explicit_route" || die "decision-gated cannot select a route"
    test "$step_review_round_limit" = none ||
      die "decision-gated cannot set a review-round limit"
  else
    validate_profile "$step_profile"
    test "$step_verification_gate" = "$step_risk" ||
      die "verification gate must match the selected risk"
    if test "$step_risk" = high; then
      test "$step_review_selection" = selected ||
        die "high-risk routing requires selected independent review"
    fi
    if test "$step_review_round_limit" != none; then
      validate_positive_integer "$step_review_round_limit"
      test "$step_review_selection" = selected ||
        die "review-round limit requires selected independent review"
    fi
  fi

  load_ledger "$step_ledger"
  lock_ledger
  require_ledger_phase prepared
  route_output=
  selected_pipe=none
  route_source=none
  if test "$step_workflow" != decision-gated; then
    if test -n "$step_explicit_route"; then
      route_output=$(route --repo "$ledger_repo" --host "$ledger_host" \
        --profile "$step_profile" --route "$step_explicit_route")
    else
      route_output=$(route --repo "$ledger_repo" --host "$ledger_host" \
        --profile "$step_profile")
    fi
    selected_harness=
    selected_provider=
    selected_model=
    selected_effort=
    selected_extra=
    while IFS="$tab" read -r route_key route_value1 route_value2 route_value3 route_value4 route_extra; do
      if test "$route_key" = selected_route; then
        selected_harness=$route_value1
        selected_provider=$route_value2
        selected_model=$route_value3
        selected_effort=$route_value4
        selected_extra=$route_extra
        break
      fi
    done <<EOF
$route_output
EOF
    test -n "$selected_harness" && test -n "$selected_provider" &&
      test -n "$selected_model" && test -n "$selected_effort" &&
      test -z "${selected_extra:-}" || die "invalid selected route evidence"
    selected_pipe="$selected_harness|$selected_provider|$selected_model|$selected_effort"
    route_source=$(objective_record_value "$route_output" route_source)
  fi
  set_ledger_value workflow "$step_workflow"
  set_ledger_value risk "$step_risk"
  set_ledger_value profile "$step_profile"
  set_ledger_value verification_gate "$step_verification_gate"
  set_ledger_value readiness_selection "$step_readiness_selection"
  set_ledger_value review_selection "$step_review_selection"
  set_ledger_value review_round_limit "$step_review_round_limit"
  set_ledger_value selected_route "$selected_pipe"
  set_ledger_value route_source "$route_source"
  set_ledger_value phase routed
  append_ledger_event route "$selected_pipe"
  unlock_ledger
  emit_step_record route
  printf 'workflow\t%s\n' "$step_workflow"
  printf 'risk\t%s\n' "$step_risk"
  printf 'profile\t%s\n' "$step_profile"
  printf 'verification_gate\t%s\n' "$step_verification_gate"
  printf 'readiness_selection\t%s\n' "$step_readiness_selection"
  printf 'review_selection\t%s\n' "$step_review_selection"
  printf 'selected_route\t%s\n' "$selected_pipe"
  printf 'route_source\t%s\n' "$route_source"
}

step_runner() {
  step_ledger=
  step_provider=
  step_model=
  step_effort=
  while test "$#" -gt 0; do
    case "$1" in
      --ledger) require_value "$@"; step_ledger=$2; shift 2 ;;
      --provider) require_value "$@"; step_provider=$2; shift 2 ;;
      --model) require_value "$@"; step_model=$2; shift 2 ;;
      --effort) require_value "$@"; step_effort=$2; shift 2 ;;
      *) die "unknown step runner option: $1" ;;
    esac
  done
  test -n "$step_ledger" && test -n "$step_provider" &&
    test -n "$step_model" && test -n "$step_effort" ||
    die "step runner requires --ledger, --provider, --model, and --effort"
  load_ledger "$step_ledger"
  lock_ledger
  require_ledger_phase routed
  test "$ledger_host" = claude || die "step runner is only valid for Claude"
  selected_route=$(ledger_state_value "$ledger_state" selected_route)
  test "$selected_route" = "claude|$step_provider|$step_model|$step_effort" ||
    die "runner route does not match ledger selection"
  runner_output=$(bash "$script_dir/claude-agent-route" --provider "$step_provider" \
    --model "$step_model" --effort "$step_effort")
  runner_type=$(objective_record_value "$runner_output" subagent_type)
  set_ledger_value runner_type "$runner_type"
  set_ledger_value phase runner-resolved
  append_ledger_event runner "$selected_route"
  unlock_ledger
  emit_step_record runner
  printf '%s\n' "$runner_output"
}

step_stage() {
  step_ledger=
  step_goal_file=
  step_expected_sha256=
  while test "$#" -gt 0; do
    case "$1" in
      --ledger) require_value "$@"; step_ledger=$2; shift 2 ;;
      --goal-file) require_value "$@"; step_goal_file=$2; shift 2 ;;
      --expected-sha256) require_value "$@"; step_expected_sha256=$2; shift 2 ;;
      *) die "unknown step stage option: $1" ;;
    esac
  done
  test -n "$step_ledger" && test -n "$step_goal_file" ||
    die "step stage requires --ledger and --goal-file"
  if test -n "$step_expected_sha256"; then
    validate_sha256_digest "$step_expected_sha256"
  fi
  step_goal_file=$(absolute_regular_file "$step_goal_file")
  load_ledger "$step_ledger"
  lock_ledger
  if test "$ledger_host" = claude; then
    require_ledger_phase runner-resolved
  else
    require_ledger_phase routed
  fi
  ledger_tmp_root=$(ledger_state_value "$ledger_state" temp_root)
  ledger_staging_dir=$(ledger_state_value "$ledger_state" staging_dir)
  step_goal_parent=$(absolute_dir "$(dirname -- "$step_goal_file")")
  test "$step_goal_parent" = "$ledger_staging_dir" ||
    die "goal staging file is outside the ledger-owned staging directory: $step_goal_file"
  test "$(absolute_dir "$(dirname -- "$ledger_staging_dir")")" = "$ledger_tmp_root" ||
    die "ledger staging directory is outside its temporary root"
  staged_digest=$(sha256_file "$step_goal_file")
  if test -n "$step_expected_sha256"; then
    test "$staged_digest" = "$step_expected_sha256" ||
      die "goal staging digest does not match --expected-sha256: $step_goal_file"
  fi
  set_ledger_value staging_file "$step_goal_file"
  set_ledger_value contract_sha256 "$staged_digest"
  set_ledger_value phase staged
  append_ledger_event stage "$staged_digest"
  unlock_ledger
  emit_step_record stage
  printf 'goal_file\t%s\n' "$step_goal_file"
  printf 'contract_sha256\t%s\n' "$staged_digest"
}

step_materialize() {
  step_ledger=
  step_goal_file=
  step_expected_sha256=
  while test "$#" -gt 0; do
    case "$1" in
      --ledger) require_value "$@"; step_ledger=$2; shift 2 ;;
      --goal-file) require_value "$@"; step_goal_file=$2; shift 2 ;;
      --expected-sha256) require_value "$@"; step_expected_sha256=$2; shift 2 ;;
      *) die "unknown step materialize option: $1" ;;
    esac
  done
  test -n "$step_ledger" && test -n "$step_goal_file" &&
    test -n "$step_expected_sha256" ||
    die "step materialize requires --ledger, --goal-file, and --expected-sha256"
  validate_sha256_digest "$step_expected_sha256"
  step_goal_file=$(absolute_regular_file "$step_goal_file")
  load_ledger "$step_ledger"
  lock_ledger
  require_ledger_phase staged
  test "$(ledger_state_value "$ledger_state" staging_file)" = "$step_goal_file" ||
    die "materialization goal file does not match staged file"
  test "$(ledger_state_value "$ledger_state" contract_sha256)" = "$step_expected_sha256" ||
    die "materialization digest does not match staged digest"
  materialized_output=$(materialize_objective --host "$ledger_host" \
    --expected-sha256 "$step_expected_sha256" --repo "$ledger_repo" \
    --goal-file "$step_goal_file")
  materialized_digest=$(objective_record_value "$materialized_output" contract_sha256)
  test "$materialized_digest" = "$step_expected_sha256" ||
    die "materialized objective digest does not match staged digest"
  materialized_mode=$(objective_record_value "$materialized_output" mode)
  if test "$ledger_host" = claude; then
    test "$materialized_mode" = file-backed ||
      die "Claude objective must be file-backed"
  fi
  materialized_attachment=$(objective_record_value "$materialized_output" attachment_dir)
  materialized_objective_file=$(objective_record_value "$materialized_output" objective_file)
  set_ledger_value attachment_dir "$materialized_attachment"
  set_ledger_value objective_file "$materialized_objective_file"
  if test "$materialized_attachment" = none; then
    set_ledger_value objective_released true
  else
    set_ledger_value objective_released false
  fi
  set_ledger_value phase materialized
  append_ledger_event materialize "$step_expected_sha256"
  unlock_ledger
  emit_step_record materialize
  printf '%s\n' "$materialized_output"
}

step_release_staging() {
  step_ledger=
  step_goal_file=
  step_expected_sha256=
  while test "$#" -gt 0; do
    case "$1" in
      --ledger) require_value "$@"; step_ledger=$2; shift 2 ;;
      --goal-file) require_value "$@"; step_goal_file=$2; shift 2 ;;
      --expected-sha256) require_value "$@"; step_expected_sha256=$2; shift 2 ;;
      *) die "unknown step release-staging option: $1" ;;
    esac
  done
  test -n "$step_ledger" && test -n "$step_goal_file" &&
    test -n "$step_expected_sha256" ||
    die "step release-staging requires --ledger, --goal-file, and --expected-sha256"
  step_goal_file=$(absolute_regular_file "$step_goal_file")
  load_ledger "$step_ledger"
  lock_ledger
  require_ledger_phase materialized
  test "$(ledger_state_value "$ledger_state" staging_file)" = "$step_goal_file" ||
    die "staging release goal file does not match ledger"
  test "$(ledger_state_value "$ledger_state" contract_sha256)" = "$step_expected_sha256" ||
    die "staging release digest does not match ledger"
  release_output=$(release_staging --goal-file "$step_goal_file" \
    --expected-sha256 "$step_expected_sha256")
  ledger_staging_dir=$(ledger_state_value "$ledger_state" staging_dir)
  test "$(absolute_dir "$(dirname -- "$step_goal_file")")" = "$ledger_staging_dir" ||
    die "staging release file is outside the ledger-owned staging directory"
  rmdir "$ledger_staging_dir" 2>/dev/null ||
    die "could not remove ledger-owned staging directory: $ledger_staging_dir"
  set_ledger_value phase staging-released
  append_ledger_event release-staging "$step_expected_sha256"
  unlock_ledger
  emit_step_record release-staging
  printf '%s\n' "$release_output"
}

step_release_objective() {
  step_ledger=
  step_attachment_dir=
  step_expected_sha256=
  while test "$#" -gt 0; do
    case "$1" in
      --ledger) require_value "$@"; step_ledger=$2; shift 2 ;;
      --attachment-dir) require_value "$@"; step_attachment_dir=$2; shift 2 ;;
      --expected-sha256) require_value "$@"; step_expected_sha256=$2; shift 2 ;;
      *) die "unknown step release-objective option: $1" ;;
    esac
  done
  test -n "$step_ledger" && test -n "$step_attachment_dir" &&
    test -n "$step_expected_sha256" ||
    die "step release-objective requires --ledger, --attachment-dir, and --expected-sha256"
  load_ledger "$step_ledger"
  lock_ledger
  case "$ledger_phase" in
    active|reviewed|readiness-stopped)
      test "$(ledger_state_value "$ledger_state" agent_id)" != pending &&
        test "$(ledger_state_value "$ledger_state" route_verified)" = true ||
        die "objective release requires a resolved, route-verified owner"
      ;;
    route-rejected|route-unavailable|launch-unavailable|goal-unavailable) ;;
    *) die "objective release requires a materialized ledger, found $ledger_phase" ;;
  esac
  test "$(ledger_state_value "$ledger_state" attachment_dir)" = "$step_attachment_dir" ||
    die "objective release attachment does not match ledger"
  test "$(ledger_state_value "$ledger_state" contract_sha256)" = "$step_expected_sha256" ||
    die "objective release digest does not match ledger"
  test "$(ledger_state_value "$ledger_state" objective_released)" = false ||
    die "objective attachment was already released"
  release_output=$(release_objective --attachment-dir "$step_attachment_dir" \
    --expected-sha256 "$step_expected_sha256")
  set_ledger_value objective_released true
  case "$ledger_phase" in
    route-rejected|route-unavailable|launch-unavailable|goal-unavailable|readiness-stopped) release_phase=$ledger_phase ;;
    *) release_phase=released ;;
  esac
  set_ledger_value phase "$release_phase"
  append_ledger_event release-objective "$step_expected_sha256"
  unlock_ledger
  emit_step_record release-objective
  printf '%s\n' "$release_output"
}

validate_route_tuple() {
  tuple_label=$1
  tuple_value=$2
  old_ifs=$IFS
  IFS='|'
  read -r tuple_harness tuple_provider tuple_model tuple_effort tuple_extra <<EOF
$tuple_value
EOF
  IFS=$old_ifs
  test -n "${tuple_harness:-}" && test -n "${tuple_provider:-}" &&
    test -n "${tuple_model:-}" && test -n "${tuple_effort:-}" &&
    test -z "${tuple_extra:-}" ||
    die "$tuple_label must be harness|provider|model|effort"
  case "$tuple_harness" in
    codex|claude) ;;
    *) die "$tuple_label has unsupported harness: $tuple_harness" ;;
  esac
}

step_activate() {
  step_ledger=
  step_applied_by=
  step_boundary=
  step_agent_id=
  step_agent_ref=
  step_effective_route=
  step_route_verified=
  while test "$#" -gt 0; do
    case "$1" in
      --ledger) require_value "$@"; step_ledger=$2; shift 2 ;;
      --applied-by) require_value "$@"; step_applied_by=$2; shift 2 ;;
      --boundary) require_value "$@"; step_boundary=$2; shift 2 ;;
      --agent-id) require_value "$@"; step_agent_id=$2; shift 2 ;;
      --agent-ref) require_value "$@"; step_agent_ref=$2; shift 2 ;;
      --effective-route) require_value "$@"; step_effective_route=$2; shift 2 ;;
      --route-verified) require_value "$@"; step_route_verified=$2; shift 2 ;;
      *) die "unknown step activate option: $1" ;;
    esac
  done
  test -n "$step_ledger" && test -n "$step_applied_by" &&
    test -n "$step_boundary" &&
    test -n "$step_effective_route" && test -n "$step_route_verified" ||
    die "step activate requires --ledger, --applied-by, --boundary, one owner identity, --effective-route, and --route-verified"
  test -z "$step_agent_id" || test -z "$step_agent_ref" ||
    die "step activate accepts only one owner identity"
  validate_boolean "$step_route_verified"
  validate_route_tuple "--effective-route" "$step_effective_route"
  load_ledger "$step_ledger"
  case "$step_applied_by|$step_boundary" in
    current-thread\|same_thread|host-api\|host_api)
      test "$step_agent_id" = none && test -z "$step_agent_ref" ||
        die "same-thread and host-api activation require agent id none"
      step_child_invocations=0
      ;;
    native-subagent\|native_subagent)
      if test "$ledger_host" = codex; then
        test -z "$step_agent_id" && test -n "$step_agent_ref" ||
          die "Codex native-subagent activation requires --agent-ref"
        validate_codex_agent_ref "$step_agent_ref"
      else
        test -n "$step_agent_id" && test -z "$step_agent_ref" ||
          die "Claude native-subagent activation requires --agent-id"
        validate_agent_id "$step_agent_id"
        test "$step_agent_id" != none ||
          die "$step_boundary activation requires an agent id"
      fi
      step_child_invocations=1
      ;;
    nested-session\|nested_session)
      test -n "$step_agent_id" && test -z "$step_agent_ref" ||
        die "nested-session activation requires --agent-id"
      validate_agent_id "$step_agent_id"
      test "$step_agent_id" != none || die "$step_boundary activation requires an agent id"
      step_child_invocations=1
      ;;
    *) die "inconsistent route application and launch boundary: $step_applied_by/$step_boundary" ;;
  esac
  lock_ledger
  require_ledger_phase staging-released
  selected_route=$(ledger_state_value "$ledger_state" selected_route)
  test "$selected_route" != none || die "activation requires a selected route"
  if test "$step_route_verified" = false; then
    test -z "$step_agent_ref" &&
      test "$ledger_host|$step_applied_by|$step_boundary|$step_agent_id" = \
      'claude|native-subagent|native_subagent|pending' ||
      die "unverified activation requires the exact provisional Claude owner tuple"
    test "$selected_route" = "$step_effective_route" ||
      die "provisional Claude activation must retain the selected route"
  else
    test "$ledger_host|$step_boundary" != 'claude|native_subagent' ||
      die "Claude native-subagent activation requires transcript observation before route verification"
    test "$selected_route" = "$step_effective_route" ||
      die "verified effective route does not match selected route"
  fi
  set_ledger_value effective_route "$step_effective_route"
  set_ledger_value route_applied_by "$step_applied_by"
  set_ledger_value route_verified "$step_route_verified"
  set_ledger_value launch_boundary "$step_boundary"
  set_ledger_value agent_id "${step_agent_id:-none}"
  set_ledger_value agent_ref "${step_agent_ref:-none}"
  set_ledger_value child_invocations "$step_child_invocations"
  readiness_selection=$(ledger_state_value "$ledger_state" readiness_selection)
  if test "$ledger_host|$step_applied_by|$step_boundary" = \
    'codex|native-subagent|native_subagent'; then
    set_ledger_value goal_persistence pending
    activation_phase='goal-pending'
  elif test "$readiness_selection" = selected; then
    activation_phase=readiness-pending
  else
    activation_phase=active
  fi
  set_ledger_value phase "$activation_phase"
  step_agent_identity=${step_agent_ref:-$step_agent_id}
  append_ledger_event activate "$step_agent_identity"
  unlock_ledger
  emit_step_record activate
  if test -n "$step_agent_ref"; then
    printf 'agent_ref\t%s\n' "$step_agent_ref"
  else
    printf 'agent_id\t%s\n' "$step_agent_id"
  fi
  printf 'effective_route\t%s\n' "$step_effective_route"
  printf 'route_verified\t%s\n' "$step_route_verified"
  printf 'enforcement\thelper\n'
}

step_goal_state() {
  step_ledger=
  step_status=
  while test "$#" -gt 0; do
    case "$1" in
      --ledger) require_value "$@"; step_ledger=$2; shift 2 ;;
      --status) require_value "$@"; step_status=$2; shift 2 ;;
      *) die "unknown step goal-state option: $1" ;;
    esac
  done
  test -n "$step_ledger" && test -n "$step_status" ||
    die "step goal-state requires --ledger and --status"
  case "$step_status" in
    active|unavailable) ;;
    *) die "unsupported native goal persistence status: $step_status" ;;
  esac
  load_ledger "$step_ledger"
  lock_ledger
  require_ledger_phase goal-pending
  test "$ledger_host" = codex &&
    test "$(ledger_state_value "$ledger_state" route_applied_by)" = native-subagent &&
    test "$(ledger_state_value "$ledger_state" launch_boundary)" = native_subagent &&
    test "$(ledger_state_value "$ledger_state" agent_ref)" != none &&
    test "$(ledger_state_value "$ledger_state" goal_persistence)" = pending ||
    die "goal-state requires a pending Codex native-subagent owner"
  if test "$step_status" = active; then
    set_ledger_value goal_persistence confirmed
    if test "$(ledger_state_value "$ledger_state" readiness_selection)" = selected; then
      goal_state_phase=readiness-pending
    else
      goal_state_phase=active
    fi
  else
    set_ledger_value goal_persistence unavailable
    set_ledger_value effective_route none
    set_ledger_value route_applied_by none
    set_ledger_value route_verified false
    set_ledger_value launch_boundary launch_required
    set_ledger_value terminal_reason goal-persistence-unavailable
    goal_state_phase='goal-unavailable'
  fi
  set_ledger_value phase "$goal_state_phase"
  append_ledger_event goal-state "$step_status"
  unlock_ledger
  emit_step_record goal-state
  printf 'goal_state\t%s\n' "$step_status"
}

step_observe_route() {
  step_ledger=
  step_agent_id=
  step_effective_route=
  step_confirmation=
  while test "$#" -gt 0; do
    case "$1" in
      --ledger) require_value "$@"; step_ledger=$2; shift 2 ;;
      --agent-id) require_value "$@"; step_agent_id=$2; shift 2 ;;
      --effective-route) require_value "$@"; step_effective_route=$2; shift 2 ;;
      --confirmation) require_value "$@"; step_confirmation=$2; shift 2 ;;
      *) die "unknown step observe-route option: $1" ;;
    esac
  done
  test -n "$step_ledger" && test -n "$step_agent_id" &&
    test -n "$step_effective_route" && test -n "$step_confirmation" ||
    die "step observe-route requires --ledger, --agent-id, --effective-route, and --confirmation"
  case "$step_agent_id" in
    pending|none|*[!a-zA-Z0-9._-]*|'') die "unsafe observed agent id: $step_agent_id" ;;
  esac
  validate_route_tuple "--effective-route" "$step_effective_route"
  case "$step_confirmation" in
    confirmed|rejected|unavailable) ;;
    *) die "unsupported route confirmation: $step_confirmation" ;;
  esac
  load_ledger "$step_ledger"
  lock_ledger
  case "$ledger_phase" in
    readiness-pending|readiness-stopped|active|reviewed) ;;
    *) die "route observation requires an activated owner, found $ledger_phase" ;;
  esac
  test "$ledger_host" = claude || die "route observation is only valid for Claude"
  activated_agent_id=$(ledger_state_value "$ledger_state" agent_id)
  case "$activated_agent_id" in
    pending) set_ledger_value agent_id "$step_agent_id" ;;
    "$step_agent_id") ;;
    *) die "observed agent id does not match ledger activation" ;;
  esac
  selected_route=$(ledger_state_value "$ledger_state" selected_route)
  if test "$step_confirmation" = confirmed; then
    test "$selected_route" = "$step_effective_route" ||
      die "confirmed route does not match selection"
    observed_verified=true
    observed_phase=$ledger_phase
  elif test "$step_confirmation" = unavailable; then
    observed_verified=false
    observed_phase=route-unavailable
  else
    test "$selected_route" != "$step_effective_route" ||
      die "rejected route unexpectedly matches selection"
    observed_verified=false
    observed_phase=route-rejected
  fi
  set_ledger_value effective_route "$step_effective_route"
  set_ledger_value route_verified "$observed_verified"
  if test "$observed_verified" = false; then
    set_ledger_value launch_boundary launch_required
  fi
  set_ledger_value phase "$observed_phase"
  append_ledger_event observe-route "$step_confirmation"
  unlock_ledger
  emit_step_record observe-route
  printf 'agent_id\t%s\n' "$step_agent_id"
  printf 'effective_route\t%s\n' "$step_effective_route"
  printf 'confirmation\t%s\n' "$step_confirmation"
  if test "$step_confirmation" = rejected; then
    return 3
  fi
}

step_readiness() {
  step_ledger=
  step_verdict=
  while test "$#" -gt 0; do
    case "$1" in
      --ledger) require_value "$@"; step_ledger=$2; shift 2 ;;
      --verdict) require_value "$@"; step_verdict=$2; shift 2 ;;
      *) die "unknown step readiness option: $1" ;;
    esac
  done
  test -n "$step_ledger" && test -n "$step_verdict" ||
    die "step readiness requires --ledger and --verdict"
  case "$step_verdict" in
    ready|needs-discovery|needs-decision|blocked) ;;
    *) die "unsupported implementation-readiness verdict: $step_verdict" ;;
  esac
  load_ledger "$step_ledger"
  lock_ledger
  require_ledger_phase readiness-pending
  test "$(ledger_state_value "$ledger_state" readiness_selection)" = selected ||
    die "readiness evidence was not selected for this goal"
  test "$(ledger_state_value "$ledger_state" readiness_verdict)" = none ||
    die "implementation-readiness verdict was already recorded"
  set_ledger_value readiness_verdict "$step_verdict"
  if test "$step_verdict" = ready; then
    readiness_phase=active
  else
    readiness_phase=readiness-stopped
  fi
  set_ledger_value phase "$readiness_phase"
  append_ledger_event readiness "$step_verdict"
  unlock_ledger
  emit_step_record readiness
  printf 'verdict\t%s\n' "$step_verdict"
}

step_launch_stop() {
  step_ledger=
  step_reason=
  step_agent_ref=
  while test "$#" -gt 0; do
    case "$1" in
      --ledger) require_value "$@"; step_ledger=$2; shift 2 ;;
      --reason) require_value "$@"; step_reason=$2; shift 2 ;;
      --agent-ref) require_value "$@"; step_agent_ref=$2; shift 2 ;;
      *) die "unknown step launch-stop option: $1" ;;
    esac
  done
  test -n "$step_ledger" && test -n "$step_reason" ||
    die "step launch-stop requires --ledger and --reason"
  case "$step_reason" in
    readiness-unavailable|review-unavailable|launch-unavailable) ;;
    *) die "unsupported pre-activation stop reason: $step_reason" ;;
  esac
  load_ledger "$step_ledger"
  failed_codex_activation=false
  if test -n "$step_agent_ref"; then
    test "$ledger_host" = codex && test "$step_reason" = launch-unavailable ||
      die "--agent-ref is only valid for an accepted Codex launch-unavailable stop"
    validate_codex_agent_ref "$step_agent_ref"
    test "$ledger_phase" = staging-released ||
      die "accepted Codex launch stop requires staging-released evidence"
    failed_codex_activation=true
  fi
  lock_ledger
  failed_provisional_activation=false
  case "$ledger_phase" in
    routed|runner-resolved|materialized|staging-released|released) ;;
    active|readiness-pending)
      test "$ledger_host" = claude && test "$step_reason" = launch-unavailable &&
        test "$(ledger_state_value "$ledger_state" agent_id)" = pending &&
        test "$(ledger_state_value "$ledger_state" route_verified)" = false &&
        test "$(ledger_state_value "$ledger_state" launch_boundary)" = native_subagent ||
        die "launch stop cannot replace an accepted owner"
      failed_provisional_activation=true
      ;;
    *) die "launch stop requires routed pre-activation evidence, found $ledger_phase" ;;
  esac
  if test "$failed_codex_activation" = true; then
    test "$(ledger_state_value "$ledger_state" agent_id)" = none &&
      test "$(ledger_state_value "$ledger_state" agent_ref)" = none ||
      die "accepted Codex launch stop cannot replace owner evidence"
    set_ledger_value agent_ref "$step_agent_ref"
    set_ledger_value child_invocations 1
  elif test "$failed_provisional_activation" = true; then
    set_ledger_value effective_route none
    set_ledger_value route_applied_by none
    set_ledger_value route_verified false
    set_ledger_value launch_boundary launch_required
    set_ledger_value agent_id none
    set_ledger_value agent_ref none
    set_ledger_value child_invocations 0
  else
    test "$(ledger_state_value "$ledger_state" agent_id)" = none &&
      test "$(ledger_state_value "$ledger_state" agent_ref)" = none ||
      die "launch stop cannot replace an activated owner"
  fi
  if test "$step_reason" = review-unavailable; then
    test "$(ledger_state_value "$ledger_state" review_selection)" = selected ||
      die "review-unavailable stop requires selected independent review"
  fi
  if test "$step_reason" = readiness-unavailable; then
    test "$(ledger_state_value "$ledger_state" readiness_selection)" = selected ||
      die "readiness-unavailable stop requires selected implementation readiness"
  fi
  set_ledger_value terminal_reason "$step_reason"
  set_ledger_value phase launch-unavailable
  append_ledger_event launch-stop "$step_reason"
  unlock_ledger
  emit_step_record launch-stop
  printf 'reason\t%s\n' "$step_reason"
  if test "$failed_codex_activation" = true; then
    printf 'agent_ref\t%s\n' "$step_agent_ref"
  fi
}

step_review() {
  step_ledger=
  step_review_mode=
  step_target_sha256=
  step_target_fingerprint=
  step_outcome=
  step_finding=none
  while test "$#" -gt 0; do
    case "$1" in
      --ledger) require_value "$@"; step_ledger=$2; shift 2 ;;
      --mode) require_value "$@"; step_review_mode=$2; shift 2 ;;
      --target-sha256) require_value "$@"; step_target_sha256=$2; shift 2 ;;
      --target-fingerprint) require_value "$@"; step_target_fingerprint=$2; shift 2 ;;
      --outcome) require_value "$@"; step_outcome=$2; shift 2 ;;
      --finding) require_value "$@"; step_finding=$2; shift 2 ;;
      *) die "unknown step review option: $1" ;;
    esac
  done
  test -n "$step_ledger" && test -n "$step_review_mode" &&
    test -n "$step_outcome" ||
    die "step review requires --ledger, --mode, one target input, and --outcome"
  if test -n "$step_target_sha256" && test -n "$step_target_fingerprint"; then
    die "step review accepts exactly one target input"
  fi
  if test -n "$step_target_fingerprint"; then
    step_target_sha256=$(sha256_text "$step_target_fingerprint")
  fi
  test -n "$step_target_sha256" || die "step review requires one target input"
  validate_sha256_digest "$step_target_sha256"
  validate_scalar "review finding" "$step_finding"
  case "$step_review_mode" in
    comprehensive)
      case "$step_outcome" in
        clear|blocking|unavailable|inconclusive) ;;
        *) die "unsupported comprehensive review outcome: $step_outcome" ;;
      esac
      ;;
    verify)
      case "$step_outcome" in
        clear|continue|no_progress|blocked|unavailable|inconclusive) ;;
        *) die "unsupported fix-verification outcome: $step_outcome" ;;
      esac
      ;;
    *) die "unsupported review mode: $step_review_mode" ;;
  esac
  case "$step_outcome" in
    blocking|continue|no_progress|blocked)
      test "$step_finding" != none || die "$step_outcome review outcome requires --finding"
      ;;
  esac
  load_ledger "$step_ledger"
  lock_ledger
  case "$ledger_phase" in
    active|reviewed) ;;
    *) die "review evidence requires an active owner, found $ledger_phase" ;;
  esac
  initial_outcome=$(ledger_state_value "$ledger_state" review_initial_outcome)
  last_outcome=$(ledger_state_value "$ledger_state" review_last_outcome)
  review_round_limit=$(ledger_state_value "$ledger_state" review_round_limit)
  review_count=$(ledger_state_value "$ledger_state" review_count)
  review_stop_reason=$(ledger_state_value "$ledger_state" review_stop_reason)
  test "$(ledger_state_value "$ledger_state" review_selection)" = selected ||
    die "review evidence was not selected for this goal"
  test "$review_stop_reason" = none ||
    die "review convergence already stopped: $review_stop_reason"
  if test "$step_review_mode" = comprehensive; then
    test "$initial_outcome" = none ||
      die "comprehensive review already established the closed finding set"
  else
    test "$initial_outcome" = blocking ||
      die "fix verification requires an initial blocking review"
    case "$last_outcome" in
      blocking|continue) ;;
      *) die "fix verification cannot follow terminal review outcome: $last_outcome" ;;
    esac
  fi
  next_review_count=$((review_count + 1))
  if test "$review_round_limit" != none; then
    test "$next_review_count" -le "$review_round_limit" ||
      die "explicit review-round limit was already reached"
  fi
  if grep -F -x -- "$step_target_sha256" "$ledger_targets" >/dev/null 2>&1; then
    die "review target fingerprint repeats an earlier convergence state"
  fi
  printf '%s\n' "$step_target_sha256" >>"$ledger_targets" ||
    die "could not append review target history"
  if test "$step_review_mode" = comprehensive; then
    set_ledger_value review_initial_outcome "$step_outcome"
    set_ledger_value review_initial_finding "$step_finding"
  fi
  set_ledger_value review_last_outcome "$step_outcome"
  set_ledger_value review_count "$next_review_count"
  if test "$review_round_limit" != none &&
    test "$next_review_count" -eq "$review_round_limit"; then
    case "$step_outcome" in
      blocking|continue) set_ledger_value review_stop_reason explicit-limit-reached ;;
    esac
  fi
  set_ledger_value phase reviewed
  append_ledger_event "review-$step_review_mode" "$step_outcome"
  unlock_ledger
  emit_step_record review
  printf 'mode\t%s\n' "$step_review_mode"
  printf 'target_sha256\t%s\n' "$step_target_sha256"
  printf 'outcome\t%s\n' "$step_outcome"
}

step_report() {
  step_ledger=
  step_status=
  step_human_interruptions=
  while test "$#" -gt 0; do
    case "$1" in
      --ledger) require_value "$@"; step_ledger=$2; shift 2 ;;
      --status) require_value "$@"; step_status=$2; shift 2 ;;
      --human-interruptions) require_value "$@"; step_human_interruptions=$2; shift 2 ;;
      *) die "unknown step report option: $1" ;;
    esac
  done
  test -n "$step_ledger" && test -n "$step_status" &&
    test -n "$step_human_interruptions" ||
    die "step report requires --ledger, --status, and --human-interruptions"
  case "$step_status" in
    complete|blocked|launch-required) ;;
    *) die "unsupported terminal status: $step_status" ;;
  esac
  validate_nonnegative_integer "$step_human_interruptions"
  load_ledger "$step_ledger"
  lock_ledger
  test "$(ledger_state_value "$ledger_state" reported)" = false ||
    die "terminal report was already rendered"

  workflow=$(ledger_state_value "$ledger_state" workflow)
  risk=$(ledger_state_value "$ledger_state" risk)
  profile=$(ledger_state_value "$ledger_state" profile)
  verification_gate=$(ledger_state_value "$ledger_state" verification_gate)
  effective_route=$(ledger_state_value "$ledger_state" effective_route)
  route_applied_by=$(ledger_state_value "$ledger_state" route_applied_by)
  route_verified=$(ledger_state_value "$ledger_state" route_verified)
  launch_boundary=$(ledger_state_value "$ledger_state" launch_boundary)
  child_invocations=$(ledger_state_value "$ledger_state" child_invocations)
  enforcement=$(ledger_state_value "$ledger_state" enforcement)
  objective_released=$(ledger_state_value "$ledger_state" objective_released)
  agent_id=$(ledger_state_value "$ledger_state" agent_id)
  agent_ref=$(ledger_state_value "$ledger_state" agent_ref)
  initial_outcome=$(ledger_state_value "$ledger_state" review_initial_outcome)
  initial_finding=$(ledger_state_value "$ledger_state" review_initial_finding)
  last_outcome=$(ledger_state_value "$ledger_state" review_last_outcome)
  review_stop_reason=$(ledger_state_value "$ledger_state" review_stop_reason)
  review_selection=$(ledger_state_value "$ledger_state" review_selection)
  readiness_selection=$(ledger_state_value "$ledger_state" readiness_selection)
  readiness_verdict=$(ledger_state_value "$ledger_state" readiness_verdict)
  terminal_reason=$(ledger_state_value "$ledger_state" terminal_reason)
  test "$enforcement" = helper || die "unsupported enforcement mode: $enforcement"

  if test "$workflow" = decision-gated; then
    test "$step_status" = launch-required && test "$ledger_phase" = routed ||
      die "decision-gated can only render a launch-required report after routing"
    test "$step_human_interruptions" -ge 1 ||
      die "decision-gated report requires at least one human interruption"
  else
    case "$ledger_phase" in
      active|reviewed|released|readiness-stopped|route-rejected|route-unavailable|launch-unavailable|goal-unavailable) ;;
      *) die "terminal report requires owner activation, found $ledger_phase" ;;
    esac
    test "$objective_released" = true ||
      die "file-backed objective must be released before terminal reporting"
    case "$ledger_phase" in
      route-rejected|route-unavailable|launch-unavailable|goal-unavailable)
        test "$step_status" = launch-required ||
          die "$ledger_phase requires a launch-required report"
        ;;
    esac
    case "$step_status" in
      complete)
        test "$agent_id" != pending ||
          die "complete report requires a resolved goal owner"
        test "$route_verified" = true || die "complete report requires a verified route"
        validate_resolved_owner_identity "$ledger_host" "$launch_boundary" \
          "$agent_id" "$agent_ref"
        if test "$readiness_selection" = selected; then
          test "$readiness_verdict" = ready ||
            die "complete report requires a ready implementation-readiness verdict"
        else
          test "$readiness_verdict" = none ||
            die "omitted implementation readiness has unexpected evidence"
        fi
        if test "$review_selection" = selected; then
          test "$last_outcome" = clear ||
            die "complete report requires a terminal clear independent-review outcome"
          test "$review_stop_reason" = none ||
            die "complete report cannot follow a stopped review chain"
        else
          test "$initial_outcome" = none ||
            die "omitted independent review has unexpected review evidence"
        fi
        ;;
      launch-required)
        case "$ledger_phase" in
          route-rejected|route-unavailable|launch-unavailable|goal-unavailable) ;;
          *) die "launch-required report requires unavailable or rejected launch evidence" ;;
        esac
        launch_boundary=launch_required
        route_verified=false
        if test "$agent_ref" != none; then
          test "$ledger_host" = codex ||
            die "launch-required agent reference is not an accepted Codex stop"
          test "$child_invocations" = 1 ||
            die "launch-required agent reference is not an accepted Codex stop"
          case "$terminal_reason" in
            launch-unavailable|goal-persistence-unavailable) ;;
            *) die "launch-required agent reference is not an accepted Codex stop" ;;
          esac
          validate_codex_agent_ref "$agent_ref"
        fi
        ;;
      blocked)
        test "$agent_id" != pending ||
          die "blocked report requires a resolved goal owner"
        test "$route_verified" = true ||
          die "blocked report requires a verified route"
        validate_resolved_owner_identity "$ledger_host" "$launch_boundary" \
          "$agent_id" "$agent_ref"
        if test "$readiness_selection" = selected; then
          case "$readiness_verdict" in
            ready|needs-discovery|needs-decision|blocked) ;;
            *) die "blocked report requires a recorded implementation-readiness verdict" ;;
          esac
        else
          test "$readiness_verdict" = none ||
            die "omitted implementation readiness has unexpected evidence"
        fi
        ;;
    esac
  fi

  if test "$effective_route" = none; then
    report_harness=none
    report_provider=none
    report_model=none
    report_effort=none
  else
    validate_route_tuple "ledger effective route" "$effective_route"
    old_ifs=$IFS
    IFS='|'
    read -r report_harness report_provider report_model report_effort report_extra <<EOF
$effective_route
EOF
    IFS=$old_ifs
    test -z "${report_extra:-}" || die "ledger effective route has extra fields"
  fi

  report_tmp=$(mktemp "$ledger/report.XXXXXX") ||
    die "could not allocate canonical report under: $ledger"
  {
    printf 'format: darrow-native-goal-report-v1\n'
    printf 'workflow: %s\n' "$workflow"
    printf 'risk: %s\n' "$risk"
    printf 'profile: %s\n' "$profile"
    printf 'harness: %s\n' "$report_harness"
    printf 'model: %s > %s\n' "$report_provider" "$report_model"
    printf 'effort: %s\n' "$report_effort"
    printf 'route_applied_by: %s\n' "$route_applied_by"
    printf 'route_verified: %s\n' "$route_verified"
    printf 'launch_boundary: %s\n' "$launch_boundary"
    printf 'verification_gate: %s\n' "$verification_gate"
    printf 'evaluation_child_invocations: %s\n' "$child_invocations"
    printf 'evaluation_human_interruptions: %s\n' "$step_human_interruptions"
    printf 'enforcement: %s\n' "$enforcement"
    case "$(ledger_state_value "$ledger_state" goal_persistence)" in
      confirmed) printf 'Native goal persistence: confirmed.\n' ;;
      unavailable) printf 'Native goal persistence: unavailable.\n' ;;
    esac
    case "$initial_outcome" in
      clear)
        printf 'Independent review: clear.\n'
        ;;
      blocking)
        if test "$last_outcome" = blocking; then
          printf 'Independent review: blocking — %s\n' "$initial_finding"
        else
          printf 'Initial independent review: blocking — %s\n' "$initial_finding"
          printf 'Fix verification: %s.\n' "$last_outcome"
        fi
        ;;
      unavailable)
        printf 'Independent review availability: unavailable.\n'
        ;;
      inconclusive)
        printf 'Independent review: inconclusive.\n'
        ;;
    esac
    if test "$terminal_reason" = review-unavailable && test "$initial_outcome" = none; then
      printf 'Independent review availability: unavailable.\n'
    fi
    if test "$terminal_reason" = readiness-unavailable; then
      printf 'Implementation readiness availability: unavailable.\n'
    fi
    if test "$review_stop_reason" = explicit-limit-reached; then
      printf 'Review gate: blocked — explicit limit reached.\n'
    fi
    case "$step_status" in
      complete) printf 'Native goal completed.\n' ;;
      blocked) printf 'Native goal settled as blocked.\n' ;;
      launch-required) printf 'Native goal requires host launch.\n' ;;
    esac
  } >"$report_tmp" || {
    rm -f "$report_tmp"
    die "could not render canonical report"
  }
  chmod 600 "$report_tmp" || {
    rm -f "$report_tmp"
    die "could not secure canonical report"
  }
  mv "$report_tmp" "$ledger/report" || {
    rm -f "$report_tmp"
    die "could not commit canonical report"
  }
  set_ledger_value reported true
  set_ledger_value phase reported
  append_ledger_event report "$step_status"
  unlock_ledger
  cat "$ledger/report"
}

step_dispatch() {
  test "$#" -gt 0 || die "step requires an action"
  step_action=$1
  shift
  case "$step_action" in
    start) step_start "$@" ;;
    prepare) step_prepare "$@" ;;
    route) step_route "$@" ;;
    runner) step_runner "$@" ;;
    stage) step_stage "$@" ;;
    materialize) step_materialize "$@" ;;
    release-staging) step_release_staging "$@" ;;
    activate) step_activate "$@" ;;
    goal-state) step_goal_state "$@" ;;
    observe-route) step_observe_route "$@" ;;
    readiness) step_readiness "$@" ;;
    review) step_review "$@" ;;
    launch-stop) step_launch_stop "$@" ;;
    release-objective) step_release_objective "$@" ;;
    report) step_report "$@" ;;
    *) die "unknown step action: $step_action" ;;
  esac
}

cleanup_launch_goal_attachment() {
  test "${launch_goal_attachment:-none}" != none || return 0
  discard_goal_attachment "$launch_goal_attachment"
}

launch() {
  host=
  repo=
  goal_file=
  provider=
  model=
  effort=
  allow_nested=0
  while test "$#" -gt 0; do
    case "$1" in
      --host)
        require_value "$@"
        host=$2
        shift 2
        ;;
      --repo)
        require_value "$@"
        repo=$2
        shift 2
        ;;
      --goal-file)
        require_value "$@"
        goal_file=$2
        shift 2
        ;;
      --provider)
        require_value "$@"
        provider=$2
        shift 2
        ;;
      --model)
        require_value "$@"
        model=$2
        shift 2
        ;;
      --effort)
        require_value "$@"
        effort=$2
        shift 2
        ;;
      --allow-nested)
        allow_nested=1
        shift
        ;;
      *) die "unknown launch option: $1" ;;
    esac
  done
  test -n "$host" && test -n "$repo" && test -n "$goal_file" && test -n "$provider" &&
    test -n "$model" && test -n "$effort" ||
    die "launch requires --host, --repo, --goal-file, --provider, --model, and --effort"
  test "$allow_nested" -eq 1 ||
    die "launch requires explicit --allow-nested"
  validate_host "$host"
  repo=$(absolute_dir "$repo")
  command -v "$host" >/dev/null 2>&1 || die "$host CLI is unavailable"

  materialized_records=$(materialize_objective --repo "$repo" --goal-file "$goal_file")
  objective_format=$(objective_record_value "$materialized_records" format)
  test "$objective_format" = darrow-native-goal-objective-v1 ||
    die "unknown materialized objective format: $objective_format"
  attachment_dir=$(objective_record_value "$materialized_records" attachment_dir)
  contract_sha256=$(objective_record_value "$materialized_records" contract_sha256)
  launch_goal_attachment=$attachment_dir
  trap cleanup_launch_goal_attachment EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  objective_file=$(objective_record_value "$materialized_records" objective_file)
  goal=$(cat "$objective_file")
  export DARROW_GOAL_LOOP_NESTED=1
  if test "$host" = codex; then
    nested_tmp=$(mktemp -d "${TMPDIR:-/tmp}/darrow-goal-route.XXXXXX")
    nested_events="$nested_tmp/events.jsonl"
    nested_result="$nested_tmp/final.txt"
    nested_status=0
    (
      cd "$repo"
      if test "${DARROW_GOAL_LOOP_EXTERNAL_SANDBOX:-0}" = 1; then
        codex exec "$goal" --model "$model" \
          -c "model_provider=\"$provider\"" \
          -c "model_reasoning_effort=\"$effort\"" \
          --json --dangerously-bypass-approvals-and-sandbox \
          --skip-git-repo-check -o "$nested_result"
      else
        codex exec "$goal" --model "$model" \
          -c "model_provider=\"$provider\"" \
          -c "model_reasoning_effort=\"$effort\"" \
          --json --sandbox workspace-write --skip-git-repo-check \
          -o "$nested_result"
      fi
    ) >"$nested_events" || nested_status=$?
    if test "$nested_status" -ne 0; then
      tail -n 40 "$nested_events" >&2 || true
      rm -f "$nested_events" "$nested_result"
      rmdir "$nested_tmp" 2>/dev/null || true
      return "$nested_status"
    fi
    completed_event=
    while IFS= read -r line; do
      case "$line" in
        *'"type":"turn.completed"'*) completed_event=$line ;;
      esac
    done <"$nested_events"
    if test -z "$completed_event" || test ! -r "$nested_result"; then
      rm -f "$nested_events" "$nested_result"
      rmdir "$nested_tmp" 2>/dev/null || true
      die "nested Codex session did not produce completion evidence"
    fi
    printf '%s\n' "$completed_event"
    printf 'nested_result_begin\n'
    cat "$nested_result"
    printf '\nnested_result_end\n'
    rm -f "$nested_events" "$nested_result"
    rmdir "$nested_tmp" 2>/dev/null || true
  else
    nested_status=0
    (
      cd "$repo"
      if test "${DARROW_GOAL_LOOP_EXTERNAL_SANDBOX:-0}" = 1; then
        claude -p "/goal $goal" --model "$model" --effort "$effort" \
          --dangerously-skip-permissions
      else
        claude -p "/goal $goal" --model "$model" --effort "$effort"
      fi
    ) || nested_status=$?
    if test "$nested_status" -ne 0; then
      return "$nested_status"
    fi
  fi
  if test "$attachment_dir" != none; then
    release_goal_attachment_dir "$attachment_dir" "$contract_sha256"
  fi
  launch_goal_attachment=none
  trap - EXIT HUP INT TERM

  printf 'format\tdarrow-native-goal-route-application-v1\n'
  printf 'selected_route\t%s\t%s\t%s\t%s\n' "$host" "$provider" "$model" "$effort"
  printf 'effective_route\t%s\t%s\t%s\t%s\n' "$host" "$provider" "$model" "$effort"
  printf 'route_applied_by\tnested-session\n'
  printf 'route_verified\ttrue\n'
}

test "$#" -gt 0 || {
  usage >&2
  exit 2
}
command=$1
shift
case "$command" in
  step) step_dispatch "$@" ;;
  prepare) prepare "$@" ;;
  route) route "$@" ;;
  confirm-route) confirm_route "$@" ;;
  materialize-objective) materialize_objective "$@" ;;
  release-staging) release_staging "$@" ;;
  release-objective) release_objective "$@" ;;
  launch) launch "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown command: $command" ;;
esac
