#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
transcript_parser="$script_dir/claude-route-json.awk"
LC_ALL=C
export LC_ALL

usage() {
  cat <<'EOF'
usage: claude-owner-route --repo <path> --agent-id <id> --selected-model <id> --selected-effort <level> [--projects-dir <path>]
EOF
}

die() {
  printf 'claude-owner-route: %s\n' "$*" >&2
  exit 2
}

require_value() {
  test "$#" -ge 2 && test -n "$2" || die "missing value for $1"
}

repo=
agent_id=
selected_model=
selected_effort=
projects_dir=
while test "$#" -gt 0; do
  case "$1" in
    --repo)
      require_value "$@"
      repo=$2
      shift 2
      ;;
    --agent-id)
      require_value "$@"
      agent_id=$2
      shift 2
      ;;
    --selected-model)
      require_value "$@"
      selected_model=$2
      shift 2
      ;;
    --selected-effort)
      require_value "$@"
      selected_effort=$2
      shift 2
      ;;
    --projects-dir)
      require_value "$@"
      projects_dir=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *) die "unknown option: $1" ;;
  esac
done

test -n "$repo" && test -n "$agent_id" && test -n "$selected_model" &&
  test -n "$selected_effort" || die "repo, agent id, model, and effort are required"
test -r "$transcript_parser" || die "missing transcript parser: $transcript_parser"
case "$agent_id" in
  ''|*[!A-Za-z0-9]*) die "unsafe agent id: $agent_id" ;;
esac
case "$selected_model" in
  claude-*) ;;
  *) die "selected model must be a concrete Claude model ID" ;;
esac
case "$selected_model" in
  *[!A-Za-z0-9._-]*) die "unsafe selected model: $selected_model" ;;
esac
case "$selected_effort" in
  low|medium|high|xhigh|max) ;;
  *) die "unsupported selected effort: $selected_effort" ;;
esac

for selector in \
  CLAUDE_CODE_USE_BEDROCK \
  CLAUDE_CODE_USE_MANTLE \
  CLAUDE_CODE_USE_VERTEX \
  CLAUDE_CODE_USE_FOUNDRY \
  CLAUDE_CODE_USE_ANTHROPIC_AWS; do
  selector_value=$(printenv "$selector" 2>/dev/null || true)
  test -z "$selector_value" ||
    die "Claude provider is not observably direct Anthropic: $selector is set"
done
base_url=${ANTHROPIC_BASE_URL:-}
case "$base_url" in
  ''|https://api.anthropic.com|https://api.anthropic.com/) ;;
  *) die "Claude provider is not observably direct Anthropic: ANTHROPIC_BASE_URL is custom" ;;
esac

repo=$(CDPATH='' cd -- "$repo" && pwd -P) || die "unreadable repo: $repo"
if test -z "$projects_dir"; then
  config_dir=${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}
  test -n "$config_dir" || die "Claude config directory is unavailable"
  projects_dir="$config_dir/projects"
fi
test -d "$projects_dir" || die "no Claude projects directory: $projects_dir"
projects_dir=$(CDPATH='' cd -- "$projects_dir" && pwd -P) ||
  die "unreadable Claude projects directory: $projects_dir"

project_key=$(printf '%s' "$repo" | sed 's/[^A-Za-z0-9]/-/g')
session_dir="$projects_dir/$project_key"
test -d "$session_dir" || die "no session transcripts for repo: $session_dir"

transcript=
transcript_count=0
candidate_list=$(find "$session_dir" -type f -name "agent-$agent_id.jsonl" -print) ||
  die "could not search session transcripts under $session_dir"
while IFS= read -r candidate; do
  test -n "$candidate" || continue
  test -r "$candidate" || die "unreadable transcript candidate: $candidate"
  transcript=$candidate
  transcript_count=$((transcript_count + 1))
done <<<"$candidate_list"
test "$transcript_count" -eq 1 ||
  die "expected exactly one transcript for agent $agent_id; found $transcript_count"

observations=$(awk -v expected_agent_id="$agent_id" -f "$transcript_parser" "$transcript") ||
  die "invalid transcript evidence for agent $agent_id in $transcript"
models=$(cut -f 1 <<<"$observations" | sort -u)
efforts=$(cut -f 2 <<<"$observations" | sort -u)
model_count=$(grep -c . <<<"$models" || true)
effort_count=$(grep -c . <<<"$efforts" || true)
test "$model_count" -eq 1 ||
  die "expected exactly one observed model for agent $agent_id"
test "$effort_count" -eq 1 ||
  die "expected exactly one observed effort for agent $agent_id"

confirmation=confirmed
if test "$models" != "$selected_model" || test "$efforts" != "$selected_effort"; then
  confirmation=rejected
fi
printf 'format\tdarrow-claude-owner-route-v1\n'
printf 'agent_id\t%s\n' "$agent_id"
printf 'transcript\t%s\n' "$transcript"
printf 'observed_route\tclaude\tanthropic\t%s\t%s\n' "$models" "$efforts"
printf 'selected_route\tclaude\tanthropic\t%s\t%s\n' "$selected_model" "$selected_effort"
printf 'confirmation\t%s\n' "$confirmation"
test "$confirmation" = confirmed || exit 3
