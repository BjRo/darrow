#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
routes_file="$script_dir/../config/routes.json"
routes_parser="$script_dir/routes-json.awk"
workflows_dir="$script_dir/../skills/pursue-goal/references/workflows"
tab=$(printf '\t')

usage() {
  cat <<'EOF'
usage:
  goal-loop preflight --repo <path>
  goal-loop prepare --repo <path> --host <codex|claude>
  goal-loop route --host <codex|claude> --profile <profile> [--route <harness|provider|model|effort>]
  goal-loop confirm-route --selected <harness|provider|model|effort> --effective <harness|provider|model|effort> --applied-by <current-thread|host-api|nested-session>
  goal-loop readiness --host <codex|claude>
  goal-loop launch --host <codex|claude> --repo <path> --goal-file <path> --provider <id> --model <id> --effort <level>
EOF
}

die() {
  printf 'goal-loop: %s\n' "$*" >&2
  exit 2
}

require_value() {
  test "$#" -ge 2 || die "missing value for $1"
  test -n "$2" || die "empty value for $1"
}

validate_host() {
  case "$1" in
    codex|claude) ;;
    *) die "unsupported host: $1" ;;
  esac
}

validate_profile() {
  profile_name=$1
  case "$profile_name" in
    ''|*[!a-z0-9-]*) die "unsupported profile: $profile_name" ;;
  esac
}

absolute_dir() {
  test -d "$1" || die "directory does not exist: $1"
  (CDPATH= cd -- "$1" && pwd)
}

route_records() {
  test -r "$routes_file" || die "route configuration is unreadable: $routes_file"
  test -r "$routes_parser" || die "route configuration parser is unreadable: $routes_parser"
  awk -f "$routes_parser" "$routes_file"
}

route_record() {
  route_host=$1
  route_profile=$2
  records=$(route_records)
  found=0
  while IFS="$tab" read -r host profile harness provider model effort fallback_model fallback_effort; do
    if test "$host" = "$route_host" && test "$profile" = "$route_profile"; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$harness" "$provider" "$model" "$effort" "$fallback_model" "$fallback_effort"
      found=1
      break
    fi
  done <<<"$records"
  test "$found" -eq 1 || die "no route for host=$route_host profile=$route_profile"
}

preflight() {
  repo=
  while test "$#" -gt 0; do
    case "$1" in
      --repo)
        require_value "$@"
        repo=$2
        shift 2
        ;;
      *) die "unknown preflight option: $1" ;;
    esac
  done
  test -n "$repo" || die "preflight requires --repo"
  repo=$(absolute_dir "$repo")
  git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    die "not a git working tree: $repo"

  revision=$(git -C "$repo" rev-parse HEAD)
  status=$(git -C "$repo" status --porcelain=v1 --untracked-files=all)
  if test -n "$status"; then
    tree_state=dirty
  else
    tree_state=clean
  fi

  printf 'format\tdarrow-native-goal-preflight-evidence-v1\n'
  printf 'repo\t%s\n' "$repo"
  printf 'base_revision\t%s\n' "$revision"
  printf 'working_tree\t%s\n' "$tree_state"
  if test -n "$status"; then
    while IFS= read -r line; do
      test -n "$line" || continue
      printf 'preexisting_change\t%s\n' "$line"
    done <<<"$status"
  fi
}

prepare() {
  repo=
  host=
  while test "$#" -gt 0; do
    case "$1" in
      --repo)
        require_value "$@"
        repo=$2
        shift 2
        ;;
      --host)
        require_value "$@"
        host=$2
        shift 2
        ;;
      *) die "unknown prepare option: $1" ;;
    esac
  done
  test -n "$repo" && test -n "$host" ||
    die "prepare requires --repo and --host"
  validate_host "$host"
  repo=$(absolute_dir "$repo")
  git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    die "not a git working tree: $repo"
  test -d "$workflows_dir" ||
    die "workflow directory is missing: $workflows_dir"

  revision=$(git -C "$repo" rev-parse HEAD)
  status=$(git -C "$repo" status --porcelain=v1 --untracked-files=all)
  if test -n "$status"; then
    tree_state=dirty
  else
    tree_state=clean
  fi

  printf 'format\tdarrow-native-goal-prepared-v1\n'
  printf 'repo\t%s\n' "$repo"
  printf 'base_revision\t%s\n' "$revision"
  printf 'working_tree\t%s\n' "$tree_state"
  if test -n "$status"; then
    while IFS= read -r line; do
      test -n "$line" || continue
      printf 'preexisting_change\t%s\n' "$line"
    done <<<"$status"
  fi
  for instruction_name in AGENTS.md CLAUDE.md; do
    instruction_path="$repo/$instruction_name"
    if test -e "$instruction_path"; then
      test -r "$instruction_path" ||
        die "repository instruction is unreadable: $instruction_path"
      printf 'instruction\t%s\n' "$instruction_path"
    fi
  done

  records=$(route_records)
  route_count=0
  while IFS="$tab" read -r route_host profile harness provider model effort fallback_model fallback_effort extra; do
    test -n "$profile" && test -n "$harness" && test -n "$provider" &&
      test -n "$model" && test -n "$effort" && test -n "$fallback_model" &&
      test -n "$fallback_effort" && test -z "${extra:-}" ||
      die "invalid route configuration row for profile: $profile"
    test "$route_host" = "$host" || continue
    printf 'route\t%s\t%s\t%s\t%s\t%s\n' \
      "$profile" "$harness" "$provider" "$model" "$effort"
    route_count=$((route_count + 1))
  done <<<"$records"
  test "$route_count" -gt 0 || die "no routes for host=$host"

  for workflow in fix-bug implement-feature change-feature refactor migration mechanical decision-gated; do
    workflow_file="$workflows_dir/$workflow.md"
    test -r "$workflow_file" ||
      die "workflow document is unreadable: $workflow_file"
    workflow_path=$(CDPATH= cd -- "$workflows_dir" && pwd)/$workflow.md
    printf 'workflow\t%s\t%s\n' "$workflow" "$workflow_path"
  done

}

route() {
  host=
  profile=
  explicit_route=
  while test "$#" -gt 0; do
    case "$1" in
      --host)
        require_value "$@"
        host=$2
        shift 2
        ;;
      --profile)
        require_value "$@"
        profile=$2
        shift 2
        ;;
      --route)
        require_value "$@"
        explicit_route=$2
        shift 2
        ;;
      *) die "unknown route option: $1" ;;
    esac
  done
  test -n "$host" || die "route requires --host"
  test -n "$profile" || die "route requires --profile"
  validate_host "$host"
  validate_profile "$profile"
  record=$(route_record "$host" "$profile")

  fallback_model=none
  fallback_effort=none
  if test -n "$explicit_route"; then
    old_ifs=$IFS
    IFS='|'
    read -r harness provider model effort extra <<EOF
$explicit_route
EOF
    IFS=$old_ifs
    test -n "${harness:-}" && test -n "${provider:-}" &&
      test -n "${model:-}" && test -n "${effort:-}" && test -z "${extra:-}" ||
      die "--route must be harness|provider|model|effort"
    test "$harness" = "$host" || die "explicit route must use current host: $host"
    source=user
  else
    old_ifs=$IFS
    IFS="$tab"
    read -r harness provider model effort fallback_model fallback_effort <<EOF
$record
EOF
    IFS=$old_ifs
    source=policy
  fi

  printf 'format\tdarrow-native-goal-route-v2\n'
  printf 'profile\t%s\n' "$profile"
  printf 'selected_route\t%s\t%s\t%s\t%s\n' "$harness" "$provider" "$model" "$effort"
  printf 'route_source\t%s\n' "$source"
  printf 'fallback\t%s\t%s\n' "$fallback_model" "$fallback_effort"
}

confirm_route() {
  selected=
  effective=
  applied_by=
  while test "$#" -gt 0; do
    case "$1" in
      --selected)
        require_value "$@"
        selected=$2
        shift 2
        ;;
      --effective)
        require_value "$@"
        effective=$2
        shift 2
        ;;
      --applied-by)
        require_value "$@"
        applied_by=$2
        shift 2
        ;;
      *) die "unknown confirm-route option: $1" ;;
    esac
  done
  test -n "$selected" && test -n "$effective" && test -n "$applied_by" ||
    die "confirm-route requires --selected, --effective, and --applied-by"
  case "$applied_by" in
    current-thread|host-api|nested-session) ;;
    *) die "unsupported route application boundary: $applied_by" ;;
  esac

  old_ifs=$IFS
  IFS='|'
  read -r selected_harness selected_provider selected_model selected_effort selected_extra <<EOF
$selected
EOF
  read -r effective_harness effective_provider effective_model effective_effort effective_extra <<EOF
$effective
EOF
  IFS=$old_ifs
  test -n "${selected_harness:-}" && test -n "${selected_provider:-}" &&
    test -n "${selected_model:-}" && test -n "${selected_effort:-}" &&
    test -z "${selected_extra:-}" ||
    die "--selected must be harness|provider|model|effort"
  test -n "${effective_harness:-}" && test -n "${effective_provider:-}" &&
    test -n "${effective_model:-}" && test -n "${effective_effort:-}" &&
    test -z "${effective_extra:-}" ||
    die "--effective must be harness|provider|model|effort"
  test "$selected" = "$effective" ||
    die "selected route does not match effective route"

  printf 'format\tdarrow-native-goal-route-application-v1\n'
  printf 'selected_route\t%s\t%s\t%s\t%s\n' \
    "$selected_harness" "$selected_provider" "$selected_model" "$selected_effort"
  printf 'effective_route\t%s\t%s\t%s\t%s\n' \
    "$effective_harness" "$effective_provider" "$effective_model" "$effective_effort"
  printf 'route_applied_by\t%s\n' "$applied_by"
  printf 'route_verified\ttrue\n'
}

readiness() {
  host=
  while test "$#" -gt 0; do
    case "$1" in
      --host)
        require_value "$@"
        host=$2
        shift 2
        ;;
      *) die "unknown readiness option: $1" ;;
    esac
  done
  test -n "$host" || die "readiness requires --host"
  validate_host "$host"

  printf 'format\tdarrow-native-goal-readiness-v1\n'
  printf 'host\t%s\n' "$host"
  printf 'capability\tsame_thread_goal\tcontroller_must_confirm\n'
  printf 'capability\tsame_thread_route_override\tcontroller_must_confirm\n'

  if command -v "$host" >/dev/null 2>&1; then
    executable=$(command -v "$host")
    printf 'capability\tnested_session\tinstalled_unverified\t%s\n' "$executable"
  else
    printf 'capability\tnested_session\tblocked\tinstall %s CLI\n' "$host"
  fi

  if test "$host" = codex && command -v codex >/dev/null 2>&1 &&
    codex app-server --help >/dev/null 2>&1; then
    printf 'capability\thost_api\tinstalled_unbound\tcodex app-server\n'
  else
    printf 'capability\thost_api\tcontroller_must_confirm\n'
  fi

  records=$(route_records)
  route_count=0
  while IFS="$tab" read -r route_host profile harness provider model effort fallback_model fallback_effort extra; do
    test -n "$profile" && test -n "$harness" && test -n "$provider" &&
      test -n "$model" && test -n "$effort" && test -n "$fallback_model" &&
      test -n "$fallback_effort" && test -z "${extra:-}" ||
      die "invalid route configuration row for profile: $profile"
    test "$route_host" = "$host" || continue
    printf 'route\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$profile" "$harness" "$provider" "$model" "$effort" "$fallback_model/$fallback_effort"
    route_count=$((route_count + 1))
  done <<<"$records"
  test "$route_count" -gt 0 || die "no routes for host=$host"
}

launch() {
  host=
  repo=
  goal_file=
  provider=
  model=
  effort=
  while test "$#" -gt 0; do
    case "$1" in
      --host)
        require_value "$@"
        host=$2
        shift 2
        ;;
      --repo)
        require_value "$@"
        repo=$2
        shift 2
        ;;
      --goal-file)
        require_value "$@"
        goal_file=$2
        shift 2
        ;;
      --provider)
        require_value "$@"
        provider=$2
        shift 2
        ;;
      --model)
        require_value "$@"
        model=$2
        shift 2
        ;;
      --effort)
        require_value "$@"
        effort=$2
        shift 2
        ;;
      *) die "unknown launch option: $1" ;;
    esac
  done
  test -n "$host" && test -n "$repo" && test -n "$goal_file" && test -n "$provider" &&
    test -n "$model" && test -n "$effort" ||
    die "launch requires --host, --repo, --goal-file, --provider, --model, and --effort"
  validate_host "$host"
  repo=$(absolute_dir "$repo")
  test -r "$goal_file" || die "goal file is unreadable: $goal_file"
  goal_size=$(wc -c <"$goal_file" | tr -d ' ')
  test "$goal_size" -gt 0 || die "goal file is empty: $goal_file"
  test "$goal_size" -le 4000 || die "goal exceeds 4000-byte native limit: $goal_size"
  command -v "$host" >/dev/null 2>&1 || die "$host CLI is unavailable"

  goal=$(cat "$goal_file")
  export DARROW_GOAL_LOOP_NESTED=1
  if test "$host" = codex; then
    nested_tmp=$(mktemp -d "${TMPDIR:-/tmp}/darrow-goal-route.XXXXXX")
    nested_events="$nested_tmp/events.jsonl"
    nested_result="$nested_tmp/final.txt"
    nested_status=0
    (
      cd "$repo"
      if test "${DARROW_GOAL_LOOP_EXTERNAL_SANDBOX:-0}" = 1; then
        codex exec "$goal" --model "$model" \
          -c "model_provider=\"$provider\"" \
          -c "model_reasoning_effort=\"$effort\"" \
          --json --dangerously-bypass-approvals-and-sandbox \
          --skip-git-repo-check -o "$nested_result"
      else
        codex exec "$goal" --model "$model" \
          -c "model_provider=\"$provider\"" \
          -c "model_reasoning_effort=\"$effort\"" \
          --json --sandbox workspace-write --skip-git-repo-check \
          -o "$nested_result"
      fi
    ) >"$nested_events" || nested_status=$?
    if test "$nested_status" -ne 0; then
      tail -n 40 "$nested_events" >&2 || true
      rm -f "$nested_events" "$nested_result"
      rmdir "$nested_tmp" 2>/dev/null || true
      return "$nested_status"
    fi
    completed_event=
    while IFS= read -r line; do
      case "$line" in
        *'"type":"turn.completed"'*) completed_event=$line ;;
      esac
    done <"$nested_events"
    if test -z "$completed_event" || test ! -r "$nested_result"; then
      rm -f "$nested_events" "$nested_result"
      rmdir "$nested_tmp" 2>/dev/null || true
      die "nested Codex session did not produce completion evidence"
    fi
    printf '%s\n' "$completed_event"
    printf 'nested_result_begin\n'
    cat "$nested_result"
    printf '\nnested_result_end\n'
    rm -f "$nested_events" "$nested_result"
    rmdir "$nested_tmp" 2>/dev/null || true
  else
    (
      cd "$repo"
      if test "${DARROW_GOAL_LOOP_EXTERNAL_SANDBOX:-0}" = 1; then
        claude -p "/goal $goal" --model "$model" --effort "$effort" \
          --dangerously-skip-permissions
      else
        claude -p "/goal $goal" --model "$model" --effort "$effort"
      fi
    )
  fi

  printf 'format\tdarrow-native-goal-route-application-v1\n'
  printf 'selected_route\t%s\t%s\t%s\t%s\n' "$host" "$provider" "$model" "$effort"
  printf 'effective_route\t%s\t%s\t%s\t%s\n' "$host" "$provider" "$model" "$effort"
  printf 'route_applied_by\tnested-session\n'
  printf 'route_verified\ttrue\n'
}

test "$#" -gt 0 || {
  usage >&2
  exit 2
}
command=$1
shift
case "$command" in
  preflight) preflight "$@" ;;
  prepare) prepare "$@" ;;
  route) route "$@" ;;
  confirm-route) confirm_route "$@" ;;
  readiness) readiness "$@" ;;
  launch) launch "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown command: $command" ;;
esac
