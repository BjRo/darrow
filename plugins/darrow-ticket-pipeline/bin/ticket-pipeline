#!/usr/bin/env bash
# Deterministic ticket-artifact mechanics for darrow-ticket-pipeline. The controller
# owns tracker interaction; this command only transforms exported body files.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: ticket-pipeline <command> [args]

  init --body-file <path> --run-id <id> --repo <absolute-path>
       --base-revision <revision> --baseline-file <path> --output <path>
  launch --body-file <path> --phase <phase> --iteration <n> --agent <id>
         --harness <name> --model <name> --effort <name> --output <path>
  record --body-file <path> --artifact-file <path> --output <path>
  summary --body-file <path>
  finish --body-file <path> --status verified|needs_human|blocked|failed|budget_exhausted
         [--reason-file <path>] --output <path>
EOF
  exit 64
}

fail() {
  code=$1
  shift
  printf 'error: %s\n' "$*" >&2
  exit "$code"
}

require_readable_file() {
  [ -f "$1" ] && [ -r "$1" ] || fail 2 "not a readable file: $1"
}

check_scalar() {
  name=$1
  value=$2
  [ -n "$value" ] || fail 2 "$name must not be empty"
  case "$value" in
    *$'\t'*|*$'\n'*) fail 2 "$name must be one line without tabs" ;;
  esac
}

check_run_id() {
  case "$1" in
    ''|*[!A-Za-z0-9._-]*) fail 2 "run id must use only letters, digits, dot, underscore, or hyphen" ;;
  esac
  [ "${#1}" -le 128 ] || fail 2 "run id must be at most 128 characters"
}

header_value() {
  file=$1
  number=$2
  expected_key=$3
  line=$(sed -n "${number}p" "$file")
  case "$line" in
    "$expected_key"$'\t'*) ;;
    *) fail 4 "artifact line $number must be $expected_key<TAB>value" ;;
  esac
  value=${line#*$'\t'}
  case "$value" in
    ''|*$'\t'*) fail 4 "artifact field $expected_key must contain one non-empty value" ;;
  esac
  printf '%s' "$value"
}

check_table_scalar() {
  name=$1
  value=$2
  limit=$3
  case "$value" in
    ''|*'|'*|*$'\t'*|*$'\n'*) fail 4 "$name is empty or contains a table delimiter" ;;
  esac
  [ "${#value}" -le "$limit" ] || fail 4 "$name exceeds $limit characters"
}

check_phase_status() {
  phase=$1
  status=$2
  case "$phase:$status" in
    refine:complete|refine:needs_human|refine:blocked|\
    challenge:approved|challenge:needs_revision|challenge:needs_human|challenge:blocked|\
    implement:complete|implement:failed|implement:needs_human|implement:blocked|\
    review:approved|review:changes_requested|review:needs_human|review:blocked|\
    rework:complete|rework:failed|rework:needs_human|rework:blocked|\
    qa:passed|qa:failed|qa:needs_human|qa:blocked|\
    codify:complete|codify:no_change|codify:needs_human|codify:blocked) return 0 ;;
    refine:*|challenge:*|implement:*|review:*|rework:*|qa:*|codify:*)
      fail 4 "status $status is invalid for phase $phase" ;;
    *) fail 4 "unknown phase: $phase" ;;
  esac
}

phase_iteration_limit() {
  case "$1" in
    refine|challenge) printf '3' ;;
    review|qa|rework) printf '2' ;;
    implement|codify) printf '1' ;;
  esac
}

is_phase() {
  case "$1" in refine|challenge|implement|review|rework|qa|codify) return 0 ;; *) return 1 ;; esac
}

ticket_field() {
  body=$1
  key=$2
  TP_FIELD=$key awk -F '\t' '
    $0 == "## Ticket Pipeline Run" {inside=1; next}
    inside && /^## / {inside=0}
    inside && $1 == ENVIRON["TP_FIELD"] {
      if (NF != 2 || found) exit 4
      value=$2; found=1
    }
    END {if (!found) exit 3; print value}
  ' "$body"
}

phase_state() {
  body=$1
  phase=$2
  TP_PHASE=$phase awk '
    $0 == "## Ticket Pipeline Phase State" {inside=1; next}
    inside && /^## / {inside=0}
    inside && $0 ~ "^\\| " ENVIRON["TP_PHASE"] " \\|" {
      if (found) exit 4
      split($0, fields, "|")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", fields[3])
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", fields[4])
      print fields[3] "\t" fields[4]; found=1
    }
    END {if (!found) exit 3}
  ' "$body"
}

phase_status() {
  phase_state "$1" "$2" | awk -F '\t' '{print $1}'
}

phase_iteration() {
  phase_state "$1" "$2" | awk -F '\t' '{print $2}'
}

last_ledger_phase() {
  awk '
    $0 == "## Ticket Pipeline Execution Ledger" {inside=1; next}
    inside && /^## / {inside=0}
    inside && /^\| [a-z]+ \| [0-9]+ \|/ {
      split($0, fields, "|"); gsub(/^[[:space:]]+|[[:space:]]+$/, "", fields[2]); last=fields[2]
    }
    END {print last}
  ' "$1"
}

validate_ticket() {
  body=$1
  require_readable_file "$body"
  body_format=$(ticket_field "$body" format) || fail 4 "ticket body has no valid Ticket Pipeline Run format"
  [ "$body_format" = darrow-ticket-pipeline-ticket-v1 ] || fail 4 "unsupported ticket body format: $body_format"
  run_id=$(ticket_field "$body" run_id) || fail 4 "ticket body has no valid run id"
  run_state=$(ticket_field "$body" state) || fail 4 "ticket body has no valid run state"
  case "$run_state" in active|verified|needs_human|blocked|failed|budget_exhausted) ;; *) fail 4 "unknown ticket run state: $run_state" ;; esac
  validation_status=0
  TP_RUN_ID=$run_id TP_RUN_STATE=$run_state awk -F '\t' '
    function trim(value) {gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); return value}
    function valid_phase(value) {return value ~ /^(refine|challenge|implement|review|rework|qa|codify)$/}
    function valid_status(phase, value) {
      if (value == "launched") return 1
      if (phase == "refine") return value ~ /^(complete|needs_human|blocked)$/
      if (phase == "challenge") return value ~ /^(approved|needs_revision|needs_human|blocked)$/
      if (phase == "implement") return value ~ /^(complete|failed|needs_human|blocked)$/
      if (phase == "review") return value ~ /^(approved|changes_requested|needs_human|blocked)$/
      if (phase == "rework") return value ~ /^(complete|failed|needs_human|blocked)$/
      if (phase == "qa") return value ~ /^(passed|failed|needs_human|blocked)$/
      if (phase == "codify") return value ~ /^(complete|no_change|needs_human|blocked)$/
      return 0
    }
    function dependency_ok(phase, iteration) {
      if (iteration != simulated_iteration[phase] + 1) return 0
      if (phase == "refine") return iteration == 1 || (simulated_status["challenge"] == "needs_revision" && simulated_iteration["challenge"] == iteration - 1)
      if (phase == "challenge") return simulated_status["refine"] == "complete" && simulated_iteration["refine"] == iteration
      if (phase == "implement") return iteration == 1 && simulated_status["challenge"] == "approved"
      if (phase == "review") {
        if (iteration == 1) return simulated_status["implement"] == "complete"
        return iteration == 2 && simulated_status["review"] == "changes_requested" && simulated_status["rework"] == "complete" && last_phase == "rework"
      }
      if (phase == "rework") {
        if (simulated_status["qa"] == "failed") return simulated_iteration["qa"] < 2
        return simulated_status["review"] == "changes_requested" && simulated_iteration["review"] < 2
      }
      if (phase == "qa") {
        if (iteration == 1) return simulated_status["review"] == "approved"
        return iteration == 2 && simulated_status["qa"] == "failed" && simulated_status["rework"] == "complete" && last_phase == "rework"
      }
      if (phase == "codify") return iteration == 1 && simulated_status["review"] == "approved" && simulated_status["qa"] == "passed"
      return 0
    }
    $0 == "## Ticket Pipeline Run" {run_sections++}
    $0 == "## Ticket Pipeline Phase State" {state_sections++; section="state"; next}
    $0 == "## Ticket Pipeline Execution Ledger" {ledger_sections++; section="ledger"; next}
    $0 == "## Ticket Pipeline User Work Baseline" {baseline_sections++; section="baseline"; next}
    /^## Ticket Pipeline/ && $0 !~ /^## Ticket Pipeline Artifact — / && $0 != "## Ticket Pipeline Run" && $0 != "## Ticket Pipeline Phase State" && $0 != "## Ticket Pipeline Execution Ledger" && $0 != "## Ticket Pipeline User Work Baseline" && $0 != "## Ticket Pipeline Escalation" {exit 40}
    /^## Ticket Pipeline/ && $0 !~ /^## Ticket Pipeline Artifact — / {section=""}
    section == "state" && /^\| (refine|challenge|implement|review|rework|qa|codify) \|/ {
      split($0, f, "|"); phase=trim(f[2]); status=trim(f[3]); iteration=trim(f[4])
      if (phase in phase_seen || iteration !~ /^[0-9]+$/) exit 41
      phase_seen[phase]=1; phase_status[phase]=status; phase_iteration[phase]=iteration+0
      next
    }
    section == "ledger" && /^\| (refine|challenge|implement|review|rework|qa|codify) \| [0-9]+ \|/ {
      split($0, f, "|")
      phase=trim(f[2]); iteration=trim(f[3]); agent=trim(f[4]); harness=trim(f[5]); model=trim(f[6]); effort=trim(f[7]); status=trim(f[8]); summary=trim(f[9])
      if (!valid_phase(phase) || iteration !~ /^[1-9][0-9]*$/ || agent == "" || harness == "" || model == "" || effort == "" || summary == "" || !valid_status(phase,status)) exit 42
      if (!dependency_ok(phase, iteration+0)) exit 42
      key=phase SUBSEP iteration
      if (key in ledger_seen) exit 43
      ledger_seen[key]=1; ledger_agent[key]=agent; ledger_status[key]=status; ledger_summary[key]=summary
      if (iteration+0 > ledger_latest[phase]) {ledger_latest[phase]=iteration+0; ledger_latest_status[phase]=status}
      simulated_iteration[phase]=iteration+0; simulated_status[phase]=(status == "launched" ? "in_progress" : status); last_phase=phase
      ledger_count++
      next
    }
    /^## Ticket Pipeline Artifact — / {
      heading=$0; sub(/^## Ticket Pipeline Artifact — /, "", heading)
      if (split(heading, h, " — Iteration ") != 2 || !valid_phase(h[1]) || h[2] !~ /^[1-9][0-9]*$/) exit 44
      artifact_phase=h[1]; artifact_iteration=h[2]; artifact_line=-1; section="artifact"
      key=artifact_phase SUBSEP artifact_iteration
      if (key in artifact_seen) exit 45
      artifact_seen[key]=1
      next
    }
    section == "artifact" && artifact_line < 8 {
      if (artifact_line == -1) {if ($0 != "") exit 46; artifact_line=0; next}
      artifact_line++
      if (artifact_line < 8) {
        field_count=split($0, a, "\t"); if (field_count != 2 || a[2] == "") exit 46
        expected_key[1]="format"; expected_key[2]="run_id"; expected_key[3]="phase"; expected_key[4]="iteration"; expected_key[5]="agent"; expected_key[6]="status"; expected_key[7]="summary"
        if (a[1] != expected_key[artifact_line]) exit 46
        artifact_value[artifact_line]=a[2]
      } else {
        if ($0 != "---") exit 47
        key=artifact_phase SUBSEP artifact_iteration
        if (artifact_value[1] != "darrow-ticket-pipeline-phase-v1" || artifact_value[2] != ENVIRON["TP_RUN_ID"] || artifact_value[3] != artifact_phase || artifact_value[4] != artifact_iteration || artifact_value[5] != ledger_agent[key] || artifact_value[6] != ledger_status[key] || artifact_value[7] != ledger_summary[key]) exit 48
        artifact_count++
        section="artifact_evidence"; current_artifact_key=key
        for (delete_index=1; delete_index<=7; delete_index++) delete artifact_value[delete_index]
      }
      next
    }
    section == "artifact_evidence" && NF {artifact_evidence[current_artifact_key]=1}
    END {
      if (run_sections != 1 || state_sections != 1 || ledger_sections != 1 || baseline_sections != 1) exit 49
      split("refine challenge implement review rework qa codify", phases, " ")
      for (i=1; i<=7; i++) {
        phase=phases[i]
        if (!(phase in phase_seen)) exit 50
        if (phase_status[phase] == "pending") {
          if (phase_iteration[phase] != 0 || ledger_latest[phase] != 0) exit 51
        } else {
          if (phase_iteration[phase] != ledger_latest[phase]) exit 52
          expected=(ledger_latest_status[phase] == "launched" ? "in_progress" : ledger_latest_status[phase])
          if (phase_status[phase] != expected) exit 53
        }
      }
      for (key in ledger_seen) {
        if (ledger_status[key] == "launched") launched_count++
        else if (!(key in artifact_seen) || !(key in artifact_evidence)) exit 54
      }
      if (artifact_count + launched_count != ledger_count) exit 55
      if (ENVIRON["TP_RUN_STATE"] == "verified" && !(phase_status["challenge"] == "approved" && phase_status["implement"] == "complete" && phase_status["review"] == "approved" && phase_status["qa"] == "passed" && phase_status["codify"] ~ /^(complete|no_change)$/ && launched_count == 0)) exit 56
    }
  ' "$body" || validation_status=$?
  [ "$validation_status" -eq 0 ] || fail 4 "ticket Ticket Pipeline sections, ledger, or artifacts are contradictory (validation $validation_status)"
}

assert_no_terminal_phase() {
  body=$1
  for checked_phase in refine challenge implement review rework qa codify; do
    checked_status=$(phase_status "$body" "$checked_phase") || fail 4 "ticket phase table is malformed"
    if [ "$checked_phase" = qa ] && [ "$checked_status" = failed ]; then
      continue
    fi
    case "$checked_status" in
      needs_human|blocked|failed) fail 4 "run already has terminal phase $checked_phase:$checked_status" ;;
    esac
  done
}

assert_phase_dependency() {
  body=$1
  phase=$2
  iteration=$3
  assert_no_terminal_phase "$body"
  refine_status=$(phase_status "$body" refine) || fail 4 "ticket phase table is malformed"
  refine_iteration=$(phase_iteration "$body" refine) || fail 4 "ticket phase table is malformed"
  challenge_status=$(phase_status "$body" challenge) || fail 4 "ticket phase table is malformed"
  challenge_iteration=$(phase_iteration "$body" challenge) || fail 4 "ticket phase table is malformed"
  implement_status=$(phase_status "$body" implement) || fail 4 "ticket phase table is malformed"
  review_status=$(phase_status "$body" review) || fail 4 "ticket phase table is malformed"
  review_iteration=$(phase_iteration "$body" review) || fail 4 "ticket phase table is malformed"
  rework_status=$(phase_status "$body" rework) || fail 4 "ticket phase table is malformed"
  qa_status=$(phase_status "$body" qa) || fail 4 "ticket phase table is malformed"
  qa_iteration=$(phase_iteration "$body" qa) || fail 4 "ticket phase table is malformed"

  case "$phase" in
    refine)
      if [ "$iteration" -eq 1 ]; then
        [ "$refine_status" = pending ] || fail 4 "first refinement is already recorded"
      else
        [ "$challenge_status" = needs_revision ] && [ "$challenge_iteration" -eq $((iteration - 1)) ] || \
          fail 4 "refinement iteration $iteration requires challenge iteration $((iteration - 1)) needs_revision"
      fi
      ;;
    challenge)
      [ "$refine_status" = complete ] && [ "$refine_iteration" -eq "$iteration" ] || \
        fail 4 "challenge iteration $iteration requires matching completed refinement"
      ;;
    implement)
      [ "$challenge_status" = approved ] || fail 4 "implementation requires an approved challenge"
      ;;
    review)
      [ "$implement_status" = complete ] || fail 4 "review requires completed implementation"
      if [ "$iteration" -eq 2 ]; then
        [ "$review_status" = changes_requested ] && [ "$review_iteration" -eq 1 ] && [ "$rework_status" = complete ] || \
          fail 4 "second review requires first-review findings and completed rework"
        [ "$(last_ledger_phase "$body")" = rework ] || fail 4 "second review requires rework after the first review"
      fi
      ;;
    rework)
      if [ "$qa_status" = failed ]; then
        [ "$qa_iteration" -lt 2 ] || fail 4 "QA repair limit is exhausted after attempt $qa_iteration"
      elif [ "$review_status" = changes_requested ]; then
        [ "$review_iteration" -lt 2 ] || fail 4 "review repair limit is exhausted after pass $review_iteration"
      else
        fail 4 "rework requires review findings or failed QA"
      fi
      ;;
    qa)
      [ "$review_status" = approved ] || fail 4 "QA requires an approved review"
      if [ "$iteration" -eq 2 ]; then
        [ "$qa_status" = failed ] && [ "$qa_iteration" -eq 1 ] && [ "$rework_status" = complete ] || \
          fail 4 "second QA requires first-attempt failure and completed rework"
        [ "$(last_ledger_phase "$body")" = rework ] || fail 4 "second QA requires rework after the first QA"
      fi
      ;;
    codify)
      [ "$review_status" = approved ] && [ "$qa_status" = passed ] || \
        fail 4 "codify requires approved review and passed QA"
      ;;
  esac
}

next_phase() {
  body=$1
  for checked_phase in refine challenge implement review rework qa codify; do
    checked_status=$(phase_status "$body" "$checked_phase") || fail 4 "ticket phase table is malformed"
    [ "$checked_status" = in_progress ] && { printf 'finish'; return; }
    case "$checked_status" in needs_human|blocked|failed) printf 'finish'; return ;; esac
  done
  refine_status=$(phase_status "$body" refine)
  refine_iteration=$(phase_iteration "$body" refine)
  challenge_status=$(phase_status "$body" challenge)
  challenge_iteration=$(phase_iteration "$body" challenge)
  implement_status=$(phase_status "$body" implement)
  review_status=$(phase_status "$body" review)
  review_iteration=$(phase_iteration "$body" review)
  rework_status=$(phase_status "$body" rework)
  qa_status=$(phase_status "$body" qa)
  qa_iteration=$(phase_iteration "$body" qa)
  codify_status=$(phase_status "$body" codify)
  last_phase=$(last_ledger_phase "$body")
  if [ "$challenge_status" = needs_revision ] && [ "$challenge_iteration" -ge 3 ]; then printf 'finish'
  elif [ "$refine_status" = pending ] || [ "$challenge_status" = needs_revision ]; then printf 'refine'
  elif [ "$challenge_status" = pending ] || [ "$refine_iteration" -gt "$challenge_iteration" ]; then printf 'challenge'
  elif [ "$implement_status" = pending ]; then printf 'implement'
  elif [ "$review_status" = pending ]; then printf 'review'
  elif [ "$review_status" = changes_requested ]; then
    if [ "$review_iteration" -ge 2 ]; then printf 'finish'
    elif [ "$last_phase" = rework ] && [ "$rework_status" = complete ]; then printf 'review'
    else printf 'rework'; fi
  elif [ "$qa_status" = pending ]; then printf 'qa'
  elif [ "$qa_status" = failed ]; then
    if [ "$qa_iteration" -ge 2 ]; then printf 'finish'
    elif [ "$last_phase" = rework ] && [ "$rework_status" = complete ]; then printf 'qa'
    else printf 'rework'; fi
  elif [ "$codify_status" = pending ]; then printf 'codify'
  else printf 'complete'
  fi
}

write_initialized_body() {
  input=$1
  run_id=$2
  repo=$3
  base_revision=$4
  baseline_file=$5
  output=$6

  [ ! -e "$output" ] || fail 4 "refusing to overwrite output: $output"
  output_dir=${output%/*}
  if [ "$output_dir" = "$output" ]; then output_dir=.; fi
  [ -d "$output_dir" ] && [ -w "$output_dir" ] || fail 2 "output directory is not writable: $output_dir"
  temp_output=$output_dir/.darrow-ticket-pipeline.$$.tmp
  trap 'rm -f "${temp_output:-}"' EXIT
  umask 077
  {
    cat "$input"
    printf '\n\n## Ticket Pipeline Run\n\n'
    printf 'format\tdarrow-ticket-pipeline-ticket-v1\n'
    printf 'run_id\t%s\n' "$run_id"
    printf 'state\tactive\n'
    printf 'repository\t%s\n' "$repo"
    printf 'base_revision\t%s\n' "$base_revision"
    printf '\n## Ticket Pipeline User Work Baseline\n\n```text\n'
    if [ -s "$baseline_file" ]; then cat "$baseline_file"; else printf '(clean)\n'; fi
    printf '```\n'
    printf '\n## Ticket Pipeline Phase State\n\n'
    printf '| Phase | Status | Iteration |\n'
    printf '| --- | --- | ---: |\n'
    for phase in refine challenge implement review rework qa codify; do
      printf '| %s | pending | 0 |\n' "$phase"
    done
    printf '\n## Ticket Pipeline Execution Ledger\n\n'
    printf '| Phase | Iteration | Agent | Harness | Model | Effort | Status | Summary |\n'
    printf '| --- | ---: | --- | --- | --- | --- | --- | --- |\n'
  } >"$temp_output"
  mv "$temp_output" "$output"
  temp_output=
  trap - EXIT
}

launch_phase() {
  body=$1 phase=$2 iteration=$3 agent=$4 harness=$5 model=$6 effort=$7 output=$8
  validate_ticket "$body"
  [ "$(ticket_field "$body" state)" = active ] || fail 4 "cannot launch a child on a non-active run"
  is_phase "$phase" || fail 2 "unknown phase: $phase"
  case "$iteration" in ''|*[!0-9]*) fail 2 "iteration must be a positive integer" ;; esac
  [ "$iteration" -gt 0 ] || fail 2 "iteration must be a positive integer"
  [ "$iteration" -le "$(phase_iteration_limit "$phase")" ] || fail 4 "$phase iteration exceeds its limit"
  check_table_scalar "agent" "$agent" 128
  check_table_scalar "harness" "$harness" 128
  check_table_scalar "model" "$model" 128
  check_table_scalar "effort" "$effort" 128
  assert_phase_dependency "$body" "$phase" "$iteration"
  [ "$(phase_status "$body" "$phase")" != in_progress ] || fail 4 "$phase already has an in-flight child"
  current_iteration=$(phase_iteration "$body" "$phase")
  [ "$iteration" -eq $((current_iteration + 1)) ] || fail 4 "$phase iteration must advance exactly once"
  [ ! -e "$output" ] || fail 4 "refusing to overwrite output: $output"
  output_dir=${output%/*}; [ "$output_dir" != "$output" ] || output_dir=.
  [ -d "$output_dir" ] && [ -w "$output_dir" ] || fail 2 "output directory is not writable: $output_dir"
  state_temp=$output_dir/.darrow-ticket-pipeline-launch-state.$$.tmp
  temp_output=$output_dir/.darrow-ticket-pipeline-launch.$$.tmp
  trap 'rm -f "${state_temp:-}" "${temp_output:-}"' EXIT
  TP_PHASE=$phase TP_ITERATION=$iteration awk '
    $0 == "## Ticket Pipeline Phase State" {inside=1}
    inside && /^## / && $0 != "## Ticket Pipeline Phase State" {inside=0}
    inside && $0 ~ "^\\| " ENVIRON["TP_PHASE"] " \\|" {print "| " ENVIRON["TP_PHASE"] " | in_progress | " ENVIRON["TP_ITERATION"] " |"; changed=1; next}
    {print}
    END {if (!changed) exit 4}
  ' "$body" >"$state_temp" || fail 4 "could not persist in-flight phase state"
  launch_row="| $phase | $iteration | $agent | $harness | $model | $effort | launched | child launch persisted |"
  TP_LEDGER_ROW=$launch_row awk '
    $0 == "## Ticket Pipeline Execution Ledger" {inside=1}
    inside && /^## / && $0 != "## Ticket Pipeline Execution Ledger" {print ENVIRON["TP_LEDGER_ROW"]; inserted=1; inside=0}
    {print}
    END {if (inside) {print ENVIRON["TP_LEDGER_ROW"]; inserted=1}; if (!inserted) exit 4}
  ' "$state_temp" >"$temp_output" || fail 4 "could not persist launch ledger row"
  mv "$temp_output" "$output"
  state_temp= temp_output=; trap - EXIT
  printf 'phase\t%s\t%s\nbody\t%s\n' "$phase" "$iteration" "$output"
}

record_artifact() {
  body=$1
  artifact=$2
  output=$3
  require_readable_file "$body"
  require_readable_file "$artifact"
  [ ! -e "$output" ] || fail 4 "refusing to overwrite output: $output"

  artifact_format=$(header_value "$artifact" 1 format)
  artifact_run_id=$(header_value "$artifact" 2 run_id)
  artifact_phase=$(header_value "$artifact" 3 phase)
  artifact_iteration=$(header_value "$artifact" 4 iteration)
  artifact_agent=$(header_value "$artifact" 5 agent)
  artifact_status=$(header_value "$artifact" 6 status)
  artifact_summary=$(header_value "$artifact" 7 summary)
  [ "$artifact_format" = darrow-ticket-pipeline-phase-v1 ] || fail 4 "unsupported artifact format: $artifact_format"
  [ "$(sed -n '8p' "$artifact")" = '---' ] || fail 4 "artifact line 8 must be ---"
  awk 'NR > 8 && NF {found=1} END {exit found ? 0 : 1}' "$artifact" || fail 4 "artifact Markdown evidence is empty"
  artifact_evidence=$(sed -n '9,$p' "$artifact")
  if grep -E '^## Ticket Pipeline([[:space:]]|$)' >/dev/null <<<"$artifact_evidence"; then
    fail 4 "artifact Markdown must not create pipeline-owned headings"
  fi
  check_run_id "$artifact_run_id"
  case "$artifact_iteration" in ''|*[!0-9]*) fail 4 "artifact iteration must be a positive integer" ;; esac
  [ "$artifact_iteration" -gt 0 ] || fail 4 "artifact iteration must be a positive integer"
  check_phase_status "$artifact_phase" "$artifact_status"
  iteration_limit=$(phase_iteration_limit "$artifact_phase")
  [ "$artifact_iteration" -le "$iteration_limit" ] || fail 4 "$artifact_phase iteration exceeds limit $iteration_limit"
  check_table_scalar "artifact agent" "$artifact_agent" 128
  check_table_scalar "artifact summary" "$artifact_summary" 500

  body_format=$(ticket_field "$body" format) || fail 4 "ticket body has no valid Ticket Pipeline Run format"
  [ "$body_format" = darrow-ticket-pipeline-ticket-v1 ] || fail 4 "unsupported ticket body format: $body_format"
  body_run_id=$(ticket_field "$body" run_id) || fail 4 "ticket body has no valid run id"
  [ "$body_run_id" = "$artifact_run_id" ] || fail 4 "artifact run $artifact_run_id does not match ticket run $body_run_id"
  body_state=$(ticket_field "$body" state) || fail 4 "ticket body has no valid run state"
  [ "$body_state" = active ] || fail 4 "cannot record an artifact on a $body_state run"
  validate_ticket "$body"
  [ "$(phase_status "$body" "$artifact_phase")" = in_progress ] || fail 4 "artifact has no durable in-flight launch"
  [ "$(phase_iteration "$body" "$artifact_phase")" -eq "$artifact_iteration" ] || fail 4 "artifact iteration does not match the in-flight launch"

  heading="## Ticket Pipeline Artifact — $artifact_phase — Iteration $artifact_iteration"
  if grep -F -x "$heading" "$body" >/dev/null; then
    fail 4 "artifact already exists for $artifact_phase iteration $artifact_iteration"
  fi

  output_dir=${output%/*}
  if [ "$output_dir" = "$output" ]; then output_dir=.; fi
  [ -d "$output_dir" ] && [ -w "$output_dir" ] || fail 2 "output directory is not writable: $output_dir"
  state_temp=$output_dir/.darrow-ticket-pipeline-state.$$.tmp
  ledger_temp=$output_dir/.darrow-ticket-pipeline-ledger.$$.tmp
  temp_output=$output_dir/.darrow-ticket-pipeline-record.$$.tmp
  trap 'rm -f "${state_temp:-}" "${ledger_temp:-}" "${temp_output:-}"' EXIT
  umask 077

  TP_PHASE=$artifact_phase TP_STATUS=$artifact_status TP_ITERATION=$artifact_iteration awk '
    $0 == "## Ticket Pipeline Phase State" {inside=1}
    inside && /^## / && $0 != "## Ticket Pipeline Phase State" {inside=0}
    inside && $0 ~ "^\\| " ENVIRON["TP_PHASE"] " \\|" {
      print "| " ENVIRON["TP_PHASE"] " | " ENVIRON["TP_STATUS"] " | " ENVIRON["TP_ITERATION"] " |"
      changed=1; next
    }
    {print}
    END {if (!changed) exit 4}
  ' "$body" >"$state_temp" || fail 4 "could not update the phase table"

  TP_PHASE=$artifact_phase TP_ITERATION=$artifact_iteration TP_AGENT=$artifact_agent TP_STATUS=$artifact_status TP_SUMMARY=$artifact_summary awk '
    $0 == "## Ticket Pipeline Execution Ledger" {inside=1}
    inside && /^## / && $0 != "## Ticket Pipeline Execution Ledger" {inside=0}
    inside && $0 ~ "^\\| " ENVIRON["TP_PHASE"] " \\| " ENVIRON["TP_ITERATION"] " \\|" {
      split($0, fields, "|")
      for (i=2; i<=9; i++) gsub(/^[[:space:]]+|[[:space:]]+$/, "", fields[i])
      if (fields[4] != ENVIRON["TP_AGENT"] || fields[8] != "launched") exit 4
      print "| " fields[2] " | " fields[3] " | " fields[4] " | " fields[5] " | " fields[6] " | " fields[7] " | " ENVIRON["TP_STATUS"] " | " ENVIRON["TP_SUMMARY"] " |"
      changed=1; next
    }
    {print}
    END {if (!changed) exit 4}
  ' "$state_temp" >"$ledger_temp" || fail 4 "could not update the execution ledger"

  {
    cat "$ledger_temp"
    printf '\n%s\n\n' "$heading"
    cat "$artifact"
    printf '\n'
  } >"$temp_output"
  mv "$temp_output" "$output"
  state_temp=
  ledger_temp=
  temp_output=
  trap - EXIT
  printf 'run_id\t%s\n' "$artifact_run_id"
  printf 'phase\t%s\t%s\n' "$artifact_phase" "$artifact_status"
  printf 'body\t%s\n' "$output"
}

summarize_body() {
  body=$1
  validate_ticket "$body"
  body_format=$(ticket_field "$body" format) || fail 4 "ticket body has no valid Ticket Pipeline Run format"
  [ "$body_format" = darrow-ticket-pipeline-ticket-v1 ] || fail 4 "unsupported ticket body format: $body_format"
  run_id=$(ticket_field "$body" run_id) || fail 4 "ticket body has no valid run id"
  state=$(ticket_field "$body" state) || fail 4 "ticket body has no valid state"
  printf 'format\tdarrow-ticket-pipeline-summary-v1\n'
  printf 'run_id\t%s\n' "$run_id"
  printf 'state\t%s\n' "$state"
  for phase in refine challenge implement review rework qa codify; do
    phase_record=$(phase_state "$body" "$phase") || fail 4 "ticket phase table is malformed"
    printf 'phase\t%s\t%s\n' "$phase" "$phase_record"
  done
  if [ "$state" = active ]; then
    printf 'next_phase\t%s\n' "$(next_phase "$body")"
  else
    printf 'next_phase\tnone\n'
  fi
}

finish_body() {
  body=$1
  status=$2
  reason_file=$3
  output=$4
  validate_ticket "$body"
  case "$status" in verified|needs_human|blocked|failed|budget_exhausted) ;; *) fail 2 "invalid finish status: $status" ;; esac
  [ ! -e "$output" ] || fail 4 "refusing to overwrite output: $output"
  state=$(ticket_field "$body" state) || fail 4 "ticket body has no valid state"
  [ "$state" = active ] || fail 4 "cannot finish a $state run"
  if [ "$status" = needs_human ]; then
    [ -n "$reason_file" ] || fail 2 "needs_human requires --reason-file"
    require_readable_file "$reason_file"
    awk 'NF {found=1} END {exit found ? 0 : 1}' "$reason_file" || fail 2 "reason file is empty"
    if grep -E '^## Ticket Pipeline' "$reason_file" >/dev/null; then
      fail 2 "reason file must not create pipeline-owned headings"
    fi
  elif [ -n "$reason_file" ]; then
    fail 2 "--reason-file is only valid with needs_human"
  fi
  if [ "$status" = verified ]; then
    [ "$(phase_status "$body" challenge)" = approved ] || fail 4 "verified requires approved challenge"
    [ "$(phase_status "$body" implement)" = complete ] || fail 4 "verified requires completed implementation"
    [ "$(phase_status "$body" review)" = approved ] || fail 4 "verified requires approved review"
    [ "$(phase_status "$body" qa)" = passed ] || fail 4 "verified requires passed QA"
    codify_status=$(phase_status "$body" codify)
    case "$codify_status" in complete|no_change) ;; *) fail 4 "verified requires codify evidence" ;; esac
    [ "$(next_phase "$body")" = complete ] || fail 4 "verified run is not converged"
  fi
  output_dir=${output%/*}
  if [ "$output_dir" = "$output" ]; then output_dir=.; fi
  [ -d "$output_dir" ] && [ -w "$output_dir" ] || fail 2 "output directory is not writable: $output_dir"
  state_temp=$output_dir/.darrow-ticket-pipeline-finish-state.$$.tmp
  temp_output=$output_dir/.darrow-ticket-pipeline-finish.$$.tmp
  trap 'rm -f "${state_temp:-}" "${temp_output:-}"' EXIT
  TP_STATUS=$status awk -F '\t' 'BEGIN {OFS="\t"}
    $0 == "## Ticket Pipeline Run" {inside=1}
    inside && /^## / && $0 != "## Ticket Pipeline Run" {inside=0}
    inside && $1 == "state" {$2=ENVIRON["TP_STATUS"]; changed=1}
    {print}
    END {if (!changed) exit 4}
  ' "$body" >"$state_temp" || fail 4 "could not update run state"
  if [ "$status" = needs_human ]; then
    {
      cat "$state_temp"
      printf '\n## Ticket Pipeline Escalation\n\n'
      cat "$reason_file"
      printf '\n'
    } >"$temp_output"
  else
    cp "$state_temp" "$temp_output"
  fi
  mv "$temp_output" "$output"
  state_temp=
  temp_output=
  trap - EXIT
  printf 'run_id\t%s\n' "$(ticket_field "$output" run_id)"
  printf 'status\t%s\n' "$status"
  printf 'body\t%s\n' "$output"
}

command=${1:-}
[ -n "$command" ] || usage
shift

case "$command" in
  init)
    body_file=
    run_id=
    repo=
    base_revision=
    baseline_file=
    output=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --body-file) [ "$#" -ge 2 ] || fail 2 "--body-file needs a value"; body_file=$2; shift 2 ;;
        --run-id) [ "$#" -ge 2 ] || fail 2 "--run-id needs a value"; run_id=$2; shift 2 ;;
        --repo) [ "$#" -ge 2 ] || fail 2 "--repo needs a value"; repo=$2; shift 2 ;;
        --base-revision) [ "$#" -ge 2 ] || fail 2 "--base-revision needs a value"; base_revision=$2; shift 2 ;;
        --baseline-file) [ "$#" -ge 2 ] || fail 2 "--baseline-file needs a value"; baseline_file=$2; shift 2 ;;
        --output) [ "$#" -ge 2 ] || fail 2 "--output needs a value"; output=$2; shift 2 ;;
        *) fail 2 "unknown init argument: $1" ;;
      esac
    done
    [ -n "$body_file" ] && [ -n "$run_id" ] && [ -n "$repo" ] && [ -n "$base_revision" ] && [ -n "$baseline_file" ] && [ -n "$output" ] || \
      fail 2 "init requires --body-file, --run-id, --repo, --base-revision, --baseline-file, and --output"
    require_readable_file "$body_file"
    require_readable_file "$baseline_file"
    if grep -E '^(```|## Ticket Pipeline([[:space:]]|$))' "$baseline_file" >/dev/null; then
      fail 2 "baseline file contains reserved ticket structure"
    fi
    check_run_id "$run_id"
    case "$repo" in /*) ;; *) fail 2 "repository path must be absolute: $repo" ;; esac
    check_scalar "base revision" "$base_revision"
    if grep -E '^## Ticket Pipeline([[:space:]]|$)' "$body_file" >/dev/null; then
      fail 4 "ticket body already contains a reserved Ticket Pipeline heading"
    fi
    write_initialized_body "$body_file" "$run_id" "$repo" "$base_revision" "$baseline_file" "$output"
    printf 'run_id\t%s\n' "$run_id"
    printf 'body\t%s\n' "$output"
    ;;
  launch)
    body_file= phase= iteration= agent= harness= model= effort= output=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --body-file) [ "$#" -ge 2 ] || fail 2 "--body-file needs a value"; body_file=$2; shift 2 ;;
        --phase) [ "$#" -ge 2 ] || fail 2 "--phase needs a value"; phase=$2; shift 2 ;;
        --iteration) [ "$#" -ge 2 ] || fail 2 "--iteration needs a value"; iteration=$2; shift 2 ;;
        --agent) [ "$#" -ge 2 ] || fail 2 "--agent needs a value"; agent=$2; shift 2 ;;
        --harness) [ "$#" -ge 2 ] || fail 2 "--harness needs a value"; harness=$2; shift 2 ;;
        --model) [ "$#" -ge 2 ] || fail 2 "--model needs a value"; model=$2; shift 2 ;;
        --effort) [ "$#" -ge 2 ] || fail 2 "--effort needs a value"; effort=$2; shift 2 ;;
        --output) [ "$#" -ge 2 ] || fail 2 "--output needs a value"; output=$2; shift 2 ;;
        *) fail 2 "unknown launch argument: $1" ;;
      esac
    done
    [ -n "$body_file" ] && [ -n "$phase" ] && [ -n "$iteration" ] && [ -n "$agent" ] && [ -n "$harness" ] && [ -n "$model" ] && [ -n "$effort" ] && [ -n "$output" ] || \
      fail 2 "launch requires body, phase, iteration, agent, harness, model, effort, and output"
    launch_phase "$body_file" "$phase" "$iteration" "$agent" "$harness" "$model" "$effort" "$output"
    ;;
  record)
    body_file=
    artifact_file=
    output=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --body-file) [ "$#" -ge 2 ] || fail 2 "--body-file needs a value"; body_file=$2; shift 2 ;;
        --artifact-file) [ "$#" -ge 2 ] || fail 2 "--artifact-file needs a value"; artifact_file=$2; shift 2 ;;
        --output) [ "$#" -ge 2 ] || fail 2 "--output needs a value"; output=$2; shift 2 ;;
        *) fail 2 "unknown record argument: $1" ;;
      esac
    done
    [ -n "$body_file" ] && [ -n "$artifact_file" ] && [ -n "$output" ] || \
      fail 2 "record requires --body-file, --artifact-file, and --output"
    record_artifact "$body_file" "$artifact_file" "$output"
    ;;
  summary)
    [ "$#" -eq 2 ] && [ "$1" = --body-file ] || fail 2 "summary requires --body-file"
    summarize_body "$2"
    ;;
  finish)
    body_file=
    status=
    reason_file=
    output=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --body-file) [ "$#" -ge 2 ] || fail 2 "--body-file needs a value"; body_file=$2; shift 2 ;;
        --status) [ "$#" -ge 2 ] || fail 2 "--status needs a value"; status=$2; shift 2 ;;
        --reason-file) [ "$#" -ge 2 ] || fail 2 "--reason-file needs a value"; reason_file=$2; shift 2 ;;
        --output) [ "$#" -ge 2 ] || fail 2 "--output needs a value"; output=$2; shift 2 ;;
        *) fail 2 "unknown finish argument: $1" ;;
      esac
    done
    [ -n "$body_file" ] && [ -n "$status" ] && [ -n "$output" ] || \
      fail 2 "finish requires --body-file, --status, and --output"
    finish_body "$body_file" "$status" "$reason_file" "$output"
    ;;
  *) usage ;;
esac
