{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darrow.dev/contracts/darrow-delivery/implement/output/0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["branch", "summary", "changedPaths", "evidence"],
  "properties": {
    "branch": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "changedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["red", "green", "regression"],
      "properties": {
        "red": { "$ref": "#/$defs/phase" },
        "green": { "$ref": "#/$defs/phase" },
        "regression": { "$ref": "#/$defs/phase" }
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exitStatus",
        "startedAt",
        "finishedAt",
        "stdout",
        "stderr",
        "workspaceDigest"
      ],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "exitStatus": { "type": "integer", "minimum": 0, "maximum": 255 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "stdout": { "type": "string", "minLength": 1 },
        "stderr": { "type": "string", "minLength": 1 },
        "workspaceDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
