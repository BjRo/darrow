{
  "format": "sevro.runtime.v1",
  "environment": {
    "inherit": ["PATH", "UV_PYTHON_INSTALL_DIR"],
    "set": {
      "UV_PYTHON_DOWNLOADS": "never"
    }
  },
  "filesystem": {
    "readOnlyRoots": ["${UV_PYTHON_INSTALL_DIR}"],
    "optionalReadOnlyRoots": ["/System/Library/OpenSSL"]
  },
  "runtime": {
    "artifactDirectories": [
      {
        "name": "principles",
        "path": ".darrow"
      }
    ]
  },
  "hooks": {
    "nativeGoal": true
  },
  "nativeTranscripts": true
}
