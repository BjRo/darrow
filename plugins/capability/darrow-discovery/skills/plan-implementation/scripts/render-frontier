#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'usage: %s --evidence TEXT --question TEXT --option LABEL --option LABEL [--option LABEL ...] --choice LABEL --rationale TEXT --deferred TEXT\n' "$0" >&2
}

die() {
  printf '%s\n' "$1" >&2
  exit 2
}

evidence=
question=
choice=
rationale=
deferred=
options=()

while test "$#" -gt 0; do
  test "$#" -ge 2 || {
    usage
    exit 2
  }
  case "$1" in
    --evidence) evidence=$2 ;;
    --question) question=$2 ;;
    --option) options[${#options[@]}]=$2 ;;
    --choice) choice=$2 ;;
    --rationale) rationale=$2 ;;
    --deferred) deferred=$2 ;;
    *)
      usage
      exit 2
      ;;
  esac
  shift 2
done

for value in "$evidence" "$question" "$choice" "$rationale" "$deferred"; do
  test -n "$value" || die 'every frontier field must be non-empty'
  case "$value" in
    *'
'*) die 'frontier fields must each be one line' ;;
  esac
done

test "${#options[@]}" -ge 2 || die 'the root question must declare at least two option labels'
for option in "${options[@]}"; do
  test -n "$option" || die 'root option labels must be non-empty'
  case "$option" in
    *'
'*) die 'root option labels must each be one line' ;;
  esac
done

question_marks=$(tr -cd '?' <<<"$question" | wc -c | tr -d '[:space:]')
test "$question_marks" = 1 || die 'the root question must contain exactly one question mark'
case "$question" in
  *'('*|*')'*) die 'the root question must use short option labels without parenthesized mechanics' ;;
esac

case "$rationale$deferred" in
  *'?'*) die 'only the root question may ask a question' ;;
esac

case " $(tr '[:upper:]' '[:lower:]' <<<"$deferred") " in
  *'('*|*')'*|*' vs '*|*' versus '*)
    die 'deferred decisions must be category names without child-option examples'
    ;;
esac
question_lower=$(tr '[:upper:]' '[:lower:]' <<<"$question")
choice_lower=$(tr '[:upper:]' '[:lower:]' <<<"$choice")
# Authority and dependency classification belong to the canonical grilling
# method. Vocabulary alone cannot determine which decision a sentence resolves.
choice_found=0
for option in "${options[@]}"; do
  option_lower=$(tr '[:upper:]' '[:lower:]' <<<"$option")
  case "$question_lower" in
    *"$option_lower"*) ;;
    *) die "root option '$option' is absent from the question" ;;
  esac
  if test "$option_lower" = "$choice_lower"; then
    choice_found=1
  fi
done
test "$choice_found" = 1 || die 'the recommended choice must equal one declared root option'

evidence=${evidence%.}
rationale=${rationale%.}
deferred=${deferred%.}

printf 'Evidence: %s.\n\n' "$evidence"
printf 'Q1 — %s\n\n' "$question"
printf 'Recommendation: Choose %s because %s.\n\n' "$choice" "$rationale"
printf 'Deferred: %s. After your answer, I will recompute the next frontier.\n' "$deferred"
