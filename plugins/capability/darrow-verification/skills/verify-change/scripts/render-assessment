#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'render-assessment: %s\n' "$1" >&2
  exit 2
}

[ "$#" -eq 4 ] && [ "$1" = --assessment ] && [ "$3" = --provider-report ] ||
  fail 'usage: render-assessment --assessment ABSOLUTE_FILE --provider-report ABSOLUTE_FILE'

canonical_input() {
  local input=$1 label=$2 parent name
  case "$input" in
    /*) ;;
    *) fail "$label requires an absolute path" ;;
  esac
  case "$input" in
    *$'\n'*) fail "$label path contains a control character" ;;
  esac
  if LC_ALL=C grep -q '[[:cntrl:]]' <<<"$input"; then
    fail "$label path contains a control character"
  fi
  [ -f "$input" ] && [ -r "$input" ] && [ -s "$input" ] ||
    fail "$label is not a readable nonempty regular file: $input"
  parent=${input%/*}
  name=${input##*/}
  [ -n "$parent" ] || parent=/
  parent=$(cd "$parent" && pwd -P) || fail "cannot resolve $label parent: $input"
  case "$parent" in
    /) printf '/%s\n' "$name" ;;
    *) printf '%s/%s\n' "$parent" "$name" ;;
  esac
}

assessment=$(canonical_input "$2" assessment)
provider_report=$(canonical_input "$4" provider-report)
# The angle-delimited Markdown destination allows spaces and parentheses;
# encode URI delimiters and backslashes without parsing provider contents.
destination=$(printf '%s\n' "$provider_report" | LC_ALL=C sed \
  -e 's/%/%25/g' -e 's/ /%20/g' -e 's/#/%23/g' -e 's/?/%3F/g' \
  -e 's/</%3C/g' -e 's/>/%3E/g' -e 's/\\/%5C/g')

cat "$assessment"
printf '\n\nComplete provider result: [report](<%s>)\n' "$destination"
