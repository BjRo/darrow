{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/stop.sh\"",
            "timeout": 45,
            "statusMessage": "Capturing Codex attribution"
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/stop.sh\" --drain",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/stop.sh\"",
            "timeout": 45,
            "statusMessage": "Capturing Codex trace locally"
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/stop.sh\" --drain",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/stop.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/stop.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/stop.sh\" --drain",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ]
  }
}
