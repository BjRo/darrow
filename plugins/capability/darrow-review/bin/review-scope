#!/usr/bin/env bash
# Pin a complete Git diff without changing the reviewed working tree.
set -u

PROGRAM=${0##*/}
TAB=$(printf '\t')

usage() {
  cat <<EOF
Usage:
  $PROGRAM prepare --repo PATH --base REV --target REV|WORKTREE [--merge-base] [--staged] [--unstaged] [--untracked]
  $PROGRAM show --manifest ABSOLUTE_SCOPE_TSV

WORKTREE includes staged, unstaged, and untracked changes unless one or more
individual working-tree flags are supplied. Working-tree flags with a commit
target require that target to resolve to HEAD.
EOF
}

fail() {
  code=$1
  shift
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit "$code"
}

reject_record_breaks() {
  value=$1
  label=$2
  case "$value" in
    *"$TAB"*|*$'\n'*) fail 2 "$label contains a tab or newline and cannot be represented safely" ;;
  esac
}

absolute_git_dir() {
  candidate=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) || return 1
  case "$candidate" in
    /*) ;;
    *) candidate=$1/$candidate ;;
  esac
  (cd "$candidate" 2>/dev/null && pwd -P)
}

resolve_commit() {
  repo=$1
  revision=$2
  label=$3
  case "$revision" in
    -*) fail 2 "$label must not begin with '-'" ;;
  esac
  oid=$(git -C "$repo" rev-parse --verify "$revision^{commit}" 2>/dev/null) ||
    fail 2 "invalid $label: $revision"
  printf '%s\n' "$oid"
}

add_names() {
  source_file=$1
  while IFS= read -r -d '' path; do
    reject_record_breaks "$path" "changed path"
    printf '%s\n' "$path" >>"$changed_rel"
  done <"$source_file"
}

append_section() {
  label=$1
  shift
  printf '### darrow-review layer=%s\n' "$label" >>"$patch_file"
  "$@" >>"$patch_file" 2>>"$error_file" ||
    fail 2 "could not render the $label diff; see $error_file"
  printf '\n' >>"$patch_file"
}

show_manifest() {
  manifest_path=${1:-}
  [ -n "$manifest_path" ] || fail 2 "show requires --manifest"
  case "$manifest_path" in
    /*) ;;
    *) fail 2 "manifest path must be absolute" ;;
  esac
  [ -f "$manifest_path" ] && [ -r "$manifest_path" ] ||
    fail 2 "manifest is not a readable regular file: $manifest_path"

  format=$(awk -F '\t' '$1 == "format" { print $2 }' "$manifest_path")
  repository=$(awk -F '\t' '$1 == "repository" { print $2 }' "$manifest_path")
  diff_path=$(awk -F '\t' '$1 == "diff" { print $2 }' "$manifest_path")
  expected=$(awk -F '\t' '$1 == "scope_checksum" { print $2 }' "$manifest_path")
  [ "$format" = "darrow-review-scope-v1" ] || fail 2 "unsupported scope manifest format"
  case "$diff_path" in
    /*) ;;
    *) fail 2 "manifest diff path must be absolute" ;;
  esac
  case "$repository" in
    /*) ;;
    *) fail 2 "manifest repository path must be absolute" ;;
  esac
  [ -f "$diff_path" ] && [ -r "$diff_path" ] || fail 2 "pinned diff is unreadable: $diff_path"
  actual=$(git -C "$repository" hash-object "$diff_path" 2>/dev/null) ||
    fail 2 "cannot hash the pinned diff"
  [ "$actual" = "$expected" ] || fail 2 "pinned diff checksum does not match the manifest"
  cat "$diff_path"
}

command=${1:-}
[ -n "$command" ] || { usage >&2; exit 2; }
shift

if [ "$command" = "show" ]; then
  [ "${1:-}" = "--manifest" ] || fail 2 "show requires --manifest"
  shift
  [ "$#" -eq 1 ] || fail 2 "show accepts exactly one manifest"
  show_manifest "$1"
  exit 0
fi

[ "$command" = "prepare" ] || { usage >&2; exit 2; }

repo_arg=.
base_input=
target_input=
use_merge_base=0
include_staged=0
include_unstaged=0
include_untracked=0
work_flags=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo)
      [ "$#" -ge 2 ] || fail 2 "--repo requires a path"
      repo_arg=$2
      shift 2
      ;;
    --base)
      [ "$#" -ge 2 ] || fail 2 "--base requires a revision"
      base_input=$2
      shift 2
      ;;
    --target)
      [ "$#" -ge 2 ] || fail 2 "--target requires a revision or WORKTREE"
      target_input=$2
      shift 2
      ;;
    --merge-base)
      use_merge_base=1
      shift
      ;;
    --staged)
      include_staged=1
      work_flags=1
      shift
      ;;
    --unstaged)
      include_unstaged=1
      work_flags=1
      shift
      ;;
    --untracked)
      include_untracked=1
      work_flags=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *) fail 2 "unknown argument: $1" ;;
  esac
done

[ -n "$base_input" ] || fail 2 "--base is required"
[ -n "$target_input" ] || fail 2 "--target is required"
reject_record_breaks "$base_input" "base"
reject_record_breaks "$target_input" "target"

inside=$(git -C "$repo_arg" rev-parse --is-inside-work-tree 2>/dev/null) ||
  fail 2 "not a Git working tree: $repo_arg"
[ "$inside" = "true" ] || fail 2 "not a Git working tree: $repo_arg"
root=$(git -C "$repo_arg" rev-parse --show-toplevel 2>/dev/null) ||
  fail 2 "cannot resolve repository root: $repo_arg"
root=$(cd "$root" 2>/dev/null && pwd -P) || fail 2 "repository root is unreadable: $root"
git_dir=$(absolute_git_dir "$root") || fail 2 "cannot resolve the repository Git directory"
reject_record_breaks "$root" "repository path"
reject_record_breaks "$git_dir" "Git directory path"

base_oid=$(resolve_commit "$root" "$base_input" "base")
head_oid=$(resolve_commit "$root" HEAD "HEAD")
case "$target_input" in
  WORKTREE|worktree)
    target_oid=$head_oid
    if [ "$work_flags" -eq 0 ]; then
      include_staged=1
      include_unstaged=1
      include_untracked=1
    fi
    ;;
  *)
    target_oid=$(resolve_commit "$root" "$target_input" "target")
    if [ "$work_flags" -eq 1 ] && [ "$target_oid" != "$head_oid" ]; then
      fail 2 "working-tree layers require the target commit to resolve to HEAD"
    fi
    ;;
esac

effective_base=$base_oid
if [ "$use_merge_base" -eq 1 ]; then
  merge_bases=$(git -C "$root" merge-base --all "$base_oid" "$target_oid" 2>/dev/null) ||
    fail 2 "base and target have no merge base"
  merge_count=$(printf '%s\n' "$merge_bases" | awk 'NF { count++ } END { print count + 0 }')
  [ "$merge_count" -eq 1 ] || fail 4 "base and target have multiple merge bases; choose the fixed point explicitly"
  effective_base=$merge_bases
fi

scope_dir=$(mktemp -d "$git_dir/darrow-review.XXXXXX") || fail 2 "cannot create an ignored review artifact directory"
scope_dir=$(cd "$scope_dir" && pwd -P) || fail 2 "cannot resolve review artifact directory"
manifest_file=$scope_dir/scope.tsv
patch_file=$scope_dir/diff.patch
changed_rel=$scope_dir/changed-relative.txt
changed_sorted=$scope_dir/changed-files.txt
layer_names=$scope_dir/layer-names.bin
error_file=$scope_dir/errors.txt
: >"$patch_file"
: >"$changed_rel"
: >"$error_file"
layers=

if ! git -C "$root" diff --name-only -z --no-ext-diff "$effective_base" "$target_oid" -- >"$layer_names" 2>>"$error_file"; then
  fail 2 "cannot enumerate committed changes; see $error_file"
fi
if [ -s "$layer_names" ]; then
  add_names "$layer_names"
  append_section committed git -C "$root" diff --binary --full-index --no-ext-diff "$effective_base" "$target_oid" --
  layers="committed"
fi

if [ "$include_staged" -eq 1 ]; then
  if ! git -C "$root" diff --cached --name-only -z --no-ext-diff "$target_oid" -- >"$layer_names" 2>>"$error_file"; then
    fail 2 "cannot enumerate staged changes; see $error_file"
  fi
  if [ -s "$layer_names" ]; then
    add_names "$layer_names"
    append_section staged git -C "$root" diff --cached --binary --full-index --no-ext-diff "$target_oid" --
    layers="$layers staged"
  fi
fi

if [ "$include_unstaged" -eq 1 ]; then
  if ! git -C "$root" diff --name-only -z --no-ext-diff -- >"$layer_names" 2>>"$error_file"; then
    fail 2 "cannot enumerate unstaged changes; see $error_file"
  fi
  if [ -s "$layer_names" ]; then
    add_names "$layer_names"
    append_section unstaged git -C "$root" diff --binary --full-index --no-ext-diff --
    layers="$layers unstaged"
  fi
fi

if [ "$include_untracked" -eq 1 ]; then
  if ! git -C "$root" ls-files --others --exclude-standard -z >"$layer_names" 2>>"$error_file"; then
    fail 2 "cannot enumerate untracked changes; see $error_file"
  fi
  if [ -s "$layer_names" ]; then
    add_names "$layer_names"
    printf '### darrow-review layer=untracked\n' >>"$patch_file"
    while IFS= read -r -d '' path; do
      printf '### untracked-file %s\n' "$path" >>"$patch_file"
      git -C "$root" diff --no-index --binary --full-index -- /dev/null "$path" >>"$patch_file" 2>>"$error_file"
      status=$?
      [ "$status" -le 1 ] || fail 2 "cannot render untracked file: $root/$path"
      printf '\n' >>"$patch_file"
    done <"$layer_names"
    layers="$layers untracked"
  fi
fi

LC_ALL=C sort -u "$changed_rel" >"$changed_sorted"
changed_count=$(awk 'NF { count++ } END { print count + 0 }' "$changed_sorted")
if [ "$changed_count" -eq 0 ]; then
  rm -f "$manifest_file" "$patch_file" "$changed_rel" "$changed_sorted" "$layer_names" "$error_file"
  rmdir "$scope_dir" 2>/dev/null || true
  fail 3 "the declared review scope is empty"
fi

scope_checksum=$(git -C "$root" hash-object "$patch_file" 2>/dev/null) ||
  fail 2 "cannot fingerprint the pinned diff"
target_label=$target_oid
if [ "$include_staged" -eq 1 ] || [ "$include_unstaged" -eq 1 ] || [ "$include_untracked" -eq 1 ]; then
  target_label=WORKTREE@$target_oid+$scope_checksum
fi

{
  printf 'format\tdarrow-review-scope-v1\n'
  printf 'repository\t%s\n' "$root"
  printf 'base_input\t%s\n' "$base_input"
  printf 'base\t%s\n' "$effective_base"
  printf 'target_input\t%s\n' "$target_input"
  printf 'target_commit\t%s\n' "$target_oid"
  printf 'target\t%s\n' "$target_label"
  printf 'merge_base\t%s\n' "$use_merge_base"
  printf 'layers\t%s\n' "$(printf '%s' "$layers" | awk '{$1=$1; print}')"
  printf 'diff\t%s\n' "$patch_file"
  printf 'scope_checksum\t%s\n' "$scope_checksum"
  printf 'changed_count\t%s\n' "$changed_count"
  while IFS= read -r path; do
    [ -n "$path" ] && printf 'changed_file\t%s/%s\n' "$root" "$path"
  done <"$changed_sorted"
  printf 'show_command\tbash %s show --manifest %s\n' "$0" "$manifest_file"
  printf 'manifest\t%s\n' "$manifest_file"
} >"$manifest_file"

cat "$manifest_file"
