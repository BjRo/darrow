#!/usr/bin/env bash
# Render a validated darrow-review-result-v1 record for people.
set -u

PROGRAM=${0##*/}
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd -P)
RESULT_TOOL=$SCRIPT_DIR/review-result

usage() {
  printf 'Usage: %s render RESULT_FILE\n' "$PROGRAM" >&2
}

[ "${1:-}" = "render" ] && [ "$#" -eq 2 ] || { usage; exit 2; }
input=$2
[ -f "$input" ] && [ -r "$input" ] || {
  printf '%s: result is not a readable regular file: %s\n' "$PROGRAM" "$input" >&2
  exit 2
}

bash "$RESULT_TOOL" validate "$input" >/dev/null || exit $?

awk -F '\t' '
function esc(value) {
  gsub(/&/, "\\&amp;", value)
  gsub(/</, "\\&lt;", value)
  gsub(/>/, "\\&gt;", value)
  gsub(/#/, "\\&#35;", value)
  gsub(/`/, "\\&#96;", value)
  gsub(/\*/, "\\&#42;", value)
  gsub(/_/, "\\&#95;", value)
  gsub(/\[/, "\\&#91;", value)
  gsub(/\]/, "\\&#93;", value)
  gsub(/[|]/, "\\&#124;", value)
  return value
}
function esc_code(value) {
  gsub(/&/, "\\&amp;", value)
  gsub(/</, "\\&lt;", value)
  gsub(/>/, "\\&gt;", value)
  return value
}
function title(value) {
  return toupper(substr(value, 1, 1)) substr(value, 2)
}
function status(value) {
  return toupper(value)
}
function print_value(label, value) {
  printf "- **%s:** %s\n", label, esc(value)
}
function print_code_value(label, value) {
  printf "- **%s:** <code>%s</code>\n", label, esc_code(value)
}
{
  kind = $1
  if (kind == "base") base = $2
  else if (kind == "target") target = $2
  else if (kind == "changed_file") changed[++changed_count] = $2
  else if (kind == "standards") standards = $2
  else if (kind == "standards_source") standards_sources[++standards_source_count] = $2
  else if (kind == "spec") spec = $2
  else if (kind == "spec_source") spec_source = $2
  else if (kind == "finding") {
    finding_axis[++finding_count] = $2
    finding_severity[finding_count] = $3
    finding_disposition[finding_count] = $4
    finding_location[finding_count] = $5
    finding_source[finding_count] = $6
    finding_evidence[finding_count] = $7
    if ($4 == "blocking") blocking++
    else advisory++
  } else if (kind == "check") {
    check_command[++check_count] = $2
    check_applicability[check_count] = $3
    check_status[check_count] = $4
    check_evidence[check_count] = $5
  } else if (kind == "verdict") verdict = $2
  else if (kind == "risk") risks[++risk_count] = $2
  else if (kind == "next_action") next_action = $2
}
END {
  printf "# Code review — %s\n\n", status(verdict)
  printf "**Verdict:** %s · **Findings:** %d (%d blocking, %d advisory)\n\n", esc(verdict), finding_count, blocking, advisory

  print "## Findings"
  if (finding_count == 0) print "No findings."
  for (i = 1; i <= finding_count; i++) {
    printf "\n### %d. %s — %s (%s)\n", i, status(finding_severity[i]), status(finding_disposition[i]), title(finding_axis[i])
    print_code_value("Location", finding_location[i])
    print_code_value("Source", finding_source[i])
    print_value("Evidence", finding_evidence[i])
  }

  print "\n## Checks"
  for (i = 1; i <= check_count; i++)
    printf "- **%s** (%s) — <code>%s</code>: %s\n", status(check_status[i]), esc_code(check_applicability[i]), esc_code(check_command[i]), esc(check_evidence[i])

  print "\n## Risks"
  for (i = 1; i <= risk_count; i++) print "- " esc(risks[i])

  print "\n## Next action"
  print esc(next_action)

  print "\n## Scope"
  print_code_value("Base", base)
  print_code_value("Target", target)
  print "- **Changed files:**"
  for (i = 1; i <= changed_count; i++) print "  - <code>" esc_code(changed[i]) "</code>"

  print "\n## Sources"
  printf "- **Standards (%s):**\n", esc(standards)
  for (i = 1; i <= standards_source_count; i++) print "  - <code>" esc_code(standards_sources[i]) "</code>"
  printf "- **Spec (%s):** <code>%s</code>\n", esc(spec), esc_code(spec_source)
}
' "$input"
