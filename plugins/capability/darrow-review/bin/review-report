#!/usr/bin/env bash
# Render a validated darrow-review-result-v1 record for people.
set -u

PROGRAM=${0##*/}
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd -P)
RESULT_TOOL=$SCRIPT_DIR/review-result

usage() {
  printf 'Usage: %s render RESULT_FILE\n' "$PROGRAM" >&2
  printf '       %s render-verification VERIFICATION_FILE\n' "$PROGRAM" >&2
}

command=${1:-}
[ "$#" -eq 2 ] || { usage; exit 2; }
input=$2
[ -f "$input" ] && [ -r "$input" ] || {
  printf '%s: result is not a readable regular file: %s\n' "$PROGRAM" "$input" >&2
  exit 2
}

if [ "$command" = "render-verification" ]; then
  "${BASH:-bash}" "$RESULT_TOOL" validate-verification "$input" >/dev/null || exit $?
  awk -F '\t' '
  function esc(value) {
    gsub(/&/, "\\&amp;", value)
    gsub(/</, "\\&lt;", value)
    gsub(/>/, "\\&gt;", value)
    gsub(/#/, "\\&#35;", value)
    gsub(/`/, "\\&#96;", value)
    gsub(/\*/, "\\&#42;", value)
    gsub(/_/, "\\&#95;", value)
    gsub(/\[/, "\\&#91;", value)
    gsub(/\]/, "\\&#93;", value)
    gsub(/[|]/, "\\&#124;", value)
    return esc_backslashes(value)
  }
  function esc_backslashes(value, escaped, at) {
    while ((at = index(value, "\\")) > 0) {
      escaped = escaped substr(value, 1, at - 1) "&#92;"
      value = substr(value, at + 1)
    }
    return escaped value
  }
  function status(value) {
    return toupper(value)
  }
  function print_value(label, value) {
    printf "- **%s:** %s\n", label, esc(value)
  }
  {
    kind = $1
    if (kind == "original_target") original_target = $2
    else if (kind == "prior_target") prior_target = $2
    else if (kind == "current_target") current_target = $2
    else if (kind == "history_target") history[++history_count] = $2
    else if (kind == "previous_verification") {
      previous_checksum = $2
      previous_path = $3
    }
    else if (kind == "original_finding") {
      key = $2
      original_key[++original_count] = key
      original_axis[key] = $3
      original_order[key] = $4
      original_severity[key] = $5
      original_disposition[key] = $6
      original_location[key] = $7
      original_source[key] = $8
      original_evidence[key] = $9
      original_guidance[key] = $10
      original_resolution[key] = $11
    } else if (kind == "attempt") {
      key = $2
      attempted[++attempt_count] = key
      attempt_status[key] = $3
      attempt_progress[key] = $4
      attempt_evidence[key] = $5
      if ($3 == "resolved") resolved++
      else if ($3 == "unresolved") unresolved++
      else blocked++
    } else if (kind == "regression") {
      regression_key[++regression_count] = $2
      regression_cause[regression_count] = $3
      regression_order[regression_count] = $4
      regression_axis[regression_count] = $5
      regression_severity[regression_count] = $6
      regression_status[regression_count] = $7
      regression_progress[regression_count] = $8
      regression_location[regression_count] = $9
      regression_source[regression_count] = $10
      regression_evidence[regression_count] = $11
      regression_guidance[regression_count] = $12
      regression_resolution[regression_count] = $13
    } else if (kind == "check") {
      check_command[++check_count] = $2
      check_applicability[check_count] = $3
      check_status[check_count] = $4
      check_evidence[check_count] = $5
    } else if (kind == "evidence_gap") gaps[++gap_count] = $2
    else if (kind == "outcome") outcome = $2
    else if (kind == "next_action") next_action = $2
  }
  END {
    printf "# Repair verification — %s\n\n", status(outcome)
    printf "**Outcome:** %s · Original findings: %d · Resolved: %d · Unresolved: %d · Blocked: %d · Regressions: %d\n\n", esc(outcome), original_count, resolved, unresolved, blocked, regression_count

    print "## Attempted findings"
    if (attempt_count == 0) print "No attempted findings were verifiable."
    for (i = 1; i <= attempt_count; i++) {
      key = attempted[i]
      printf "\n### %d. %s — %s / %s (%s, %s)\n", i, esc(key), status(attempt_status[key]), status(attempt_progress[key]), status(original_severity[key]), esc(original_disposition[key])
      print_value("Location", original_location[key])
      print_value("Source", original_source[key])
      printf "- **Original evidence:** %s\n", esc(original_evidence[key])
      if (original_guidance[key] != "") {
        print_value("Repair guidance (advisory)", original_guidance[key])
        print_value("Resolution evidence", original_resolution[key])
      }
      printf "- **Current evidence:** %s\n", esc(attempt_evidence[key])
    }

    print "\n## Repair-caused regressions"
    if (regression_count == 0) print "No repair-caused regressions."
    for (i = 1; i <= regression_count; i++) {
      printf "\n### %d. %s — %s / %s (%s)\n", i, esc(regression_key[i]), status(regression_status[i]), status(regression_progress[i]), status(regression_severity[i])
      print_value("Axis", regression_axis[i])
      print_value("Caused by", regression_cause[i])
      print_value("Location", regression_location[i])
      print_value("Source", regression_source[i])
      printf "- **Evidence:** %s\n", esc(regression_evidence[i])
      if (regression_guidance[i] != "") {
        print_value("Repair guidance (advisory)", regression_guidance[i])
        print_value("Resolution evidence", regression_resolution[i])
      }
    }

    print "\n## Checks"
    for (i = 1; i <= check_count; i++)
      printf "- **%s** (%s) — %s: %s\n", status(check_status[i]), esc(check_applicability[i]), esc(check_command[i]), esc(check_evidence[i])

    print "\n## Evidence gaps"
    if (gap_count == 0) print "No evidence gaps."
    for (i = 1; i <= gap_count; i++) print "- " esc(gaps[i])

    print "\n## Target binding"
    print_value("Original target", original_target)
    print_value("Prior target", prior_target)
    print_value("Current target", current_target)
    print_value("Previous verification checksum", previous_checksum)
    print_value("Previous verification artifact", previous_path)
    if (history_count > 0) {
      print "- **Earlier targets:**"
      for (i = 1; i <= history_count; i++) print "  - " esc(history[i])
    }

    print "\n## Closed original finding set"
    for (i = 1; i <= original_count; i++) {
      key = original_key[i]
      printf "- %s — %s #%s, %s/%s; %s; source %s; %s\n", esc(key), esc(original_axis[key]), esc(original_order[key]), esc(original_severity[key]), esc(original_disposition[key]), esc(original_location[key]), esc(original_source[key]), esc(original_evidence[key])
      if (original_guidance[key] != "") {
        printf "  - **Repair guidance (advisory):** %s\n", esc(original_guidance[key])
        printf "  - **Resolution evidence:** %s\n", esc(original_resolution[key])
      }
    }

    print "\n## Next action"
    print esc(next_action)
  }
  ' "$input"
  exit 0
fi

[ "$command" = "render" ] || { usage; exit 2; }

"${BASH:-bash}" "$RESULT_TOOL" validate "$input" >/dev/null || exit $?

awk -F '\t' '
function esc(value) {
  gsub(/&/, "\\&amp;", value)
  gsub(/</, "\\&lt;", value)
  gsub(/>/, "\\&gt;", value)
  gsub(/#/, "\\&#35;", value)
  gsub(/`/, "\\&#96;", value)
  gsub(/\*/, "\\&#42;", value)
  gsub(/_/, "\\&#95;", value)
  gsub(/\[/, "\\&#91;", value)
  gsub(/\]/, "\\&#93;", value)
  gsub(/[|]/, "\\&#124;", value)
  return esc_backslashes(value)
}
function esc_backslashes(value, escaped, at) {
  while ((at = index(value, "\\")) > 0) {
    escaped = escaped substr(value, 1, at - 1) "&#92;"
    value = substr(value, at + 1)
  }
  return escaped value
}
function title(value) {
  return toupper(substr(value, 1, 1)) substr(value, 2)
}
function status(value) {
  return toupper(value)
}
function print_value(label, value) {
  printf "- **%s:** %s\n", label, esc(value)
}
{
  kind = $1
  if (kind == "base") base = $2
  else if (kind == "target") target = $2
  else if (kind == "changed_file") changed[++changed_count] = $2
  else if (kind == "standards") standards = $2
  else if (kind == "standards_source") standards_sources[++standards_source_count] = $2
  else if (kind == "spec") spec = $2
  else if (kind == "spec_source") spec_source = $2
  else if (kind == "finding") {
    finding_axis[++finding_count] = $2
    finding_severity[finding_count] = $3
    finding_disposition[finding_count] = $4
    finding_location[finding_count] = $5
    finding_source[finding_count] = $6
    finding_evidence[finding_count] = $7
    finding_guidance[finding_count] = $8
    finding_resolution[finding_count] = $9
    if ($4 == "blocking") blocking++
    else advisory++
  } else if (kind == "check") {
    check_command[++check_count] = $2
    check_applicability[check_count] = $3
    check_status[check_count] = $4
    check_evidence[check_count] = $5
  } else if (kind == "verdict") verdict = $2
  else if (kind == "risk") risks[++risk_count] = $2
  else if (kind == "next_action") next_action = $2
}
END {
  printf "# Code review — %s\n\n", status(verdict)
  printf "**Verdict:** %s · **Findings:** %d (%d blocking, %d advisory)\n\n", esc(verdict), finding_count, blocking, advisory

  print "## Findings"
  if (finding_count == 0) print "No findings."
  for (i = 1; i <= finding_count; i++) {
    printf "\n### %d. %s — %s (%s)\n", i, status(finding_severity[i]), status(finding_disposition[i]), title(finding_axis[i])
    print_value("Location", finding_location[i])
    print_value("Source", finding_source[i])
    print_value("Evidence", finding_evidence[i])
    if (finding_guidance[i] != "") {
      print_value("Repair guidance (advisory)", finding_guidance[i])
      print_value("Resolution evidence", finding_resolution[i])
    }
  }

  print "\n## Checks"
  for (i = 1; i <= check_count; i++)
    printf "- **%s** (%s) — %s: %s\n", status(check_status[i]), esc(check_applicability[i]), esc(check_command[i]), esc(check_evidence[i])

  print "\n## Risks"
  for (i = 1; i <= risk_count; i++) print "- " esc(risks[i])

  print "\n## Next action"
  print esc(next_action)

  print "\n## Scope"
  print_value("Base", base)
  print_value("Target", target)
  print "- **Changed files:**"
  for (i = 1; i <= changed_count; i++) print "  - " esc(changed[i])

  print "\n## Sources"
  printf "- **Standards (%s):**\n", esc(standards)
  for (i = 1; i <= standards_source_count; i++) print "  - " esc(standards_sources[i])
  printf "- **Spec (%s):** %s\n", esc(spec), esc(spec_source)
}
' "$input"
