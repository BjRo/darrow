{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--quiet",
              "--frozen",
              "--no-dev",
              "--project",
              "${CLAUDE_PLUGIN_ROOT}/backend",
              "darrow-git-claude-context"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
