{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--quiet",
              "--no-project",
              "${CLAUDE_PLUGIN_ROOT}/backend/scripts/run_locked.py",
              "darrow-git-claude-context"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
