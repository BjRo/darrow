#!/usr/bin/env bash
# Backend facade for the darrow-tickets skills (ADR-0002): one command shape,
# all backend specifics live here. First backend: GitHub Issues via gh (JSON
# handling through gh's embedded --jq — no external jq).
# stdout is read by a model: print only compact, decision-relevant data.
# Checkable invariants are enforced here, not in the prompt: backend
# resolution (TM-1), relation target verification (TM-2), script-owned
# relation markers (TM-3), body structure per type (TM-C3), existing labels
# only (TM-C6), no AI attribution (TM-C7/TM-U6), deliberate state
# transitions (TM-U4), honest list truncation (TM-L4).
#
# Exit codes: 2 usage/input, 3 backend unusable, 4 backend op failed,
# 5 title violation, 6 attribution, 7 body structure, 8 unknown label,
# 9 refusal (duplicate/conflicting state), 64 unknown command.
set -euo pipefail

# `head` would SIGPIPE the writer under pipefail on large output.
truncate_lines() { awk 'NR<=50'; }

TMPFILE=""
cleanup() { if [[ -n "$TMPFILE" ]]; then rm -f "$TMPFILE"; fi; }
trap cleanup EXIT

usage() {
  cat >&2 <<'EOF'
usage: ticket <command> [args]

  inspect
  list [--state open|closed|all] [--type <t>] [--label <l>]... [--search <q>]
       [--milestone <m>] [--limit <n>]
  get <id>
  create --title <t> --type bug|feature|task|chore --body-file <f>
         [--label <l>]... [--depends-on <id>]... [--parent <id>]
  comment <id> --body-file <f>
  close <id>
  reopen <id>
  label <id> (--add <l> | --remove <l>)
  relate <id> (--depends-on <id> | --remove-depends-on <id> |
               --parent <id> | --remove-parent)

create enforces body structure per type:
  bug      -> "## Observed", "## Expected", "## Reproduction"
  feature  -> "## Motivation", "## Acceptance criteria"
  task     -> "## Outcome", "## Done criteria"
  chore    -> "## Outcome", "## Done criteria"
"## Open questions" is optional on every type.
EOF
  exit 64
}

# TM-1: exactly one backend, resolved deterministically; unusable -> refuse
# with the missing piece, never guess.
resolve_backend() {
  if [[ "$(git rev-parse --is-inside-work-tree 2>/dev/null || true)" != "true" ]]; then
    echo "error: not inside a git work tree" >&2
    exit 3
  fi
  if ! command -v gh >/dev/null 2>&1; then
    echo "error: gh CLI not found — the GitHub Issues backend is unusable" >&2
    exit 3
  fi
  if ! git remote get-url origin >/dev/null 2>&1; then
    echo "error: no 'origin' remote — cannot resolve a ticket backend" >&2
    exit 3
  fi
  BACKEND=github
}

# Backend failures are relayed verbatim (truncated) — the caller reports
# them, never works around them.
run_gh() {
  local out
  if ! out=$(gh "$@" 2>&1); then
    truncate_lines <<< "$out" >&2
    exit 4
  fi
  printf '%s' "$out"
}

norm_id() {
  local id=${1#\#}
  if ! [[ "$id" =~ ^[0-9]+$ ]]; then
    echo "error: invalid ticket id: $1" >&2
    exit 2
  fi
  printf '%s' "$id"
}

# TM-2: a relation target must exist before anything is created or mutated.
# Echoes "<state>\t<title>".
verify_ticket() {
  local out
  if ! out=$(gh issue view "$1" --json state,title --jq '[(.state|ascii_downcase), .title] | @tsv' 2>&1); then
    echo "error: ticket #$1 not found:" >&2
    truncate_lines <<< "$out" >&2
    exit 4
  fi
  printf '%s' "$out"
}

fetch_labels() {
  REPO_LABELS=$(run_gh label list --json name --jq '.[].name' --limit 200)
}

label_exists() { grep -qxF "$1" <<< "$REPO_LABELS"; }

# First existing label a type maps to; empty when none (TM-C6: never create
# taxonomy as a side effect).
type_label() {
  local cand
  for cand in $(type_label_candidates "$1"); do
    if label_exists "$cand"; then
      printf '%s' "$cand"
      return
    fi
  done
}

type_label_candidates() {
  case "$1" in
    bug) echo "bug" ;;
    feature) echo "feature enhancement" ;;
    task) echo "task" ;;
    chore) echo "chore" ;;
    *) return 1 ;;
  esac
}

required_headings() {
  case "$1" in
    bug) printf '%s\n' "## Observed" "## Expected" "## Reproduction" ;;
    feature) printf '%s\n' "## Motivation" "## Acceptance criteria" ;;
    task|chore) printf '%s\n' "## Outcome" "## Done criteria" ;;
  esac
}

# Attribution needs tool context: "generated by openapi-generator" is
# legitimate prose, "Generated using Claude Code" is not.
# Herestring, not a pipe: grep -q exits at the first match, and on a >64KB
# body the writer's SIGPIPE (141) would make pipefail discard the match.
check_attribution() {
  if grep -qiE 'co-authored-by:.*\b(claude|gpt|chatgpt|codex|copilot|cursor|gemini|ai)\b|co[- ]?authored[- ]by +(claude|gpt|chatgpt|codex|copilot|cursor|gemini)\b|(generated|built|written|created|made|assisted)[- ](with|by|using) +\[?(claude|gpt|chatgpt|codex|copilot|cursor|gemini|an? ai\b|ai\b)|🤖' <<< "$1"; then
    echo "error: AI attribution is not allowed in tickets" >&2
    exit 6
  fi
}

# A section ends at the next heading of the same or higher level; deeper
# sub-headings count as content. Fenced lines never start or end a section
# but do count as content. Herestring (SIGPIPE, see check_attribution);
# heading rides in via ENVIRON — awk -v mangles backslashes.
# Returns 0 filled, 1 empty, 2 missing.
section_state() {
  local rc=0
  TKT_H="$1" awk '
    BEGIN {h=ENVIRON["TKT_H"]; hl=0; while (substr(h, hl+1, 1) == "#") hl++}
    {
      l=$0; sub(/[[:space:]]+$/, "", l)
      n=0; while (substr(l, n+1, 1)==" ") n++
      c = substr(l, n+1, 3)
      isfence = (n<=3 && (c=="```" || c=="~~~"))
    }
    isfence {f=!f}
    !f && !isfence && !insec && l==h {insec=1; seen=1; next}
    insec && !f && !isfence && l ~ /^#+[ \t]/ {m=0; while (substr(l, m+1, 1) == "#") m++; if (m<=hl) exit}
    insec && NF {ok=1; exit}
    END {if (!seen) exit 2; exit ok ? 0 : 1}' <<< "$2" || rc=$?
  return $rc
}

check_body_structure() {
  local type=$1 body=$2 h rc
  while IFS= read -r h; do
    rc=0
    section_state "$h" "$body" || rc=$?
    if [[ $rc -eq 2 ]]; then
      echo "error: required section missing for type $type: $h" >&2
      exit 7
    elif [[ $rc -ne 0 ]]; then
      echo "error: required section is empty: $h" >&2
      exit 7
    fi
  done <<< "$(required_headings "$type")"
}

read_body_file() {
  if [[ ! -r "$1" ]]; then
    echo "error: body file is not readable: $1" >&2
    exit 2
  fi
  BODY=$(cat "$1")
  if ! [[ "$BODY" =~ [^[:space:]] ]]; then
    echo "error: body file is empty: $1" >&2
    exit 2
  fi
}

# TM-3: relations are stored as script-owned marker lines in the body
# ("Depends-on: #N", "Parent: #N"). Matched at line level; a verbatim
# marker inside a fenced code block would be picked up too — accepted, the
# markers are namespaced enough in practice.
parse_relations() {
  awk '
    /^Parent: #[0-9]+$/ {p=$2}
    /^Depends-on: #[0-9]+$/ {d = d (d ? " " : "") $2}
    END {
      print "parent: " (p ? p : "(none)")
      print "depends-on: " (d ? d : "(none)")
    }' <<< "$1"
}

strip_markers() {
  awk '!/^Depends-on: #[0-9]+$/ && !/^Parent: #[0-9]+$/' <<< "$1"
}

has_marker() { grep -qxF "$2" <<< "$1"; }

remove_marker() {
  MK="$2" awk 'BEGIN {mk=ENVIRON["MK"]} $0 != mk' <<< "$1"
}

fetch_body() {
  run_gh issue view "$1" --json body --jq '.body // ""'
}

write_body() {
  TMPFILE=$(mktemp)
  printf '%s\n' "$2" > "$TMPFILE"
  run_gh issue edit "$1" --body-file "$TMPFILE" >/dev/null
}

issue_labels() {
  run_gh issue view "$1" --json labels --jq '.labels[].name'
}

cmd=${1:-}
if [[ -z "$cmd" ]]; then
  usage
fi
shift

case "$cmd" in
  inspect)
    resolve_backend
    fetch_labels
    echo "## backend: $BACKEND"
    echo "## types: bug, feature, task, chore (create maps the type to an existing label; none -> created unlabeled)"
    echo "## labels"
    if [[ -z "$REPO_LABELS" ]]; then
      echo "(none defined)"
    else
      truncate_lines <<< "$REPO_LABELS"
      total=$(awk 'END{print NR}' <<< "$REPO_LABELS")
      if [[ "$total" -gt 50 ]]; then
        echo "## note: label list truncated at 50 ($total total)"
      fi
    fi
    ;;

  list)
    state=open
    limit=20
    search=""
    milestone=""
    type=""
    labels=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --state)
          [[ $# -ge 2 ]] || { echo "error: --state needs a value" >&2; exit 2; }
          state=$2; shift 2 ;;
        --type)
          [[ $# -ge 2 ]] || { echo "error: --type needs a value" >&2; exit 2; }
          type=$2; shift 2 ;;
        --label)
          [[ $# -ge 2 ]] || { echo "error: --label needs a value" >&2; exit 2; }
          labels+=("$2"); shift 2 ;;
        --search)
          [[ $# -ge 2 ]] || { echo "error: --search needs a value" >&2; exit 2; }
          search=$2; shift 2 ;;
        --milestone)
          [[ $# -ge 2 ]] || { echo "error: --milestone needs a value" >&2; exit 2; }
          milestone=$2; shift 2 ;;
        --limit)
          [[ $# -ge 2 ]] || { echo "error: --limit needs a value" >&2; exit 2; }
          limit=$2; shift 2 ;;
        *) echo "error: unknown list argument: $1" >&2; exit 2 ;;
      esac
    done
    case "$state" in open|closed|all) ;; *)
      echo "error: --state must be open, closed or all: $state" >&2; exit 2 ;;
    esac
    if ! [[ "$limit" =~ ^[1-9][0-9]*$ ]]; then
      echo "error: --limit must be a positive number: $limit" >&2
      exit 2
    fi
    resolve_backend
    filters="state=$state"
    args=(issue list --state "$state" --limit $((limit + 1)))
    if [[ -n "$type" ]]; then
      if ! type_label_candidates "$type" >/dev/null 2>&1; then
        echo "error: unknown type: $type (bug, feature, task, chore)" >&2
        exit 2
      fi
      fetch_labels
      tlabel=$(type_label "$type")
      if [[ -z "$tlabel" ]]; then
        echo "error: no existing label maps to type $type — cannot filter by it" >&2
        exit 8
      fi
      labels+=("$tlabel")
      filters="$filters, type=$type"
    fi
    for l in ${labels[@]+"${labels[@]}"}; do
      args+=(--label "$l")
      filters="$filters, label=$l"
    done
    if [[ -n "$search" ]]; then
      args+=(--search "$search")
      filters="$filters, search=\"$search\""
    fi
    if [[ -n "$milestone" ]]; then
      args+=(--milestone "$milestone")
      filters="$filters, milestone=$milestone"
    fi
    args+=(--json number,state,title,labels --jq '.[] | "#\(.number) \(.state|ascii_downcase)  \(.title)" + (if (.labels|length) > 0 then " (" + ([.labels[].name]|join(", ")) + ")" else "" end)')
    out=$(run_gh "${args[@]}")
    if [[ -z "$out" ]]; then
      echo "no matches ($filters)"
    else
      count=$(awk 'END{print NR}' <<< "$out")
      if [[ "$count" -gt "$limit" ]]; then
        awk -v n="$limit" 'NR<=n' <<< "$out"
        echo "total: more than $limit ($filters)"
        echo "note: list truncated at $limit — narrow the filters or raise --limit"
      else
        printf '%s\n' "$out"
        echo "total: $count ($filters)"
      fi
    fi
    ;;

  get)
    [[ $# -ge 1 ]] || usage
    id=$(norm_id "$1")
    resolve_backend
    meta=$(run_gh issue view "$id" --json number,state,title,url,labels --jq '"#\(.number) \(.state|ascii_downcase) — \(.title)\n\(.url)\nlabels: " + (if (.labels|length) > 0 then ([.labels[].name]|join(", ")) else "(none)" end)')
    body=$(fetch_body "$id")
    echo "backend: $BACKEND"
    printf '%s\n' "$meta"
    parse_relations "$body"
    echo "## body"
    strip_markers "$body"
    ;;

  create)
    title=""
    type=""
    body_file=""
    parent=""
    labels=()
    deps=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --title)
          [[ $# -ge 2 ]] || { echo "error: --title needs a value" >&2; exit 2; }
          title=$2; shift 2 ;;
        --type)
          [[ $# -ge 2 ]] || { echo "error: --type needs a value" >&2; exit 2; }
          type=$2; shift 2 ;;
        --body-file)
          [[ $# -ge 2 ]] || { echo "error: --body-file needs a value" >&2; exit 2; }
          body_file=$2; shift 2 ;;
        --label)
          [[ $# -ge 2 ]] || { echo "error: --label needs a value" >&2; exit 2; }
          labels+=("$2"); shift 2 ;;
        --depends-on)
          [[ $# -ge 2 ]] || { echo "error: --depends-on needs a value" >&2; exit 2; }
          deps+=("$(norm_id "$2")"); shift 2 ;;
        --parent)
          [[ $# -ge 2 ]] || { echo "error: --parent needs a value" >&2; exit 2; }
          parent=$(norm_id "$2"); shift 2 ;;
        *) echo "error: unknown create argument: $1" >&2; exit 2 ;;
      esac
    done
    if [[ -z "$title" || -z "$type" || -z "$body_file" ]]; then
      echo "error: --title, --type and --body-file are required" >&2
      exit 2
    fi
    if ! type_label_candidates "$type" >/dev/null 2>&1; then
      echo "error: unknown type: $type (bug, feature, task, chore)" >&2
      exit 2
    fi
    # TM-C5: checkable parts of the title convention; conciseness stays
    # with the model.
    if ! [[ "$title" =~ [^[:space:]] ]]; then
      echo "error: title is empty" >&2
      exit 5
    fi
    if [[ "$title" == *. ]]; then
      echo "error: title has trailing period" >&2
      exit 5
    fi
    if [[ "$title" == *$'\n'* ]]; then
      echo "error: title must be a single line" >&2
      exit 5
    fi
    read_body_file "$body_file"
    check_attribution "$title"$'\n'"$BODY"
    check_body_structure "$type" "$BODY"
    resolve_backend
    fetch_labels
    for l in ${labels[@]+"${labels[@]}"}; do
      if ! label_exists "$l"; then
        echo "error: label does not exist in the tracker: $l — pick from:" >&2
        truncate_lines <<< "$REPO_LABELS" >&2
        exit 8
      fi
    done
    tlabel=$(type_label "$type")
    type_note=""
    if [[ -z "$tlabel" ]]; then
      type_note="note: no existing label matches type $type — created without a type label"
    else
      already=""
      for l in ${labels[@]+"${labels[@]}"}; do
        if [[ "$l" == "$tlabel" ]]; then already=1; fi
      done
      if [[ -z "$already" ]]; then
        labels+=("$tlabel")
      fi
    fi
    # TM-2: verify every relation target before creating anything.
    for d in ${deps[@]+"${deps[@]}"}; do
      verify_ticket "$d" >/dev/null
    done
    if [[ -n "$parent" ]]; then
      verify_ticket "$parent" >/dev/null
    fi
    body_out=$BODY
    markers=""
    for d in ${deps[@]+"${deps[@]}"}; do
      markers="$markers"$'\n'"Depends-on: #$d"
    done
    if [[ -n "$parent" ]]; then
      markers="$markers"$'\n'"Parent: #$parent"
    fi
    if [[ -n "$markers" ]]; then
      body_out="$body_out"$'\n'"$markers"
    fi
    TMPFILE=$(mktemp)
    printf '%s\n' "$body_out" > "$TMPFILE"
    args=(issue create --title "$title" --body-file "$TMPFILE")
    for l in ${labels[@]+"${labels[@]}"}; do
      args+=(--label "$l")
    done
    url=$(run_gh "${args[@]}" | awk 'NF {l=$0} END {print l}')
    num=${url##*/}
    echo "backend: $BACKEND"
    echo "created: #$num $url"
    if [[ -n "$tlabel" ]]; then
      echo "type: $type (label: $tlabel)"
    else
      echo "type: $type"
    fi
    if [[ ${#labels[@]} -gt 0 ]]; then
      out=""
      for l in "${labels[@]}"; do
        out="$out${out:+, }$l"
      done
      echo "labels: $out"
    fi
    if [[ ${#deps[@]} -gt 0 || -n "$parent" ]]; then
      parse_relations "$body_out"
    fi
    if [[ -n "$type_note" ]]; then
      echo "$type_note"
    fi
    ;;

  comment)
    [[ $# -ge 1 ]] || usage
    id=$(norm_id "$1")
    shift
    body_file=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --body-file)
          [[ $# -ge 2 ]] || { echo "error: --body-file needs a value" >&2; exit 2; }
          body_file=$2; shift 2 ;;
        *) echo "error: unknown comment argument: $1" >&2; exit 2 ;;
      esac
    done
    if [[ -z "$body_file" ]]; then
      echo "error: --body-file required" >&2
      exit 2
    fi
    read_body_file "$body_file"
    check_attribution "$BODY"
    resolve_backend
    verify_ticket "$id" >/dev/null
    url=$(run_gh issue comment "$id" --body-file "$body_file" | awk 'NF {l=$0} END {print l}')
    echo "commented on #$id: $url"
    ;;

  close|reopen)
    [[ $# -ge 1 ]] || usage
    [[ $# -eq 1 ]] || { echo "error: unknown $cmd argument: $2" >&2; exit 2; }
    id=$(norm_id "$1")
    resolve_backend
    info=$(verify_ticket "$id")
    state=${info%%$'\t'*}
    title=${info#*$'\t'}
    if [[ "$cmd" == close ]]; then
      target=closed
    else
      target=open
    fi
    # TM-U4: the transition is deliberate and reported from -> to; a no-op
    # transition is a refusal, not silent success.
    if [[ "$state" == "$target" ]]; then
      echo "error: #$id is already $target — $title" >&2
      exit 9
    fi
    run_gh issue "$cmd" "$id" >/dev/null
    echo "#$id: $state -> $target — $title"
    ;;

  label)
    [[ $# -ge 1 ]] || usage
    id=$(norm_id "$1")
    shift
    add=""
    remove=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --add)
          [[ $# -ge 2 ]] || { echo "error: --add needs a value" >&2; exit 2; }
          add=$2; shift 2 ;;
        --remove)
          [[ $# -ge 2 ]] || { echo "error: --remove needs a value" >&2; exit 2; }
          remove=$2; shift 2 ;;
        *) echo "error: unknown label argument: $1" >&2; exit 2 ;;
      esac
    done
    if [[ -n "$add" && -n "$remove" ]] || [[ -z "$add" && -z "$remove" ]]; then
      echo "error: exactly one of --add or --remove" >&2
      exit 2
    fi
    resolve_backend
    verify_ticket "$id" >/dev/null
    current=$(issue_labels "$id")
    if [[ -n "$add" ]]; then
      fetch_labels
      if ! label_exists "$add"; then
        echo "error: label does not exist in the tracker: $add — pick from:" >&2
        truncate_lines <<< "$REPO_LABELS" >&2
        exit 8
      fi
      if grep -qxF "$add" <<< "$current"; then
        echo "error: #$id already has label: $add" >&2
        exit 9
      fi
      run_gh issue edit "$id" --add-label "$add" >/dev/null
      echo "#$id labels: +$add"
    else
      if ! grep -qxF "$remove" <<< "$current"; then
        echo "error: #$id does not have label: $remove" >&2
        exit 9
      fi
      run_gh issue edit "$id" --remove-label "$remove" >/dev/null
      echo "#$id labels: -$remove"
    fi
    ;;

  relate)
    [[ $# -ge 1 ]] || usage
    id=$(norm_id "$1")
    shift
    op=""
    target=""
    ops=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --depends-on)
          [[ $# -ge 2 ]] || { echo "error: --depends-on needs a value" >&2; exit 2; }
          op=add-dep; target=$(norm_id "$2"); ops=$((ops + 1)); shift 2 ;;
        --remove-depends-on)
          [[ $# -ge 2 ]] || { echo "error: --remove-depends-on needs a value" >&2; exit 2; }
          op=rm-dep; target=$(norm_id "$2"); ops=$((ops + 1)); shift 2 ;;
        --parent)
          [[ $# -ge 2 ]] || { echo "error: --parent needs a value" >&2; exit 2; }
          op=add-parent; target=$(norm_id "$2"); ops=$((ops + 1)); shift 2 ;;
        --remove-parent)
          op=rm-parent; target=""; ops=$((ops + 1)); shift ;;
        *) echo "error: unknown relate argument: $1" >&2; exit 2 ;;
      esac
    done
    # TM-U2: one asked change per invocation, nothing smuggled alongside.
    if [[ $ops -ne 1 ]]; then
      echo "error: exactly one relation change per invocation" >&2
      exit 2
    fi
    if [[ -n "$target" && "$target" == "$id" ]]; then
      echo "error: #$id cannot relate to itself" >&2
      exit 2
    fi
    resolve_backend
    verify_ticket "$id" >/dev/null
    body=$(fetch_body "$id")
    case "$op" in
      add-dep)
        verify_ticket "$target" >/dev/null
        if has_marker "$body" "Depends-on: #$target"; then
          echo "error: #$id already depends on #$target" >&2
          exit 9
        fi
        body="$body"$'\n'"Depends-on: #$target"
        ;;
      rm-dep)
        if ! has_marker "$body" "Depends-on: #$target"; then
          echo "error: #$id does not depend on #$target" >&2
          exit 9
        fi
        body=$(remove_marker "$body" "Depends-on: #$target")
        ;;
      add-parent)
        existing=$(awk '/^Parent: #[0-9]+$/ {print $2; exit}' <<< "$body")
        if [[ -n "$existing" ]]; then
          echo "error: #$id already has parent $existing — use --remove-parent first" >&2
          exit 9
        fi
        verify_ticket "$target" >/dev/null
        body="$body"$'\n'"Parent: #$target"
        ;;
      rm-parent)
        existing=$(awk '/^Parent: #[0-9]+$/ {print $2; exit}' <<< "$body")
        if [[ -z "$existing" ]]; then
          echo "error: #$id has no parent" >&2
          exit 9
        fi
        body=$(awk '!/^Parent: #[0-9]+$/' <<< "$body")
        ;;
    esac
    write_body "$id" "$body"
    echo "#$id relations:"
    parse_relations "$body"
    ;;

  *)
    usage
    ;;
esac
