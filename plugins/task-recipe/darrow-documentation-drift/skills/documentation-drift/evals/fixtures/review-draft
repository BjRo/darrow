#!/usr/bin/env bash
set -eu
draft=$1
test -r "$draft"
state=.fixture-state
digest=$(git hash-object "$draft")
if grep -Eqi 'token|encrypt' "$draft"; then
  cat "$draft" >>"$state/rejected-bodies"
  printf '%s\n' "$digest rejected-unsupported" >>"$state/reviewed-drafts"
  printf '%s\n' 'Rejected: the diagnostic snapshot does not establish token storage behavior. It cannot support removing the encryption guarantee. Withhold this proposed correction until runtime evidence exists.'
elif ! grep -qi 'offline' "$draft"; then
  printf '%s\n' "$digest directly-cleared" >>"$state/reviewed-drafts"
  printf '%s\n' 'Exact routine draft cleared.'
else
  correction=offline-default
  if grep -Eqi 'paid|plan|entitlement|purchase|upgrade' "$draft"; then
    correction=offline-entitlement
  fi
  prior="$state/revision-$correction"
  if test ! -e "$prior"; then
    printf '%s\n' "$digest finding-open $correction" >>"$state/reviewed-drafts"
    printf '%s\n' "$digest" >"$prior"
    printf '%s\n' 'Finding: clarify the completion criteria so readers need no paid upgrade for offline access, while preserving the current disabled offline default. source.json grants every-plan availability and sets offlineDefault to false. Return the revised exact draft for repair verification; no prescribed heading or wording is required.'
  else
    test "$digest" != "$(cat "$prior")"
    printf '%s\n' "$digest resolved-cleared $correction" >>"$state/reviewed-drafts"
    printf '%s\n' 'Prior finding resolved. Exact current draft cleared; the governing source remains every-plan availability with the offline default disabled.'
  fi
fi
