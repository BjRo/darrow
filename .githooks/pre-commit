#!/bin/sh
set -eu

if ! command -v bun >/dev/null 2>&1; then
  echo "error: Bun is required to run the pre-commit checks" >&2
  exit 1
fi

bun run lint:staged

staged_root=$(mktemp -d)
trap 'rm -rf "$staged_root"' EXIT HUP INT TERM
git checkout-index --all --prefix="$staged_root/"

if [ ! -f "$staged_root/scripts/plugin-projections.ts" ]; then
  echo "error: staged projection checker is missing" >&2
  exit 1
fi

bun "$staged_root/scripts/plugin-projections.ts" check-staged "$PWD"
