#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if ! command -v bun >/dev/null 2>&1; then
  echo "error: Bun is required to run the pre-commit lint check" >&2
  exit 1
fi

if ! command -v shellcheck >/dev/null 2>&1; then
  echo "error: shellcheck is required to run the pre-commit lint check" >&2
  echo "hint: brew install shellcheck" >&2
  exit 1
fi

exec bun run lint:staged
